{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Colours are the STYLUS palette hexes rather than terminal colour names.
  // Names like "cyan" and "magenta" resolve against whatever the terminal's
  // ANSI palette happens to be, which is why this came out as a row of green,
  // teal, yellow and pink keys - four hues that appear nowhere else in the
  // everything else when the scheme changes.

  // The STYLUS wordmark, generated by tools/gen-artwork.py from the same glyphs
  // as the wallpaper and the boot splash. "file" (not "file-raw") so the $1/$2
  // colour placeholders in it are honoured: $1 is the mark, $2 the campus line
  // beneath it, which now reads as a subtitle instead of competing with it.
  "logo": {
    "type": "file",
    "source": "/usr/share/stylus/logo.txt",
    // Three colours, switched inline inside the wordmark: the solid strokes in
    // the institutional green, the drop shadow in a darker one so the mark has
    // depth, and the campus line quieter than both.
    "color": {
      "1": "#5bcefa",
      "2": "#141820",
      "3": "#c3cbd8"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    // Values line up in one column instead of ragging off the end of each key.
    // 12, not 10: the widest key is "Terminal", which with its icon is ten
    // cells, and fastfetch aligns values by jumping the cursor to an absolute
    // column. At 10 that column landed *inside* the key and the value printed
    // over the end of it.
    "key": { "width": 12 },
    "color": {
      "keys": "#5bcefa",
      "title": "#5bcefa",
      "output": "#e2e7f0"
    }
  },

  // Grouped, because thirteen facts in a flat list is a wall. The headings do
  // the work the four key colours used to attempt.
  "modules": [
    { "type": "title", "fqdn": false },

    { "type": "custom", "format": "Sistema", "outputColor": "#5bcefa" },
    { "type": "os",       "key": " OS" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": " Ligado" },
    { "type": "packages", "key": " Pacotes" },
    "break",

    { "type": "custom", "format": "Ambiente", "outputColor": "#5bcefa" },
    { "type": "wm",       "key": " Janelas" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    "break",

    { "type": "custom", "format": "Hardware", "outputColor": "#5bcefa" },
    { "type": "cpu",      "key": " CPU" },
    { "type": "gpu",      "key": " GPU" },
    { "type": "memory",   "key": " RAM" },
    // zram is one of the things that makes an old machine usable here, and
    // this is the only place that shows whether it is actually working: on a
    // 4 GiB laptop the swap line is compressed memory, not disk.
    { "type": "swap",     "key": " Swap" },
    { "type": "disk",     "key": " Disco", "folders": "/" },
    // Prints nothing at all on a machine with no battery, so the desktops in
    // the lab do not get an empty row. Checked against fastfetch 2.66.
    { "type": "battery",  "key": " Bateria" },
    { "type": "localip",  "key": " Rede" },
    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
