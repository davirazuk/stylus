# ─────────────────────────────────────────────────────────────────────────────
#  STYLUS — i3 configuration
#  Docs: https://i3wm.org/docs/userguide.html      Cheatsheet: $mod+F1
# ─────────────────────────────────────────────────────────────────────────────

set $mod Mod4
# alacritty, because it is the terminal this system actually ships — it is in
# packages.x86_64 and in packages.install, and xfce4-terminal is in neither.
# Mod+Return opened nothing at all on the live medium for exactly that reason.
# Anything that has to RUN something in a window goes through stylus-term,
# which picks whichever terminal is installed and gets its "run this" flag
# right (they all spell it differently) instead of hardcoding one here.
set $term alacritty
set $termrun stylus-term
set $menu rofi -show drun

font pango:JetBrainsMono Nerd Font 10

# ── Behaviour ────────────────────────────────────────────────────────────────
# New windows open as tabs rather than splitting the screen. Plain i3 tiling
# rearranges everything you already had open every time you start an app, which
# is disorienting if you have not used a tiling window manager before. Tabbed
# means each app gets the whole workspace and you move between them with
# Mod+Left/Right or Alt+Tab - closer to what people expect - while splitting is
# still one keypress away with Mod+B / Mod+V.
workspace_layout tabbed
focus_follows_mouse no
mouse_warping none
title_align center
popup_during_fullscreen smart

# ── Autostart ────────────────────────────────────────────────────────────────
exec --no-startup-id dunst
exec --no-startup-id ~/.config/picom/launch.sh
# The wallpaper lives in its own directory (backgrounds/stylus/stylus.png).
# Pointed one level too high, feh simply exits and the desktop comes up on the
# X root's grey stipple, which reads as "the theme did not load".
exec --no-startup-id feh --no-fehbg --bg-fill /usr/share/backgrounds/stylus/stylus.png
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xdg-user-dirs-update

# Mount removable media and say so. thunar-volman only does this while Thunar is
# open, being a Thunar plugin, so plugging in a pendrive on the desktop itself
# used to do nothing at all. No tray icon: the bar has no tray, and udiskie
# notifies through dunst anyway.
exec --no-startup-id udiskie --no-tray --automount --notify

# Night light. Warms the screen after sunset. The config file it used to be
# pointed at was never shipped, and gammastep exits with an error when -c names
# a file that is not there - so the night light simply never ran. The
# coordinates go on the command line instead, which needs no file and no
# geolocation service. -l is latitude:longitude; this is Campo Grande, the same
# default the installer uses for the timezone.
exec --no-startup-id gammastep -l -20.44:-54.65 -t 6500:3600

# Lock after 10 minutes idle, blank the screen after 12. xss-lock also locks on
# suspend, so closing a laptop lid does the right thing.
exec --no-startup-id xset s 600 && xset dpms 0 0 720
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/lock.sh
# Avisa quando o lado do disco acaba. É a tese do sistema — "no meio você tem
# que levantar e virar" — e era a única parte dela que nada implementava: a
# barra CONTAVA ("vira em 12 min") e ninguém nunca era avisado no momento.
exec --no-startup-id stylus-side-watch
exec --no-startup-id ~/.config/i3/scripts/battery-watch.sh
exec --no-startup-id ~/.config/i3/scripts/disk-watch.sh
# Checks once, shortly after login, whether the graphics driver is actually
# working - and says so if it is not, since nothing else about that failure is
# visible until a game refuses to start.
exec --no-startup-id ~/.config/i3/scripts/gpu-watch.sh
# Put the mouse speed back where it was left. libinput's per-device properties
# are not persisted by anything - they reset to the default on every login, so a
# speed chosen once was gone the next morning.
exec --no-startup-id stylus-mouse --apply
# And the learned mouse button, if there is one. Exits immediately and silently
# when there is not, which is the ordinary case.
exec --no-startup-id stylus-mouse --daemon
# Lay the screens out before the bar starts, so polybar sees the final set of
# outputs and puts a bar on each.
#
# Only when there is more than one screen. On a single-screen machine there is
# nothing to lay out and autorandr can only do harm: --default horizontal
# applies each output's preferred mode, which on a laptop that was running
# anything else changes the resolution out from under the person using it. That
# is not hypothetical - it went out and broke a machine.
#
# --skip-options gamma leaves gammastep's night warmth alone, which autorandr
# would otherwise reset every time a screen changed.
exec_always --no-startup-id sh -c 'if command -v autorandr >/dev/null && [ "$(xrandr --query | grep -c " connected")" -gt 1 ]; then autorandr --change --default horizontal --skip-options gamma; fi; exec ~/.config/polybar/launch.sh'

# The launcher opens with the session, so the machine starts on the list of
# what it can do rather than on an empty desktop. Esc closes it and you are on
# the desktop as before. The script skips live media and the first login, where
# the welcome screen has to be the thing you see; delete this line to stop it
# opening on its own. `exec`, not `exec_always` - otherwise every config reload
exec --no-startup-id ~/.config/i3/scripts/autostart-launcher.sh

# ── Applications ─────────────────────────────────────────────────────────────
bindsym $mod+Return    exec $term
bindsym $mod+d         exec $menu
bindsym $mod+e         exec thunar
bindsym $mod+g         exec stylus-ui
# Ctrl+Shift+Esc is the reflex everyone brings from Windows; Mod+Esc is the
# same idea without clashing with a terminal's Ctrl+Shift bindings. Falls back
# to htop in a terminal if the graphical one is not installed.
bindsym $mod+Escape    exec --no-startup-id stylus-term "Processos" btop
bindsym $mod+n         exec --no-startup-id ~/.config/i3/scripts/nightlight.sh
# The notification centre: everything the machine said and you did not catch,
# plus Não perturbe. The bell in the bar is the discoverable way in; this is
# for the people who would rather not reach for the mouse.
bindsym $mod+Shift+n   exec --no-startup-id ~/.config/rofi/notifications.sh
# Re-detect the screens, for when a projector is plugged into a machine whose
# udev rule did not fire, or when the room's cable is swapped mid-class.
bindsym $mod+p         exec --no-startup-id ~/.config/i3/scripts/screens.sh
# ...and switch the screen to the largest mode it advertises, for a monitor
# being driven below what it can do - a 1440p or 4K panel running at 1080
# because the preferred mode in its list is not its native one. Separate from
# Mod+P because changing someone's resolution should be something they asked
# for, not something a script decides at login.
bindsym $mod+Shift+p   exec --no-startup-id ~/.config/i3/scripts/screens.sh --use-best
bindsym $mod+Shift+a   exec $termrun "Programas" stylus-app
# The installer. It was bound to `install-stylus`, which has never been the
# name of anything: the command is stylus-install. Booting the USB stick and
# pressing the documented key did nothing whatsoever.
bindsym $mod+Shift+i   exec $termrun "Instalar o STYLUS" sudo stylus-install
bindsym $mod+q         kill
bindsym $mod+Shift+q   kill
bindsym $mod+Shift+c   reload
bindsym $mod+Shift+r   restart
bindsym $mod+Shift+e   exec ~/.config/rofi/powermenu.sh
bindsym $mod+l         exec --no-startup-id ~/.config/i3/scripts/lock.sh

# Cheatsheet
bindsym $mod+F1 exec --no-startup-id stylus-term "stylus-help" less -R /usr/share/stylus/keybindings.txt

# ── Screenshots (maim) ───────────────────────────────────────────────────────
# The modes live in one script rather than three near-identical one-liners
# here, which is how the window mode finally got added. Mod1 is Alt: i3 does
# not document "Alt" as a modifier name, and `i3 -C` accepts any name it does
# not recognise without complaint, so the working spelling is the one already
# used by Alt+Tab below.
bindsym Print       exec --no-startup-id ~/.config/i3/scripts/screenshot.sh full
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh region
bindsym Mod1+Print  exec --no-startup-id ~/.config/i3/scripts/screenshot.sh window
bindsym Ctrl+Print  exec --no-startup-id ~/.config/i3/scripts/screenshot.sh clip

# ── Media / hardware keys ────────────────────────────────────────────────────
set $osd ~/.config/i3/scripts/osd.sh
bindsym XF86AudioRaiseVolume  exec --no-startup-id $osd vol-up
bindsym XF86AudioLowerVolume  exec --no-startup-id $osd vol-down
bindsym XF86AudioMute         exec --no-startup-id $osd vol-mute
bindsym XF86AudioMicMute      exec --no-startup-id $osd mic-mute
bindsym XF86MonBrightnessUp   exec --no-startup-id $osd bright-up
bindsym XF86MonBrightnessDown exec --no-startup-id $osd bright-down
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
bindsym $mod+Shift+m          exec --no-startup-id pavucontrol

# ── Focus ────────────────────────────────────────────────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# ── Move ─────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ── Layout ───────────────────────────────────────────────────────────────────
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod

# ── Workspaces ───────────────────────────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# A familiar window switcher, on the key people already reach for.
bindsym Mod1+Tab        exec --no-startup-id rofi -show window
bindsym $mod+Tab        workspace back_and_forth
bindsym $mod+Ctrl+Left  workspace prev
bindsym $mod+Ctrl+Right workspace next

# ── Resize ───────────────────────────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ── Window rules ─────────────────────────────────────────────────────────────
for_window [window_role="pop-up"]         floating enable
for_window [window_role="task_dialog"]    floating enable
for_window [window_type="dialog"]         floating enable
for_window [class="Pavucontrol"]          floating enable, resize set 800 550
for_window [class="Blueman-manager"]      floating enable, resize set 700 500
for_window [class="Arandr"]               floating enable
for_window [class="Gparted"]              floating enable
for_window [class="Nm-connection-editor"] floating enable
# Mod+Esc. A task manager is something you glance at and dismiss, so it floats
# like the other utility windows rather than becoming another tab you have to
# navigate away from.
for_window [title="^Processos$"]            floating enable, resize set 900 620, move position center
for_window [title="^STYLUS$"]               fullscreen enable
for_window [title="stylus-help"]            floating enable, resize set 820 640, move position center
# The installer is a dialog(1) TUI and wants the whole screen to be readable.
for_window [title="Instalar o STYLUS"]      fullscreen enable

# ── Appearance ───────────────────────────────────────────────────────────────
gaps inner 10
gaps outer 6
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 3
title_align center

# In a tabbed workspace the tab bar *is* the window decoration, so it needs to
# be legible rather than hairline-thin.
for_window [class=".*"] title_format "  %title  "

# class                 border  backgr. text    indicator child_border
client.focused          #5bcefa #5bcefa #040507 #5bcefa   #5bcefa
client.focused_inactive #0d0f14 #0d0f14 #e2e7f0 #0d0f14   #0d0f14
client.unfocused        #0d0f14 #07080b #7e899c #0d0f14   #0d0f14
client.urgent           #f5a9b8 #f5a9b8 #040507 #f5a9b8   #f5a9b8
client.background       #07080b

# ── STYLUS ────────────────────────────────────────────────────────────────
# A estante, o deck e a volta para o modo música. São as três coisas que
# você quer alcançar sem tirar a mão do teclado num sistema cujo assunto é
# a coleção.
# $mod+d já é o menu e $mod+Shift+m já é o pavucontrol, então estas ficam em
# torno de $mod+m (a estante), que é a que se usa dez vezes por dia.
bindsym $mod+m         exec --no-startup-id stylus-shelf
bindsym $mod+Control+m exec --no-startup-id stylus-mode music
bindsym $mod+o         exec --no-startup-id stylus-deck
bindsym $mod+Shift+o   exec --no-startup-id stylus record --play
bindsym $mod+slash     exec --no-startup-id rofi -e "$(stylus lyrics --print 2>/dev/null)"
