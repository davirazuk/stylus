#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-update — traz o STYLUS novo do GitHub e atualiza o sistema
# ═══════════════════════════════════════════════════════════════════════════
#      stylus-update              o pacote todo: sistema + STYLUS
#      stylus-update --check      só diz o que mudaria, não mexe em nada
#      stylus-update --stylus     só o STYLUS (rápido, sem pacman)
#      stylus-update --system     só os pacotes
#      stylus-update --branch X   de outro galho, para testar algo
#      stylus-update --force-dotfiles   adota os padrões novos por cima dos seus
#
#  Como funciona: o repositório é a fonte. Ele é clonado raso para
#  /var/lib/stylus/repo e o airootfs de dentro dele é copiado por cima do
#  sistema. Isso quer dizer que qualquer melhoria empurrada para o GitHub
#  chega aqui com um comando, sem ISO nova e sem reinstalar nada.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

REPO="${STYLUS_REPO:-https://github.com/davirazuk/stylus.git}"
BRANCH="${STYLUS_BRANCH:-main}"
STATE=/var/lib/stylus
REPO_DIR="$STATE/repo"

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'
c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

CHECK=0; DO_SYS=1; DO_STY=1; FORCE_DOT=0
while [[ $# -gt 0 ]]; do
    case $1 in
        --check)   CHECK=1; shift ;;
        --stylus)  DO_SYS=0; shift ;;
        --system)  DO_STY=0; shift ;;
        --branch)  BRANCH=${2:?}; shift 2 ;;
        --force-dotfiles) FORCE_DOT=1; shift ;;
        -h|--help) sed -n '4,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) die "não conheço $1" ;;
    esac
done

# Só pede root quando vai mesmo escrever. `--check` roda como usuário, que é
# como uma verificação deveria ser: sem custo e sem consequência.
if (( ! CHECK )) && [[ $EUID -ne 0 ]]; then
    exec sudo -E "$0" "$@"
fi
SUDO=""; [[ $EUID -eq 0 ]] || SUDO=sudo

command -v git >/dev/null || die "o git não está instalado."

# ── 1. trazer o repositório ────────────────────────────────────────────────
$SUDO mkdir -p "$STATE"
OLD=""
if [[ -d $REPO_DIR/.git ]]; then
    OLD=$($SUDO git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo "")
    info "Buscando $REPO ($BRANCH)…"
    $SUDO git -C "$REPO_DIR" remote set-url origin "$REPO"
    $SUDO git -C "$REPO_DIR" fetch --depth 1 origin "$BRANCH" >/dev/null 2>&1 \
        || die "não consegui buscar. sem rede?"
    $SUDO git -C "$REPO_DIR" reset --hard "origin/$BRANCH" >/dev/null
else
    info "Clonando $REPO ($BRANCH)…"
    $SUDO rm -rf "$REPO_DIR"
    $SUDO git clone --depth 1 --branch "$BRANCH" "$REPO" "$REPO_DIR" >/dev/null 2>&1 \
        || die "não consegui clonar. sem rede?"
fi
NEW=$($SUDO git -C "$REPO_DIR" rev-parse --short HEAD)
QUANDO=$($SUDO git -C "$REPO_DIR" log -1 --format=%cd --date=short)

echo
if [[ $OLD == "$NEW" ]]; then
    ok "o STYLUS já está no $NEW ($QUANDO)"
else
    ok "STYLUS ${OLD:-—} → $NEW ($QUANDO)"
    echo
    if [[ -n $OLD ]]; then
        $SUDO git -C "$REPO_DIR" log --oneline "$OLD..$NEW" 2>/dev/null | head -25 \
            | sed "s/^/    $c_d/;s/\$/$c_0/" || true
    else
        $SUDO git -C "$REPO_DIR" log --oneline -10 | sed "s/^/    $c_d/;s/\$/$c_0/"
    fi
fi
echo

# ── 2. pacotes que passaram a existir na lista ─────────────────────────────
FALTANDO=()
LISTA="$REPO_DIR/packages.x86_64"
if [[ -r $LISTA ]]; then
    while IFS= read -r p; do
        pacman -Qq "$p" >/dev/null 2>&1 || FALTANDO+=("$p")
    done < <(grep -vE '^\s*#|^\s*$' "$LISTA")
fi
if (( ${#FALTANDO[@]} )); then
    warn "${#FALTANDO[@]} pacote(s) da lista não estão instalados:"
    printf '      %s\n' "${FALTANDO[@]}" | head -20
fi

if (( CHECK )); then
    echo
    info "Isto foi só uma conferida. Nada mudou."
    exit 0
fi

# ── 3. o sistema ───────────────────────────────────────────────────────────
if (( DO_SYS )); then
    info "Pacotes…"
    $SUDO pacman -Syu --noconfirm || warn "o pacman reclamou; siga e resolva depois"
    if (( ${#FALTANDO[@]} )); then
        info "Instalando o que passou a fazer parte do STYLUS…"
        $SUDO pacman -S --needed --noconfirm "${FALTANDO[@]}" \
            || warn "algum pacote novo não instalou"
    fi
fi

# ── 4. o STYLUS ────────────────────────────────────────────────────────────
if (( DO_STY )); then
    SYNC="$REPO_DIR/airootfs/usr/share/stylus/sync.sh"
    [[ -x $SYNC ]] || die "o repositório não tem sync.sh — versão estranha?"
    $SUDO env STYLUS_SOURCE="$REPO_DIR/airootfs" \
              STYLUS_FORCE_DOTFILES="$FORCE_DOT" "$SYNC" / \
        || die "a cópia falhou."
fi

# ── 5. serviços que passaram a existir ─────────────────────────────────────
# Tudo que o repositório trouxe e que o sistema ainda não conhece. Ler do
# diretório em vez de manter uma lista aqui é o que evita a lista envelhecer
# em silêncio toda vez que um serviço novo é acrescentado ao repositório.
if [[ -d $REPO_DIR/airootfs/etc/systemd/system ]]; then
    while IFS= read -r -d '' unidade; do
        u=$(basename "$unidade")
        [[ $u == *.service || $u == *.timer ]] || continue
        grep -q '^\[Install\]' "$unidade" || continue
        systemctl is-enabled --quiet "$u" 2>/dev/null && continue
        $SUDO systemctl enable "$u" >/dev/null 2>&1 && ok "serviço novo ligado: $u"
    done < <(find "$REPO_DIR/airootfs/etc/systemd/system" -maxdepth 1 -type f -print0)
fi

echo
ok "pronto. o STYLUS está no $NEW."
echo "   ${c_d}a interface pega as mudanças ao reabrir; \`stylus-mode toggle\` duas vezes basta.${c_0}"
