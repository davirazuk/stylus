#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-set-session — troca a sessão que o SDDM lança (roda como root)
# ═══════════════════════════════════════════════════════════════════════════
#  Chamado pelo stylus-mode via sudo. Valida a entrada: isto roda como root a
#  pedido de um usuário comum, então o que chega aqui não é confiável.
#
#      stylus-set-session desktop      a área de trabalho (KDE, se houver)
#      stylus-set-session music        a tela cheia
#
#  Os nomes de arquivo continuam aceitos por compatibilidade.
#
#  ── Por que ele NUNCA aponta o SDDM direto para o plasmax11.desktop ──
#
#  Porque aí nada do STYLUS roda no caminho. O SDDM lança o Plasma, o KWin
#  não acha OpenGL, morre, e — com autologin — o SDDM lança de novo, para
#  sempre, sem tela de login. Apontando para stylus-desktop.desktop, quem
#  abre o Plasma é o stylus-session, que confere antes se ele tem como abrir
#  e cai no i3 quando não tem. A sessão do Plasma continua instalada e
#  escolhível na tela de login por quem quiser; o que muda é para onde a
#  máquina vai SOZINHA.
#
#  (O Plasma 6 também renomeou a sessão X11 para plasmax11.desktop, e
#  plasma.desktop virou a do Wayland. Este comando aceitava só plasma.desktop
#  e, numa máquina com Plasma 6, gravava no SDDM o nome de uma sessão que não
#  existe. Isso agora não importa mais aqui: quem procura o nome certo é o
#  stylus-session, na hora.)
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

[[ $EUID -eq 0 ]] || { echo "precisa ser root" >&2; exit 1; }

PEDIDO="${1:?uso: stylus-set-session <desktop|music>}"
SDDM_CONF="/etc/sddm.conf.d/stylus.conf"
ESTADO="/var/lib/sddm/state.conf"
XS=/usr/share/xsessions

case "$PEDIDO" in
    desktop|kde|plasma.desktop|plasmax11.desktop|plasma-x11.desktop)
        SESSION=stylus-desktop.desktop ;;
    music|musica|stylus.desktop|stylus-music.desktop)
        SESSION=stylus-music.desktop ;;
    *)  echo "sessão desconhecida: $PEDIDO" >&2; exit 1 ;;
esac

# Um STYLUS antigo pode não ter os dois arquivos separados; ali o despachante
# resolve, lendo ~/.config/stylus/mode — que o stylus-mode acabou de escrever.
[[ -f $XS/$SESSION ]] || SESSION=stylus.desktop
[[ -f $XS/$SESSION ]] || { echo "a sessão $SESSION não está instalada" >&2; exit 1; }

mudou=0

# ── 1. o que o autologin abre sozinho ──────────────────────────────────────
#  Só dentro de um [Autologin] que já exista. Acrescentar a seção quando ela
#  não está lá criava um segundo [Autologin] no mesmo arquivo, com um
#  Session= sem User= nenhum — que não liga autologin em máquina alguma e só
#  deixava o arquivo confuso para quem fosse ler depois.
if [[ -f $SDDM_CONF ]] && grep -q '^\[Autologin\]' "$SDDM_CONF"; then
    if sed -n '/^\[Autologin\]/,/^\[/p' "$SDDM_CONF" | grep -q '^Session='; then
        sed -i "/^\[Autologin\]/,/^\[/{s|^Session=.*|Session=$SESSION|}" "$SDDM_CONF"
    else
        sed -i "/^\[Autologin\]/a Session=$SESSION" "$SDDM_CONF"
    fi
    mudou=1
fi

# ── 2. o que a tela de login vem marcada ───────────────────────────────────
#  Isto é o que o SDDM realmente relê para preselecionar a sessão, e nada
#  mexia nele: trocar de modo mudava o autologin e deixava o greeter marcando
#  a sessão antiga, então quem entrava digitando a senha voltava para o modo
#  de onde tinha acabado de sair.
if [[ -d /var/lib/sddm ]] || mkdir -p /var/lib/sddm 2>/dev/null; then
    if [[ -f $ESTADO ]] && grep -q '^Session=' "$ESTADO"; then
        sed -i "s|^Session=.*|Session=$XS/$SESSION|" "$ESTADO"
    else
        printf '[Last]\nSession=%s\n' "$XS/$SESSION" > "$ESTADO"
    fi
    chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true
    mudou=1
fi

(( mudou )) || { echo "não achei configuração do SDDM para mudar" >&2; exit 1; }
echo "Sessão → $SESSION"
