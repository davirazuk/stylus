#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-set-session — troca a sessão que o SDDM lança (roda como root)
# ═══════════════════════════════════════════════════════════════════════════
#  Chamado pelo stylus-mode via sudo. Valida a entrada: isto roda como root a
#  pedido de um usuário comum, então o que chega aqui não é confiável.
#
#      stylus-set-session desktop      a área de trabalho (KDE, se houver)
#      stylus-set-session music        a tela cheia (i3)
#
#  Os nomes de arquivo continuam aceitos por compatibilidade.
#
#  Por que NOME e não arquivo: o Plasma 6 renomeou a sessão X11 para
#  plasmax11.desktop, e plasma.desktop virou a do Wayland. Este comando só
#  aceitava plasma.desktop — numa máquina com Plasma 6, trocar para a área de
#  trabalho escrevia no SDDM o nome de uma sessão que não existe, e o login
#  seguinte caía numa tela que morre na hora. Quem sabe o nome certo é a
#  máquina; então é ela que responde.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

[[ $EUID -eq 0 ]] || { echo "precisa ser root" >&2; exit 1; }

PEDIDO="${1:?uso: stylus-set-session <desktop|music>}"
SDDM_CONF="/etc/sddm.conf.d/stylus.conf"
XS=/usr/share/xsessions

sessao_da_area_de_trabalho() {
    local c
    for c in plasmax11 plasma-x11 plasma; do
        [[ -f $XS/$c.desktop ]] && { echo "$c.desktop"; return 0; }
    done
    # Sem Plasma instalado, a área de trabalho é o i3 do STYLUS.
    [[ -f $XS/stylus-desktop.desktop ]] && { echo stylus-desktop.desktop; return 0; }
    echo stylus.desktop
}

case "$PEDIDO" in
    desktop|kde|plasma.desktop|plasmax11.desktop|plasma-x11.desktop)
        SESSION=$(sessao_da_area_de_trabalho) ;;
    music|musica|stylus.desktop)
        SESSION=stylus.desktop ;;
    *)  echo "sessão desconhecida: $PEDIDO" >&2; exit 1 ;;
esac

[[ -f $XS/$SESSION ]] || { echo "a sessão $SESSION não está instalada" >&2; exit 1; }
[[ -f $SDDM_CONF ]]   || { echo "$SDDM_CONF não existe" >&2; exit 1; }

if grep -q '^Session=' "$SDDM_CONF"; then
    sed -i "s/^Session=.*/Session=$SESSION/" "$SDDM_CONF"
else
    printf '\n[Autologin]\nSession=%s\n' "$SESSION" >> "$SDDM_CONF"
fi
echo "Sessão → $SESSION"
