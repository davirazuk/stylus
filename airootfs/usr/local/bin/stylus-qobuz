#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-qobuz — a interface do qobuz-dl, e a fila que enche a estante
# ═══════════════════════════════════════════════════════════════════════════
#  Este repositório já trazia DUAS ferramentas que conversam com a interface
#  web do qobuz-dl — `tools/run_queue_api.py` e `tools/run_queue.sh` — e
#  nenhuma delas era alcançável: nada as chamava, nada instalava a interface
#  que elas dirigem, e nada a punha no ar. Era uma fila inteira escrita para
#  um programa que a máquina não tinha.
#
#      stylus qobuz              o estado: instalado? no ar? em que porta?
#      stylus qobuz instalar     instala o qobuz-dl (num venv, dentro da casa)
#      stylus qobuz entrar       entra na sua conta, sem navegador nenhum
#      stylus qobuz buscar TERMO procura discos e mostra id, ano e qualidade
#      stylus qobuz baixar ID    baixa direto para a estante, sem navegador
#      stylus qobuz tocar ID     TOCA sem baixar — o disco vem pela rede
#      stylus qobuz abrir        põe a interface web no ar e abre no navegador
#      stylus qobuz servir       põe no ar e fica em segundo plano
#      stylus qobuz parar        derruba
#      stylus qobuz log          acompanha o registro dela
#      stylus qobuz fila ARQ     baixa a fila inteira e arquiva cada disco
#                                  (linhas "url|artista|álbum")
#
#  O `tocar` é a assinatura usada como assinatura: o disco toca agora, sem
#  ocupar disco nenhum, pelo mesmo mpv e com as mesmas travas de áudio do
#  deck — nada de reamostrar, nada de replaygain. O que você quiser guardar,
#  `baixar` guarda.
#
#  O `buscar` e o `baixar` são o caminho de linha de comando e não precisam da
#  interface web nem de navegador nenhum: buscar imprime os discos com o id ao
#  lado, baixar recebe esse id e põe o disco na estante, no formato
#  Artista/Álbum que o resto do sistema espera. A interface web continua aqui
#  para quem a quiser, mas deixou de ser o único jeito de baixar — antes,
#  buscar achava o disco e não havia o que fazer com o resultado.
#
#  A fila arquiva UM disco de cada vez, inteiro — baixa, move, retagueia,
#  busca letra, atualiza a playlist — antes de começar o próximo. Assim uma
#  queda de energia no meio nunca deixa meio álbum enfiado na estante.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# Igual ao `stylus`: dá para apontar este comando para um clone e testar o
# conserto antes de aplicá-lo na máquina.
SHARE=${STYLUS_SHARE:-/usr/share/stylus}
TOOLS=$SHARE/tools

# O qobuz-dl não existe nos repositórios do Arch, e o `pip install` do sistema
# é recusado (PEP 668) — inclusive com --user. Quem resolve é o venv da
# pessoa; o porquê inteiro está em /usr/share/stylus/venv.sh.
# shellcheck source=/dev/null
source "$SHARE/venv.sh" 2>/dev/null || true
if declare -F venv_python_ou_sistema >/dev/null; then
    PY=$(venv_python_ou_sistema)
else
    PY="$SHARE/deck/venv/bin/python3"; [[ -x $PY ]] || PY=python3
fi

REPO="${STYLUS_QOBUZ_GUI_REPO:-git+https://github.com/peykc/qobuz-dl-gui.git}"
ESTADO="$HOME/.local/share/stylus"
PIDFILE="$ESTADO/qobuz-gui.pid"
LOG="${STYLUS_QOBUZ_LOG:-/tmp/qobuz-gui.log}"
# 8765 é a porta que as duas filas deste repositório sempre falaram. As outras
# são as que as variantes conhecidas do programa usam — procurar é mais barato
# do que a pessoa descobrir sozinha que mudou.
PORTAS=("${STYLUS_QOBUZ_PORT:-}" 8765 5000 8080 3000)

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'
c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

# A trava vale para o que ESCREVE, não para o comando inteiro: `stylus qobuz`
# sozinho e o `--help` só olham, e recusá-los com sudo seria recusar
# justamente a pergunta que alguém faz quando está tentando entender o que
# está acontecendo.
precisa_ser_voce() {
    [[ $EUID -eq 0 ]] && die \
        "não rode isto com sudo: instalaria na casa do root e os discos
       baixariam para /root/Qobuz Downloads, onde você não os vê."
    return 0
}

achar_binario() {
    local c
    # O venv primeiro: é onde o `instalar` põe hoje. Os outros dois caminhos
    # ficam para quem instalou na versão antiga, com --break-system-packages —
    # tirar daqui faria o comando parar de achar o que já estava funcionando.
    if declare -F venv_bin >/dev/null; then
        c=$(venv_bin qobuz-dl-gui) && [[ -n $c ]] && { printf '%s\n' "$c"; return 0; }
    fi
    for c in "$HOME/.local/bin/qobuz-dl-gui" /usr/local/bin/qobuz-dl-gui; do
        [[ -x $c ]] && { printf '%s\n' "$c"; return 0; }
    done
    c=$(command -v qobuz-dl-gui 2>/dev/null) && [[ -n $c ]] && \
        { printf '%s\n' "$c"; return 0; }
    return 1
}

viva_em() {  # viva_em PORTA — responde HTTP ali?
    curl -fsS --max-time 2 -o /dev/null "http://127.0.0.1:$1/" 2>/dev/null
}

achar_porta() {
    local p
    for p in "${PORTAS[@]}"; do
        [[ -n $p ]] || continue
        viva_em "$p" && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

pid_vivo() {
    local pid
    [[ -f $PIDFILE ]] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    # Confere o cmdline, não só a existência do pid: o número pode ter sido
    # reciclado por outro processo qualquer, e matar um pid reciclado é como
    # se derruba a coisa errada.
    grep -qa 'qobuz-dl-gui' "/proc/$pid/cmdline" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

instalar() {
    precisa_ser_voce
    declare -F venv_instalar >/dev/null || die "falta o $SHARE/venv.sh"
    # O qobuz-dl PRIMEIRO: é ele que o `buscar` e o `baixar` usam, e é o que
    # faltava. Antes daqui só a interface web era instalada, então o caminho
    # de linha de comando — o que esta máquina realmente quer — nunca tinha
    # com o que funcionar.
    info "Instalando o qobuz-dl…"
    venv_instalar qobuz-dl || die "não deu para instalar o qobuz-dl (sem rede?)"
    ok "qobuz-dl instalado"
    if [[ ${1:-} != --interface ]]; then
        printf '  %spara a interface web também:  stylus qobuz instalar --interface%s\n' "$c_d" "$c_0"
        return 0
    fi
    info "Instalando a interface do qobuz-dl…"
    # Num venv da pessoa, e não mais com `--user --break-system-packages`.
    # Aquilo funcionava no dia e quebrava depois: o pacote ia para
    # ~/.local/lib/python3.13 e sumia inteiro na atualização para o 3.14, e o
    # executável caía em ~/.local/bin, que pode nem estar no PATH — daí o
    # "instalou e não achei" logo abaixo, que era o fim normal da história.
    # Dentro do venv, nós chamamos o binário pelo caminho todo e nada disso
    # depende de sorte.
    venv_instalar "$REPO" \
        || die "a instalação falhou. Sem rede, ou o repositório mudou de lugar:
       $REPO
       STYLUS_QOBUZ_GUI_REPO aponta para outro."
    achar_binario >/dev/null || die \
        "instalou e o \`qobuz-dl-gui\` não apareceu em
       $STYLUS_VENV/bin — o pacote pode ter mudado o nome do executável."
    ok "$(achar_binario)"
}

servir() {
    local pid porta bin
    precisa_ser_voce
    if porta=$(achar_porta); then
        ok "já está no ar em http://127.0.0.1:$porta/"
        printf '%s\n' "$porta"; return 0
    fi
    bin=$(achar_binario) || die \
        "a interface não está instalada. \`stylus qobuz instalar\`"
    mkdir -p "$ESTADO"
    info "Subindo a interface… (registro em $LOG)"
    # QOBUZ_DL_GUI_BROWSER=1: sem isto ele tenta abrir uma janela própria pelo
    # pywebview, que exige um webkit que esta imagem não traz — e o sintoma é
    # o programa sair na hora sem dizer por quê. No navegador funciona em
    # qualquer máquina, e é onde a fila fala com ele de qualquer forma.
    QOBUZ_DL_GUI_BROWSER=1 setsid "$bin" >>"$LOG" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PIDFILE"
    for _ in $(seq 1 40); do          # até 20 s
        porta=$(achar_porta) && { ok "no ar em http://127.0.0.1:$porta/"
                                  printf '%s\n' "$porta"; return 0; }
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    warn "não respondeu em 20 s. As últimas linhas do registro:"
    tail -n 15 "$LOG" 2>/dev/null | sed 's/^/      /'
    return 1
}

estado() {
    local bin porta pid
    echo
    # O qobuz-dl PRIMEIRO, e a interface web depois. É o qobuz-dl que o
    # `buscar` e o `baixar` usam, e é dele que tudo depende; a interface é
    # opcional. Antes esta tela só falava da interface, então uma máquina com
    # a interface instalada e sem a biblioteca dizia "instalada" e não
    # baixava nada pela linha de comando.
    if "$PY" -c 'import qobuz_dl' 2>/dev/null; then
        ok "o qobuz-dl está aí (é ele que procura e baixa)"
    else
        warn "sem o qobuz-dl — \`stylus qobuz instalar\`"
    fi
    if bin=$(achar_binario); then
        printf '  %s·%s interface web: %s%s\n' "$c_d" "$c_0" "$bin" "$c_0"
    else
        printf '  %s·%s sem interface web (opcional): `stylus qobuz instalar --interface`%s\n' \
            "$c_d" "$c_0" "$c_0"
    fi
    if porta=$(achar_porta); then
        ok "no ar: http://127.0.0.1:$porta/"
    else
        printf '  %s·%s fora do ar — `stylus qobuz abrir`\n' "$c_d" "$c_0"
    fi
    pid=$(pid_vivo) && printf '  %s·%s subida por nós, pid %s%s\n' \
        "$c_d" "$c_0" "$pid" "$c_0"

    # A conta, e por qual dos dois jeitos. Quem entra pela interface web
    # autentica por TOKEN e fica com e-mail e senha vazios no config.ini —
    # olhar só para e-mail e senha diz "sem conta" numa máquina logada.
    local cfg="$HOME/.config/qobuz-dl/config.ini"
    if [[ -f $cfg ]]; then
        if grep -qE '^user_auth_token *= *.+' "$cfg"; then
            ok "conta: entrada por token"
        elif grep -qE '^password *= *.+' "$cfg"; then
            ok "conta: entrada por e-mail e senha"
        else
            warn "config.ini existe mas sem credencial — \`stylus qobuz abrir\`"
        fi
    else
        warn "sem conta ainda — \`stylus qobuz abrir\` e entre uma vez"
    fi

    # Onde cada caminho põe o disco. Eram DOIS destinos diferentes e a tela
    # só mostrava um: o `baixar` põe direto na estante, em Artista/Álbum, e é
    # o caminho normal; a interface web usa a pasta dela e depois alguém tem
    # que arquivar à mão. Mostrar só a segunda fazia parecer que o disco
    # baixado tinha se perdido.
    printf '  %sbaixar → a estante: %s%s\n' "$c_d" \
        "$("$PY" -c 'import sys; sys.path.insert(0,"/usr/share/stylus/deck"); import vinyl; print(vinyl.library_root())' 2>/dev/null || echo '?')" "$c_0"
    printf '  %sinterface web → %s%s\n' "$c_d" \
        "${STYLUS_QOBUZ_DIR:-$HOME/Qobuz Downloads}" "$c_0"
    echo
}

case "${1:-}" in
    ""|estado|status) estado ;;
    instalar|install) shift; instalar "$@" ;;
    servir|serve)     servir >/dev/null ;;
    abrir|open)
        porta=$(servir | tail -1) || exit 1
        [[ $porta =~ ^[0-9]+$ ]] || die "não descobri a porta"
        for nav in xdg-open firefox chromium; do
            command -v "$nav" >/dev/null && { "$nav" "http://127.0.0.1:$porta/" \
                >/dev/null 2>&1 & break; }
        done
        ok "abrindo http://127.0.0.1:$porta/"
        ;;
    parar|stop)
        pid=$(pid_vivo) || { warn "não achei nenhuma que tenhamos subido"; exit 0; }
        kill "$pid" 2>/dev/null
        for _ in $(seq 1 20); do pid_vivo >/dev/null || break; sleep 0.25; done
        pid_vivo >/dev/null && kill -9 "$pid" 2>/dev/null
        rm -f "$PIDFILE"; ok "parada"
        ;;
    log)   exec tail -n 100 -f "$LOG" ;;
    fila|queue)
        arq=${2:-}
        [[ -n $arq && -f $arq ]] || die \
            "uso: stylus qobuz fila ARQUIVO
       uma linha por disco, no formato:  url|artista|álbum"
        porta=$(servir | tail -1) || die "a interface não subiu; sem ela não há fila"
        shift 2 || shift
        export STYLUS_QOBUZ_API="http://127.0.0.1:$porta/api"
        export STYLUS_QOBUZ_LOG="$LOG"
        export PYTHONPATH="$TOOLS:$SHARE/deck${PYTHONPATH:+:$PYTHONPATH}"
        exec "$PY" "$TOOLS/run_queue_api.py" "$arq" "$@"
        ;;
    buscar|search)
        query="${2:-}"
        [[ -n $query ]] || die "uso: stylus qobuz buscar TERMOS"
        "$PY" - "$query" <<'PYEOF'
import contextlib, json, sys, os

# ── Só JSON no stdout ──────────────────────────────────────────────────────
# O qobuz_dl imprime "Logging..." e "Membership: Studio" no stdout ao
# autenticar. Este comando promete JSON, e quem consome — a tela de Qobuz da
# interface em tela cheia — fazia json.loads() em cima de
# "Logging...\nMembership: Studio\n{...}" e estourava. De fora, a busca do
# Qobuz simplesmente não funcionava, sem nada dizendo por quê.
#
# O barulho não é lixo: é útil para quem roda no terminal. Então ele vai para
# o stderr, onde não atrapalha o JSON e continua visível.
@contextlib.contextmanager
def so_json():
    with contextlib.redirect_stdout(sys.stderr):
        yield


try:
    from qobuz_dl.qopy import Client
except ImportError:
    # `pip install qobuz-dl` não funciona no Arch: o python é do pacman e o
    # pip recusa (PEP 668). Mandar fazer o impossível é pior que não dizer
    # nada — quem tentava concluía que o sistema estava quebrado.
    print(json.dumps({"error": "o qobuz-dl não está instalado. "
                               "Rode:  stylus qobuz instalar"}))
    sys.exit(1)

cfg = os.path.expanduser("~/.config/qobuz-dl/config.ini")
if not os.path.isfile(cfg):
    print(json.dumps({"error": "qobuz-dl não configurado: rode `qobuz-dl` uma vez para criar ~/.config/qobuz-dl/config.ini"}))
    sys.exit(1)

import configparser
c = configparser.ConfigParser()
c.read(cfg)
app_id = c.get("DEFAULT", "app_id", fallback="")
secrets = c.get("DEFAULT", "secrets", fallback="")
token = c.get("DEFAULT", "user_auth_token", fallback="")
user_id = c.get("DEFAULT", "user_id", fallback="")

if not app_id or not token:
    print(json.dumps({"error": "qobuz-dl sem credenciais"}))
    sys.exit(1)

secrets_list = [s.strip() for s in secrets.split(",") if s.strip()]
try:
  with so_json():
    client = Client(
        email="", pwd="",
        app_id=app_id,
        secrets=secrets_list,
        skip_auth=True,
    )
    client.auth_with_token(user_id, token)
except Exception as e:
    print(json.dumps({"error": f"autenticação falhou: {e}"}))
    sys.exit(1)

query = sys.argv[1]
try:
    with so_json():
        data = client.search_albums(query, limit=25)
except Exception as e:
    print(json.dumps({"error": f"busca falhou: {e}"}))
    sys.exit(1)

items = data.get("albums", {})
if isinstance(items, dict):
    items = items.get("items", [])
if not isinstance(items, list):
    items = []

results = []
for item in items:
    artist_name = "?"
    artist_data = item.get("artist", {})
    if isinstance(artist_data, dict):
        artist_name = artist_data.get("name", "?")
    elif isinstance(artist_data, str):
        artist_name = artist_data

    # O maximum_sampling_rate do Qobuz JÁ VEM EM kHz (44.1, 96, 192), não em
    # Hz. O `rate/1000` de antes transformava todo CD em "16bit/0.0kHz" — e
    # como o ramo hi-res escondia a taxa por completo, a única taxa que a tela
    # chegava a mostrar era a errada.
    depth = item.get("maximum_bit_depth") or 16
    rate = item.get("maximum_sampling_rate") or 44.1
    try:
        rate = float(rate)
    except (TypeError, ValueError):
        rate = 44.1
    if rate > 1000:                       # se um dia mudarem de ideia
        rate /= 1000.0
    taxa = ("%g" % round(rate, 1)).replace(".", ",")
    quality = f"{depth}bit/{taxa}kHz"

    results.append({
        "id": item.get("id", ""),
        "display_title": item.get("title", "?"),
        "display_subtitle": artist_name,
        "release_year": str(item.get("release_date_original", item.get("release_date_stream", "")))[:4],
        "tracks": item.get("tracks_count", 0),
        "quality": quality,
        # Booleano em vez de "tem 'hi' no texto?": a tela marcava o disco de
        # hi-res procurando a palavra dentro da string de qualidade, e no
        # momento em que a string passou a dizer "24bit/96kHz" o losango
        # dourado sumiu de todos os discos de uma vez.
        "hires": bool(depth > 16 or rate > 48),
        # A capa. Sem ela a loja era uma grade de quadrados cinzentos com um
        # ícone igual em todos — do lado de uma ESTANTE que mostra as capas
        # de verdade, parecia outra máquina. A `large` tem 600 px, que é o
        # tamanho de uma capa na grade em telas grandes.
        "cover": ((item.get("image") or {}).get("large")
                  or (item.get("image") or {}).get("small")
                  or (item.get("image") or {}).get("thumbnail") or ""),
        "url": f"https://www.qobuz.com/album/{item.get('id', '')}",
    })

print(json.dumps({"results": results}))
PYEOF
        ;;
    baixar|download|get)
        alvo="${2:-}"
        [[ -n $alvo ]] || die "uso: stylus qobuz baixar ID|URL
       o id sai do \`stylus qobuz buscar TERMOS\`"
        "$PY" - "$alvo" <<'QOBUZDL'
import configparser, os, re, sys

# ── O que o qobuz-dl escreve, e o que a pessoa lê ─────────────────────────
# O qobuz-dl fala para uma interface web, não para gente. Ele cospe
#
#     [TRACK_START] 01|Spectre|https://…/cover.jpg|Radiohead|Spectre|199|0
#     [TRACK_RESULT] 01|Spectre|downloaded|01 - Spectre.flac|-|/…|…|33932278|…
#
# e uma barra de progresso feita de \r — que num terminal se reescreve em
# cima de si mesma e fica bonita, mas quando a saída é um cano vira UMA linha
# de dez mil caracteres com o mesmo `.01.tmp` repetido. Isso importa mais do
# que parece: o painel de tarefa da tela cheia mostra as últimas trinta linhas,
# e as últimas trinta eram todas fragmento de caminho temporário. Baixar um
# disco pelo sofá parecia um erro rolando.
#
# Então traduzimos: uma linha por faixa, em português, e o progresso de volta
# ao \r quando há terminal de verdade do outro lado.
class Tradutor:
    """Filtra a tagarelice do qobuz-dl em linhas que se leem."""

    def __init__(self, saida):
        self.saida = saida
        self.resto = ""
        self.tty = saida.isatty()

    def write(self, txt):
        self.resto += txt
        # \r e \n separam igual: a barra de progresso usa \r, e sem tratar
        # os dois o pedaço todo chega aqui como um segmento só.
        while True:
            corte = min([i for i in (self.resto.find("\n"), self.resto.find("\r"))
                         if i >= 0] or [-1])
            if corte < 0:
                break
            seg, self.resto = self.resto[:corte], self.resto[corte + 1:]
            self.linha(seg)

    def linha(self, ln):
        t = ln.strip()
        if not t:
            return
        if t.startswith("[TRACK_START]"):
            c = t[len("[TRACK_START]"):].strip().split("|")
            if len(c) >= 2:
                self.emitir("  ↓ %s  %s" % (c[0], c[1]), efemero=True)
            return
        if t.startswith("[TRACK_RESULT]"):
            c = t[len("[TRACK_RESULT]"):].strip().split("|")
            if len(c) >= 3:
                marca = "✓" if c[2] == "downloaded" else "·"
                fim = "" if c[2] == "downloaded" else "  (%s)" % c[2]
                self.emitir("  %s %s  %s%s" % (marca, c[0], c[1], fim))
            return
        if " /// " in t:                       # a barra de progresso
            feito, _, onde = t.partition(" /// ")
            self.emitir("    %s  %s" % (feito.strip(), os.path.basename(onde)),
                        efemero=True)
            return
        if t.startswith("Logging"):
            self.emitir("entrando no Qobuz…", efemero=True); return
        if t.startswith("Membership:"):
            self.emitir("assinatura: %s" % t.split(":", 1)[1].strip()); return
        if t.startswith("Set max quality:"):
            # "27 - 24 bit, >96kHz" → só a parte que quer dizer alguma coisa
            resto = t.split(":", 1)[1].strip()
            _, _, humano = resto.partition(" - ")
            self.emitir("teto: %s" % (humano or resto)); return
        if t.startswith("Downloading:"):
            self.emitir("disco: %s" % t.split(":", 1)[1].strip()); return
        if t.startswith("Quality:"):
            self.emitir("qualidade: %s" % t.split(":", 1)[1].strip()); return
        if t.startswith("[+] Wrote"):
            return                              # o encarte; não é notícia
        if t == "Completed":
            return                              # quem diz "pronto" somos nós
        self.emitir(t)

    def emitir(self, txt, efemero=False):
        """efêmero = linha de progresso: some sozinha num terminal.

        Sem terminal (o painel da tela cheia, um log) ela viraria centenas de
        linhas iguais, então ali só passam os marcos.
        """
        if efemero and not self.tty:
            return
        fim = "\r" if (efemero and self.tty) else "\n"
        pad = " " * max(0, 78 - len(txt)) if efemero and self.tty else ""
        self.saida.write(txt + pad + fim)
        self.saida.flush()

    def flush(self):
        self.saida.flush()

    def isatty(self):
        return self.tty



# Instalado ANTES do import do qobuz_dl, e no STDERR — as duas coisas por
# motivo. É no stderr que ele escreve tudo (a primeira versão disto filtrava o
# stdout e não pegava uma linha sequer), e o logging dele guarda o objeto
# sys.stderr no instante do import: trocar depois não troca nada.
_ERRO_REAL = sys.stderr
_TRADUTOR = Tradutor(_ERRO_REAL)
sys.stderr = _TRADUTOR

try:
    from qobuz_dl.core import QobuzDL
except ImportError:
    print("o qobuz-dl não está instalado. Rode:  stylus qobuz instalar",
          file=sys.stderr)
    sys.exit(1)

cfg = os.path.expanduser("~/.config/qobuz-dl/config.ini")
if not os.path.isfile(cfg):
    print("o qobuz-dl não está configurado. Rode `qobuz-dl` uma vez para "
          "criar ~/.config/qobuz-dl/config.ini", file=sys.stderr)
    sys.exit(1)
c = configparser.ConfigParser()
c.read(cfg, encoding="utf-8")


def g(k):
    return c.get("DEFAULT", k, fallback="").strip()


def segredos():
    return [x.strip() for x in g("secrets").split(",") if x.strip()]


# Baixar DIRETO na estante, no formato Artista/Álbum — o mesmo desenho de
# pasta que o vinyl.py lê, então o disco aparece na estante sem passo nenhum
# de arquivamento, que era onde a fila antiga precisava da interface web no ar
# só para mover arquivo de lugar.
sys.path.insert(0, "/usr/share/stylus/deck")
try:
    import vinyl
    destino = vinyl.library_root()
except Exception:                                        # noqa: BLE001
    destino = os.path.expanduser("~/Músicas")

alvo = sys.argv[1]
# Aceita id puro ou URL colada do navegador.
m = re.search(r"/album/(?:[^/]+/)?([A-Za-z0-9]+)/?$", alvo)
item_id = m.group(1) if m else alvo

# 27 = 24 bit até 192 kHz, o melhor que a assinatura der. O padrão do
# qobuz-dl é 6, que trava tudo em 16/44,1 — num sistema cuja tese inteira é
# não reamostrar, baixar CD quando havia hi-res disponível é jogar fora
# exatamente a coisa que o resto da máquina existe para preservar. O
# quality_fallback do próprio qobuz-dl cuida de quem não tem hi-res.
try:
    qualidade = int(os.environ.get("STYLUS_QOBUZ_QUALITY", "27"))
except ValueError:
    qualidade = 27

q = QobuzDL(directory=destino, quality=qualidade, embed_art=True,
            folder_format="{artist}/{album}",
            track_format="{tracknumber} - {tracktitle}")


def entrar():
    """Autentica, e diz em português o que faltou quando não dá.

    ── O defeito que isto conserta ───────────────────────────────────────────
    A chamada era

        q.initialize_client_with_token(token, app_id, secrets)

    e a assinatura de verdade é

        initialize_client_with_token(user_id, user_auth_token, app_id, secrets)

    Quatro argumentos, e o user_id na frente. Faltando um, o Python levanta
    TypeError ANTES de tocar na rede — e o `except Exception` logo abaixo
    engolia isso e caía no login por e-mail e senha. Só que quem entra pela
    interface (qobuz-dl-gui) autentica por TOKEN: e-mail e senha ficam vazios
    no config.ini. Então o plano B tentava logar com string vazia e morria em
    "credenciais inválidas".

    O sintoma, de fora, era o mais confuso possível: a interface web baixava,
    a linha de comando não, com as mesmas credenciais e o mesmo config.ini.
    """
    uid, uat = g("user_id"), g("user_auth_token")
    app_id, secs = g("app_id"), segredos()

    # O get_tokens() raspa o app_id e os segredos do player web do Qobuz. É
    # rede, e rede falha. Só vale a pena quando o config.ini não os tem —
    # antes ele rodava sempre, dentro do mesmo try do login, e uma raspagem
    # falha derrubava um download que tinha credencial boa guardada em casa.
    if not app_id or not secs:
        try:
            q.get_tokens()
            app_id = app_id or q.app_id
            secs = secs or q.secrets
        except Exception as e:                           # noqa: BLE001
            print("não deu para descobrir o app_id do Qobuz: %s" % e,
                  file=sys.stderr)

    if uid and uat and app_id and secs:
        q.initialize_client_with_token(uid, uat, app_id, secs)
        return

    email, senha = g("email"), g("password")
    if email and senha and app_id and secs:
        q.initialize_client(email, senha, app_id, secs)
        return

    faltam = [n for n, v in (("user_id", uid), ("user_auth_token", uat),
                             ("app_id", app_id), ("secrets", secs)) if not v]
    print("o config.ini do qobuz-dl está incompleto: falta %s.\n"
          "Entre uma vez pela interface (stylus qobuz abrir) ou rode "
          "`qobuz-dl` no terminal — os dois escrevem o que falta."
          % ", ".join(faltam), file=sys.stderr)
    sys.exit(1)


try:
    entrar()
except SystemExit:
    raise
except Exception as e:                                   # noqa: BLE001
    print("não deu para entrar no Qobuz: %s" % e, file=sys.stderr)
    sys.exit(1)

print("baixando para %s …" % destino)
try:
    if alvo.startswith("http"):
        q.handle_url(alvo)
    else:
        q.download_from_id(item_id, album=True)
except Exception as e:                                   # noqa: BLE001
    print("o download falhou: %s" % e, file=_ERRO_REAL)
    sys.exit(1)
if _TRADUTOR.tty:
    _ERRO_REAL.write(" " * 78 + "\r")         # apaga a última barra
print("pronto. `stylus reindex` se a estante não mostrar na hora.")
QOBUZDL
        ;;
    entrar|login)
        precisa_ser_voce
        # --json: a tela cheia chama assim. Ela precisa da resposta crua para
        # mostrar o erro DENTRO do formulário, em vez de num terminal que
        # ninguém está olhando.
        if [[ ${2:-} == --json ]]; then
            exec "$PY" "$SHARE/qobuz_login.py"
        fi
        # A senha entra pelo `read -s`, nunca por argumento: argumento de
        # processo aparece no `ps` para qualquer usuário da máquina e fica no
        # histórico do shell. E vai para o python pelo STDIN pelo mesmo
        # motivo.
        if [[ -t 0 ]]; then
            printf 'e-mail do Qobuz: '; read -r _email
            printf 'senha (não aparece): '; read -rs _senha; echo
        else
            read -r _email; read -r _senha
        fi
        resposta=$(printf '%s\n%s\n' "$_email" "$_senha" \
                   | "$PY" "$SHARE/qobuz_login.py")
        _email=""; _senha=""
        if grep -q '"ok": true' <<<"$resposta"; then
            ok "entrou: $(sed -n 's/.*"assinatura": "\([^"]*\)".*/\1/p' <<<"$resposta")"
            printf '  %s`stylus qobuz buscar NOME` e `stylus qobuz tocar ID` já funcionam.%s\n' "$c_d" "$c_0"
        else
            die "$(sed -n 's/.*"erro": "\([^"]*\)".*/\1/p' <<<"$resposta")"
        fi
        ;;
    tocar|play|stream)
        alvo="${2:-}"
        [[ -n $alvo ]] || die "uso: stylus qobuz tocar ID|URL
       o id sai do \`stylus qobuz buscar TERMOS\`"
        precisa_ser_voce
        command -v mpv >/dev/null || die "o mpv não está instalado."
        LISTA=$("$PY" "$SHARE/qobuz_stream.py" "$alvo") || exit 1
        [[ -s $LISTA ]] || die "não saiu lista nenhuma"

        # Pôr um disco é um ato EXCLUSIVO, e o pidfile é o MESMO do deck: sem
        # isto, transmitir enquanto um disco da estante toca deixa os dois
        # saindo pela mesma placa, e o polybar mostrando um enquanto se ouve
        # o outro. O deck já resolvia isso para si; o problema era que ele
        # resolvia sozinho, e nada mais conhecia o pidfile dele.
        PIDMPV="$ESTADO/deck.mpv.pid"
        if [[ -f $PIDMPV ]]; then
            _old=$(cat "$PIDMPV" 2>/dev/null || true)
            # Confere o comm antes de matar: um PID reciclado por outro
            # programa entre uma sessão e outra não é para morrer.
            if [[ $_old =~ ^[0-9]+$ ]] && [[ -r /proc/$_old/comm ]] \
               && [[ $(cat "/proc/$_old/comm" 2>/dev/null) == mpv ]]; then
                kill "$_old" 2>/dev/null || true
            fi
        fi
        mkdir -p "$ESTADO"

        # O MESMO socket do deck. É por ele que o `stylus-side-watch` sabe em
        # que faixa e em que segundo a agulha está — e sem isso um disco vindo
        # da rede tocaria sem nunca avisar que o lado acabou, que é a única
        # coisa que este sistema faz e mais nenhum faz.
        SOCK="$ESTADO/deck.sock"
        rm -f "$SOCK"

        # As mesmas travas de áudio do stylus-deck, e pelo mesmo motivo: um
        # `replaygain=track` ou um `af=loudnorm` herdado de um ~/.config/mpv
        # desfaz a tese do sistema ANTES de o som chegar ao PipeWire, e o
        # `stylus audio` — que mede dali para a frente — continuaria dizendo
        # "sem conversão". A linha de comando ganha do arquivo do usuário.
        mpv_args=(--input-ipc-server="$SOCK"
                  --no-video --really-quiet --audio-display=no
                  --gapless-audio=yes --audio-samplerate=0
                  --replaygain=no --af= --volume=100
                  --loop-playlist=no
                  # Isto vem pela INTERNET. Sem cache, um FLAC de 24/192 num
                  # link doméstico engasga no meio da faixa — e o sintoma
                  # parece defeito de áudio, não de rede. É a mesma folga que
                  # o deck já dá para coleção montada por FUSE.
                  --cache=yes --demuxer-max-bytes=192MiB
                  --demuxer-readahead-secs=40
                  --playlist="$LISTA")
        [[ ${STYLUS_QOBUZ_MUDO:-} == 1 ]] && mpv_args+=(--ao=null)
        setsid mpv "${mpv_args[@]}" </dev/null >/dev/null 2>&1 &
        printf '%s\n' "$!" > "$PIDMPV"
        ok "tocando. \`stylus deck --no-scope\` não; isto vem da rede."
        ;;
    -h|--help|help)
        # Do primeiro `stylus qobuz` do cabeçalho até a linha que o fecha.
        # Era `sed -n '11,26p'` — um intervalo de linhas escrito à mão, que
        # passa a mentir na primeira vez que alguém acrescenta um subcomando
        # acima dele. Foi o que aconteceu quando o `tocar` entrou.
        sed -n '/^#      stylus qobuz /,/^# ═══/p' "$0" \
            | sed '$d' | sed 's/^# \?//' ;;
    *) die "não conheço \"$1\". \`stylus qobuz --help\`" ;;
esac
