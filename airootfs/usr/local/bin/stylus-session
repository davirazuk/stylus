#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-session — decide em qual dos dois modos a máquina liga
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

MODE_FILE="$HOME/.config/stylus/mode"
mkdir -p "$(dirname "$MODE_FILE")"
mode=$(cat "$MODE_FILE" 2>/dev/null || echo music)
[[ ${1:-} ]] && mode=$1

export STYLUS_MODE="$mode"

# ── UTF-8 ──────────────────────────────────────────────────────────────────
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8|*utf-8|*UTF8|*utf8) : ;;
    *)
        unset LC_ALL
        if locale -a 2>/dev/null | grep -qix 'pt_BR.utf8'; then
            export LANG=pt_BR.UTF-8
        else
            export LANG=C.UTF-8
        fi
        export LC_CTYPE="$LANG"
        ;;
esac
command -v xdg-user-dirs-update >/dev/null && xdg-user-dirs-update

if [[ ! -s $HOME/.config/stylus/library ]]; then
    /usr/share/stylus/first-run.sh || true
fi

# ── Deploy autostart do KDE se não existe ───────────────────────────────
# skel só copia para usuários NOVOS. Usuários que já existiam não recebem.
# Fazer aqui garante que o autostart existe SEMPRE que o KDE for iniciado.
KDE_AUTOSTART="$HOME/.config/autostart/stylus-kde.desktop"
if [[ "$mode" == "desktop" || "$mode" == "kde" ]]; then
    if [[ ! -f "$KDE_AUTOSTART" ]] && command -v startplasma-x11 &>/dev/null; then
        mkdir -p "$HOME/.config/autostart"
        cat > "$KDE_AUTOSTART" <<'EOF'
[Desktop Entry]
Type=Application
Name=Stylus KDE
Exec=/usr/local/bin/stylus-kde-shortcuts
Hidden=false
NoDisplay=true
X-KDE-autostart-after-desktop=true
OnlyShowIn=KDE;
EOF
    fi
fi

case "$mode" in
    desktop)
        if command -v startplasma-x11 >/dev/null 2>&1; then
            # Plasma precisa de D-Bus session bus. startplasma-x11 normalmente
            # é chamado pelo SDDM que já configurou tudo, mas quando passa
            # pelo stylus-session o D-Bus pode não estar pronto.
            if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
                eval "$(dbus-launch --sh-syntax)" 2>/dev/null
                export DBUS_SESSION_BUS_ADDRESS
            fi
            exec startplasma-x11
        fi
        exec i3
        ;;
    kde)
        if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
            eval "$(dbus-launch --sh-syntax)" 2>/dev/null
            export DBUS_SESSION_BUS_ADDRESS
        fi
        exec startplasma-x11
        ;;
    *)
        exec i3 -c /usr/share/stylus/i3-music.config
        ;;
esac
