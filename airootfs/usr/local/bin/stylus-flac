#!/usr/bin/env python3
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-flac — procura um disco por NOME e traz o melhor que houver
# ═══════════════════════════════════════════════════════════════════════════
#      stylus-flac "radiohead in rainbows"        acha e baixa (Qobuz, FLAC)
#      stylus-flac --listar "slowdive"            só mostra o que achou
#      stylus-flac -n 2 "in rainbows"             baixa o SEGUNDO resultado
#      stylus-flac --faixa "creep radiohead"      uma faixa, não o disco
#      stylus-flac --formato hires "loveless"     24/96 em vez de 16/44,1
#
#      stylus-flac --fontes                       o que cada fonte dá
#      stylus-flac -f arquivo "radiohead 1993"    o acervo de shows ao vivo
#      stylus-flac -f soundcloud "burial mix"     o que mora só lá
#      stylus-flac -f youtube "..."               o catálogo mais largo (com perda)
#      stylus-flac --todas "creep"                procura em todas de uma vez
#
#  ── O que este programa é ────────────────────────────────────────────────
#  A ideia veio do SpotiFLAC, e o nome DELE engana: o assunto ali não é o
#  Spotify, é LOSSLESS. Isto é essa metade — procurar por nome e trazer o
#  disco — em várias fontes, como ele faz.
#
#  ── A regra da casa, e onde o SpotiFLAC erra ─────────────────────────────
#  Uma ferramenta que se chama FLAC e devolve um Opus de 160 kbps
#  reempacotado em .flac está mentindo: o arquivo tem a extensão certa e a
#  música dentro dele já perdeu o que perdeu. Reempacotar não devolve nada.
#
#  Por isso TODA listagem aqui traz a coluna QUALIDADE, e ela diz a verdade:
#  "FLAC 16/44" é lossless, "Opus ~160" não é, e as duas aparecem lado a lado
#  para a escolha ser sua. Nenhuma fonte com perda é o padrão, e nenhuma delas
#  é convertida para .flac ao ser guardada.
#
#  ── De onde vem cada coisa ───────────────────────────────────────────────
#  QOBUZ é a assinatura PAGA do dono desta máquina: as credenciais saem de
#  ~/.config/qobuz-dl/config.ini, a mesma conta que o tocador do Vita usa.
#  Nada vem de conta alheia, e nada aqui contorna pagamento de ninguém.
#
#  ARQUIVO é o Live Music Archive do archive.org: shows gravados e liberados
#  PELAS PRÓPRIAS BANDAS, quase tudo em FLAC, sem conta e sem pedir licença
#  a ninguém. É a fonte que mais combina com este acervo, que é feito de
#  gravações ao vivo.
#
#  SOUNDCLOUD e YOUTUBE saem pelo yt-dlp, e só alcançam o que está público.
#  As duas são COM PERDA e a listagem diz isso em toda linha.
#
#  ── Por que não tem Amazon Music (o SpotiFLAC tem) ───────────────────────
#  O áudio da Amazon Music é entregue com DRM. Tirar música de lá quer dizer
#  quebrar essa proteção, e isso eu não escrevo — nem para quem assina o
#  serviço. Não é uma limitação técnica que falte resolver; é onde a linha
#  está. Para lossless pago, o Qobuz daqui já faz o serviço, legalmente.
# ═══════════════════════════════════════════════════════════════════════════

import argparse
import configparser
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request

CONFIG = os.path.expanduser("~/.config/qobuz-dl/config.ini")
UA = "Mozilla/5.0 (X11; Linux x86_64)"


def audio_ext():
    """O que conta como música — a MESMA resposta do resto do sistema.

    Este arquivo mora em /usr/local/bin e as ferramentas de coleção em
    /usr/share/stylus/tools, então o import precisa da ponte. A reserva
    existe para quem rodar isto direto do repositório, sem instalar.
    """
    for d in ("/usr/share/stylus/tools",
              os.path.join(os.path.dirname(os.path.abspath(__file__)),
                           "..", "..", "share", "stylus", "tools")):
        if os.path.isdir(d) and d not in sys.path:
            sys.path.insert(0, d)
    try:
        import _raiz
        return set(_raiz.audio_ext())
    except Exception:
        return {".flac", ".mp3", ".ogg", ".opus", ".m4a", ".wav", ".shn"}

# 5 = MP3 320, 6 = FLAC 16/44,1, 7 = 24/96, 27 = 24/192. O padrão é o
# lossless que cabe em qualquer lugar — inclusive num cartão de Vita.
QUALIDADES = {"mp3": 5, "flac": 6, "hires": 7, "max": 27}


def morre(msg):
    print("stylus-flac: %s" % msg, file=sys.stderr)
    sys.exit(1)


def aviso(msg):
    print("  ! %s" % msg, file=sys.stderr)


def pega_json(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


# ── um achado, venha de onde vier ────────────────────────────────────────
class Achado:
    """O mesmo formato para as quatro fontes.

    `qualidade` não é enfeite nem é para o log: é a COLUNA que separa o que
    é lossless do que só tem a extensão certa. Ela aparece em toda listagem.
    """

    def __init__(self, fonte, titulo, artista, qualidade, lossless,
                 ref, ano="", extra=""):
        self.fonte = fonte
        self.titulo = titulo or "?"
        self.artista = artista or ""
        self.qualidade = qualidade
        self.lossless = lossless
        self.ref = ref              # o que a fonte precisa para baixar
        self.ano = str(ano or "")
        self.extra = extra

    def linha(self, i, marca):
        selo = "\033[32m♦\033[0m" if self.lossless else " "
        # O ANO quando a fonte o tem; a DURAÇÃO quando não. As duas respondem
        # "é esta mesmo?" e nenhuma fonte dá as duas: catálogo tem ano, vídeo
        # tem duração. Uma coluna vazia em metade das linhas seria pior que
        # qualquer das duas. (E este campo já existia escrito e nunca lido —
        # a conferência de estado morto do check.sh o pegou.)
        quando = self.ano or self.extra
        return "%s %2d. %s %-9s %-38.38s %-22.22s %-5s %s" % (
            marca, i, selo, self.fonte, self.titulo, self.artista,
            quando, self.qualidade)


# ── FONTE: Qobuz ─────────────────────────────────────────────────────────
class Qobuz:
    nome = "qobuz"
    diz = "assinatura paga do dono da máquina — FLAC 16/44 a 24/192"
    lossless = True

    def __init__(self, destino, formato):
        self.destino = destino
        self.formato = formato
        self._q = None

    def _abre(self):
        if self._q:
            return self._q
        try:
            from qobuz_dl.core import QobuzDL
        except ImportError:
            morre("falta o qobuz-dl (pip install --user qobuz-dl)")

        # CALAR O "Logging... / Membership: Studio / Set max quality".
        #
        # Numa lista numerada, três linhas soltas em cima do primeiro
        # resultado leem como erro. Duas tentativas antes desta não pegaram
        # nada, e o motivo vale anotar: aquilo não sai por `print`, sai pelo
        # módulo `logging` — então nem `redirect_stdout` nem `redirect_stderr`
        # o alcançam. Os dois só trocam `sys.stdout`/`sys.stderr`, e o
        # StreamHandler que o qobuz-dl instala guardou o fluxo ORIGINAL na
        # hora do import. Quem cala logging é o nível do logger.
        #
        # `INFO` some, `WARNING` para cima passa: o que der errado continua
        # aparecendo, que é a parte que não se pode perder.
        import logging
        logging.getLogger("qobuz_dl").setLevel(logging.WARNING)
        cfg = configparser.ConfigParser()
        if not cfg.read(CONFIG):
            morre("não achei %s — rode o qobuz-dl uma vez para configurar" % CONFIG)
        d = cfg["DEFAULT"]
        for chave in ("app_id", "secrets", "user_auth_token", "user_id"):
            if not d.get(chave):
                morre("falta '%s' no %s" % (chave, CONFIG))
        q = QobuzDL(directory=self.destino,
                    quality=QUALIDADES[self.formato], embed_art=True)
        q.initialize_client_with_token(
            d["user_id"], d["user_auth_token"], d["app_id"],
            [s for s in d["secrets"].split(",") if s])
        self._q = q
        return q

    def procura(self, termo, faixa, quantos):
        q = self._abre()
        res = q.search_by_type(termo, "track" if faixa else "album", limit=quantos)
        out = []
        for r in res or []:
            out.append(Achado(
                self.nome, r.get("display_title", "?"),
                r.get("display_subtitle", ""),
                r.get("quality", "") or "FLAC", True,
                r["url"], r.get("release_year", "")))
        return out

    def baixa(self, a):
        self._abre().handle_url(a.ref)


# ── FONTE: Internet Archive (Live Music Archive) ─────────────────────────
class Arquivo:
    """archive.org — shows liberados pelas próprias bandas, quase tudo FLAC.

    É a fonte que mais combina com ESTE acervo, que é feito de gravações ao
    vivo com nome de data. Não pede conta, não pede licença e não contorna
    nada: o que está lá está lá porque o artista deixou.
    """

    nome = "arquivo"
    diz = "archive.org, shows liberados pelas bandas — quase tudo FLAC, sem conta"
    lossless = True

    def __init__(self, destino, formato):
        self.destino = destino

    # Coleções que casam com nome de banda e não são música. Um episódio de
    # podcast chamado "Phishing Thru The Archives" aparece em toda busca por
    # Phish, e uma lista cujo primeiro item não é música ensina a desconfiar
    # da lista inteira.
    NAO_E_MUSICA = ("podcast", "radioprogram", "audio_bookspoetry",
                    "audio_news", "audio_religion", "oldtimeradio")

    def procura(self, termo, faixa, quantos):
        # `format:(Flac)` E NÃO `collection:(etree)`.
        #
        # O etree é o Live Music Archive de verdade, mas ele só aceita banda
        # que autoriza troca de gravação — Grateful Dead, Phish, uns mil
        # outros — e as que ESTE acervo tem não estão lá: procurar
        # "radiohead 1993" no etree devolvia ZERO, o que lê como "o
        # archive.org não tem", quando ele tem o mesmo show que está no
        # cartão (`Radiohead Live - 1993-02-XX, Signal Radio Session`).
        #
        # Filtrar por FORMATO acha aquilo e ainda serve melhor ao propósito
        # deste programa: só entram itens que têm áudio lossless de verdade.
        q = 'mediatype:(audio) AND format:(Flac) AND (%s)' % termo
        url = ("https://archive.org/advancedsearch.php?q=%s"
               "&fl[]=identifier&fl[]=title&fl[]=creator&fl[]=year"
               "&fl[]=collection&rows=%d&page=1&output=json"
               % (urllib.parse.quote(q), quantos * 3))
        try:
            d = pega_json(url)
        except Exception as e:
            aviso("archive.org não respondeu: %s" % e)
            return []
        out = []
        for doc in d.get("response", {}).get("docs", []):
            cols = doc.get("collection") or []
            if isinstance(cols, str):
                cols = [cols]
            if any(any(r in c.lower() for r in self.NAO_E_MUSICA) for c in cols):
                continue
            cri = doc.get("creator", "")
            if isinstance(cri, list):
                cri = ", ".join(cri)
            out.append(Achado(
                self.nome, doc.get("title", doc["identifier"]), cri,
                "FLAC (do show)", True, doc["identifier"], doc.get("year", "")))
            if len(out) >= quantos:
                break
        return out

    def baixa(self, a):
        ident = a.ref
        try:
            meta = pega_json("https://archive.org/metadata/%s" % ident, timeout=45)
        except Exception as e:
            morre("não deu para ler o show %s: %s" % (ident, e))

        # O QUE BAIXAR. Um item do archive traz o MESMO áudio em três
        # formatos (flac, vbr mp3, ogg) mais os arquivos de conferência.
        # Pegar tudo baixaria o show três vezes; pegar "o primeiro da lista"
        # pegaria o mp3 metade das vezes.
        #
        # Então: uma PREFERÊNCIA ordenada, e depois dela a lista comum do
        # sistema como rede. A ordem tem de ser escrita à mão — é a resposta
        # para "qual destes eu quero", que uma lista de pertencimento não
        # responde —, mas o que ela não cobrir cai no `_raiz.audio_ext()`, o
        # mesmo lugar de todo o resto. Assim um formato novo (ALAC, Opus)
        # deixa de ser IGNORADO EM SILÊNCIO só por não estar aqui, que é o
        # estrago que as seis listas divergentes deste repositório fizeram.
        nomes = [f.get("name", "") for f in meta.get("files", [])]
        ordem = [".flac", ".shn"]          # lossless primeiro, sempre
        for e in sorted(audio_ext()):
            if e not in ordem:
                ordem.append(e)
        for ext in ordem:
            fs = [f for f in meta.get("files", [])
                  if f.get("name", "").lower().endswith(ext)]
            if fs:
                break
        else:
            morre("esse item não tem áudio que eu saiba baixar (%d arquivos)"
                  % len(nomes))

        pasta = os.path.join(self.destino, re.sub(r'[/\0]', "_", ident))
        os.makedirs(pasta, exist_ok=True)
        print("%d arquivo(s) %s em %s" % (len(fs), ext, pasta))
        for i, f in enumerate(sorted(fs, key=lambda x: x["name"]), 1):
            alvo = os.path.join(pasta, os.path.basename(f["name"]))
            if os.path.exists(alvo):
                print("  %2d/%d  já está: %s" % (i, len(fs), os.path.basename(alvo)))
                continue
            url = "https://archive.org/download/%s/%s" % (
                ident, urllib.parse.quote(f["name"]))
            print("  %2d/%d  %s" % (i, len(fs), os.path.basename(alvo)))
            # NOME PROVISÓRIO: um Ctrl-C no meio deixaria um arquivo truncado
            # com o nome bom, e a próxima execução o trataria como "já está".
            # O rename é atômico; o .parcial ninguém confunde com música.
            meio = alvo + ".parcial"
            try:
                req = urllib.request.Request(url, headers={"User-Agent": UA})
                with urllib.request.urlopen(req, timeout=120) as r, \
                        open(meio, "wb") as g:
                    while True:
                        b = r.read(262144)
                        if not b:
                            break
                        g.write(b)
                os.replace(meio, alvo)
            except Exception as e:
                if os.path.exists(meio):
                    os.remove(meio)
                aviso("falhou em %s: %s" % (os.path.basename(alvo), e))


# ── FONTES pelo yt-dlp: SoundCloud e YouTube ─────────────────────────────
class ViaYtdlp:
    """As duas fontes COM PERDA, e a listagem diz isso em toda linha.

    Passam pelo yt-dlp de propósito: os dois sites mudam o modo de assinar
    endereço várias vezes por ano, e manter isso à mão aqui seria manter uma
    segunda cópia de um problema que já tem dono.
    """

    lossless = False

    def __init__(self, destino, formato):
        self.destino = destino
        if not self.tem_ytdlp():
            self._falta = True
        else:
            self._falta = False

    @staticmethod
    def tem_ytdlp():
        return subprocess.run(["sh", "-c", "command -v yt-dlp"],
                              capture_output=True).returncode == 0

    def procura(self, termo, faixa, quantos):
        if self._falta:
            aviso("falta o yt-dlp: a fonte %s fica de fora" % self.nome)
            return []
        alvo = "%s%d:%s" % (self.prefixo, quantos, termo)
        p = subprocess.run(
            ["yt-dlp", "--flat-playlist", "-J", "--no-warnings", alvo],
            capture_output=True, text=True)
        if p.returncode != 0:
            aviso("%s não respondeu" % self.nome)
            return []
        try:
            d = json.loads(p.stdout)
        except Exception:
            return []
        out = []
        for e in d.get("entries", []) or []:
            if not e:
                continue
            dur = e.get("duration")
            mm = "%d:%02d" % (int(dur) // 60, int(dur) % 60) if dur else ""
            out.append(Achado(
                self.nome, e.get("title", "?"),
                e.get("uploader") or e.get("channel") or "",
                self.qual, False,
                e.get("url") or e.get("webpage_url") or e.get("id"),
                "", mm))
        return out

    def baixa(self, a):
        if self._falta:
            morre("falta o yt-dlp")
        # SEM --audio-format flac. Reempacotar um Opus em .flac não devolve
        # nada do que se perdeu — só põe a extensão de lossless num arquivo
        # que não é, e é exatamente essa a mentira que este programa não
        # conta. Guarda-se o melhor áudio COMO ELE VEM.
        cmd = ["yt-dlp", "-f", "bestaudio", "-x", "--no-warnings",
               "--embed-metadata", "--embed-thumbnail",
               "-o", os.path.join(self.destino, "%(uploader)s - %(title)s.%(ext)s"),
               a.ref]
        r = subprocess.run(cmd)
        if r.returncode != 0:
            morre("o yt-dlp saiu com %d" % r.returncode)


class SoundCloud(ViaYtdlp):
    nome = "soundcloud"
    diz = "o que só existe lá: remix, set, inédito — COM PERDA (MP3/Opus)"
    prefixo = "scsearch"
    qual = "MP3/Opus (com perda)"


class YouTube(ViaYtdlp):
    nome = "youtube"
    diz = "o catálogo mais largo que existe — COM PERDA (Opus ~160 kbps)"
    prefixo = "ytsearch"
    qual = "Opus ~160 (com perda)"


FONTES = {c.nome: c for c in (Qobuz, Arquivo, SoundCloud, YouTube)}
APELIDOS = {"yt": "youtube", "ytmusic": "youtube", "sc": "soundcloud",
            "archive": "arquivo", "ia": "arquivo", "q": "qobuz"}


def termo_de_link_spotify(url):
    """Só metadado: devolve 'artista título' para virar busca. Ou None.

    Nenhum áudio vem do Spotify — e o dono desta máquina não gosta dele. O
    link é aceito só porque às vezes um disco chega assim, de alguém.
    """
    m = re.search(r"open\.spotify\.com/(?:intl-\w+/)?(track|album)/(\w+)", url)
    if not m:
        return None
    req = urllib.request.Request(
        "https://open.spotify.com/embed/%s/%s" % (m.group(1), m.group(2)),
        headers={"User-Agent": UA})
    try:
        html = urllib.request.urlopen(req, timeout=25).read().decode("utf-8", "replace")
    except Exception:
        return None
    j = re.search(r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>', html, re.S)
    if not j:
        return None

    def cava(o, alvo, prof=0):
        if prof > 8:
            return None
        if isinstance(o, dict):
            if alvo in o:
                return o[alvo]
            for v in o.values():
                r = cava(v, alvo, prof + 1)
                if r is not None:
                    return r
        elif isinstance(o, list):
            for v in o:
                r = cava(v, alvo, prof + 1)
                if r is not None:
                    return r
        return None

    e = cava(json.loads(j.group(1)), "entity") or {}
    art = ", ".join(a.get("name", "") for a in (e.get("artists") or []))
    nome = e.get("name") or ""
    return ("%s %s" % (art, nome)).strip() or None


def mostra_fontes():
    print("\nfontes (\033[32m♦\033[0m = lossless de verdade):\n")
    for nome, cls in FONTES.items():
        selo = "\033[32m♦\033[0m" if cls.lossless else " "
        print("  %s %-11s %s" % (selo, nome, cls.diz))
    print("""
  \033[33m—\033[0m amazon      NÃO ESTÁ AQUI, de propósito: o áudio da Amazon Music
                sai com DRM, e tirá-lo de lá quer dizer quebrar isso. Não é
                falta de conseguir; é onde a linha está. Para lossless pago,
                a fonte `qobuz` acima já faz o serviço.

  o padrão é `qobuz`. `--todas` procura em todas de uma vez e mostra junto,
  que é como se descobre que aquele show só existe no arquivo.
""")


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("busca", nargs="*", help="nome do disco, do artista, ou um link")
    ap.add_argument("-f", "--fonte", default="qobuz",
                    help="qobuz | arquivo | soundcloud | youtube")
    ap.add_argument("--todas", action="store_true",
                    help="procura em TODAS as fontes e mostra junto")
    ap.add_argument("--fontes", action="store_true", help="lista as fontes e sai")
    ap.add_argument("--formato", default="flac", choices=sorted(QUALIDADES))
    ap.add_argument("--destino", default=os.path.expanduser("~/Músicas"))
    ap.add_argument("--faixa", action="store_true", help="procura FAIXA, não disco")
    ap.add_argument("--listar", action="store_true", help="mostra e não baixa")
    ap.add_argument("-n", type=int, default=1, metavar="N",
                    help="baixa o N-ésimo resultado (padrão: o primeiro)")
    ap.add_argument("--quantos", type=int, default=8, metavar="N",
                    help="quantos resultados por fonte")
    a = ap.parse_args()

    if a.fontes:
        mostra_fontes()
        return 0
    if not a.busca:
        ap.error("diga o que procurar (ou --fontes para ver de onde)")

    termo = " ".join(a.busca).strip()
    if "open.spotify.com" in termo:
        virado = termo_de_link_spotify(termo)
        if not virado:
            morre("não consegui ler o nome desse link")
        print("link -> busca: %s" % virado)
        termo = virado

    escolhidas = list(FONTES) if a.todas else \
        [APELIDOS.get(a.fonte, a.fonte)]
    for nome in escolhidas:
        if nome not in FONTES:
            morre("fonte desconhecida: %s (--fontes lista as que existem)" % nome)

    os.makedirs(a.destino, exist_ok=True)
    res = []
    for nome in escolhidas:
        fonte = FONTES[nome](a.destino, a.formato)
        try:
            achados = fonte.procura(termo, a.faixa, a.quantos)
        except Exception as e:
            aviso("%s: %s" % (nome, e))
            continue
        for x in achados:
            x._fonte_obj = fonte
        res.extend(achados)

    if not res:
        morre("nada em %s para %r" % (" nem ".join(escolhidas), termo))

    # A ORDEM DA LISTA MISTURADA, e ela decide o que o `-n 1` pega — que é o
    # caminho que se usa sem ler.
    #
    # Lossless primeiro, óbvio. Mas entre as duas lossless a ordem também
    # importa e não é alfabética: por nome, "arquivo" vem antes de "qobuz", e
    # aí procurar "slowdive souvlaki" baixava um BOOTLEG DE 1993 no lugar do
    # disco de estúdio. A ordem é a das fontes declaradas — do catálogo
    # oficial para o mais solto.
    if a.todas:
        prio = {n: i for i, n in enumerate(FONTES)}
        res.sort(key=lambda x: (not x.lossless, prio.get(x.fonte, 99)))

    print()
    for i, r in enumerate(res, 1):
        marca = "->" if (i == a.n and not a.listar) else "  "
        print(r.linha(i, marca))
    print()

    if a.listar:
        print("nada baixado (--listar). -n escolhe qual.")
        return 0
    if a.n < 1 or a.n > len(res):
        morre("-n %d está fora dos %d resultados" % (a.n, len(res)))

    e = res[a.n - 1]
    if not e.lossless:
        # DIZ ANTES, não depois. Quem chamou um programa chamado "flac" e vai
        # receber um Opus tem de saber disso enquanto ainda dá para escolher
        # outro número — não ao ver a extensão do arquivo baixado.
        print("\033[33matenção:\033[0m este é \033[33mCOM PERDA\033[0m (%s), da fonte %s."
              % (e.qualidade, e.fonte))
        print("         não vai virar .flac: reempacotar não devolve o que se perdeu.\n")
    print("baixando: %s — %s  [%s]" % (e.artista, e.titulo, e.fonte))
    try:
        e._fonte_obj.baixa(e)
    except SystemExit:
        raise
    except Exception as exc:
        morre("o download falhou: %s" % exc)
    print("pronto, em %s" % a.destino)
    return 0


if __name__ == "__main__":
    sys.exit(main())
