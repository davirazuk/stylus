#!/usr/bin/env python3
"""stylus-side-watch — avisa quando o lado acaba.

POR QUE ISTO EXISTE
-------------------
É a tese do sistema, e era a única parte dela que não estava implementada.

O README diz: "Você escolhe um objeto, ele manda por quarenta minutos, e no
meio você tem que levantar e virar." A máquina sabia disso — a barra mostra
"vira em 12 min" e a tela cheia também — mas ninguém nunca era AVISADO no
momento. O disco virava sozinho, em silêncio, e a coisa que separa ouvir um
disco de ouvir uma playlist simplesmente não acontecia.

Um contador que só conta não é a mesma coisa que um acontecimento. Isto aqui
é o acontecimento.

    stylus-side-watch              fica olhando e avisa (é o que a sessão roda)
    stylus-side-watch --once       diz em que lado está agora e sai
    stylus-side-watch --pause      além de avisar, PAUSA no fim do lado

Sobre o --pause: num toca-discos de verdade o lado acaba e o som para —
é isso que faz você levantar. Aqui é opcional e desligado por padrão, porque
impor uma pausa a quem só quer ouvir seria trocar uma tese por uma
implicância. Quem quer a coisa inteira liga com
`stylus-side-watch --pause`, ou põe STYLUS_SIDE_PAUSE=1 no ambiente.
"""
import argparse
import json
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/share/stylus/deck")
try:
    import vinyl
except Exception as e:                                    # noqa: BLE001
    sys.exit(f"stylus-side-watch: preciso do vinyl.py do deck: {e}")

INTERVALO = 2.0
# Onde a agulha parou. Uma linha só, reescrita de tempos em tempos: o
# stylus-deck lê daqui para pôr o disco de volta onde estava em vez de no
# começo — que é o que acontece com um toca-discos de verdade quando você
# levanta a agulha e volta depois.
#
# Quem grava é ESTE serviço e não o deck: ele já está perguntando a posição a
# cada dois segundos para saber o lado, e um segundo processo perguntando a
# mesma coisa seria conversa de socket em dobro pelo resto da sessão.
AGULHA = os.path.expanduser("~/.local/share/stylus/agulha.tsv")
GRAVA_CADA = 10.0
# Uma etiqueta de pilha do dunst: o aviso novo SUBSTITUI o anterior em vez de
# empilhar. Um disco de seis lados não pode deixar seis avisos na tela.
TAG = "stylus-side"

# ── a assinatura do Qobuz vence antes da playlist acabar ──────────────────
# Os endereços que o Qobuz assina valem cerca de UMA HORA. Uma playlist de
# 200 faixas são treze. O que acontecia depois da primeira hora não era um
# erro na tela: o mpv pedia o endereço seguinte, levava 403, pulava para o
# próximo, levava 403 de novo, e varria o resto da lista em poucos segundos.
# Da poltrona isso é "a música parou sozinha", e não havia nada — nem tela,
# nem journal — ligando aquilo a uma assinatura vencida.
#
# Quem renova é ESTE serviço porque ele já está perguntando ao mpv, de dois
# em dois segundos, em que faixa a agulha está: renovar é justamente saber o
# que ainda não tocou. Um processo novo só para isso seria conversa de socket
# em dobro pelo resto da sessão — o mesmo motivo pelo qual a agulha.tsv é
# gravada aqui.
RENOVA_APOS = 45 * 60      # com ~15 min de folga antes da hora
QOBUZ_STREAM = "/usr/share/stylus/qobuz_stream.py"


UI = "/usr/share/stylus/ui/app.py"


def tela_cheia_no_ar():
    """A interface de tela cheia está rodando?

    Ela mostra o mesmo aviso ocupando a tela inteira — é a tese do sistema no
    tamanho certo. Mandar TAMBÉM um balãozinho de canto seria dizer a mesma
    coisa duas vezes, e a segunda por cima da primeira.

    Lido do /proc e não com `pkill -f`, que casa com o próprio shell de quem
    procura. Aqui só se lê, mas o hábito é o mesmo.
    """
    try:
        pids = [n for n in os.listdir("/proc") if n.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                if UI.encode() in fh.read():
                    return True
        except OSError:                   # o processo morreu no meio; segue
            continue
    return False


def avisar(titulo, corpo, urgencia="normal"):
    # A pausa continua valendo com a tela cheia no ar: quem ligou o --pause
    # quer o som parando, e isso a interface não faz.
    if tela_cheia_no_ar():
        return
    try:
        subprocess.run(
            ["notify-send", "--app-name=STYLUS", f"--urgency={urgencia}",
             f"--hint=string:x-dunst-stack-tag:{TAG}",
             "--icon=stylus", titulo, corpo],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def pausar():
    """Pausa quem estiver tocando, sem saber quem é."""
    for cmd in (["playerctl", "pause"],
                ["mpv-ipc-pause"]):          # reservado; o playerctl cobre mpv
        try:
            if subprocess.run(cmd, check=False,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0:
                return True
        except OSError:
            continue
    return False


def gravar_agulha(album, indice, pos):
    """Anota onde a agulha está. Escreve por arquivo temporário e renomeia:
    uma queda de energia no meio de um write deixaria a linha pela metade, e
    uma linha pela metade faz o deck seguinte recomeçar do zero em silêncio."""
    try:
        os.makedirs(os.path.dirname(AGULHA), exist_ok=True)
        tmp = AGULHA + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(f"{int(time.time())}\t{album.folder}\t{indice}\t{pos:.1f}\n")
        os.replace(tmp, AGULHA)
    except OSError:
        pass


def virar(olho, direcao=+1):
    """Põe a agulha no começo do outro lado.

    Dá para pular FAIXA desde sempre — os ombros do controle fazem isso — e
    não dava para pular LADO, que é a única coisa que este sistema pede que
    você faça com as mãos. Virar um disco não é avançar sete faixas: é pôr a
    agulha no primeiro sulco do outro lado, e é isso que acontece aqui.

    Cai na PRIMEIRA FAIXA do lado, não no instante em que o lado começa: os
    dois quase sempre são o mesmo ponto (um lado começa numa faixa), e quando
    não são, cair no meio de uma faixa não é o que ninguém quer dizer com
    "virar o disco".
    """
    al, i, _lado, _restam = olho.onde()
    if al is None or not al.sides:
        return "nada tocando", None, None
    alvo = i + direcao
    if alvo < 0:
        return "já está no primeiro lado", al, i
    if alvo >= len(al.sides):
        return "este era o último lado", al, i
    faixas = al.sides[alvo].get("tracks") or []
    if not faixas:
        return "não sei onde esse lado começa", al, i
    ipc = vinyl._MpvIPC()
    if not ipc.connect():
        # Sem o socket não há como pôr a agulha em lugar nenhum: o MPRIS diz
        # o que está tocando, não manda tocar de um ponto.
        return ("só dá para virar o disco quando ele foi posto pelo deck "
                "(`stylus deck`)"), al, i
    try:
        ipc.command("set_property", "playlist-pos", int(faixas[0]))
        ipc.command("set_property", "pause", False)
    finally:
        ipc.close()
    return None, al, i


class Olho:
    """Onde o disco está, e o que mudou desde a última olhada."""

    def __init__(self):
        self.sessao = vinyl.Session()
        self.album = None
        self.pasta = None
        self.lado = None
        self._ti = [None, 0]
        self._gravei = 0.0

    def onde(self):
        """(álbum, índice do lado, lado, quanto falta) — ou Nones."""
        snap = self.sessao.snapshot()
        caminho = snap.get("path") or ""
        pasta = os.path.dirname(caminho) if caminho else ""
        chave = pasta or f"{snap.get('artist')}/{snap.get('album')}"
        if chave and chave != self.pasta:
            self.pasta = chave
            self.lado = None                  # disco novo: recomeça a contar
            try:
                f = vinyl.resolve_album(snap.get("path"), snap.get("artist", ""),
                                        snap.get("album", ""))
                self.album = vinyl.Album(f, envelope=False) if f else None
            except Exception:                 # noqa: BLE001
                self.album = None
        al = self.album
        if al is None or not al.total or not al.sides:
            return None, None, None, 0.0
        idx = vinyl.track_index_for(al, snap, self._ti)
        pos, _d = self.sessao.position()
        # Pausado não conta: parar para atender o telefone não é levantar a
        # agulha, e regravar a mesma linha a cada dois segundos com o disco
        # parado é escrita à toa.
        agora = time.time()
        if not snap.get("paused") and agora - self._gravei >= GRAVA_CADA:
            gravar_agulha(al, idx, pos)
            self._gravei = agora
        t_abs = al.album_time(idx, pos)
        i, lado = al.side_for(t_abs)
        restam = max(0.0, lado["end"] - t_abs) if lado else 0.0
        return al, i, lado, restam


def _manifesto(pasta):
    try:
        with open(os.path.join(pasta, "disco.json"), encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:                         # noqa: BLE001
        return None


def precisa_renovar(al):
    """Este disco veio do Qobuz e a assinatura dele está velha?

    Barato de propósito: roda a cada duas segundos, e a resposta quase sempre
    é não. Um disco da estante nem chega a abrir arquivo — não tem disco.json.
    """
    if al is None or not getattr(al, "folder", ""):
        return False
    m = _manifesto(al.folder)
    if not m or not str(m.get("fonte", "")).startswith("qobuz"):
        return False
    quando = m.get("assinado_em")
    if not isinstance(quando, (int, float)):
        return False
    return (time.time() - quando) > RENOVA_APOS


def renovar_assinatura(pasta):
    """Reassina o que ainda não tocou e pendura no fim da fila do mpv.

    A faixa que está tocando NÃO é tocada: o fluxo dela já está aberto e
    continua até o fim. Só o que vem depois é trocado — e por isso não há
    corte no som, que é a diferença entre isto e reabrir a lista inteira.

    A cauda vai por `loadlist` e não por `loadfile` faixa a faixa: o m3u leva
    os `#EXTINF` junto, e sem eles o mpv anuncia o ENDEREÇO como título — uma
    linha de duzentos caracteres com uma assinatura dentro, que é o que
    apareceria no polybar e na notificação de troca de faixa.
    """
    ipc = vinyl._MpvIPC()
    if not ipc.connect():
        return False
    try:
        pos = ipc.get("playlist-pos")
        total = ipc.get("playlist-count")
        if not isinstance(pos, int) or not isinstance(total, int):
            return False
        if pos < 0 or pos + 1 >= total:
            return False                      # nada à frente para renovar
        r = subprocess.run(
            [sys.executable, QOBUZ_STREAM, "--renovar", pasta,
             "--desde", str(pos + 1)],
            capture_output=True, text=True, timeout=300)
        cauda = (r.stdout or "").strip().splitlines()
        cauda = cauda[-1] if cauda else ""
        if r.returncode != 0 or not cauda or not os.path.isfile(cauda):
            print("stylus-side-watch: não deu para renovar a assinatura: %s"
                  % (r.stderr or "").strip()[:200], file=sys.stderr)
            return False
        # De trás para a frente: removendo do fim, os índices do que ainda
        # não foi removido não mudam. Do começo para o fim, cada remoção
        # empurra o resto e a metade da cauda sobreviveria.
        for j in range(total - 1, pos, -1):
            ipc.command("playlist-remove", j)
        ipc.command("loadlist", cauda, "append")
        return True
    except Exception:                         # noqa: BLE001 — nunca derrubar
        return False
    finally:
        ipc.close()


class Renovador:
    """Uma renovação por vez, numa thread, e nunca no laço do aviso.

    Assinar 150 faixas leva dezenas de segundos. Feito no laço, o serviço
    pararia de olhar o lado durante todo esse tempo — e o aviso de virar o
    disco é a razão de ele existir.
    """

    def __init__(self):
        self.rodando = False
        self.ultima = 0.0

    def talvez(self, al):
        if self.rodando or time.time() - self.ultima < 120:
            return
        try:
            if not precisa_renovar(al):
                return
        except Exception:                     # noqa: BLE001
            return
        pasta = al.folder
        self.rodando = True
        self.ultima = time.time()

        def _corre():
            try:
                if renovar_assinatura(pasta):
                    print("stylus-side-watch: assinatura do Qobuz renovada",
                          file=sys.stderr)
            finally:
                self.rodando = False

        threading.Thread(target=_corre, daemon=True).start()


def rotulo(lado):
    return (lado or {}).get("label", "LADO").replace("SIDE", "LADO")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--virar", action="store_true",
                    help="põe a agulha no começo do próximo lado")
    ap.add_argument("--voltar", action="store_true",
                    help="e este põe no começo do lado anterior")
    ap.add_argument("--pause", action="store_true",
                    default=os.environ.get("STYLUS_SIDE_PAUSE") == "1")
    args = ap.parse_args()

    olho = Olho()

    if args.virar or args.voltar:
        erro, al, antes = virar(olho, -1 if args.voltar else +1)
        if erro:
            print(erro)
            return 1
        # Diz para onde foi. Virar um disco e a tela não mudar nada seria a
        # mesma falta de acontecimento que este comando existe para consertar.
        #
        # Espera o Session enxergar a mudança antes de perguntar: ele pesquisa
        # numa thread própria, e perguntar no mesmo instante devolve o lado
        # ANTIGO — o comando funcionaria e diria que não fez nada.
        # `antes` vem de dentro do virar(): o índice de ANTES do salto. Ler
        # olho.lado aqui devolveria None (só o laço principal o preenche), e
        # `i != None` é verdade na primeira volta — o comando sairia dizendo
        # o lado velho, como se não tivesse feito nada.
        lado = None; restam = 0.0; i = antes
        for _ in range(20):                        # até 2 s
            _al, i, lado, restam = olho.onde()
            if lado is not None and i != antes:
                break
            time.sleep(0.1)
        olho.lado = i
        minutos = int((restam or 0.0) // 60)
        avisar(rotulo(lado), f"{al.name} — {minutos} min deste lado")
        print(f"{rotulo(lado)} de {len(al.sides)}  ·  {minutos} min")
        return 0

    if args.once:
        al, i, lado, restam = olho.onde()
        if al is None:
            print("nada tocando")
            return 0
        ultimo = i >= len(al.sides) - 1
        print(f"{al.artist} — {al.name}")
        print(f"{rotulo(lado)} de {len(al.sides)}  ·  "
              f"{'acaba' if ultimo else 'vira'} em {int(restam // 60)} min")
        return 0

    renovador = Renovador()
    while True:
        try:
            al, i, lado, _restam = olho.onde()
        except Exception:                     # noqa: BLE001 — nunca morrer
            time.sleep(INTERVALO)
            continue
        # Antes de qualquer aviso: uma lista do Qobuz cuja assinatura está
        # perto de vencer é reassinada agora, com a música ainda tocando.
        renovador.talvez(al)

        if al is not None and lado is not None:
            if olho.lado is not None and i != olho.lado:
                # Passou de lado. Só avisa quando ANDA para a frente: um seek
                # para trás não é o disco virando, é a pessoa procurando uma
                # faixa, e avisar ali seria puro ruído.
                if i > olho.lado:
                    ultimo = i >= len(al.sides) - 1
                    anterior = al.sides[olho.lado]
                    if ultimo and i == len(al.sides) - 1:
                        avisar(f"{rotulo(anterior)} acabou",
                               f"{al.name} — vire o disco para o "
                               f"{rotulo(lado)}")
                    else:
                        avisar(f"{rotulo(anterior)} acabou",
                               f"{al.name} — agora o {rotulo(lado)}")
                    if args.pause and pausar():
                        avisar(f"{rotulo(anterior)} acabou",
                               f"{al.name} — pausado. Levante e vire.",
                               urgencia="critical")
            olho.lado = i
        else:
            olho.lado = None

        time.sleep(INTERVALO)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
