#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — roda no login do KDE, configura tudo
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Só roda no KDE ─────────────────────────────────────────────────────
if ! pgrep -x plasmashell >/dev/null 2>&1 && \
   [[ "${XDG_CURRENT_DESKTOP:-}" != *"KDE"* ]]; then
    exit 0
fi

# ── kglobalaccel5: o daemon que faz o Meta key funcionar ────────────────
if ! pgrep -x kglobalaccel5 >/dev/null 2>&1; then
    kglobalaccel5 &>/dev/null &
    sleep 1
fi

# ── plasmashell: o painel e desktop ────────────────────────────────────
if ! pgrep -x plasmashell >/dev/null 2>&1; then
    plasmashell &>/dev/null &
    sleep 2
fi

# ── Corrigir kglobalshortcutsrc se corrompido ──────────────────────────
KGSC="$HOME/.config/kglobalshortcutsrc"
if [[ -f "$KGSC" ]]; then
    # Se não tem nenhuma entrada do plasma, está vazio ou corrompido
    if ! grep -q "plasma-show-desktop\|_k_friendly_name\|Text\s*=" "$KGSC" 2>/dev/null; then
        rm -f "$KGSC"
    fi
fi

# ── KWin: janelas funcionam direito ────────────────────────────────────
kwriteconfig5 --file kwinrc --group Compositing --key OpenGLIsUnsafe false 2>/dev/null
kwriteconfig5 --file kwinrc --group Desktops --key Number 1 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key BorderlessMaximizedWindows true 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key FocusPolicy ClickRaise 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key BorderlessMouseQuickTileEnabled true 2>/dev/null
kwriteconfig5 --file kwinrc --group TabBox --key LayoutName Compact 2>/dev/null

# ── Tema escuro ────────────────────────────────────────────────────────
kwriteconfig5 --file plasmarc --group Theme --key name "Breeze Dark" 2>/dev/null
plasma-apply-desktop-theme "Breeze Dark" 2>/dev/null

# ── Wallpaper ──────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f "$WALLPAPER" ]] && command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
fi

# ── Numlock ────────────────────────────────────────────────────────────
command -v numlockx &>/dev/null && numlockx on 2>/dev/null

# ── xsettingsd ─────────────────────────────────────────────────────────
if command -v xsettingsd &>/dev/null; then
    pgrep -x xsettingsd >/dev/null || xsettingsd &>/dev/null &
fi

# ── Aplicar configs do KWin ────────────────────────────────────────────
qdbus org.kde.KWin /KWin reconfigure 2>/dev/null
