#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — roda no login do KDE
# ═══════════════════════════════════════════════════════════════════════════
#  Stock KDE + atalhos Stylus + configs visuais. NÃO mata nenhum processo
#  KDE. Os atalhos Stylus usam seções próprias no kglobalshortcutsrc —
#  não sobrescrevem nada do KDE.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Wallpaper ──────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f "$WALLPAPER" ]] && command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
fi

# ── Numlock ────────────────────────────────────────────────────────────
command -v numlockx &>/dev/null && numlockx on 2>/dev/null

# ── Tema Kvantum ──────────────────────────────────────────────────────
# Aplica o tema Stylus no Kvantum (se instalado)
if command -v kvantummanager &>/dev/null && [[ -d /usr/share/Kvantum/Stylus ]]; then
    kvantummanager -x Stylus 2>/dev/null || true
fi

# ── Atalhos Stylus ────────────────────────────────────────────────────
KGSC="$HOME/.config/kglobalshortcutsrc"
mkdir -p "$(dirname "$KGSC")"

add_shortcut() {
    local id="$1" name="$2" keys="$3"
    grep -q "\[$id\]" "$KGSC" 2>/dev/null && return
    {
        echo ""
        echo "[$id]"
        echo "_k_friendly_name=$name"
        echo "$id=$keys,none,$name"
    } >> "$KGSC"
}

# Música
add_shortcut "stylus-shelf" "Stylus Shelf" "Meta+M"
add_shortcut "stylus-deck" "Stylus Deck" "Meta+D"
add_shortcut "stylus-qobuz" "Stylus Qobuz" "Meta+Q"
add_shortcut "stylus-phone" "Stylus Phone" "Meta+P"

# Sistema
add_shortcut "stylus-term" "Stylus Terminal" "Meta+T"
add_shortcut "stylus-mode" "Stylus Toggle Mode" "Meta+Escape"

# ── Dolphin config ────────────────────────────────────────────────────
# Detalhes, fundo escuro, colunas úteis
DOLPHIN_RC="$HOME/.config/dolphinrc"
if [[ -f "$DOLPHIN_RC" ]]; then
    # Mostrar barra de localização (path bar)
    sed -i 's/ShowLocationBarInNewTabs=.*/ShowLocationBarInNewTabs=true/' "$DOLPHIN_RC" 2>/dev/null
    sed -i 's/ShowFullPath=.*/ShowFullPath=false/' "$DOLPHIN_RC" 2>/dev/null
else
    mkdir -p "$(dirname "$DOLPHIN_RC")"
    cat > "$DOLPHIN_RC" <<'EOF'
[General]
ShowLocationBarInNewTabs=true
ShowFullPath=false
ShowStatusBar=true
ShowSortButton=true
ShowZoomButton=true

[Settings]
ShowPreviewForFolders=true
EOF
fi

# ── Konsole — perfil Stylus como padrão ───────────────────────────────
KONSOLE_PROF="$HOME/.config/konsolerc"
if [[ -f "$KONSOLE_PROF" ]]; then
    # Tornar o perfil Stylus o padrão para novos terminais
    if grep -q 'Stylus' "$KONSOLE_PROF" 2>/dev/null; then
        sed -i 's/DefaultProfile=.*/DefaultProfile=Stylus.profile/' "$KONSOLE_PROF" 2>/dev/null
    fi
fi

# ── Dunst (notificações) ──────────────────────────────────────────────
if command -v dunst &>/dev/null && ! pgrep -x dunst >/dev/null 2>&1; then
    dunst &
fi

# ── KWin — desabilitar compostor se lento ──────────────────────────────
# O KWin tem um compositor que pode causar input lag em jogos.
# Se o usuário tem GPU dedicada, vale manter; se é integrada, desligar
# ajuda. Aqui só documentamos — quem quiser desliga com Alt+Shift+F12.
