#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — configura KDE: atalhos, tema, wallpaper, janelas
# ═══════════════════════════════════════════════════════════════════════════
#  Roda como autostart no KDE. Só executa SE estiver no KDE.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Só roda no KDE ─────────────────────────────────────────────────────
[[ "$XDG_CURRENT_DESKTOP" == *"KDE"* ]] || exit 0

sleep 4

# ── Tema escuro ────────────────────────────────────────────────────────
kwriteconfig5 --file plasmarc --group Theme --key name "Breeze Dark" 2>/dev/null
plasma-apply-desktop-theme "Breeze Dark" 2>/dev/null

# ── KWin: janelas funcionam direito ────────────────────────────────────
kwriteconfig5 --file kwinrc --group Compositing --key OpenGLIsUnsafe false 2>/dev/null
kwriteconfig5 --file kwinrc --group Desktops --key Number 1 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key BorderlessMaximizedWindows true 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key FocusPolicy ClickRaise 2>/dev/null
kwriteconfig5 --file kwinrc --group Windows --key BorderlessMouseQuickTileEnabled true 2>/dev/null
kwriteconfig5 --file kwinrc --group TabBox --key LayoutName Compact 2>/dev/null
qdbus org.kde.KWin /KWin reconfigure 2>/dev/null

# ── Wallpaper ──────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f "$WALLPAPER" ]] && command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
fi

# ── Numlock ────────────────────────────────────────────────────────────
command -v numlockx &>/dev/null && numlockx on 2>/dev/null

# ── xsettingsd (GTK apps usam tema do KDE) ────────────────────────────
if command -v xsettingsd &>/dev/null; then
    pgrep -x xsettingsd >/dev/null || xsettingsd &>/dev/null &
fi

# ── Atalhos Stylus via custom shortcuts do KDE ────────────────────────
# Usar qdbus é o jeito mais confiável — não depende de khotkeys instalado
SHORTCUTS_DIR="$HOME/.local/share/knetattach"
mkdir -p "$SHORTCUTS_DIR"

# Verificar se os atalhos já existem
EXISTING=$(qdbus org.kde.kglobalaccel /component/kwin listShortcuts 2>/dev/null | grep -c "stylus" || true)

if [[ "$EXISTING" -eq 0 ]]; then
    # Criar desktop files para custom shortcuts do Plasma
    SHORTCUTS_DIR="$HOME/.local/share/kglobalaccel"
    mkdir -p "$SHORTCUTS_DIR"

    cat > "$SHORTCUTS_DIR/stylus-shelf.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Estante
Exec=stylus-shelf
X-KDE-Shortcuts=Meta+M
EOF

    cat > "$SHORTCUTS_DIR/stylus-deck.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Deck
Exec=stylus-deck
X-KDE-Shortcuts=Meta+O
EOF

    cat > "$SHORTCUTS_DIR/stylus-ui.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Interface
Exec=stylus-ui
X-KDE-Shortcuts=Meta+G
EOF

    cat > "$SHORTCUTS_DIR/stylus-toggle.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Trocar Modo
Exec=stylus-mode toggle
X-KDE-Shortcuts=Meta+T
EOF

    cat > "$SHORTCUTS_DIR/stylus-virar.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Virar Lado
Exec=stylus-side-watch --virar
X-KDE-Shortcuts=Meta+Shift+V
EOF
fi
