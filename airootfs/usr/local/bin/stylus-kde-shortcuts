#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — a sessão do KDE com cara de STYLUS
# ═══════════════════════════════════════════════════════════════════════════
#  KDE de fábrica + atalhos do STYLUS + a paleta âmbar. NÃO mata processo
#  nenhum do KDE e não substitui nada que seja do Plasma.
#
#      stylus-kde-shortcuts            no login (autostart), sessão de pé
#      stylus-kde-shortcuts --seed     só escreve arquivo; roda no chroot da
#                                      instalação, para que os atalhos já
#                                      valham no PRIMEIRO login
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

SEED=0
[[ ${1:-} == --seed ]] && SEED=1

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONF" 2>/dev/null

# ── Atalhos ────────────────────────────────────────────────────────────────
# O formato importa. Um atalho que ABRE UM PROGRAMA mora numa seção
# `[services][arquivo.desktop]` com a chave `_launch`; era escrito como
# `[stylus-shelf]` com uma linha `stylus-shelf=Meta+M,none,...`, que é o
# formato de quem REGISTRA uma ação no KGlobalAccel — coisa que só um
# programa do KDE em execução faz. O arquivo ficava bonito e nenhuma tecla
# funcionava.
KGSC="$CONF/kglobalshortcutsrc"
[[ -f $KGSC ]] || : > "$KGSC"

atalho() {                      # atalho <arquivo.desktop> <teclas> <nome>
    local desk=$1 keys=$2 nome=$3
    [[ -f /usr/share/applications/$desk ]] || return 0   # não prometa o que não existe
    grep -qF "[services][$desk]" "$KGSC" 2>/dev/null && return 0
    {
        printf '\n[services][%s]\n' "$desk"
        printf '_k_friendly_name=%s\n' "$nome"
        printf '_launch=%s\n' "$keys"
    } >> "$KGSC"
}

# Meta+M/D/Q/P são a música; Meta+Esc troca de mundo. Nada disso colide com
# atalho de fábrica do Plasma (que usa Meta sozinho, Meta+E, Meta+L…).
#
# Meta+G é a tela cheia SEM trocar de sessão, e é o mesmo Mod+G do i3 de
# propósito: quem aprende o atalho num modo não o perde no outro.
atalho stylus-ui.desktop         "Meta+G"      "STYLUS em tela cheia"
atalho stylus-shelf.desktop      "Meta+M"      "Estante"
atalho stylus-deck.desktop       "Meta+D"      "Toca-discos"
atalho stylus-qobuz.desktop      "Meta+Q"      "Qobuz"
atalho stylus-phone.desktop      "Meta+P"      "Celular"
# Antes isto apontava para stylus-mode.desktop, um interruptor sem lado: num
# menu, "Trocar de modo" não diz se vai ligar ou desligar. Vindo do KDE só há
# um destino que faz sentido, e agora o atalho diz qual é.
atalho stylus-music-mode.desktop "Meta+Escape" "Modo música"
atalho stylus-claude.desktop     "Meta+T"      "Terminal"

# ── Konsole: o perfil Stylus como padrão ───────────────────────────────────
# Antes isto só agia se o konsolerc JÁ falasse em Stylus — ou seja, nunca na
# máquina onde faria diferença.
KRC="$CONF/konsolerc"
if [[ -f $KRC ]]; then
    if grep -q '^DefaultProfile=' "$KRC"; then
        sed -i 's/^DefaultProfile=.*/DefaultProfile=Stylus.profile/' "$KRC" 2>/dev/null
    else
        printf '\n[Desktop Entry]\nDefaultProfile=Stylus.profile\n' >> "$KRC"
    fi
else
    printf '[Desktop Entry]\nDefaultProfile=Stylus.profile\n' > "$KRC"
fi

# ── Dolphin ────────────────────────────────────────────────────────────────
DRC="$CONF/dolphinrc"
if [[ ! -f $DRC ]]; then
    cat > "$DRC" <<'EOF'
[General]
ShowLocationBarInNewTabs=true
ShowFullPath=false
ShowStatusBar=true
RememberOpenedTabs=false

[DetailsMode]
PreviewSize=32

[IconsMode]
PreviewSize=64
EOF
fi

# Daqui para baixo só faz sentido com uma sessão de pé.
(( SEED )) && exit 0

# ── Papel de parede ────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f $WALLPAPER ]] && command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1
fi

# ── A paleta ───────────────────────────────────────────────────────────────
# O kdeglobals já nasce apontando para o StylusDark, mas quem instalou antes
# desta versão não tem essa linha — e aplicar por fora conserta sem mexer no
# que a pessoa escolheu depois.
if command -v plasma-apply-colorscheme >/dev/null 2>&1 \
   && [[ -f /usr/share/color-schemes/StylusDark.colors ]] \
   && ! grep -q '^ColorScheme=StylusDark' "$CONF/kdeglobals" 2>/dev/null; then
    plasma-apply-colorscheme StylusDark >/dev/null 2>&1
fi

if command -v kvantummanager >/dev/null 2>&1 && [[ -d /usr/share/Kvantum/Stylus ]]; then
    kvantummanager --set Stylus >/dev/null 2>&1 || kvantummanager -x Stylus >/dev/null 2>&1
fi

# ── O cursor ───────────────────────────────────────────────────────────────
# O SDDM usa Adwaita (está no stylus.conf dele). Sem esta linha o Plasma
# entrava com o Breeze e o cursor MUDAVA de desenho no meio do login — um
# detalhe pequeno que faz o sistema parecer duas coisas coladas.
if command -v plasma-apply-cursortheme >/dev/null 2>&1; then
    plasma-apply-cursortheme Adwaita >/dev/null 2>&1
fi

command -v numlockx >/dev/null 2>&1 && numlockx on >/dev/null 2>&1

# ── Os dois ícones que fazem a máquina se explicar sozinha ─────────────────
# Uma vez só, no primeiro login: "STYLUS" e "Modo música" na área de
# trabalho. O friend que abre o KDE pela primeira vez não sabe que existe
# Meta+G nem onde procurar no menu — mas vê a área de trabalho.
#
# O carimbo é o que impede isto de virar praga: quem apagar os ícones não
# os vê voltar no login seguinte.
CARIMBO="${XDG_DATA_HOME:-$HOME/.local/share}/stylus/kde-primeiro-login"
if [[ ! -e $CARIMBO ]]; then
    AREA=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
    if mkdir -p "$AREA" 2>/dev/null; then
        for d in stylus-ui stylus-music-mode; do
            origem="/usr/share/applications/$d.desktop"
            [[ -f $origem ]] || continue
            cp -f "$origem" "$AREA/" 2>/dev/null || continue
            # O Plasma pergunta "confia neste arquivo?" para todo .desktop
            # que não seja executável — e a resposta certa para um arquivo
            # que o próprio sistema acabou de pôr ali é não perguntar.
            chmod +x "$AREA/$d.desktop" 2>/dev/null
        done
    fi
    mkdir -p "$(dirname "$CARIMBO")" 2>/dev/null && : > "$CARIMBO"
fi

# O dunst NÃO entra aqui. O KDE tem notificação própria (o Plasma), e os dois
# disputam o mesmo nome no D-Bus: quem chega primeiro fica com ele e o outro
# some — na prática, ligar o dunst aqui apagava as notificações do Plasma. É
# por isso que o stylus-dunst.desktop diz NotShowIn=KDE, e era contradito por
# esta linha, que rodava SÓ no KDE.

exit 0
