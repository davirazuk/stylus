#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — roda no login do KDE
# ═══════════════════════════════════════════════════════════════════════════
#  Stock KDE + atalhos Stylus. NÃO mata nenhum processo KDE.
#  Só aplica wallpaper e registra atalhos (que entram no próximo login).
#  Os atalhos Stylus usam seções próprias no kglobalshortcutsrc — não
#  sobrescrevem nada do KDE.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Wallpaper ──────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f "$WALLPAPER" ]] && command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
fi

# ── Numlock ────────────────────────────────────────────────────────────
command -v numlockx &>/dev/null && numlockx on 2>/dev/null

# ── Atalhos Stylus ────────────────────────────────────────────────────
# Cada atalho tem sua PRÓPRIA seção no kglobalshortcutsrc — nunca mexe
# nas seções do KDE (kwin, plasmashell, etc).
KGSC="$HOME/.config/kglobalshortcutsrc"
mkdir -p "$(dirname "$KGSC")"

add_shortcut() {
    local id="$1" name="$2" keys="$3"
    grep -q "\[$id\]" "$KGSC" 2>/dev/null && return
    {
        echo ""
        echo "[$id]"
        echo "_k_friendly_name=$name"
        echo "$id=$keys,none,$name"
    } >> "$KGSC"
}

# Mod+M → estante (shelf)
add_shortcut "stylus-shelf" "Stylus Shelf" "Meta+M"
# Mod+D → deck (vinyl visualizer)
add_shortcut "stylus-deck" "Stylus Deck" "Meta+D"
# Mod+Q → qobuz search
add_shortcut "stylus-qobuz" "Stylus Qobuz" "Meta+Q"
# Mod+T → terminal (konsole)
add_shortcut "stylus-term" "Stylus Terminal" "Meta+T"
# Mod+P → phone sync
add_shortcut "stylus-phone" "Stylus Phone" "Meta+P"
# Mod+S → shelf (duplicate for convenience)
add_shortcut "stylus-shelf2" "Stylus Shelf Alt" "Meta+S"

# ── Dunst (notificações) ──────────────────────────────────────────────
# Garantir que dunst roda no KDE — ele é o sistema de notificações do
# Stylus e funciona tanto no i3 quanto no KDE.
if command -v dunst &>/dev/null && ! pgrep -x dunst >/dev/null 2>&1; then
    dunst &
fi

# ── Rofi (app launcher) ───────────────────────────────────────────────
# O rofi funciona no KDE sem problemas — só precisa estar no PATH.
# Não substitui o kickoff do KDE, só fica disponível para quem quiser.
