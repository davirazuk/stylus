#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-shortcuts — roda no login do KDE
# ═══════════════════════════════════════════════════════════════════════════
#  Stock KDE + atalho Mod+M para a estante. NÃO mata nenhum processo KDE.
#  Só aplica wallpaper e registra o atalho (que entra no próximo login).
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Wallpaper ──────────────────────────────────────────────────────────
WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
if [[ -f "$WALLPAPER" ]] && command -v plasma-apply-wallpaperimage &>/dev/null; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
fi

# ── Numlock ────────────────────────────────────────────────────────────
command -v numlockx &>/dev/null && numlockx on 2>/dev/null

# ── Atalho: Mod+M → estante ──────────────────────────────────────────
# Só registra se não existe. NÃO mata kglobalaccel5 — deixar o KDE
# gerenciar o lifecycle. O atalho entra no próximo login.
KGSC="$HOME/.config/kglobalshortcutsrc"
SHELF_ID="stylus-shelf"
mkdir -p "$(dirname "$KGSC")"
if ! grep -q "\[$SHELF_ID\]" "$KGSC" 2>/dev/null; then
    {
        echo ""
        echo "[$SHELF_ID]"
        echo "_k_friendly_name=Stylus Shelf"
        echo "$SHELF_ID=Meta+M,none,Abrir estante"
    } >> "$KGSC"
fi
