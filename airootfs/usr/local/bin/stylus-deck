#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-deck — põe um disco, e mostra o disco
# ═══════════════════════════════════════════════════════════════════════════
#      stylus deck "Radiohead/In Rainbows"    o disco inteiro, na ordem
#      stylus deck loveless                   acha pelo nome, sem o caminho
#      stylus deck                            sorteia um da estante
#      stylus deck "Novidades 2026-08-30"     uma playlist .m3u da coleção
#      stylus deck --quiet   DISCO            toca num sink nulo: silêncio na sala
#      stylus deck --no-scope DISCO           só toca, sem tela  (= stylus play)
#      stylus deck --recomeçar DISCO          do começo, ignorando onde parou
#
#  ── O que este comando é, agora que o deck não existe mais ───────────────
#  O DECK era um segundo programa: OpenGL, um venv só dele com PyOpenGL,
#  PortAudio, uma janela por cima do lançador. Ele saiu — o que ele desenhava
#  o lançador desenha melhor, na tela cheia da AGORA ([f]), sem GL e sem
#  venv. Ver `NowScreen._cheia` no ui/app.py.
#
#  O que sobrou aqui, e é a metade que sempre importou: PÔR O DISCO. Achar o
#  álbum pelo nome, subir um mpv com as travas de áudio que blindam o caminho
#  do sinal, e pôr a agulha de volta onde ela parou. Depois disso ele pede ao
#  lançador para mostrar o disco na tela toda.
#
#  Por que um lançador em vez de mandar tocar e pronto: quem desenha prefere
#  falar com um mpv por socket IPC, porque assim sabe a posição exata E a
#  ordem das faixas do lado inteiro. O MPRIS sozinho dá a faixa atual e mais
#  nada, e a agulha precisa saber quanto falta do LADO, não da música.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

SHARE=/usr/share/stylus
LIB=$SHARE/lib
PY=python3
export PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}"

# Os caminhos de estado vêm do vinyl.py — escritos à mão aqui, no
# stylus-qobuz e lá, eles já eram três cópias da mesma decisão. Ver a lição
# das seis listas de extensão no CLAUDE.md: cópia que ninguém confere deriva.
eval "$("$PY" -c 'import vinyl
print("SOCK=%r" % vinyl.SOCKET_PATH)
print("PIDFILE=%r" % vinyl.MPV_PIDFILE)
print("RECADO=%r" % vinyl.UI_CMD)' 2>/dev/null)"
: "${SOCK:=$HOME/.local/share/stylus/deck.sock}"
: "${PIDFILE:=$HOME/.local/share/stylus/deck.mpv.pid}"
: "${RECADO:=$HOME/.local/share/stylus/ui.cmd}"
NULL_SINK=stylus_quiet

# ── mostrar o disco na tela toda ─────────────────────────────────────────
# O lançador é INSTÂNCIA ÚNICA (ver o stylus-ui): com ele já aberto — que é o
# caso normal no modo música — não dá para abrir outra tela por cima. Então
# o recado fica num arquivo que ele lê no quadro seguinte, e o `stylus-ui`
# é chamado assim mesmo: se ele não estava aberto, abre já na tela cheia; se
# estava, devolve 76 e o recado já chegou.
mostrar_o_disco() {
    mkdir -p "$(dirname "$RECADO")" 2>/dev/null || true
    printf 'disco\n' > "$RECADO" 2>/dev/null || true
    stylus-ui --disco
    local rc=$?
    (( rc == 76 )) && return 0
    return $rc
}
QUIET=0; TELA=1; VIEW=0; TARGET=""; RETOMAR=1

while [[ $# -gt 0 ]]; do
    case $1 in
        --quiet)    QUIET=1; shift ;;
        # --no-scope é o nome antigo e continua valendo: está escrito no i3,
        # na estante do rofi e no lançador. --sem-tela é o nome de hoje.
        --no-scope|--sem-tela) TELA=0; shift ;;
        --view|--observar|--monitor) VIEW=1; shift ;;
        --recomeçar|--recomecar|--do-inicio|--restart) RETOMAR=0; shift ;;
        -h|--help)  sed -n '5,11p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)          TARGET=$1; shift ;;
    esac
done

# ── mostrar o disco que JÁ está tocando ───────────────────────────────────
# Sem pôr disco novo, sem tocar no mpv, sem TARGET: é o lançador que abre a
# tela cheia no que já está no prato. Ver `mostrar_o_disco`.
if (( VIEW )); then
    mostrar_o_disco
    exit 0
fi

# ── achar o disco ──────────────────────────────────────────────────────────
# Um caminho é um caminho. Qualquer outra coisa é um NOME, e procurar o nome
# na estante é o que faz `stylus deck loveless` funcionar — que é como uma
# pessoa pensa num disco, e não "barra home barra músicas barra".
if [[ -z $TARGET ]]; then
    TARGET=$("$PY" -c 'import vinyl,sys; d=vinyl.draw_record(); print(d or "", end="")')
    [[ -n $TARGET ]] || { echo "stylus: não achei disco nenhum. \`stylus library\` diz onde estou procurando." >&2; exit 1; }
    echo "stylus: sorteei ${TARGET##*/}"
elif [[ ! -e $TARGET ]]; then
    FOUND=$("$PY" - "$TARGET" <<'PYEOF'
import os, sys, difflib, vinyl
want = sys.argv[1].lower()
# As PLAYLISTS entram na busca junto com os discos, e na frente: quem digita
# o nome de uma playlist quer a playlist, e um disco com nome parecido não
# tem por que ganhar. Sem isto o sistema escrevia .m3u que ninguém conseguia
# tocar — nem pelo nome, nem por caminho.
for pl in vinyl.playlists():
    nome = os.path.splitext(os.path.basename(pl))[0].lower()
    if nome == want or want in nome:
        print(pl, end="")
        raise SystemExit
cands = vinyl.shelf(min_tracks=1)
# casamento exato de pasta primeiro, depois "artista/disco", depois o mais
# parecido — nessa ordem porque digitar o nome inteiro certo tem que ganhar
# de um palpite difuso que por acaso pontuou mais.
exact = [c for c in cands if os.path.basename(c).lower() == want]
part  = [c for c in cands if want in os.path.join(*vinyl.folder_names(c)).lower()]
best  = difflib.get_close_matches(want, [os.path.basename(c).lower() for c in cands], n=1, cutoff=0.6)
pick = (exact or part or [c for c in cands if best and os.path.basename(c).lower() == best[0]])
print(pick[0] if pick else "", end="")
PYEOF
)
    [[ -n $FOUND ]] || { echo "stylus: não achei nenhum disco chamado \"$TARGET\"." >&2; exit 1; }
    [[ $FOUND == "$TARGET" ]] || echo "stylus: ${FOUND##*/}"
    TARGET=$FOUND
fi
TARGET="${TARGET/#\~/$HOME}"
command -v mpv >/dev/null || { echo "stylus: o mpv não está instalado." >&2; exit 1; }

# Pôr um disco é um ato EXCLUSIVO: dois tocadores ao mesmo tempo deixam a barra
# e o deck mostrando um disco enquanto sai o som do outro. É o defeito clássico
# da tela cheia — a pessoa escolhe um disco atrás do outro na estante e cada
# escolha larga mais um mpv tocando por cima.
#
# Pausar os OUTROS players (não-mpv) resolve a metade fácil. A metade que
# faltava era o mpv anterior deste próprio lançador: `playerctl` pula todo mpv
# de propósito (para não se pausar), e apagar o socket não mata processo
# nenhum. Um pidfile fecha o buraco — matamos pelo PID exato que largamos da
# última vez, sem `pkill -f` (que casaria com o shell desta ferramenta e
# derrubaria a sessão).
if command -v playerctl >/dev/null; then
    for _p in $(playerctl -l 2>/dev/null); do
        [[ $_p == mpv* ]] && continue
        playerctl -p "$_p" pause 2>/dev/null || true
    done
fi
mkdir -p "$(dirname "$SOCK")"
if [[ -f $PIDFILE ]]; then
    _old=$(cat "$PIDFILE" 2>/dev/null || true)
    # Confere que o PID é mesmo um mpv nosso antes de matar: um PID reciclado
    # por outro programa entre uma sessão e outra não é para morrer.
    if [[ $_old =~ ^[0-9]+$ ]] && [[ -r /proc/$_old/comm ]] &&        [[ $(cat "/proc/$_old/comm" 2>/dev/null) == mpv ]]; then
        kill "$_old" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
fi
rm -f "$SOCK"

mpv_args=(--input-ipc-server="$SOCK" --no-video --term-status-msg= --really-quiet
          --audio-display=no --gapless-audio=yes
          # O mpv reamostra por conta própria se deixarem. Aqui não: o
          # servidor de áudio já está configurado para seguir a taxa do
          # arquivo, e um resampler no tocador desfaz isso em silêncio.
          --audio-samplerate=0
          # ── e o que um ~/.config/mpv/mpv.conf pode desfazer ─────────────
          # O mpv LÊ o config do usuário, e a linha de comando ganha dele. Um
          # `replaygain=track` ou um `af=loudnorm` herdado de outra máquina
          # desfaz a tese inteira do sistema ANTES de o som chegar ao
          # PipeWire — e o `stylus audio`, que mede do PipeWire para a frente,
          # continuaria dizendo "sem conversão". Por isso vão explícitos:
          #
          #   replaygain=no  um disco tem UM nível, do jeito que foi
          #                  masterizado. Normalizar faixa a faixa é
          #                  exatamente o que uma playlist faz e um disco não.
          #   af=            nenhum filtro no caminho.
          #   volume=100     qualquer outro valor é ganho digital. O volume
          #                  desta máquina é o do PipeWire (as teclas chamam
          #                  o pamixer), não o do tocador.
          --replaygain=no --af= --volume=100)
if (( QUIET )); then
    if ! pactl list sinks short 2>/dev/null | grep -q "\b$NULL_SINK\b"; then
        NULL_MOD=$(pactl load-module module-null-sink \
            sink_name="$NULL_SINK" \
            sink_properties=device.description=STYLUS-Quiet 2>/dev/null)
    fi
    mpv_args+=(--audio-device="pulse/$NULL_SINK")
    export STYLUS_AUDIO_SOURCE="$NULL_SINK.monitor"
fi

# Os arquivos vão UM A UM, não a pasta. Dando a pasta, o mpv enfileira tudo
# que houver dentro dela — cover.jpg inclusive — e no fim do disco ele tenta
# "tocar" a imagem e fecha, além de reportar um índice de faixa que não existe
# no álbum. A lista sai do vinyl.track_paths, a MESMA que o Album lê, então o
# índice do mpv e o índice do disco são o mesmo número por construção.
# Uma playlist é um ARQUIVO, e o track_paths sabe lê-la. O `-d` sozinho a
# deixava de fora: o mpv recebia o .m3u e até tocava, mas aí o índice da
# faixa não é o índice do Album e o LADO, a agulha e a letra falam todos da
# faixa errada.
_tracks=()
if [[ -d $TARGET ]] || [[ -f $TARGET && $TARGET == *.m3u ]] || [[ -f $TARGET && $TARGET == *.m3u8 ]]; then
    # Usar arquivo temporário para evitar problemas de shell com caminhos e bytes nulos
    _tmp_tracks=$(mktemp)
    "$PY" -c '
import os, sys, vinyl
with open(sys.argv[2], "w") as f:
    for t in vinyl.track_paths(sys.argv[1]):
        f.write(t + "\n")' "$TARGET" "$_tmp_tracks" 2>&1
    
    if [[ $? -eq 0 ]]; then
        mapfile -t _tracks < "$_tmp_tracks"
        rm -f "$_tmp_tracks"
    else
        echo "stylus: erro ao ler o disco" >&2
        rm -f "$_tmp_tracks"
        exit 1
    fi
fi

# ── pôr a agulha de volta onde ela estava ──────────────────────────────────
#  Num toca-discos você levanta a agulha e o disco fica onde está; voltar
#  depois e recomeçar da faixa 1 é coisa de tocador de arquivo. O
#  stylus-side-watch anota a posição enquanto toca; aqui ela é lida de volta.
#
#  Não dá para deixar isso a cargo do `--resume-playback` do mpv: ele guarda a
#  posição pelo hash do CAMINHO DO ARQUIVO que estava tocando, então relançar
#  o disco inteiro faz ele procurar a posição salva da FAIXA 1 — que quase
#  nunca é onde você parou. Quem sabe qual faixa é o índice da lista, e isso é
#  nosso.
if (( RETOMAR )) && (( ${#_tracks[@]} )); then
    _volta=$("$PY" - "$TARGET" <<'PYEOF' 2>/dev/null
import os, sys, vinyl
alvo = os.path.realpath(sys.argv[1])
arq = os.path.expanduser("~/.local/share/stylus/agulha.tsv")
try:
    _ts, pasta, idx, pos = open(arq, encoding="utf-8").read().strip().split("\t")
    idx, pos = int(idx), float(pos)
except Exception:
    sys.exit(0)
if os.path.realpath(pasta) != alvo or pos < 3:
    sys.exit(0)
# Uma lista SORTEADA não se retoma. O índice guardado continua válido — é a
# MÚSICA por trás dele que não é mais a mesma: pôr a mesma playlist de novo
# sorteia outra ordem, e "retomar na faixa 47" cairia numa faixa que não tem
# nada a ver com onde a pessoa parou. Numa lista na ordem (ou num disco) o
# índice significa sempre a mesma faixa, e aí retomar é o certo.
m = vinyl.manifesto(alvo) or {}
if m.get("sorteada"):
    sys.exit(0)
al = vinyl.Album(alvo, envelope=False)
if not al.tracks or not 0 <= idx < len(al.tracks):
    sys.exit(0)
# No fim do último lado o disco ACABOU: retomar aí seria pôr o disco para
# ouvir os vinte segundos finais, que não é o que ninguém quer.
dur = al.tracks[idx].get("duration") or 0.0
if idx == len(al.tracks) - 1 and dur and pos > dur - 20:
    sys.exit(0)
print(f"{idx}\t{pos:.1f}\t{al.tracks[idx].get('title') or ''}")
PYEOF
)
    if [[ -n $_volta ]]; then
        IFS=$'\t' read -r _idx _pos _titulo <<<"$_volta"
        mpv_args+=(--playlist-start="$_idx" --start="$_pos")
        _seg=${_pos%.*}
        printf 'stylus: retomando na faixa %d, %d:%02d%s\n' \
            "$((_idx + 1))" "$(( _seg / 60 ))" "$(( _seg % 60 ))" \
            "${_titulo:+  ($_titulo)}"
        echo "        \`stylus deck --recomeçar\` põe do começo."
    fi
fi

# Coleção montada pela rede (o `stylus webdav` põe o celular na estante): sem
# leitura adiantada, um FLAC de 24/96 lido por FUSE engasga no meio da faixa —
# e o sintoma parece defeito de áudio, não de rede. Local não precisa e não
# ganha nada, então só quando é o caso.
# E um disco que vem INTEIRO pela internet — o `stylus qobuz tocar`, que
# monta uma pasta com um disco.json e endereços no lugar de arquivos. O
# `findmnt` abaixo não vê nada disso: a pasta é local, o áudio é que não é.
# Sem folga aqui, um FLAC de 24/192 num link doméstico engasga no meio da
# faixa e o sintoma parece defeito de áudio, não de rede.
if [[ -f $TARGET/disco.json ]]; then
    mpv_args+=(--cache=yes --demuxer-max-bytes=192MiB
               --demuxer-readahead-secs=40)
else
    # Coleção montada pela rede (o `stylus webdav` põe o celular na estante):
    # mesma razão, folga menor. Local não precisa e não ganha nada.
    _fs=$(findmnt -no FSTYPE -T "$TARGET" 2>/dev/null || echo "")
    case "$_fs" in
        fuse*|nfs*|cifs|smb*|sshfs|davfs*)
            mpv_args+=(--cache=yes --demuxer-max-bytes=64MiB
                       --demuxer-readahead-secs=20) ;;
    esac
fi

# Os ARQUIVOS por último, depois de todas as opções. No mpv uma opção depois
# do nome do arquivo não é erro — ela simplesmente não vale para a lista que
# já foi montada, e `--playlist-start` ali é ignorado em silêncio.
if (( ${#_tracks[@]} )); then
    mpv_args+=(--loop-playlist=no "${_tracks[@]}")
elif [[ -d $TARGET ]]; then
    mpv_args+=(--loop-playlist=no "$TARGET")   # álbum em Disc 01/Disc 02
else
    mpv_args+=("$TARGET")
fi

# Cerimônia: começa pausado, e o som entra quando a agulha encosta no sulco.
# Em --no-scope (só tocar) não: ali é put_on e queremos som imediato.
#
# Quem tirava a pausa era o ritual do deck, no fim da descida da agulha. Sem
# ele, quem tira é o bloco lá embaixo — e tira MESMO que o lançador não
# abra, porque um disco que fica pausado para sempre é o pior desfecho
# possível desta linha.
if (( TELA )); then
    mpv_args+=(--pause)
fi

# mpv desacoplado: fechar o deck (ou o ritual) NÃO para a música.
# setsid para não receber SIGHUP quando o lançador sair; pidfile fica para
# o próximo `stylus deck` saber quem matar antes de pôr outro disco.
setsid mpv "${mpv_args[@]}" </dev/null >/dev/null 2>&1 &
MPV=$!
echo "$MPV" > "$PIDFILE"
cleanup() {
    # fechar o deck não para a música — só limpa o sink quiet se criamos
    [[ -n ${NULL_MOD:-} ]] && pactl unload-module "$NULL_MOD" 2>/dev/null || true
}
trap cleanup EXIT
for _ in $(seq 1 50); do [[ -S $SOCK ]] && break; sleep 0.1; done

if (( TELA )); then
    # ── a agulha desce, e só então sai som ────────────────────────────────
    # Os segundos são os do vinyl.py (SPINUP_T + CUE_T + DROP_T), os MESMOS
    # que a tela cheia usa para desenhar a descida. Duas cópias à mão do
    # mesmo ritual derivam, e aí o som entra antes ou depois da agulha
    # encostar — que é a única coisa que esta espera existe para acertar.
    ESPERA=$("$PY" -c 'import vinyl
print("%.2f" % (getattr(vinyl, "SPINUP_T", 1.1) + getattr(vinyl, "CUE_T", 1.05)
                + getattr(vinyl, "DROP_T", 0.55)))' 2>/dev/null || echo 2.7)
    (
        sleep "$ESPERA"
        # Pelo socket, com o MESMO cliente que o resto do sistema usa
        # (vinyl._MpvIPC) — nada de socat, que não está em pacote nenhum
        # aqui. O playerctl é a reserva; e se as duas falharem, ainda assim
        # não se desiste calado: um disco pausado para sempre é justamente o
        # defeito que este bloco existe para evitar.
        "$PY" -c 'import sys, vinyl
ipc = vinyl._MpvIPC()
sys.exit(0 if ipc.command("set_property", "pause", False) is not None else 1)' \
            2>/dev/null || playerctl -p mpv play 2>/dev/null || true
    ) >/dev/null 2>&1 &
    mostrar_o_disco
    # a tela saiu, a música segue — desarma o trap do sink temporário e sai
    trap - EXIT
    cleanup
else
    # --no-scope: só pôs o disco pra tocar, sem tela
    # desacopla e sai imediatamente — não espera o álbum acabar
    trap - EXIT
    cleanup
fi
