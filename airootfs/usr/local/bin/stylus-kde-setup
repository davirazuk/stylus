#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde-setup — configura o KDE na primeira vez que abre
# ═══════════════════════════════════════════════════════════════════════════
#  Roda como autostart no KDE. Aplica wallpaper, tema e atalhos.
#  Só executa uma vez por sessão.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# Espera o KDE terminar de carregar
sleep 3

WALLPAPER="/usr/share/backgrounds/stylus/stylus.png"
KDE_CONF="$HOME/.config"
MODE_FILE="$KDE_CONF/stylus/mode"
mode=$(cat "$MODE_FILE" 2>/dev/null || echo desktop)

# ── Wallpaper ──────────────────────────────────────────────────────────
if [[ -f "$WALLPAPER" ]]; then
    # Plasma 5: plasma-apply-wallpaperimage
    if command -v plasma-apply-wallpaperimage &>/dev/null; then
        plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null
    fi
    # Fallback: nitrogen (se disponível)
    if command -v nitrogen &>/dev/null; then
        nitrogen --set-zoom-fill "$WALLPAPER" --save 2>/dev/null
    fi
fi

# ── Tema escuro ────────────────────────────────────────────────────────
# KDE 5: aplicar Breeze Dark
if command -v plasma-apply-desktop-theme &>/dev/null; then
    plasma-apply-desktop-theme "Breeze Dark" 2>/dev/null
fi

# Ícones Papirus-Dark
if command -v plasmapkg2 &>/dev/null; then
    # Plasma 5 já deve ter Papirus instalado
    :
fi

# ── Numlock ON ─────────────────────────────────────────────────────────
if command -v numlockx &>/dev/null; then
    numlockx on 2>/dev/null
fi

# ── xsettingsd (GTK apps usam config do KDE) ──────────────────────────
if command -v xsettingsd &>/dev/null; then
    pgrep -x xsettingsd >/dev/null || xsettingsd &>/dev/null &
fi

# ── Notificações ───────────────────────────────────────────────────────
# KDE tem seu próprio sistema de notificações, não precisa do dunst
# Mas se dunst estiver instalado, mata para evitar duplicata
if pgrep -x dunst >/dev/null 2>&1; then
    killall dunst 2>/dev/null
fi
