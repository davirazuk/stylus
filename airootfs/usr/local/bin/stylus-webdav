#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-webdav — a coleção do celular na estante, sem cabo e sem copiar
# ═══════════════════════════════════════════════════════════════════════════
#      stylus webdav                 o que está montado agora
#      stylus webdav ligar [URL]     monta e põe na estante
#      stylus webdav desligar        desmonta
#      stylus webdav sozinho         remonta a cada login (e agora)
#      stylus webdav esquecer        apaga a configuração e a senha
#
#  POR QUE ISTO EXISTE, E POR QUE NÃO É O `stylus phone`
#
#  O `stylus phone` COPIA: ele compara os dois lados e move arquivo, para a
#  música ficar nos dois lugares. Isto aqui não copia nada — ele MONTA o
#  celular como se fosse uma pasta, e os discos que estão lá aparecem na
#  estante junto com os de casa. É o caso de quem tem 200 GB no celular e 60
#  no computador: você não quer copiar, quer pôr para tocar.
#
#  Sobre a escolha do rclone em vez do davfs2: o davfs2 monta como root, quer
#  linha no /etc/fstab e um binário setuid. O rclone monta em espaço de
#  usuário pelo FUSE, já está instalado (o `stylus backup` usa), fala WebDAV
#  nativamente e guarda a senha ofuscada em vez de em texto puro num arquivo
#  de sistema. Um servidor de WebDAV num celular muda de IP e cai o tempo
#  todo; nada disso merece root.
#
#  Montado como SÓ LEITURA de propósito. Pôr um disco não escreve nada, e um
#  `rm` distraído numa pasta montada apagaria a música do celular de verdade.
#  Quem quer mandar arquivo para o celular usa o `stylus phone`, que sabe o
#  que está fazendo.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/stylus"
CONF="$CONF_DIR/webdav"
LIB_CONF="$CONF_DIR/library"
REMOTO=stylus-celular
MONTAGEM="${STYLUS_WEBDAV_MOUNT:-$HOME/.local/share/stylus/celular}"

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'
c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

precisa() {
    command -v "$1" >/dev/null ||
        die "falta o $1. \`sudo pacman -S ${2:-$1}\` resolve."
}

montado() { mountpoint -q "$MONTAGEM" 2>/dev/null; }

# ── onde o celular está ─────────────────────────────────────────────────────
# O mesmo truque do `stylus phone wifi`: o próprio aparelho sabe o IP dele, e
# o adb pergunta. Só serve como PALPITE — o servidor de WebDAV do celular
# escolhe a porta, e essa ninguém adivinha.
ip_do_celular() {
    command -v adb >/dev/null || return 1
    adb shell ip route 2>/dev/null |
        tr ' ' '\n' | grep -E '^[0-9]+(\.[0-9]+){3}$' | grep -v '^0\.' | tail -1
}

# ── ler e escrever a configuração ───────────────────────────────────────────
ler_conf() {
    URL=""; USUARIO=""
    [[ -r $CONF ]] || return 1
    # shellcheck source=/dev/null
    . "$CONF"
    [[ -n $URL ]]
}

# ═══════════════════════════════════════════════════════════════════════════
mostrar() {
    printf '\n  %sSTYLUS — o celular por WebDAV%s\n\n' "$c_d" "$c_0"
    if ler_conf; then
        printf '    servidor   %s\n' "$URL"
        [[ -n $USUARIO ]] && printf '    usuário    %s\n' "$USUARIO"
        printf '    pasta      %s\n' "$MONTAGEM"
    else
        printf '    Nada configurado ainda.\n\n'
        printf '    No celular, abra o aplicativo de servidor WebDAV e veja o\n'
        printf '    endereço que ele mostra (algo como http://192.168.0.10:8080).\n'
        local ip; ip=$(ip_do_celular || true)
        [[ -n ${ip:-} ]] && printf '\n    %sO celular plugado está em %s.%s\n' "$c_d" "$ip" "$c_0"
        printf '\n    Depois:  %sstylus webdav ligar URL%s\n\n' "$c_b" "$c_0"
        return 0
    fi
    printf '\n'
    if montado; then
        local n
        n=$(find "$MONTAGEM" -maxdepth 3 -type d 2>/dev/null | wc -l)
        ok "montado  ($((n > 0 ? n - 1 : 0)) pastas visíveis)"
        na_estante && printf '    %sestá na estante%s\n' "$c_d" "$c_0" \
                   || warn "montado, mas fora da estante — \`stylus webdav ligar\` conserta"
    else
        printf '    %s·%s não está montado   %s(stylus webdav ligar)%s\n' \
               "$c_y" "$c_0" "$c_d" "$c_0"
    fi
    printf '\n'
}

na_estante() { [[ -r $LIB_CONF ]] && grep -qxF "$MONTAGEM" "$LIB_CONF"; }

# A pasta de casa, perguntada ao vinyl quando dá, e adivinhada como ele
# adivinha quando não dá. O caminho do deck é uma variável porque escrevê-lo
# fixo fazia isto devolver vazio em qualquer árvore que não fosse a
# instalada — e vazio aqui significa "não escreve a casa", que é justamente
# o defeito que esta função existe para evitar.
raiz_de_casa() {
    local deck="${STYLUS_DECK:-/usr/share/stylus/deck}" casa=""
    if [[ -d $deck ]]; then
        casa=$(PYTHONPATH="$deck" python3 -c \
               'import vinyl; print(vinyl.library_root())' 2>/dev/null || true)
    fi
    if [[ -z ${casa:-} || ! -d ${casa:-} ]]; then
        local p
        for p in "${XDG_MUSIC_DIR:-}" "$HOME/Music" "$HOME/Músicas" \
                 "$HOME/Musica" "$HOME/Musique"; do
            [[ -n $p && -d $p ]] && { casa=$p; break; }
        done
    fi
    printf '%s' "${casa:-}"
}

pôr_na_estante() {
    mkdir -p "$CONF_DIR"
    na_estante && return 0

    # A pasta de casa PRIMEIRO, quando ainda não há arquivo de estante.
    #
    # Sem isto o celular virava a única linha configurada — e a partir do
    # momento em que existe qualquer linha configurada, os palpites (~/Music,
    # ~/Músicas…) deixam de valer. Resultado: ligar o celular fazia a coleção
    # local SUMIR da estante. Escrever a de casa antes mantém a regra que o
    # resto do sistema assume: a primeira linha é a estante principal, e o
    # celular soma.
    if [[ ! -s $LIB_CONF ]]; then
        local casa
        casa=$(raiz_de_casa)
        [[ -n ${casa:-} && -d ${casa:-} && $casa != "$MONTAGEM" ]] &&
            printf '%s\n' "$casa" > "$LIB_CONF"
    fi

    printf '%s\n' "$MONTAGEM" >> "$LIB_CONF"
    ok "a estante agora inclui o celular"
}

tirar_da_estante() {
    [[ -r $LIB_CONF ]] || return 0
    # SEM `&&` depois do grep. Quando a montagem é a única linha do arquivo,
    # o grep -v não seleciona nada e SAI COM 1 — e o `&&` engolia o mv, então
    # desmontar deixava a linha lá e a estante continuava apontando para uma
    # pasta vazia. O que importa é o arquivo temporário ter sido escrito.
    grep -vxF "$MONTAGEM" "$LIB_CONF" > "$LIB_CONF.tmp" 2>/dev/null
    if [[ -f $LIB_CONF.tmp ]]; then
        mv "$LIB_CONF.tmp" "$LIB_CONF"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
ligar() {
    precisa rclone
    precisa fusermount3 fuse3
    local url=${1:-}

    if [[ -z $url ]] && ler_conf; then
        url=$URL
    fi
    if [[ -z $url ]]; then
        local ip sug=""
        ip=$(ip_do_celular || true)
        [[ -n ${ip:-} ]] && sug="http://$ip:8080/"
        printf '\n  Endereço do servidor WebDAV do celular\n'
        printf '  %s(o aplicativo no celular mostra esse endereço)%s\n' "$c_d" "$c_0"
        read -rp "  URL${sug:+ [$sug]}: " url
        url=${url:-$sug}
    fi
    [[ -n $url ]] || die "sem endereço, não há o que montar."
    [[ $url == http://* || $url == https://* ]] ||
        die "o endereço tem que começar com http:// ou https:// — veio \"$url\""

    local usuario senha
    if ler_conf && [[ $url == "$URL" ]]; then
        usuario=$USUARIO
    else
        read -rp "  Usuário (Enter se o servidor não pede): " usuario
    fi
    if [[ -n ${usuario:-} ]]; then
        read -rsp "  Senha: " senha; echo
    fi

    info "Guardando o endereço…"
    mkdir -p "$CONF_DIR"
    { printf 'URL=%q\n' "$url"; printf 'USUARIO=%q\n' "${usuario:-}"; } > "$CONF"
    # A senha NUNCA entra aqui: ela vai para a configuração do rclone, que a
    # guarda ofuscada. Este arquivo é só endereço e usuário.
    chmod 600 "$CONF"

    info "Configurando o rclone…"
    local -a cria=(rclone config create "$REMOTO" webdav
                   url="$url" vendor=other)
    [[ -n ${usuario:-} ]] && cria+=(user="$usuario")
    [[ -n ${senha:-} ]] && cria+=(pass="$(rclone obscure "$senha")")
    "${cria[@]}" >/dev/null 2>&1 || die "o rclone não aceitou essa configuração."

    montado && { info "Desmontando o de antes…"; fusermount3 -u "$MONTAGEM" 2>/dev/null; }
    mkdir -p "$MONTAGEM"

    info "Montando…"
    # --read-only: veja o cabeçalho. --vfs-cache-mode full porque o deck e o
    # mpv PROCURAM dentro da faixa, e sem cache um seek em WebDAV rebaixa o
    # arquivo inteiro de novo. --dir-cache-time curto porque música nova
    # aparece no celular a toda hora e uma estante que só atualiza de hora em
    # hora parece quebrada.
    rclone mount "$REMOTO": "$MONTAGEM" \
        --read-only \
        --vfs-cache-mode full \
        --vfs-cache-max-size 2G \
        --dir-cache-time 1m \
        --daemon \
        --daemon-timeout 30s \
        --log-file "$HOME/.local/share/stylus/webdav.log" \
        2>/dev/null || die "não deu para montar. O servidor está ligado no celular?
    O registro está em ~/.local/share/stylus/webdav.log"

    # O --daemon volta antes de o ponto de montagem existir de verdade, então
    # perguntar logo em seguida diz "não montou" sobre uma montagem que está
    # a meio segundo de existir.
    local tentativa=0
    while (( tentativa++ < 30 )) && ! montado; do sleep 0.2; done
    montado || die "o rclone subiu mas a pasta não montou. Veja ~/.local/share/stylus/webdav.log"

    ok "montado em $MONTAGEM"
    pôr_na_estante
    local n
    n=$(find "$MONTAGEM" -maxdepth 2 -mindepth 1 -type d 2>/dev/null | wc -l)
    printf '\n  %s%s pastas no celular. `stylus shelf` mostra a estante inteira.%s\n\n' \
           "$c_d" "$n" "$c_0"
}

desligar() {
    if montado; then
        fusermount3 -u "$MONTAGEM" 2>/dev/null ||
            fusermount -u "$MONTAGEM" 2>/dev/null ||
            die "não deu para desmontar. Algum programa ainda está lendo de lá?"
        ok "desmontado"
    else
        printf '  %snão estava montado%s\n' "$c_d" "$c_0"
    fi
    tirar_da_estante
    ok "a estante voltou a ser só a de casa"
}

sozinho() {
    local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$unit_dir"
    cat > "$unit_dir/stylus-webdav.service" <<UNIT
[Unit]
Description=A coleção do celular, montada por WebDAV
# Depois da rede: um celular só responde quando há wifi, e tentar antes
# disso é uma falha garantida no login.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/stylus-webdav ligar
ExecStop=/usr/local/bin/stylus-webdav desligar
# O celular pode não estar em casa. Isso não é motivo para a sessão reclamar.
SuccessExitStatus=1

[Install]
WantedBy=default.target
UNIT
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now stylus-webdav.service 2>/dev/null ||
        warn "não deu para ligar o serviço; \`systemctl --user enable --now stylus-webdav\`"
    ok "vai montar sozinho a cada login"
}

esquecer() {
    desligar >/dev/null 2>&1
    rclone config delete "$REMOTO" >/dev/null 2>&1 || true
    rm -f "$CONF"
    systemctl --user disable --now stylus-webdav.service 2>/dev/null || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/stylus-webdav.service"
    systemctl --user daemon-reload 2>/dev/null || true
    ok "esquecido: endereço, senha e o montar sozinho"
}

case ${1:-} in
    ""|status)          mostrar ;;
    ligar|mount|montar) shift; ligar "${1:-}" ;;
    desligar|umount|desmontar) desligar ;;
    sozinho|auto)       sozinho ;;
    esquecer|forget)    esquecer ;;
    -h|--help)          sed -n '4,9p' "$0" | sed 's/^# \?//' ;;
    *) die "não conheço \"$1\". \`stylus webdav --help\`" ;;
esac
