#!/usr/bin/env python3
"""stylus-ch — baixa músicas do Clone Hero direto do Chorus Encore.

Pesquisa, baixa e sincroniza charts .sng com o celular. Tudo via API,
sem abrir navegador.

    stylus-ch buscar <texto>          pesquisa no Chorus Encore
    stylus-ch baixar <chartId>        baixa o chart para a máquina
    stylus-ch sync                    envia todas as músicas baixadas pro celular
    stylus-ch list                    lista músicas já baixadas
"""
import http.client
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import time

API_HOST = "api.enchor.us"
FILES_HOST = "files.enchor.us"
CH_SONGS = os.path.expanduser("~/.local/share/Clone Hero/Songs")
PHONE_SONGS = "/sdcard/Documents/Clone Hero/Songs"
CHARTS_DB = os.path.expanduser("~/.local/share/stylus/charts.json")
SEARCH_CACHE = os.path.expanduser("~/.local/share/stylus/ch-search-cache.json")

c_b = "\033[1m"; c_dim = "\033[2m"; c_g = "\033[1;32m"
c_r = "\033[1;31m"; c_y = "\033[1;33m"; c_0 = "\033[0m"
c_acc = "\033[38;5;117m"; c_pink = "\033[38;5;218m"


def _api_post(path, body):
    ctx = ssl.create_default_context()
    conn = http.client.HTTPSConnection(API_HOST, timeout=30, context=ctx)
    data = json.dumps(body).encode()
    try:
        conn.request("POST", path, body=data, headers={
            "Content-Type": "application/json",
            "User-Agent": "stylus-ch/1.0",
        })
        resp = conn.getresponse()
        raw = resp.read()
        if resp.status not in (200, 201):
            print(f"{c_r}✗{c_0} API erro {resp.status}", file=sys.stderr)
            sys.exit(1)
        return json.loads(raw, strict=False)
    except Exception as e:
        print(f"{c_r}✗{c_0} falha na API: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        conn.close()


def _download_file(url, dest, label=""):
    ctx = ssl.create_default_context()
    parsed = url.split("/", 3)
    host = parsed[2]
    path = "/" + parsed[3] if len(parsed) > 3 else "/"
    conn = http.client.HTTPSConnection(host, timeout=120, context=ctx)
    try:
        conn.request("GET", path, headers={"User-Agent": "stylus-ch/1.0"})
        resp = conn.getresponse()
        if resp.status != 200:
            print(f"    {c_r}✗{c_0} HTTP {resp.status}")
            return False
        total = int(resp.headers.get("Content-Length", 0))
        downloaded = 0
        tmp = dest + ".part"
        with open(tmp, "wb") as f:
            while True:
                chunk = resp.read(256 * 1024)
                if not chunk:
                    break
                f.write(chunk)
                downloaded += len(chunk)
                if total and label:
                    pct = downloaded * 100 // total
                    bar = "█" * (pct // 4) + "░" * (25 - pct // 4)
                    print(f"\r    {bar} {pct:3d}%  {_fmt_size(downloaded)}/{_fmt_size(total)}",
                          end="", flush=True)
        if total and label:
            print()
        shutil.move(tmp, dest)
        return True
    except Exception as e:
        print(f"\n    {c_r}✗{c_0} {e}")
        if os.path.exists(dest + ".part"):
            os.remove(dest + ".part")
        return False
    finally:
        conn.close()


def _fmt_size(n):
    if n > 1_073_741_824:
        return f"{n / 1_073_741_824:.1f} GB"
    if n > 1_048_576:
        return f"{n / 1_048_576:.0f} MB"
    if n > 1024:
        return f"{n / 1024:.0f} KB"
    return f"{n} B"


def _load_db():
    try:
        with open(CHARTS_DB) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {"downloaded": {}, "synced": []}


def _save_db(db):
    os.makedirs(os.path.dirname(CHARTS_DB), exist_ok=True)
    with open(CHARTS_DB, "w") as f:
        json.dump(db, f, indent=2)


def _diff_label(val):
    if val < 0:
        return "-"
    dots = min(val, 6)
    return "●" * dots + "○" * (6 - dots)


def _save_search_cache(results):
    os.makedirs(os.path.dirname(SEARCH_CACHE), exist_ok=True)
    cache = {}
    try:
        with open(SEARCH_CACHE) as f:
            cache = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    for c in results:
        cache[str(c["chartId"])] = c
    with open(SEARCH_CACHE, "w") as f:
        json.dump(cache, f, indent=2)


def _load_search_cache():
    try:
        with open(SEARCH_CACHE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def cmd_buscar(args):
    if not args:
        print(f"uso: {c_b}stylus-ch buscar{c_0} <texto>", file=sys.stderr)
        sys.exit(1)
    query = " ".join(args)
    page = 1
    all_results = []

    while True:
        data = _api_post("/search", {"search": query, "page": page})
        charts = data.get("data", [])
        if not charts:
            break
        all_results.extend(charts)
        if len(all_results) >= data.get("found", 0) or page >= 5:
            break
        page += 1

    if not all_results:
        print(f"{c_dim}nenhum resultado para \"{query}\"{c_0}")
        return

    _save_search_cache(all_results)

    print(f"\n  {c_b}Chorus Encore{c_0}  {c_dim}{len(all_results)} resultados{c_0}\n")

    db = _load_db()
    downloaded_ids = set(db.get("downloaded", {}).keys())

    for i, c in enumerate(all_results[:30], 1):
        cid = str(c["chartId"])
        marker = f"{c_g}✓{c_0}" if cid in downloaded_ids else " "
        name = c.get("name", "?")
        artist = c.get("artist", "?")
        charter = c.get("charter", "?")
        pack = c.get("packName", "")

        diff_g = _diff_label(c.get("diff_guitar", -1))
        diff_b = _diff_label(c.get("diff_bass", -1))
        diff_d = _diff_label(c.get("diff_drums", -1))

        print(f"  {marker} {c_acc}{i:>2}{c_0} {c_pink}{artist}{c_0} — {name}")
        print(f"      {c_dim}id:{c_0} {cid}  "
              f"{c_dim}chart:{c_0} {charter}  "
              f"{c_dim}guitar:{c_0} {diff_g}  "
              f"{c_dim}bass:{c_0} {diff_b}  "
              f"{c_dim}drums:{c_0} {diff_d}"
              f"{'  ' + c_dim + 'pack:' + c_0 + ' ' + pack if pack else ''}")

    print(f"\n  {c_dim}baixar:  stylus-ch baixar <id>{c_0}\n")


def cmd_baixar(args):
    if not args:
        print(f"uso: {c_b}stylus-ch baixar{c_0} <chartId> [chartId ...]", file=sys.stderr)
        sys.exit(1)

    os.makedirs(CH_SONGS, exist_ok=True)
    db = _load_db()
    cache = _load_search_cache()

    for chart_id_str in args:
        chart_id = int(chart_id_str)

        if chart_id_str in db.get("downloaded", {}):
            info = db["downloaded"][chart_id_str]
            print(f"{c_y}≈{c_0} {info.get('artist','?')} — {info.get('name','?')} já baixado")
            continue

        # Look up in cache first
        chart = cache.get(chart_id_str)
        if not chart:
            # Search by ID as text query
            data = _api_post("/search", {"search": chart_id_str, "page": 1})
            for c in data.get("data", []):
                if c["chartId"] == chart_id:
                    chart = c
                    break

        if not chart:
            print(f"{c_r}✗{c_0} chart {chart_id} não encontrado. rode {c_b}stylus-ch buscar{c_0} primeiro.")
            continue

        name = chart.get("name", "Unknown")
        artist = chart.get("artist", "Unknown")
        md5 = chart.get("md5", "")

        if not md5:
            print(f"{c_r}✗{c_0} {artist} — {name}: sem arquivo disponível")
            continue

        url = f"https://{FILES_HOST}/{md5}.sng"
        folder_name = f"{artist} - {name}"
        folder_name = re.sub(r'[<>:"/\\|?*]', '-', folder_name)
        dest_dir = os.path.join(CH_SONGS, folder_name)
        dest_file = os.path.join(dest_dir, f"{name}.sng")

        if os.path.exists(dest_file):
            print(f"{c_y}≈{c_0} {artist} — {name} já existe")
            db["downloaded"][chart_id_str] = {
                "name": name, "artist": artist, "charter": chart.get("charter", ""),
                "path": dest_dir, "md5": md5,
            }
            _save_db(db)
            continue

        print(f"  {c_g}↓{c_0} {c_pink}{artist}{c_0} — {name}"
              f"  {c_dim}{chart.get('charter', '')}{c_0}")

        os.makedirs(dest_dir, exist_ok=True)
        ok = _download_file(url, dest_file, label=name)
        if ok:
            print(f"    {c_g}✓{c_0} salvo em {dest_dir}")
            db["downloaded"][chart_id_str] = {
                "name": name, "artist": artist, "charter": chart.get("charter", ""),
                "path": dest_dir, "md5": md5,
            }
            _save_db(db)

        time.sleep(0.3)


def cmd_sync(args):
    """Envia todas as músicas baixadas pro celular via adb."""
    db = _load_db()
    downloaded = db.get("downloaded", {})
    if not downloaded:
        print(f"{c_dim}nenhuma música baixada ainda. use: stylus-ch buscar + baixar{c_0}")
        return

    try:
        subprocess.run(["adb", "get-state"], capture_output=True, timeout=5)
    except Exception:
        print(f"{c_r}✗{c_0} celular não detectado. plugue e autorize o adb.")
        return

    subprocess.run(["adb", "shell", f"mkdir -p \"{PHONE_SONGS}\""],
                   capture_output=True, timeout=10)

    synced = 0
    skipped = 0
    for cid, info in downloaded.items():
        local_path = info.get("path", "")
        if not local_path or not os.path.isdir(local_path):
            continue

        folder_name = os.path.basename(local_path)

        check = subprocess.run(
            ["adb", "shell", f'ls "{PHONE_SONGS}/{folder_name}" 2>/dev/null'],
            capture_output=True, text=True, timeout=10,
        )
        if check.returncode == 0 and check.stdout.strip():
            skipped += 1
            continue

        print(f"  {c_g}→{c_0} {info.get('artist','?')} — {info.get('name','?')}")
        result = subprocess.run(
            ["adb", "push", local_path, f"{PHONE_SONGS}/"],
            capture_output=True, text=True, timeout=300,
        )
        if result.returncode == 0:
            synced += 1
            db.setdefault("synced", []).append(cid)
        else:
            print(f"    {c_r}✗{c_0} {result.stderr.strip()}")

    _save_db(db)
    print(f"\n  {c_g}✓{c_0} {synced} enviadas · {c_dim}{skipped} já no celular{c_0}\n")


def cmd_list(args):
    """Lista músicas já baixadas na máquina."""
    db = _load_db()
    downloaded = db.get("downloaded", {})

    if not downloaded:
        print(f"{c_dim}nenhuma música baixada ainda{c_0}")
        return

    print(f"\n  {c_b}Músicas baixadas{c_0}  {c_dim}{len(downloaded)} charts{c_0}\n")

    by_artist = {}
    for cid, info in downloaded.items():
        artist = info.get("artist", "Unknown")
        by_artist.setdefault(artist, []).append((cid, info))

    synced_set = set(db.get("synced", []))
    for artist in sorted(by_artist.keys()):
        songs = by_artist[artist]
        print(f"  {c_pink}{artist}{c_0}")
        for cid, s in songs:
            sync_mark = f"  {c_g}→ celular{c_0}" if cid in synced_set else ""
            print(f"    — {s.get('name', '?')}{sync_mark}")
    print()


def main():
    if len(sys.argv) < 2:
        print(f"""
  {c_b}stylus-ch{c_0} — Clone Hero songs

  {c_b}buscar{c_0} <texto>       pesquisa no Chorus Encore
  {c_b}baixar{c_0} <id> [...]    baixa charts .sng
  {c_b}list{c_0}                 lista baixados
  {c_b}sync{c_0}                 envia pro celular
""")
        return

    cmd = sys.argv[1]
    rest = sys.argv[2:]

    commands = {
        "buscar": cmd_buscar,
        "search": cmd_buscar,
        "baixar": cmd_baixar,
        "download": cmd_baixar,
        "sync": cmd_sync,
        "list": cmd_list,
        "ls": cmd_list,
    }

    if cmd in commands:
        commands[cmd](rest)
    else:
        print(f"{c_r}✗{c_0} não conheço \"{cmd}\". comandos: buscar, baixar, sync, list",
              file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
