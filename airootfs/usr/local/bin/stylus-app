#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-app — instala o que não vem em pacote
# ═══════════════════════════════════════════════════════════════════════════
#  Nem tudo que uma máquina de música e jogos precisa está nos repositórios
#  do Arch, e empacotar tudo à mão seria um trabalho que não acaba. Isto é a
#  lista curta do que importa aqui, com a receita de cada um.
#
#      stylus app                lista o que dá para instalar
#      stylus app clonehero      instala
#      stylus app --all          tudo
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail
c_g=$'\033[1;32m'; c_d=$'\033[2m'; c_b=$'\033[1;34m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_g" "$c_0" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

OPT=/opt/stylus
# Havia um `BIN=$HOME/.local/bin; mkdir -p "$BIN"` aqui, e nada no arquivo
# usava o $BIN. Depois do `sudo -E` deste script o $HOME continua sendo o da
# pessoa e o processo é root: numa casa onde ~/.local/bin ainda não existisse,
# a linha o CRIAVA COMO ROOT — e a partir daí todo `pip install --user` e
# todo instalador que escreve ali passa a falhar por permissão, sem ninguém
# ligar uma coisa à outra.

# Os argumentos com que ESTE script foi chamado, guardados antes de qualquer
# função existir.
#
# **Sintoma:** `stylus app yay` imprimia o menu e não instalava nada. Idem
# clonehero e heroic — ou seja, todo aplicativo que precisa de root, que são
# quase todos.
#
# O `precisa_root` era chamado de DENTRO de `app_yay`, como `precisa_root
# "$@"`. Ali `$@` são os argumentos da FUNÇÃO, e o despachante lá embaixo
# chama `"app_$a"` sem argumento nenhum. Então o `exec sudo -E "$0" "$@"`
# relançava o stylus-app com a linha de comando VAZIA — e sem argumento o
# stylus-app faz exatamente uma coisa: imprime a lista e sai com zero. Nada
# falhava, nada avisava, e o comando parecia simplesmente não fazer nada.
ARGV_ORIGINAL=("$@")

precisa_root() {
    [[ $EUID -eq 0 ]] && return 0
    exec sudo -E "$0" "${ARGV_ORIGINAL[@]}"
}

app_clonehero() {
    # O Clone Hero é distribuído como um zip do site oficial, sem pacote e
    # sem URL estável de versão — por isso o link fixo "latest". É o jogo que
    # justifica metade da pasta de charts do celular.
    precisa_root
    local url="https://clonehero.net/assets/release/clonehero-linux.zip"
    local dest=$OPT/clonehero
    info "Baixando Clone Hero…"
    mkdir -p "$dest"
    local tmp; tmp=$(mktemp -d)
    curl -fL --progress-bar "$url" -o "$tmp/ch.zip" || die "não deu para baixar"
    bsdtar -xf "$tmp/ch.zip" -C "$dest" --strip-components=1 || \
        bsdtar -xf "$tmp/ch.zip" -C "$dest" || die "o zip veio estranho"
    rm -rf "$tmp"
    chmod +x "$dest"/*.x86_64 "$dest"/Clone*Hero 2>/dev/null || true
    local exe; exe=$(find "$dest" -maxdepth 1 -type f \
        \( -name '*.x86_64' -o -name 'Clone*Hero' \) | head -1)
    [[ -n $exe ]] || die "não achei o executável dentro do zip"
    printf '#!/bin/sh\nexec %q "$@"\n' "$exe" > /usr/local/bin/clonehero
    chmod 0755 /usr/local/bin/clonehero
    cat > /usr/share/applications/clonehero.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Clone Hero
Exec=clonehero
Icon=applications-games
Categories=Game;
EOF
    ok "Clone Hero em $dest"
}

app_qobuzdl() {
    # Isto fazia `pip install --user --break-system-packages`, que é o jeito
    # que o resto do sistema abandonou de propósito: o pacote vai para
    # ~/.local/lib/python3.13 e SOME inteiro na atualização do python para
    # 3.14, e o executável cai em ~/.local/bin, que pode nem estar no PATH.
    # Funciona no dia e quebra depois, sem aviso. Quem faz certo é o
    # `stylus qobuz instalar`, num venv da pessoa (ver venv.sh) — então é
    # para lá que este vai, em vez de manter duas receitas para o mesmo
    # programa, uma delas errada.
    [[ $EUID -eq 0 ]] && die \
        "não instale o qobuz-dl como root: ele iria para a casa do root.
       Rode sem sudo:  stylus app qobuzdl"
    info "Instalando o qobuz-dl…"
    stylus-qobuz instalar || die "não deu para instalar o qobuz-dl"
    ok "qobuz-dl — entre na sua conta com:  stylus qobuz abrir"
}

app_heroic() {
    precisa_root
    info "Heroic vem do AUR; instalando com o yay…"
    command -v yay >/dev/null || die "instale o yay primeiro: stylus app yay"
    sudo -u "${SUDO_USER:-$USER}" yay -S --needed --noconfirm heroic-games-launcher-bin
}

app_yay() {
    precisa_root
    command -v yay >/dev/null && { ok "o yay já está aqui"; return; }
    info "Compilando o yay…"
    pacman -S --needed --noconfirm git base-devel
    local tmp; tmp=$(mktemp -d); chown "${SUDO_USER:-$USER}" "$tmp"
    sudo -u "${SUDO_USER:-$USER}" git clone -q https://aur.archlinux.org/yay-bin.git "$tmp/yay"
    (cd "$tmp/yay" && sudo -u "${SUDO_USER:-$USER}" makepkg -si --noconfirm)
    rm -rf "$tmp"; ok "yay"
}

app_protonge() {
    info "Proton-GE mais recente…"
    local dir="$HOME/.steam/root/compatibilitytools.d"
    [[ -n ${SUDO_USER:-} ]] && dir="$(getent passwd "$SUDO_USER" | cut -d: -f6)/.steam/root/compatibilitytools.d"
    mkdir -p "$dir"
    local url; url=$(curl -fsSL https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest \
        | grep -o 'https://[^"]*\.tar\.gz' | head -1)
    [[ -n $url ]] || die "não achei o lançamento"
    curl -fL --progress-bar "$url" | bsdtar -xf - -C "$dir" || die "falhou"
    ok "Proton-GE em $dir — reinicie o Steam"
}

APPS="clonehero qobuzdl heroic yay protonge"

if [[ $# -eq 0 ]]; then
    echo
    echo "  ${c_d}o que dá para instalar daqui:${c_0}"
    for a in $APPS; do printf '    %s\n' "$a"; done
    echo
    echo "  ${c_d}stylus app clonehero${c_0}"
    echo
    exit 0
fi
if [[ ${1:-} == --all ]]; then
    for a in $APPS; do "app_$a" || true; done
    exit 0
fi
for a in "$@"; do
    case " $APPS " in
        *" $a "*) "app_$a" ;;
        *) die "não conheço \"$a\". \`stylus app\` lista." ;;
    esac
done
