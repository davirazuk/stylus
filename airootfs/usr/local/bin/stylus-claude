#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-claude — o Claude Code aqui dentro, olhando a máquina de verdade
# ═══════════════════════════════════════════════════════════════════════════
#  Tudo que este sistema é foi escrito numa sessão remota, num contêiner sem
#  placa de som, sem disco e sem tela: dava para LER o código e não dava para
#  ver nada acontecer. Foi assim que o instalador chegou a formatar o disco e
#  só então descobrir que faltava multilib, e foi assim que o deck passou
#  semanas abrindo em preto porque faltava um pacote que nenhuma máquina sem
#  pacman tinha como notar.
#
#  Isto encerra esse problema. A partir daqui a conversa acontece NA máquina,
#  com o áudio tocando do lado e o `journalctl` a um comando de distância.
#
#      stylus claude              abre o Claude Code na fonte do sistema
#      stylus claude --setup      só instala/atualiza e sai
#      stylus claude --fonte      onde está o clone, e o quanto ele atrasou
#      stylus claude -- ARGS      o resto vai para o `claude` sem eu olhar
#
#  Duas coisas ele monta antes de abrir, porque sem elas a sessão começa
#  cega:
#
#    ~/stylus              a FONTE do sistema, um clone de git seu para
#                          editar. É o que se conserta; a máquina é gerada
#                          dele.
#    ~/.claude/CLAUDE.md   as instruções desta máquina — a divisão entre
#                          fonte e sistema, o que é seguro olhar, o que não
#                          se faz. Sem isso o Claude edita /usr à mão e o
#                          conserto some no próximo update, em silêncio.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

SHARE=/usr/share/stylus
MODELOS=$SHARE/claude              # o que a ISO traz
FONTE="${STYLUS_SRC:-$HOME/stylus}"
REPO="${STYLUS_REPO:-https://github.com/davirazuk/stylus.git}"
BRANCH="${STYLUS_BRANCH:-main}"
DEST=$HOME/.claude
# A cópia do que instalamos da última vez. É ela que diz se o arquivo lá foi
# mexido pelo usuário ou está como o deixamos — a mesma regra do pacman.
SELO=$HOME/.local/share/stylus/claude-instalado

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'
c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

[[ $EUID -eq 0 && -z ${STYLUS_CLAUDE_ROOT:-} ]] && die \
    "não rode isto com sudo: ele instalaria na casa do root e as instruções
       e o clone ficariam onde você não os vê. Rode como você mesmo."

# ── onde está o claude ─────────────────────────────────────────────────────
# Não use `command -v claude` sozinho: numa máquina onde o PATH ainda não
# pegou o ~/.local/bin (a primeira sessão depois de instalar) ele responde
# "não existe" logo depois de instalarmos, e o comando parece ter falhado.
achar_claude() {
    local c
    for c in "$HOME/.local/bin/claude" /usr/local/bin/claude /usr/bin/claude; do
        [[ -x $c ]] && { printf '%s\n' "$c"; return 0; }
    done
    c=$(command -v claude 2>/dev/null) && [[ -n $c ]] && { printf '%s\n' "$c"; return 0; }
    return 1
}

instalar_claude() {
    local tmp rc=1
    info "Baixando o Claude Code…"
    tmp=$(mktemp) || die "sem /tmp"
    # Baixa e SÓ ENTÃO roda. `curl | bash` executa o que chegou pela metade
    # quando a rede cai no meio — e o que chegou pela metade de um instalador
    # é meio instalador.
    if curl -fsSL --max-time 120 https://claude.ai/install.sh -o "$tmp" \
       && [[ -s $tmp && $(head -c 2 "$tmp") == '#!' ]]; then
        bash "$tmp"; rc=$?
    else
        warn "o instalador oficial não veio inteiro"
    fi
    rm -f "$tmp"

    if (( rc != 0 )) || ! achar_claude >/dev/null; then
        # Segunda via. --prefix mantém tudo dentro da casa: um `npm -g` sem
        # prefixo quer /usr/lib, que é do pacman, e as duas coisas brigam.
        if command -v npm >/dev/null; then
            warn "tentando pelo npm…"
            npm install -g --prefix "$HOME/.local" @anthropic-ai/claude-code || true
        fi
    fi

    achar_claude >/dev/null || die \
        "não consegui instalar. Com rede, tente à mão:
         curl -fsSL https://claude.ai/install.sh | bash
       ou, se preferir pelo npm:
         sudo pacman -S --needed npm
         npm install -g --prefix ~/.local @anthropic-ai/claude-code"
    ok "claude em $(achar_claude)"
}

atualizar_claude() {
    local claude; claude=$(achar_claude) || return 1
    info "Procurando versão nova do Claude Code…"
    "$claude" update 2>/dev/null || instalar_claude
}

# ── a fonte do sistema, do lado ────────────────────────────────────────────
montar_fonte() {
    if [[ -d $FONTE/.git ]]; then
        # Não puxa sozinho. Se houver trabalho não commitado ali, um `pull`
        # no meio de uma sessão é a maneira mais rápida de perdê-lo.
        local atras
        git -C "$FONTE" fetch --quiet origin "$BRANCH" 2>/dev/null || true
        atras=$(git -C "$FONTE" rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null || echo 0)
        if [[ ${atras:-0} -gt 0 ]]; then
            warn "a fonte em $FONTE está $atras commit(s) atrás do $BRANCH"
            printf '      %sgit -C %s pull --rebase%s\n' "$c_d" "$FONTE" "$c_0"
        else
            ok "a fonte está em dia ($FONTE)"
        fi
        return 0
    fi
    [[ -e $FONTE ]] && die "$FONTE existe e não é um clone de git"
    command -v git >/dev/null || die "falta o git: sudo pacman -S git"
    info "Clonando a fonte do sistema em $FONTE…"
    git clone --quiet "$REPO" "$FONTE" || die "não deu para clonar. sem rede?"
    ok "a fonte do STYLUS está em $FONTE"
}

# ── as instruções ──────────────────────────────────────────────────────────
#  A regra do pacman, de novo: igual ao que deixamos da última vez, atualiza;
#  mexido pelo usuário, MANTÉM e põe o novo ao lado como .novo. Escrever por
#  cima de um CLAUDE.md que a pessoa escreveu apaga o trabalho dela sem
#  perguntar, e é o tipo de coisa que só se descobre depois.
novos=()
por_arquivo() {
    local src=$1 dst=$2 selo=$3
    mkdir -p "$(dirname "$dst")" "$(dirname "$selo")"
    if [[ ! -e $dst ]]; then
        cp "$src" "$dst"
    elif cmp -s "$src" "$dst"; then
        :                                   # já é este
    elif [[ -f $selo ]] && cmp -s "$selo" "$dst"; then
        cp "$src" "$dst"                    # intocado desde a última vez
    else
        cmp -s "$src" "$dst.novo" || cp "$src" "$dst.novo"
        novos+=("$dst")
        cp "$src" "$selo"; return 0
    fi
    cp "$src" "$selo"
}

instrucoes() {
    [[ -d $MODELOS ]] || { warn "$MODELOS não existe nesta máquina"; return 0; }
    novos=()
    por_arquivo "$MODELOS/CLAUDE.md" "$DEST/CLAUDE.md" "$SELO/CLAUDE.md"
    local f
    for f in "$MODELOS"/commands/*.md; do
        [[ -e $f ]] || continue
        por_arquivo "$f" "$DEST/commands/$(basename "$f")" "$SELO/commands/$(basename "$f")"
    done
    if (( ${#novos[@]} )); then
        warn "você mexeu nestes; guardei o novo ao lado como .novo:"
        printf '      %s\n' "${novos[@]}"
    else
        ok "as instruções desta máquina estão em $DEST/CLAUDE.md"
    fi
}

# ── esta máquina é um STYLUS? ──────────────────────────────────────────────
#  As instruções dizem "você está dentro de um STYLUS" e descrevem caminhos
#  que só existem aqui. Instalá-las em outra máquina faria o Claude trabalhar
#  a partir de um mapa de outro lugar, o que é pior do que não ter mapa.
e_stylus() { grep -qx 'ID=stylus' /etc/os-release 2>/dev/null; }

SETUP=0; SO_FONTE=0; FORCE=0
args=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --setup|--instalar) SETUP=1; shift ;;
        --update)           SETUP=1; ATUALIZAR=1; shift ;;
        --fonte|--src)      SO_FONTE=1; shift ;;
        --force)            FORCE=1; shift ;;
        -h|--help)          sed -n '15,29p' "$0" | sed 's/^# \?//'; exit 0 ;;
        --)                 shift; args+=("$@"); break ;;
        *)                  args+=("$1"); shift ;;
    esac
done

e_stylus || (( FORCE )) || die \
    "isto aqui não é um STYLUS (/etc/os-release não diz ID=stylus).
       As instruções que eu instalo descrevem ESTA distribuição e seriam um
       mapa errado em qualquer outra. --force se você sabe o que está fazendo."

if (( SO_FONTE )); then montar_fonte; printf '%s\n' "$FONTE"; exit 0; fi

echo
if achar_claude >/dev/null; then
    ok "claude em $(achar_claude)"
    [[ -n ${ATUALIZAR:-} ]] && atualizar_claude
else
    instalar_claude
fi
montar_fonte
instrucoes
echo

if (( SETUP )); then
    printf '  %sabra com:%s stylus claude\n\n' "$c_d" "$c_0"
    exit 0
fi

# A sessão começa DENTRO da fonte, não na casa. É lá que estão o CLAUDE.md do
# repositório, o check.sh e o código — abrir em ~ faria a primeira coisa de
# toda sessão ser procurar onde o sistema mora.
cd "$FONTE" || die "não consegui entrar em $FONTE"
exec "$(achar_claude)" "${args[@]}"
