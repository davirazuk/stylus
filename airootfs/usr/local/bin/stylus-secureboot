#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  stylus-secureboot — bootar com o Secure Boot LIGADO, sem entrar na BIOS
#
#      stylus-secureboot            o estado desta máquina, explicado
#      stylus-secureboot --check    sai 0 se esta máquina já boota assim
#      stylus-secureboot --prepare  monta a cadeia assinada (precisa de root)
#
#  O problema, que é o dos computadores da escola: o Secure Boot está ligado e
#  ninguém tem a senha da BIOS para desligar. O firmware só executa um
#  carregador de boot assinado por uma chave que ele já conhece, e o do STYLUS não
#  é. A máquina simplesmente não inicia o STYLUS, sem explicação nenhuma.
#
#  A saída existe e não passa pela BIOS. Chama-se shim: um carregador
#  minúsculo assinado pela Microsoft, cuja chave todo firmware de PC já traz de
#  fábrica. O firmware aceita o shim; o shim carrega o GRUB. Se o GRUB estiver
#  assinado por uma chave que o shim não conhece, ele abre o MokManager - uma
#  tela azul, antes de qualquer sistema operacional - onde a pessoa matricula a
#  chave, com uma senha que ela mesma acabou de escolher. Da segunda vez em
#  diante tudo inicia normalmente, com o Secure Boot ligado o tempo todo.
#
#  A cadeia fica assim:
#
#      firmware ──(chave da Microsoft)──▶ shim
#                                          │
#                                          ├─(chave do STYLUS, matriculada)─▶ GRUB
#                                          │                                 │
#                                          └─ MokManager (só na 1ª vez)      ▼
#                                                                         kernel
#
#  A chave é gerada nesta máquina e a parte privada nunca sai dela: cada
#  computador tem a sua. Não existe uma "chave do STYLUS" espalhada por aí, e
#  perder um computador não compromete os outros.
#
#  ── O que isto NÃO faz ─────────────────────────────────────────────────────
#
#  Não faz o pendrive de instalação bootar com o Secure Boot ligado. Para
#  instalar, o Secure Boot precisa ser desligado uma vez. Isto é para depois:
#  instalado o sistema, monta-se a cadeia assinada e o Secure Boot pode voltar a
#  ficar ligado para sempre.
#
#  ── Segurança de não deixar ninguém sem máquina ────────────────────────────
#
#  Nada aqui remove ou substitui o que já existe. O shim entra ao lado do GRUB,
#  numa entrada de boot nova, e a entrada antiga continua lá. Isso importa
#  menos do que parece, porque com o Secure Boot ligado a entrada antiga não
#  inicia de qualquer jeito - o que significa que este comando não tem como
#  piorar a situação de ninguém. Ou passa a bootar, ou fica como estava.
#
#  E antes de mexer na ordem de boot, cada arquivo assinado é conferido com
#  sbverify contra a própria chave. Assinatura que não confere, nada é trocado.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_dim=$'\033[2m'; c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'; c_blu=$'\033[1;34m'

# Como em toda ferramenta do STYLUS: tudo é lido debaixo deste prefixo, para que
# o teste possa montar uma máquina de mentira. Vazio é a máquina de verdade.
SYSROOT=${STYLUS_SB_SYSROOT:-}

ESP=${STYLUS_SB_ESP:-/boot/efi}
KEYDIR=$SYSROOT/etc/stylus/secureboot
EFI_DIR=$SYSROOT$ESP/EFI/STYLUS

# Onde o pacote shim-signed deixa as duas peças. Conferido em disco, nunca
# assumido: se não estiver lá, o comando diz o nome do pacote e para.
SHIM_SRC=$SYSROOT/usr/share/shim-signed/shimx64.efi
MM_SRC=$SYSROOT/usr/share/shim-signed/mmx64.efi

# ── Ler o estado ─────────────────────────────────────────────────────────────

is_uefi() { [[ -d $SYSROOT/sys/firmware/efi ]]; }

# A variável EFI tem 5 bytes: 4 de atributos e 1 de valor. O último é 1 quando
# o Secure Boot está ligado. Lida direto do efivarfs para não depender de
# nenhum pacote estar instalado - esta ferramenta precisa funcionar antes de
# qualquer instalação.
SB_GUID=8be4df61-93ca-11d2-aa0d-00e098032b8c
efivar_last_byte() {   # efivar_last_byte <nome>
    local f=$SYSROOT/sys/firmware/efi/efivars/$1-$SB_GUID
    [[ -r $f ]] || return 1
    od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' \n'
}

secureboot_on()  { [[ $(efivar_last_byte SecureBoot 2>/dev/null) == 1 ]]; }
setup_mode_on()  { [[ $(efivar_last_byte SetupMode  2>/dev/null) == 1 ]]; }

# Se esta máquina já foi preparada. Os três de uma vez, porque qualquer um
# sozinho é uma preparação pela metade.
chain_ready() {
    [[ -f $EFI_DIR/shimx64.efi && -f $EFI_DIR/mmx64.efi && -f $KEYDIR/MOK.crt ]]
}

# Se a chave desta máquina já foi matriculada. mokutil é quem sabe; sem ele a
# resposta é "não dá para saber", que não é o mesmo que "não".
key_enrolled() {
    command -v mokutil >/dev/null 2>&1 || return 2
    [[ -f $KEYDIR/MOK.der ]] || return 1
    mokutil --test-key "$KEYDIR/MOK.der" 2>/dev/null | grep -q 'is already enrolled'
}

missing_tools() {
    local t out=()
    for t in openssl sbsign sbverify mokutil efibootmgr; do
        command -v "$t" >/dev/null 2>&1 || out+=("$t")
    done
    printf '%s\n' "${out[@]:-}"
}

# ── O veredito, em uma frase ─────────────────────────────────────────────────
#
#  Quatro situações, e o que fazer em cada uma. Função pura das quatro
#  respostas para que o teste possa percorrer as combinações sem firmware
#  nenhum por perto - que é a única forma de verificar isto daqui.
verdict() {   # verdict <uefi:0|1> <sb_on:0|1> <chain:0|1> <enrolled:0|1|2>
    local uefi=$1 sb=$2 chain=$3 enrolled=$4

    if (( ! uefi )); then
        printf 'legacy|Este computador inicia pelo modo antigo (BIOS), onde não existe Secure Boot. Não há nada a fazer aqui.'
        return
    fi
    if (( chain && sb )); then
        if (( enrolled == 1 )); then
            printf 'pronto|Esta máquina inicia com o Secure Boot ligado, pela cadeia assinada do STYLUS. Não precisa mexer em nada.'
        else
            printf 'matricular|A cadeia assinada está montada, mas a chave ainda não foi matriculada. Reinicie: vai aparecer uma tela azul (MokManager) pedindo para matricular a chave. Escolha "Enroll MOK", confirme, e digite a senha que você escolheu.'
        fi
        return
    fi
    if (( chain )); then
        printf 'pronto-sb-desligado|A cadeia assinada está montada e o Secure Boot está desligado. Pode ligar o Secure Boot na BIOS quando quiser — esta máquina já sabe iniciar com ele ligado.'
        return
    fi
    if (( sb )); then
        # Só se chega aqui bootando por outro caminho; vale dizer o que é.
        printf 'preparar|O Secure Boot está ligado e esta máquina ainda não tem a cadeia assinada do STYLUS. Rode: sudo stylus-secureboot --prepare'
        return
    fi
    printf 'preparar|O Secure Boot está desligado. Se ele for ligado na BIOS, esta máquina para de iniciar. Para poder ligá-lo: sudo stylus-secureboot --prepare'
}

current_verdict() {
    local uefi=0 sb=0 chain=0 enrolled
    is_uefi        && uefi=1
    secureboot_on  && sb=1
    chain_ready    && chain=1
    key_enrolled; enrolled=$?
    verdict "$uefi" "$sb" "$chain" "$enrolled"
}

# ── Relatório ────────────────────────────────────────────────────────────────

show() {
    local v tag msg
    v=$(current_verdict); tag=${v%%|*}; msg=${v#*|}

    printf '\n  %sIFOS — Secure Boot%s\n\n' "$c_b" "$c_reset"

    if is_uefi; then
        printf '    Firmware ........... UEFI\n'
        if secureboot_on; then
            printf '    Secure Boot ........ %sligado%s\n' "$c_grn" "$c_reset"
        else
            printf '    Secure Boot ........ %sdesligado%s\n' "$c_yel" "$c_reset"
        fi
        setup_mode_on && printf '    Modo de configuração %sativo%s (o firmware aceita chaves novas)\n' \
                                "$c_yel" "$c_reset"
    else
        printf '    Firmware ........... BIOS (sem Secure Boot)\n'
    fi

    if chain_ready; then
        printf '    Cadeia do STYLUS ..... %smontada%s\n' "$c_grn" "$c_reset"
        key_enrolled
        case $? in
            0) printf '    Chave .............. %smatriculada%s\n' "$c_grn" "$c_reset" ;;
            1) printf '    Chave .............. %sainda não matriculada%s\n' "$c_yel" "$c_reset" ;;
            *) printf '    Chave .............. %snão dá para conferir (falta o mokutil)%s\n' "$c_dim" "$c_reset" ;;
        esac
    else
        printf '    Cadeia do STYLUS ..... %snão montada%s\n' "$c_dim" "$c_reset"
    fi

    printf '\n'
    case $tag in
        pronto|pronto-sb-desligado|legacy)
            printf '  %s✓%s %s\n\n' "$c_grn" "$c_reset" "$msg" ;;
        matricular)
            printf '  %s!%s %s\n\n' "$c_yel" "$c_reset" "$msg" ;;
        *)
            printf '  %s%s%s\n\n' "$c_b" "$msg" "$c_reset" ;;
    esac
}

# ── Preparar ─────────────────────────────────────────────────────────────────

step() { printf '  %s==>%s %s\n' "$c_blu" "$c_reset" "$*"; }
bad()  { printf '\n  %s✗%s %s\n\n' "$c_red" "$c_reset" "$*"; }

prepare() {
    [[ $EUID -eq 0 ]] || { bad "Precisa de root:  sudo stylus-secureboot --prepare"; return 1; }
    is_uefi || { bad "Este computador inicia pelo modo antigo (BIOS). Secure Boot não existe aqui."; return 1; }

    local -a lacking
    mapfile -t lacking < <(missing_tools)
    if [[ -n ${lacking[0]:-} ]]; then
        bad "Faltam ferramentas: ${lacking[*]}

Instale com:  sudo pacman -S --needed sbsigntools mokutil efibootmgr openssl"
        return 1
    fi

    # O shim assinado pela Microsoft não pode ser produzido aqui, nem baixado
    # de qualquer lugar: é o pacote shim-signed que o traz. Conferido em disco
    # e não pelo nome do pacote, para que a mensagem seja verdadeira mesmo que
    # o pacote mude de nome.
    if [[ ! -f $SHIM_SRC || ! -f $MM_SRC ]]; then
        bad "O shim não está instalado.

O shim é o carregador assinado pela Microsoft, e é a peça que faz o firmware
aceitar iniciar o STYLUS. Ele não vem nos repositórios oficiais do Arch; está no
AUR, como shim-signed:

    yay -S shim-signed

Depois rode este comando de novo."
        return 1
    fi

    local esp_real=$SYSROOT$ESP
    [[ -d $esp_real/EFI ]] || { bad "Não encontrei a partição EFI em $ESP."; return 1; }

    # ── A chave desta máquina ────────────────────────────────────────────────
    # Gerada aqui, e a parte privada nunca sai daqui. Cada computador tem a
    # sua: não existe uma chave do STYLUS circulando, e um computador perdido não
    # compromete nenhum outro.
    if [[ ! -f $KEYDIR/MOK.key ]]; then
        step "Gerando a chave desta máquina…"
        install -d -m 700 "$KEYDIR"
        openssl req -newkey rsa:2048 -nodes -keyout "$KEYDIR/MOK.key" \
                -new -x509 -sha256 -days 3650 \
                -subj "/CN=STYLUS Secure Boot ($(cat "$SYSROOT/etc/hostname" 2>/dev/null || echo stylus))/" \
                -out "$KEYDIR/MOK.crt" 2>/dev/null \
            || { bad "Não foi possível gerar a chave."; return 1; }
        openssl x509 -outform DER -in "$KEYDIR/MOK.crt" -out "$KEYDIR/MOK.der" 2>/dev/null \
            || { bad "Não foi possível converter a chave."; return 1; }
        chmod 600 "$KEYDIR/MOK.key"
    else
        step "Usando a chave que já existe em $KEYDIR"
    fi

    # ── O shim, ao lado do GRUB ──────────────────────────────────────────────
    # Na mesma pasta, porque é lá que o shim procura o grubx64.efi.
    install -d "$EFI_DIR"
    [[ -f $EFI_DIR/grubx64.efi ]] || {
        bad "Não encontrei o GRUB em $EFI_DIR/grubx64.efi.

Rode antes:  sudo grub-install --target=x86_64-efi --efi-directory=$ESP --bootloader-id=STYLUS"
        return 1
    }
    step "Colocando o shim ao lado do GRUB…"
    install -m 644 "$SHIM_SRC" "$EFI_DIR/shimx64.efi" || { bad "Falha ao copiar o shim."; return 1; }
    install -m 644 "$MM_SRC"   "$EFI_DIR/mmx64.efi"   || { bad "Falha ao copiar o MokManager."; return 1; }

    sign_everything || return 1

    # ── A entrada de boot ────────────────────────────────────────────────────
    # Acrescentada, nunca substituindo. A entrada antiga continua existindo -
    # o que importa pouco com o Secure Boot ligado, já que ela não inicia
    # assim mesmo, e é exatamente por isso que este comando não tem como
    # piorar a situação de ninguém.
    step "Criando a entrada de boot do shim…"
    local esp_dev disk part
    esp_dev=$(findmnt -no SOURCE "$ESP" 2>/dev/null)
    disk=$(lsblk -npo PKNAME "$esp_dev" 2>/dev/null | head -1)
    part=$(printf '%s' "$esp_dev" | grep -o '[0-9]*$')
    if [[ -n $disk && -n $part ]]; then
        efibootmgr --create --disk "$disk" --part "$part" \
                   --label "STYLUS (Secure Boot)" \
                   --loader '\EFI\STYLUS\shimx64.efi' >/dev/null 2>&1 \
            || printf '    %s!%s Não deu para criar a entrada; o firmware ainda pode achar o shim sozinho.\n' \
                      "$c_yel" "$c_reset"
    else
        printf '    %s!%s Não identifiquei o disco da partição EFI; pulei a entrada de boot.\n' \
               "$c_yel" "$c_reset"
    fi

    install_hook

    # ── E a matrícula ────────────────────────────────────────────────────────
    # A senha é pedida aqui e digitada de novo na tela azul do próximo boot.
    # É de uso único e não é a senha de ninguém: serve só para provar, na tela
    # azul, que quem está matriculando a chave é quem rodou este comando.
    step "Pedindo a matrícula da chave…"
    printf '\n'
    printf '  O firmware vai pedir esta senha na tela azul do próximo boot.\n'
    printf '  Ela é de uso único. Escolha algo simples e %sanote%s.\n\n' "$c_b" "$c_reset"
    if ! mokutil --import "$KEYDIR/MOK.der"; then
        bad "A matrícula não foi registrada. Rode:  sudo mokutil --import $KEYDIR/MOK.der"
        return 1
    fi

    printf '\n  %sPronto.%s\n\n' "$c_b" "$c_reset"
    cat <<'FIM'
  No próximo boot vai aparecer uma tela azul chamada MokManager:

    1. Escolha "Enroll MOK"
    2. "Continue", e depois "Yes"
    3. Digite a senha que você acabou de escolher
    4. "Reboot"

  Depois disso o Secure Boot pode ficar ligado para sempre nesta máquina.
  Se a tela azul não aparecer, escolha "STYLUS (Secure Boot)" no menu de boot
  do firmware.

FIM
}

# Assinar o GRUB e os kernels, e conferir cada assinatura antes de dizer que
# deu certo. Uma assinatura que não confere é a diferença entre uma máquina que
# inicia e uma que não - não é coisa para presumir.
#
# O kernel é assinado porque o GRUB, quando construído com o verificador
# shim_lock, se recusa a iniciar um kernel sem assinatura com o Secure Boot
# ligado. Nem toda instalação do GRUB tem esse módulo, e daqui não dá para
# saber qual é o caso - assinar de qualquer jeito não custa nada e cobre os dois.
sign_everything() {
    local f rc=0 signed=0
    step "Assinando o GRUB e os kernels…"
    for f in "$EFI_DIR/grubx64.efi" \
             "$SYSROOT/boot/vmlinuz-linux" "$SYSROOT/boot/vmlinuz-linux-lts"; do
        [[ -f $f ]] || continue
        # Já assinado por esta chave? Assinar de novo empilharia assinaturas.
        if sbverify --cert "$KEYDIR/MOK.crt" "$f" >/dev/null 2>&1; then
            printf '    %s·%s %s já estava assinado\n' "$c_dim" "$c_reset" "${f##*/}"
            signed=$((signed + 1))
            continue
        fi
        if sbsign --key "$KEYDIR/MOK.key" --cert "$KEYDIR/MOK.crt" \
                  --output "$f" "$f" >/dev/null 2>&1 &&
           sbverify --cert "$KEYDIR/MOK.crt" "$f" >/dev/null 2>&1; then
            printf '    %s✓%s %s\n' "$c_grn" "$c_reset" "${f##*/}"
            signed=$((signed + 1))
        else
            printf '    %s✗%s %s — a assinatura não confere\n' "$c_red" "$c_reset" "${f##*/}"
            rc=1
        fi
    done
    (( signed )) || { bad "Nada foi assinado. Nada foi alterado na ordem de boot."; return 1; }
    (( rc == 0 )) || { bad "Alguma assinatura falhou. Não vou mexer na ordem de boot com a cadeia pela metade."; return 1; }
    return 0
}

# Um kernel novo chega sem assinatura, e uma atualização do GRUB reescreve o
# grubx64.efi por cima do assinado. Nos dois casos a máquina para de iniciar no
# boot seguinte, sem nada na tela explicando. Este hook re-assina depois de cada
# um dos dois.
install_hook() {
    step "Instalando o hook que re-assina a cada atualização…"
    install -d "$SYSROOT/etc/pacman.d/hooks"
    cat > "$SYSROOT/etc/pacman.d/hooks/stylus-secureboot.hook" <<'HOOK'
# Escrito pelo STYLUS (stylus-secureboot).
#
# Um kernel novo chega sem assinatura e uma atualização do GRUB reescreve o
# grubx64.efi por cima do que estava assinado. Nos dois casos a máquina para de
# iniciar no boot seguinte, com o Secure Boot ligado e nada na tela dizendo por
# quê.
[Trigger]
Operation=Install
Operation=Upgrade
Type=Package
Target=linux
Target=linux-lts
Target=grub

[Action]
Description=Re-assinando o boot para o Secure Boot…
When=PostTransaction
Exec=/usr/local/bin/stylus-secureboot --resign
HOOK
}

# ── Entradas ─────────────────────────────────────────────────────────────────

case ${1:-} in
    -h|--help) sed -n '3,7p' "$0" | sed 's/^# \?//'; exit 0 ;;

    --check)
        v=$(current_verdict)
        [[ ${v%%|*} == pronto || ${v%%|*} == legacy ]] && exit 0
        exit 1 ;;

    # Uma frase, para quem só quer saber o que fazer. Mesma ideia do
    # `stylus-gpu --why`.
    --why) v=$(current_verdict); printf '%s\n' "${v#*|}"; exit 0 ;;

    # Chamado pelo hook do pacman, nunca por gente. Silencioso quando não há
    # cadeia montada: a maioria das máquinas não tem, e um hook que reclama em
    # toda atualização de kernel de toda máquina é pior que nenhum.
    --resign)
        chain_ready || exit 0
        [[ $EUID -eq 0 ]] || exit 0
        sign_everything >/dev/null 2>&1 || {
            printf 'stylus-secureboot: a re-assinatura falhou; rode "sudo stylus-secureboot --prepare"\n' >&2
            exit 1
        }
        exit 0 ;;

    --prepare) prepare; exit $? ;;
    "")        show; exit 0 ;;
    *)  printf 'stylus-secureboot: opção desconhecida: %s\n' "$1" >&2; exit 2 ;;
esac
