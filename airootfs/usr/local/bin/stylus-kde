#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-kde — por que a área de trabalho não abriu, e o que fazer
# ═══════════════════════════════════════════════════════════════════════════
#      stylus kde              o estado, explicado
#      stylus kde --tentar     limpa a trava e manda tentar o KDE de novo
#
#  Existe porque a proteção do stylus-session é silenciosa por natureza: ela
#  entrega uma sessão que funciona e segue a vida. Do lado de fora isso é
#  "pedi KDE e abriu o i3", sem uma palavra. Este comando é a palavra.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

c_b=$'\033[1m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
ok()   { printf '  %s✓%s %s\n' "$c_g" "$c_0" "$*"; }
mau()  { printf '  %s✗%s %s\n' "$c_r" "$c_0" "$*"; }
aviso(){ printf '  %s!%s %s\n' "$c_y" "$c_0" "$*"; }

ESTADO="${XDG_DATA_HOME:-$HOME/.local/share}/stylus"
FALHAS="$ESTADO/desktop-falhas"
MOTIVO="$ESTADO/desktop-motivo"
LOG="$ESTADO/sessao.log"
RESGATE=/etc/sddm.conf.d/zz-stylus-resgate.conf

if [[ ${1:-} == --tentar ]]; then
    rm -f "$FALHAS" "$MOTIVO"
    echo desktop > "$HOME/.config/stylus/mode" 2>/dev/null || true
    sudo -n /usr/local/bin/stylus-set-session desktop >/dev/null 2>&1 || true
    printf '\n  %sPronto.%s A trava foi limpa e o modo voltou para área de trabalho.\n' "$c_g" "$c_0"
    printf '  Saia da sessão (ou %sstylus-mode desktop%s) para tentar o KDE de novo.\n\n' "$c_b" "$c_0"
    exit 0
fi

printf '\n  %sSTYLUS — área de trabalho%s\n\n' "$c_b" "$c_0"

# ── O Plasma está aqui? ────────────────────────────────────────────────────
if command -v startplasma-x11 >/dev/null 2>&1; then
    sess=""
    for c in plasmax11 plasma-x11 plasma; do
        [[ -f /usr/share/xsessions/$c.desktop ]] && { sess=$c.desktop; break; }
    done
    ok "KDE Plasma instalado${sess:+ (sessão: $sess)}"
else
    mau "O Plasma não está instalado."
    printf '      sudo pacman -S plasma-desktop plasma-workspace\n'
fi

# ── OpenGL: a pergunta que decide tudo ─────────────────────────────────────
gl=$(stylus-gpu --opengl 2>/dev/null)
case "$gl" in hardware|software|nenhum) ;; *) gl=desconhecido ;; esac
case "$gl" in
    hardware) ok "OpenGL acelerado — o KWin abre normalmente" ;;
    software) aviso "Tem OpenGL, mas sem aceleração: o KDE abre por software (llvmpipe) e fica lento.
      Rode ${c_b}stylus-gpu${c_0} para ver o que falta no driver." ;;
    nenhum)   mau "Esta máquina NÃO tem OpenGL — e o KWin não abre sem ele.
      É isto que faz a tela piscar sem parar em vez de abrir o KDE.
      Para resolver:  ${c_b}sudo pacman -S mesa${c_0}" ;;
    *)        aviso "Não deu para conferir o OpenGL (o stylus-gpu desta máquina não
      entende --opengl). O KDE vai ser tentado assim mesmo." ;;
esac

# ── A trava ────────────────────────────────────────────────────────────────
n=$(cat "$FALHAS" 2>/dev/null || echo 0); [[ $n =~ ^[0-9]+$ ]] || n=0
if (( n >= 2 )); then
    mau "A área de trabalho está travada: ela abriu e morreu $n vezes seguidas,
      então o STYLUS parou de tentar para a máquina não ficar piscando."
elif (( n > 0 )); then
    aviso "A última tentativa de abrir o KDE não firmou (tentativa $n de 2)."
else
    ok "Nenhuma falha registrada na área de trabalho"
fi

[[ -s $MOTIVO ]] && { printf '\n  %sO que aconteceu da última vez%s\n\n' "$c_b" "$c_0"; sed 's/^/    /' "$MOTIVO"; }

# ── O resgate do boot ──────────────────────────────────────────────────────
if [[ -f $RESGATE ]]; then
    printf '\n  %sO guarda de boot desviou o autologin%s\n\n' "$c_b" "$c_0"
    sed -n 's/^# //p' "$RESGATE" | sed '/^$/d;s/^/    /'
    printf '\n    Ele sai sozinho no boot em que o problema acima deixar de existir.\n'
fi

# ── O registro ─────────────────────────────────────────────────────────────
if [[ -s $LOG ]]; then
    printf '\n  %sÚltimas sessões%s\n\n' "$c_b" "$c_0"
    tail -n 6 "$LOG" | sed 's/^/    /'
fi

printf '\n  Para tentar o KDE de novo:  %sstylus kde --tentar%s\n\n' "$c_b" "$c_0"
