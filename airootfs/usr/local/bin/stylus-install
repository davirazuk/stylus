#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  stylus-install — guided STYLUS installer
#
#  Asks a short list of plain questions, shows you exactly what it is about to
#  do, and only then touches the disk. Three disk modes:
#
#    alongside  create STYLUS in unallocated free space, reuse the existing EFI
#               partition, and leave every other operating system untouched
#    partition  format one partition you pick, nothing else
#    wipe       erase an entire disk (requires typing APAGAR)
#
#  stylus-install --advanced  hands over to upstream archinstall instead.
#
#  Everything is logged to /var/log/stylus-install.log
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

LOG=/var/log/stylus-install.log
MNT=/mnt
MIN_ROOT_MIB=20480            # 20 GiB — refuse to install into less
ESP_TYPE_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_blue=$'\033[1;34m'; c_grn=$'\033[1;32m'
c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'

info() { printf '%s==>%s %s\n' "$c_blue" "$c_reset" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_grn"  "$c_reset" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_yel"  "$c_reset" "$*"; }
die()  { printf '\n%s==> ERRO:%s %s\n' "$c_red" "$c_reset" "$*" >&2
         printf '    O registro completo está em %s\n' "$LOG" >&2; exit 1; }

# ── Interaction helpers (dialog when available, prompts otherwise) ───────────
USE_DIALOG=0
command -v dialog >/dev/null && [[ -t 0 && -t 1 ]] && USE_DIALOG=1
DTITLE="Instalador do STYLUS"
# dialog labels its own buttons from its gettext catalogue, which is not
# guaranteed to be installed for pt_BR. Naming them here means the buttons match
# the questions above them whatever dialog would have chosen.
DLABELS=(--ok-label "OK" --cancel-label "Cancelar")
DYESNO=(--yes-label "Sim" --no-label "Não")

msg() {
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DLABELS[@]}" --msgbox "\n$1" 16 74
    else
        printf '\n  %s\n' "$1"; read -rp "  Pressione Enter… "
    fi
}

ask_input() {   # ask_input <prompt> <default>
    local prompt=$1 default=${2:-} out
    if (( USE_DIALOG )); then
        out=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --inputbox "\n$prompt" 10 66 "$default" \
              3>&1 1>&2 2>&3) || return 1
    else
        read -rp "  $prompt [${default}]: " out
    fi
    printf '%s' "${out:-$default}"
}

ask_password() {
    local prompt=$1 a b
    while :; do
        if (( USE_DIALOG )); then
            a=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --insecure --passwordbox "\n$prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
            b=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --insecure --passwordbox "\nConfirme: $prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
        else
            read -rsp "  $prompt: " a; echo
            read -rsp "  Confirme: "  b; echo
        fi
        [[ -z $a ]] && { msg "A senha não pode ficar em branco."; continue; }
        [[ $a == "$b" ]] && { printf '%s' "$a"; return 0; }
        msg "As duas senhas não são iguais. Tente de novo."
    done
}

ask_menu() {    # ask_menu <prompt> <tag1> <desc1> [tag2 desc2 ...]
    local prompt=$1; shift
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DLABELS[@]}" --menu "\n$prompt" 20 78 10 "$@" 3>&1 1>&2 2>&3
    else
        local -a tags=() descs=()
        while (( $# )); do tags+=("$1"); descs+=("$2"); shift 2; done
        # To stderr, not stdout. Every caller reads this function through
        # `X=$(ask_menu …)`, so anything printed on stdout is captured as part
        # of the answer - the prompt and the whole numbered list ended up
        # inside $DISK, $MODE and $FSTYPE. The dialog branch above already
        # redirects for exactly this reason (3>&1 1>&2 2>&3); this branch did
        # not. It only shows up without dialog installed, or when stdin is not
        # a terminal, which is why it survived: the ISO has dialog.
        printf '\n  %s\n\n' "$prompt" >&2
        local i
        for i in "${!tags[@]}"; do
            printf '   %2d) %-14s %s\n' "$((i+1))" "${tags[i]}" "${descs[i]}" >&2
        done
        local c; read -rp $'\n  Escolha: ' c
        [[ $c =~ ^[0-9]+$ ]] && (( c>=1 && c<=${#tags[@]} )) && printf '%s' "${tags[c-1]}"
    fi
}

ask_yesno() {
    local q=$1
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DYESNO[@]}" --yesno "\n$q" 12 70
    else
        # "s" for sim, and "y" still works for anyone typing out of habit.
        local a; read -rp "  $q [s/N] " a; [[ ${a,,} == s* || ${a,,} == y* ]]
    fi
}

# ── Preflight ────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Execute como root:  sudo stylus-install"

case ${1:-} in
    --advanced) exec archinstall --config /usr/share/stylus/archinstall-preset.json ;;
    -h|--help)  cat <<'AJUDA'; exit 0 ;;
stylus-install — instalador guiado do STYLUS

Faz uma lista curta de perguntas simples, mostra exatamente o que vai fazer, e
só então mexe no disco. Três modos de disco:

  alongside   cria o STYLUS no espaço livre não alocado, reaproveita a partição
              EFI existente e não toca em nenhum outro sistema operacional
  partition   formata uma partição que você escolher, e mais nada
  wipe        apaga um disco inteiro (exige digitar APAGAR)

    stylus-install --advanced   usa o archinstall original no lugar deste

Tudo é registrado em /var/log/stylus-install.log
AJUDA
esac

FIRMWARE=BIOS
[[ -d /sys/firmware/efi/efivars ]] && FIRMWARE=UEFI

# Whether there is a network, asked the way pacstrap is going to ask it.
#
# This was one `ping archlinux.org`, and ICMP is blocked on a great many school
# and campus networks - including exactly the kind this distribution exists
# for. On those the installer refused to start, at the first step, on a machine
# whose network was working perfectly, with a message telling the student to
# connect to a network they were already connected to. There is no way past
# that and nothing on screen suggesting there should be.
#
# An HTTPS request is the honest question, because downloading packages is an
# HTTPS request. ping stays as a fallback for the reverse case: a network that
# answers ICMP while something sits in front of HTTPS.
have_network() {
    local url
    for url in https://archlinux.org/ https://geo.mirror.pkgbuild.com/; do
        if command -v curl >/dev/null 2>&1; then
            curl -fsS --max-time 8 -o /dev/null "$url" 2>/dev/null && return 0
        fi
        if command -v wget >/dev/null 2>&1; then
            wget -q --timeout=8 -O /dev/null "$url" 2>/dev/null && return 0
        fi
    done
    ping -c1 -W3 archlinux.org &>/dev/null
}

have_network || die "Sem conexão com a internet.

Conecte-se primeiro — clique no ícone de Wi-Fi na barra, ou execute nmtui.

Se você já está conectado e mesmo assim aparece isto, provavelmente a rede pede
login numa página (é o caso de muitas redes de escola): abra o navegador, faça
o login, e rode o instalador de novo."

for tool in sgdisk parted mkfs.ext4 mkfs.vfat pacstrap genfstab arch-chroot lsblk reflector; do
    command -v "$tool" >/dev/null || die "Ferramenta necessária não encontrada: $tool"
done

clear
msg "Bem-vindo ao instalador do STYLUS.

Ele faz algumas perguntas, mostra um resumo e não mexe em nada até você
confirmar no final.

Firmware detectado: $FIRMWARE

Para manter outro sistema operacional, escolha 'alongside' na etapa do disco —
essa opção usa apenas espaço livre não alocado e nunca formata uma partição que
já existe. Se ainda não houver espaço livre, saia e crie um com o GParted (ele
já está instalado)."

# ── Questions ────────────────────────────────────────────────────────────────
KEYMAP=$(ask_input "Layout do teclado (br-abnt2, us, ...)" "br-abnt2") || exit 1
LOCALE=$(ask_input "Idioma do sistema" "pt_BR.UTF-8")                   || exit 1

# Brazilian default, overridden by geolocation when there is a network.
TZ_GUESS=$(curl -fsS --max-time 5 https://ipapi.co/timezone 2>/dev/null)
[[ -f /usr/share/zoneinfo/${TZ_GUESS:-nope} ]] || TZ_GUESS=America/Campo_Grande
TIMEZONE=$(ask_input "Fuso horário (Região/Cidade)" "$TZ_GUESS")   || exit 1
[[ -f /usr/share/zoneinfo/$TIMEZONE ]] || die "Fuso horário desconhecido: $TIMEZONE"

HOSTNAME=$(ask_input "Nome do computador" "stylus")       || exit 1

while :; do
    USERNAME=$(ask_input "Seu nome de usuário (minúsculas, sem espaços)" "") || exit 1
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
    msg "'$USERNAME' não serve como nome de usuário. Use letras minúsculas, números, - e _."
done
USERPASS=$(ask_password "Senha de $USERNAME") || exit 1

if ask_yesno "Definir uma senha separada de root (administrador)?

Responder Não bloqueia a conta root e você administra a máquina com sudo, que é
o que a maioria das distribuições faz."; then
    ROOTPASS=$(ask_password "Senha de root") || exit 1
else
    ROOTPASS=""
fi

# ── Disk selection ───────────────────────────────────────────────────────────
# Never offer the medium we are running from.
LIVE_DISK=""
live_src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)
[[ -n $live_src ]] && LIVE_DISK=$(lsblk -npo PKNAME "$live_src" 2>/dev/null | head -1)

mapfile -t disks < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"')
disk_menu=()
for d in "${disks[@]}"; do
    dev=$(awk '{print $1}' <<<"$d")
    [[ -n $LIVE_DISK && $dev == "$LIVE_DISK" ]] && continue
    disk_menu+=("$dev" "$(sed "s|^$dev *||; s/ disk$//" <<<"$d")")
done
(( ${#disk_menu[@]} )) || die "Nenhum disco onde instalar foi encontrado."

DISK=$(ask_menu "Em qual disco o STYLUS deve ser instalado?" "${disk_menu[@]}") || exit 1
[[ -b $DISK ]] || die "Não é um dispositivo de bloco: $DISK"

clear
printf '\n%s  Organização atual de %s%s\n\n' "$c_b" "$DISK" "$c_reset"
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK"
printf '\n'
read -rp "  Pressione Enter para continuar… "

find_free_space() {     # biggest unallocated gap: "START_MIB END_MIB SIZE_MIB"
    parted -m -s "$1" unit MiB print free 2>/dev/null |
    awk -F: '/:free;$/ {
        s=$2; e=$3; sz=$4
        sub(/MiB/,"",s); sub(/MiB/,"",e); sub(/MiB/,"",sz)
        if (sz+0 > best+0) { best=sz+0; bs=s+0; be=e+0 }
    } END { if (best>0) printf "%d %d %d\n", bs, be, best }'
}

find_esp() {
    lsblk -rpno NAME,PARTTYPE "$1" |
        awk -v g="$ESP_TYPE_GUID" 'tolower($2)==g {print $1; exit}'
}

# The little partition GRUB embeds itself into when booting a GPT disk without
# UEFI. Without one, `grub-install --target=i386-pc` refuses at the very end -
# after forty minutes of downloading - with a message about embedding.
BIOS_BOOT_GUID=21686148-6449-6e6f-744e-656564454649
find_bios_boot() {
    lsblk -rpno NAME,PARTTYPE "$1" |
        awk -v g="$BIOS_BOOT_GUID" 'tolower($2)==g {print $1; exit}'
}

# Why "alongside" cannot be offered on this disk, or nothing at all when it can.
#
# The menu entry for it says "manter todo o resto", and the installer says
# "nenhuma outra partição foi modificada" after it runs. Both were promises the
# code could not always keep:
#
#  - sgdisk is a GPT tool. Handed a disk with an MBR partition table - which is
#    every machine that came with Windows 7, and plenty that came with 10 - it
#    converts the table to GPT in place. The other operating system on that disk
#    stops booting. Nothing warned, and the mode that promises not to touch
#    anything was the one doing it.
#
#  - On a GPT disk booted without UEFI, GRUB needs a BIOS boot partition to
#    embed itself into. When there is none the install fails at grub-install,
#    which is the last step, long after the disk has been written to.
#
# A pure function of six values so it can be tested without a disk: everything
# it needs is passed in.
alongside_block_reason() {  # <pttype> <firmware> <esp> <bios-boot> <free-mib> <min-mib>
    local pt=$1 fw=$2 esp=$3 bios=$4 free=$5 min=$6

    if (( free < min )); then
        printf 'não há espaço livre não alocado suficiente neste disco (%s GiB livres, e o STYLUS precisa de %s GiB). Use o GParted para diminuir uma partição existente e abrir espaço.' \
               "$(( free / 1024 ))" "$(( min / 1024 ))"
        return 0
    fi
    if [[ $pt != gpt ]]; then
        printf 'este disco usa uma tabela de partições antiga (%s), e criar uma partição nela converteria a tabela para GPT — o que faria o outro sistema operacional do disco parar de iniciar. Para instalar ao lado dele seria preciso converter o disco antes, com o Windows fechado e com backup.' \
               "${pt:-desconhecida}"
        return 0
    fi
    if [[ $fw == UEFI && -z $esp ]]; then
        printf 'não há partição EFI neste disco para compartilhar. Crie uma com o GParted, ou use "wipe".'
        return 0
    fi
    if [[ $fw != UEFI && -z $bios ]]; then
        printf 'este computador inicia pelo modo antigo (BIOS) e o disco é GPT sem a partição de boot que o GRUB precisa. Sem ela a instalação falharia no final. Use "wipe", ou crie uma partição "BIOS boot" de 2 MiB com o GParted.'
        return 0
    fi
    return 1
}

FREE_START=0; FREE_END=0; FREE_SIZE=0
read -r FREE_START FREE_END FREE_SIZE < <(find_free_space "$DISK") || true
FREE_SIZE=${FREE_SIZE:-0}
EXISTING_ESP=$(find_esp "$DISK")
EXISTING_BIOS_BOOT=$(find_bios_boot "$DISK")
PTTYPE=$(lsblk -dno PTTYPE "$DISK" 2>/dev/null | head -1)

mode_menu=()
ALONGSIDE_WHY_NOT=$(alongside_block_reason "$PTTYPE" "$FIRMWARE" "$EXISTING_ESP" \
                                           "$EXISTING_BIOS_BOOT" "$FREE_SIZE" "$MIN_ROOT_MIB")
if [[ -z $ALONGSIDE_WHY_NOT ]]; then
    mode_menu+=(alongside "Usar os $((FREE_SIZE/1024)) GiB livres e manter todo o resto")
else
    # Said out loud rather than quietly left out of the menu. Somebody who came
    # here to install next to Windows and does not see the option needs to know
    # why, or the conclusion they reach is that STYLUS cannot do it at all.
    msg "Não dá para instalar ao lado do que já está no $DISK, porque $ALONGSIDE_WHY_NOT

As outras opções continuam disponíveis."
fi
mode_menu+=(partition "Formatar uma partição que eu escolher")
mode_menu+=(wipe      "Apagar o disco INTEIRO e começar do zero")

MODE=$(ask_menu "Como o STYLUS deve usar o $DISK?" "${mode_menu[@]}") || exit 1

TARGET_PART=""
case $MODE in
  alongside)
    # Belt and braces: the menu should not have offered it, and this runs one
    # step before the disk is written to.
    [[ -z $ALONGSIDE_WHY_NOT ]] || die "Não dá para instalar ao lado: $ALONGSIDE_WHY_NOT"
    ;;
  partition)
    mapfile -t parts < <(lsblk -rpno NAME,SIZE,FSTYPE,MOUNTPOINTS "$DISK" | awk 'NR>1')
    (( ${#parts[@]} )) || die "O $DISK não tem partições para escolher."
    part_menu=()
    for p in "${parts[@]}"; do
        pdev=$(awk '{print $1}' <<<"$p")
        part_menu+=("$pdev" "$(sed "s|^$pdev *||" <<<"$p")")
    done
    TARGET_PART=$(ask_menu "Qual partição deve ser FORMATADA como raiz do STYLUS?
Tudo que estiver nela será perdido. As outras partições não são tocadas." "${part_menu[@]}") || exit 1
    [[ -b $TARGET_PART ]] || die "Não é uma partição: $TARGET_PART"
    findmnt -rno TARGET "$TARGET_PART" &>/dev/null && die "$TARGET_PART está montada no momento."

    # The EFI partition is checked here, not later, and that ordering is the
    # whole point. This mode reuses an existing ESP rather than creating one -
    # and the check that there *is* one lived after mkfs. On a UEFI machine
    # whose disk had no ESP, the installer formatted the partition the student
    # chose, destroying whatever was on it, and only then gave up saying it had
    # nowhere to put the bootloader. Nothing was gained by the formatting and
    # there was no way to undo it.
    if [[ $FIRMWARE == UEFI && -z $EXISTING_ESP ]]; then
        die "Este computador inicia por UEFI e o $DISK não tem partição de sistema EFI.

O STYLUS precisa de uma para instalar o carregador de boot, e neste modo ele
reaproveita a que já existe em vez de criar uma.

Escolha 'wipe' (que cria uma), ou crie uma partição EFI de 1 GiB com o GParted
— tipo FAT32, sinalizadores 'boot' e 'esp' — e rode o instalador de novo.

Nada foi alterado no disco."
    fi

    # And the ESP must not be the partition being formatted, which is a click
    # away in the menu above: the list is every partition on the disk, the ESP
    # included, and formatting it as ext4 takes the other operating system's
    # bootloader with it.
    if [[ -n $EXISTING_ESP && $TARGET_PART == "$EXISTING_ESP" ]]; then
        die "$TARGET_PART é a partição de sistema EFI do disco.

Formatá-la apagaria o carregador de boot de todos os sistemas instalados aqui,
inclusive os outros. Escolha outra partição.

Nada foi alterado no disco."
    fi

    psize=$(( $(blockdev --getsize64 "$TARGET_PART") / 1024 / 1024 ))
    (( psize >= MIN_ROOT_MIB )) || \
        die "$TARGET_PART tem só $((psize/1024)) GiB; o STYLUS precisa de pelo menos $((MIN_ROOT_MIB/1024)) GiB."
    ;;
  wipe)
    ask_yesno "Isso APAGA TUDO no $DISK, inclusive qualquer outro sistema
operacional instalado nele.

Tem certeza?" || exit 1
    # The confirmation word is translated too: typing a word you do not read as
    # a word is not a confirmation, it is copying letters off the screen.
    read -rp "  Digite APAGAR em maiúsculas para confirmar: " confirm
    [[ $confirm == APAGAR ]] || die "Não confirmado — nada foi alterado."
    ;;
  *) exit 1 ;;
esac

FSTYPE=$(ask_menu "Sistema de arquivos da partição raiz do STYLUS" \
    ext4  "Simples e confiável (recomendado)" \
    btrfs "Snapshots e compressão") || exit 1

# ── Swap file size ───────────────────────────────────────────────────────────
# Sized against the disk as well as the memory. The old default was simply
# min(RAM, 8 GiB), which ignored where it was going: on the 32 GiB eMMC laptops
# schools buy, a machine with 4 GiB of memory proposed a 4 GiB swap file - an
# eighth of the whole disk - and one with 8 GiB proposed 8.
#
# It does not need to match the memory anyway. zram already provides swap
# sized to half of RAM, compressed and in memory; this file is the overflow
# underneath it, which is reached rarely and does not need to be large. A tenth
# of the root partition is the ceiling, so the proportion holds on any disk.
#
# Still only a default: the question is asked either way and any number can be
# typed, including 0.
root_mib() {
    case $MODE in
        alongside) printf '%s' "$(( FREE_END - FREE_START ))" ;;
        partition) printf '%s' "${psize:-0}" ;;
        wipe)      printf '%s' "$(( $(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0) / 1024 / 1024 ))" ;;
        *)         printf '0' ;;
    esac
}

RAM_MIB=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
ROOT_MIB=$(root_mib)
SWAP_DEFAULT=$(( RAM_MIB > 8192 ? 8192 : RAM_MIB ))
if (( ROOT_MIB > 0 )); then
    disk_cap=$(( ROOT_MIB / 10 ))
    (( SWAP_DEFAULT > disk_cap )) && SWAP_DEFAULT=$disk_cap
fi
# Below a gigabyte a swap file is not worth the space it costs; zram covers it.
(( SWAP_DEFAULT < 1024 )) && SWAP_DEFAULT=0

SWAP_MIB=$(ask_input "Tamanho do arquivo de swap em MiB (0 para nenhum)" "$SWAP_DEFAULT") || exit 1
[[ $SWAP_MIB =~ ^[0-9]+$ ]] || SWAP_MIB=0

# ── Hardware that worked on the USB stick and would stop working after ───────
# These are on the live medium and were not being installed, which produces the
# worst kind of bug report: it worked before I installed it.
HW_PKGS=(
    # Sound Open Firmware. Intel laptops from about 2019 on have no audio at
    # all without it - not quiet audio, no sound card. This is the single most
    # common "I installed it and the sound disappeared" on Arch.
    sof-firmware
    alsa-utils
    # Wi-Fi regulatory rules. Without them the card is limited to the most
    # conservative channel set, so the 5 GHz network the school runs may simply
    # not appear.
    wireless-regdb
    linux-firmware-marvell
    # Mobile broadband. NetworkManager cannot see a built-in LTE modem without
    # it, and a few school laptops have one.
    modemmanager
)

# Broadcom wireless is detected rather than always installed. The module is
# built by DKMS on every kernel update, which is a real cost on a slow machine,
# and most machines have nothing for it to drive. The ones that do have no Wi-Fi
# at all without it.
#
# The DKMS build rather than the prebuilt broadcom-wl: this installs both the
# normal and the LTS kernel, and the prebuilt module only matches the first. The
# LTS kernel exists to be booted when the normal one breaks, which is exactly
# when needing to reach the network matters most.
if lspci 2>/dev/null | grep -Ei 'network|wireless' | grep -qi 'broadcom'; then
    HW_PKGS+=(broadcom-wl-dkms dkms)
fi

# ── Graphics driver ──────────────────────────────────────────────────────────
# Nothing installed a graphics driver. Intel and AMD survived that because mesa
# arrives as a dependency, but an NVIDIA machine came up on nouveau or on
# software rendering - which is also why the desktop's compositor has a check
# for whether a render node exists at all. A machine whose whole selling point
# includes games should not need a trip to the software catalog before it can
# draw one.
GPU_PKGS=()
ENABLE_MULTILIB=0

detect_gpus() {
    local line out=""
    while IFS= read -r line; do
        case ${line,,} in
            *nvidia*)                                   out+="nvidia "  ;;
            *"advanced micro devices"*|*"amd/ati"*|*radeon*) out+="amd " ;;
            *intel*)                                    out+="intel "   ;;
        esac
    done < <(lspci 2>/dev/null | grep -Ei 'vga|3d controller|display controller')
    printf '%s' "$out"
}

GPUS=$(detect_gpus)
GPU_SEEN=$(lspci 2>/dev/null | grep -Ei 'vga|3d controller|display controller' |
           sed 's/^[0-9a-f:.]* //' | head -3)
[[ -n $GPU_SEEN ]] || GPU_SEEN="(nenhuma detectada)"

# Mesa and its 32-bit half are wanted in every case: they drive Intel and AMD,
# and on a hybrid laptop they still drive the integrated chip that everything
# except games runs on.
#
# The Vulkan loader is in every case too. It is what a game links against - the
# vendor drivers below are plugins for it - and every Vulkan title, all of
# Proton included, fails without it in a way that names neither the loader nor
# the driver. It usually arrives as a dependency of vulkan-radeon or
# vulkan-intel, which is a guarantee only for as long as those are installed.
MESA_SET="mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader"
[[ $GPUS == *intel* ]] && MESA_SET+=" vulkan-intel lib32-vulkan-intel"
[[ $GPUS == *amd*   ]] && MESA_SET+=" vulkan-radeon lib32-vulkan-radeon"

# Playing video on the graphics chip instead of the processor. This is the
# single largest difference available to an old laptop and it was missing:
# decoding 1080p H.264 in software is most of both cores of a 2013 machine -
# the fan runs, the battery goes, and it stutters anyway - while the same clip
# through VA-API is close to idle, on a decoder that was sitting there unused.
#
# Both Intel drivers, deliberately. iHD covers Broadwell and newer, i965 the
# generations before it; they do not conflict and libva picks by device at run
# time. Choosing one from the marketing name in lspci would be a guess, and
# guessing wrong is silent. AMD decodes through mesa, which is already here.
MESA_SET+=" libva-utils"
[[ $GPUS == *intel* ]] && MESA_SET+=" intel-media-driver libva-intel-driver"

if [[ $GPUS == *nvidia* ]]; then
    # Which NVIDIA driver, decided here rather than asked.
    #
    # There is no one NVIDIA driver: there are four, each covering a different
    # range of cards, and the wrong one does not fail loudly - it installs, the
    # module loads, it binds no card, and the machine runs on the processor
    # looking perfectly configured. The old version of this screen asked the
    # student "is your card older than a GTX 16xx?", which is a question a
    # student cannot answer about a laptop they were given, and then offered
    # nouveau as the answer for older cards - which on a GTX 1050 means giving
    # up most of the card's speed for no reason, because nouveau cannot raise
    # the clocks on Pascal at all.
    #
    # The machine already knows. lspci prints the chip codename and stylus-gpu
    # turns it into the driver name, so this asks nothing and says what it found.
    NV_DRIVER=$(stylus-gpu --nvidia-driver 2>/dev/null || echo proprietary)
    NV_PKG=$(stylus-gpu --nvidia-pkg 2>/dev/null || echo nvidia-dkms)
    NV_ARCH_LABEL=$(stylus-gpu --nvidia-label 2>/dev/null || echo "geração não reconhecida")

    case $NV_DRIVER in
        legacy470|legacy390)
            # Old enough that nothing in the official repositories drives it.
            # Installing an NVIDIA driver here would blacklist nouveau and
            # leave the machine with no graphics driver whatsoever.
            ask_yesno "Placas de vídeo detectadas:

$GPU_SEEN

Esta placa NVIDIA é antiga demais para os drivers da NVIDIA que ainda existem
nos repositórios. O driver livre (nouveau) é o que funciona nela, e é o que
vai ser instalado.

Continuar?" || exit 1
            GPU_CHOICE=nouveau ;;
        *)
            nv_label="Driver NVIDIA ($NV_PKG) + bibliotecas de 32 bits"
            [[ $GPUS == *intel* || $GPUS == *amd* ]] &&
                nv_label="NVIDIA ($NV_PKG) + vídeo integrado, com prime-run"

            GPU_CHOICE=$(ask_menu "Placas de vídeo detectadas:

$GPU_SEEN

O STYLUS reconheceu esta placa como $NV_ARCH_LABEL, e o driver certo para ela é
o $NV_PKG. É o que a primeira opção instala — não precisa saber de nada disso
para escolher." \
                nvidia  "$nv_label (recomendado)" \
                nouveau "Driver livre, mais lento, sem compilar nada" \
                skip    "Instalar um driver depois, pelo stylus-app") || exit 1 ;;
    esac
else
    GPU_CHOICE=$( [[ -n $GPUS ]] && echo mesa || echo skip )
    if [[ $GPU_CHOICE == mesa ]]; then
        ask_yesno "Placas de vídeo detectadas:

$GPU_SEEN

Instalar os drivers livres e as bibliotecas de 32 bits para jogos?" || GPU_CHOICE=skip
    fi
fi

case $GPU_CHOICE in
    nvidia)
        # A -dkms package, whichever one this card needs, and never the
        # prebuilt one. This image installs two kernels - linux and linux-lts -
        # and the prebuilt modules are built against linux alone. Booting the
        # LTS kernel, which exists precisely for when the main one breaks,
        # would have found no NVIDIA module at all; and even on the main kernel
        # the prebuilt module and the kernel have to move in lockstep, so an
        # update that lands one without the other leaves the machine on
        # software rendering with nothing to explain it. DKMS rebuilds for
        # every installed kernel. Both kernels' headers are already in
        # PACKAGES, so nothing else is needed.
        # shellcheck disable=SC2206
        GPU_PKGS=("$NV_PKG" dkms nvidia-utils nvidia-settings lib32-nvidia-utils $MESA_SET)
        # A hybrid laptop needs prime-run to send a game to the discrete chip;
        # without it every game runs on the integrated one and nobody can tell
        # why the machine is slow.
        [[ $GPUS == *intel* || $GPUS == *amd* ]] && GPU_PKGS+=(nvidia-prime)
        ENABLE_MULTILIB=1 ;;
    nouveau|mesa)
        # shellcheck disable=SC2206
        GPU_PKGS=($MESA_SET)
        ENABLE_MULTILIB=1 ;;
    skip)
        GPU_PKGS=() ;;
esac

# ── Summary ──────────────────────────────────────────────────────────────────
case $MODE in
  alongside) plan="Criar uma partição $FSTYPE de $(( (FREE_END-FREE_START)/1024 )) GiB no espaço livre do $DISK.
Reaproveitar a partição EFI ${EXISTING_ESP:-(boot BIOS)} sem formatá-la.
Nenhuma partição existente é formatada, redimensionada ou removida." ;;
  partition) plan="Formatar $TARGET_PART como $FSTYPE e instalar o STYLUS nela.
Reaproveitar a partição EFI ${EXISTING_ESP:-(boot BIOS)} sem formatá-la.
Nenhuma outra partição é tocada." ;;
  wipe)      plan="APAGAR TODOS OS DADOS do $DISK e criar um layout novo: EFI + $FSTYPE." ;;
esac

clear
cat <<EOF

${c_b}  O STYLUS será instalado com estas configurações${c_reset}

    Modo de disco  ${c_b}$MODE${c_reset}
    Disco          $DISK
    Sist. arquivos $FSTYPE
    Arquivo swap   $SWAP_MIB MiB
    Vídeo          $( (( ${#GPU_PKGS[@]} )) && echo "${GPU_PKGS[*]}" || echo 'nenhum (instale depois pelo stylus-app)' )
    Hardware       ${HW_PKGS[*]}
    Firmware       $FIRMWARE
    Nome da máquina $HOSTNAME
    Usuário        $USERNAME $( [[ -n $ROOTPASS ]] && echo '(+ senha de root separada)' || echo '(root bloqueado, só sudo)' )
    Fuso horário   $TIMEZONE
    Idioma         $LOCALE / teclado $KEYMAP

${c_yel}  O que acontece com o disco:${c_reset}
$(sed 's/^/    /' <<<"$plan")

EOF
read -rp "  Digite SIM para começar a instalar, qualquer outra coisa para cancelar: " go
[[ $go == SIM ]] || die "Cancelado — nada foi alterado."

# ── Everything below is logged ───────────────────────────────────────────────
exec > >(tee -a "$LOG") 2>&1
printf '\n===== STYLUS install started %s =====\n' "$(date -Is)"

cleanup() { set +e; swapoff "$MNT/swapfile" 2>/dev/null; umount -R "$MNT" 2>/dev/null; }
trap cleanup EXIT

snapshot_parts() { lsblk -rpno NAME "$DISK" | tail -n +2 | sort; }

ROOT_PART=""
ESP_PART="$EXISTING_ESP"

case $MODE in
  wipe)
    info "Apagando o $DISK…"
    swapoff -a 2>/dev/null
    umount -R "$MNT" 2>/dev/null
    wipefs -af "$DISK"       || die "wipefs falhou no $DISK"
    sgdisk --zap-all "$DISK" || die "Não foi possível limpar a tabela de partições."
    if [[ $FIRMWARE == UEFI ]]; then
        sgdisk -n 1:1M:+1G -t 1:ef00 -c 1:"EFI system" "$DISK" || die "Falha ao criar a partição EFI."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"STYLUS root"  "$DISK" || die "Falha ao criar a partição raiz."
    else
        sgdisk -n 1:1M:+2M -t 1:ef02 -c 1:"BIOS boot"  "$DISK" || die "Falha ao criar a partição de boot do BIOS."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"STYLUS root"  "$DISK" || die "Falha ao criar a partição raiz."
    fi
    partprobe "$DISK"; udevadm settle; sleep 1
    mapfile -t newparts < <(snapshot_parts)
    (( ${#newparts[@]} >= 2 )) || die "As novas partições não apareceram."
    [[ $FIRMWARE == UEFI ]] && ESP_PART=${newparts[0]}
    ROOT_PART=${newparts[1]}
    if [[ $FIRMWARE == UEFI ]]; then
        mkfs.vfat -F32 -n STYLUS_EFI "$ESP_PART" || die "Falha ao formatar a partição EFI."
    fi
    ;;

  alongside)
    info "Criando uma partição no espaço livre (${FREE_START} MiB → ${FREE_END} MiB)…"
    before=$(snapshot_parts)
    sgdisk -n "0:${FREE_START}M:$((FREE_END - 1))M" -t 0:8300 -c 0:"STYLUS root" "$DISK" \
        || die "Não foi possível criar uma partição no espaço livre."
    partprobe "$DISK"; udevadm settle; sleep 1
    ROOT_PART=$(comm -13 <(printf '%s\n' "$before") <(snapshot_parts) | head -1)
    [[ -b ${ROOT_PART:-} ]] || die "A nova partição não apareceu. Nada foi formatado."
    ok "Criada $ROOT_PART — nenhuma outra partição foi modificada"
    ;;

  partition)
    ROOT_PART=$TARGET_PART
    wipefs -af "$ROOT_PART" || die "Não foi possível limpar $ROOT_PART"
    ;;
esac

[[ -b ${ROOT_PART:-} ]] || die "Nenhuma partição raiz definida — cancelando antes de formatar."

info "Formatando $ROOT_PART como $FSTYPE…"
case $FSTYPE in
    ext4)  mkfs.ext4  -F -L STYLUS "$ROOT_PART" || die "mkfs.ext4 falhou." ;;
    btrfs) mkfs.btrfs -f -L STYLUS "$ROOT_PART" || die "mkfs.btrfs falhou." ;;
esac

info "Montando…"
mount "$ROOT_PART" "$MNT" || die "Não foi possível montar $ROOT_PART"
if [[ $FIRMWARE == UEFI ]]; then
    [[ -b ${ESP_PART:-} ]] || die "Nenhuma partição de sistema EFI disponível."
    mkdir -p "$MNT/boot/efi"
    mount "$ESP_PART" "$MNT/boot/efi" || die "Não foi possível montar a partição EFI $ESP_PART"
    ok "Usando a partição EFI $ESP_PART (não foi reformatada)"
fi

info "Ordenando os espelhos de download…"
reflector --latest 20 --sort rate --protocol https --save /etc/pacman.d/mirrorlist 2>/dev/null \
    || warn "reflector falhou; mantendo a lista de espelhos atual."

PACKAGES=(
    # ── base system ──────────────────────────────────────────────────────────
    base linux linux-firmware linux-headers mkinitcpio
    # A second kernel to fall back on when an update breaks the first one.
    linux-lts linux-lts-headers
    amd-ucode intel-ucode
    grub efibootmgr os-prober dosfstools
    # Assinar o próprio carregador de boot, para a máquina poder iniciar com o
    # Secure Boot ligado sem ninguém precisar da senha da BIOS. É o caso dos
    # computadores da escola, onde o Secure Boot não se desliga. `stylus-secureboot`
    # usa estes dois; sem eles a ferramenta existe e não faz nada, o que é a
    # pior das duas situações. São pequenos e ninguém precisa saber que existem.
    sbsigntools mokutil
    e2fsprogs btrfs-progs exfatprogs ntfs-3g
    sudo man-db man-pages bash-completion pacman-contrib reflector
    git vim nano openssh rsync wget curl unzip zip 7zip unrar

    # ── networking ───────────────────────────────────────────────────────────
    networkmanager network-manager-applet nm-connection-editor wpa_supplicant
    ufw

    # ── audio and bluetooth ──────────────────────────────────────────────────
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber
    pavucontrol pamixer playerctl brightnessctl power-profiles-daemon
    zram-generator
    # The good Bluetooth codecs. PipeWire can speak AAC, aptX and LDAC, but only
    # if these are installed - they are optional dependencies, so nothing pulls
    # them in and a pair of headphones falls back to SBC without saying so.
    # SBC at the default bitpool is the reason Bluetooth audio has a reputation
    # for sounding muddy, and it is the codec every STYLUS machine has been using.
    # Three small libraries, and the difference is audible on the headphones a
    # student already owns.
    libfreeaptx libldac fdk-aac
    # For as long as a game is open: the processor on the performance governor,
    # the game's scheduling and I/O priority above everything else, and the
    # screen not blanking. It ends when the game does, so it costs a machine
    # nothing while nobody is playing - which is why the launcher can turn it
    # on for every game without asking.
    #
    # lib32-gamemode is not optional and used to be. gamemoderun works by
    # LD_PRELOAD, and a 32-bit program handed a 64-bit preload cannot load it -
    # so a 32-bit game got no treatment at all, and anything running a Chromium
    # sandbox inside itself got worse than nothing: Steam's steamwebhelper dies
    # on a preload it cannot load, with "Unexpected Transport Error (0x3008)"
    # and no mention of GameMode anywhere in it.
    gamemode lib32-gamemode
    # Running out of memory on a 4 GiB machine does not produce an error, it
    # produces a machine that stops responding for minutes while the kernel
    # thrashes, and often never recovers - the kernel's own OOM killer waits
    # until there is no memory left at all, by which time the desktop has been
    # unusable for a long time. earlyoom watches the free-memory figure and
    # kills the single worst offender while the machine is still answering.
    # On the hardware this distribution exists for, that is the difference
    # between losing one browser tab and losing the session.
    earlyoom
    bluez bluez-utils blueman

    # ── desktop ──────────────────────────────────────────────────────────────
    xorg-server xorg-xinit xorg-xrandr xorg-xsetroot xf86-input-libinput
    # The i3 config runs `xset s 600` and `xset dpms 0 0 720` at login. Without
    # this the line fails and neither thing happens: the screen never blanks,
    # and xss-lock never gets the cue it locks on. A laptop then sits unlocked
    # with the backlight on until the battery runs out.
    xorg-xset
    # xinput: the only way to read or set libinput's per-device properties,
    # which is where the mouse speed and acceleration profile live. stylus-mouse
    # is built on it, and without it there was nothing on the machine that
    # could look at a mouse at all.
    xorg-xinput
    # lspci, which stylus-gpu reads to decide whether the machine has a discrete
    # card - which is how the launcher knows to send a game to it. It was in
    # packages.x86_64 for the ISO but not here, so an installed system had the
    # tool and nothing for it to read.
    pciutils
    # glxinfo, which answers the one question `stylus-gpu --check` cannot get from
    # the package list: what is actually drawing. Without it a machine with
    # every driver installed and still rendering on the CPU - the exact state
    # that stops Steam from opening - reports itself as healthy.
    mesa-utils
    i3-wm i3lock xss-lock libnotify polybar rofi picom dunst feh
    xfce4-terminal alacritty xterm
    thunar thunar-volman thunar-archive-plugin gvfs gvfs-mtp gvfs-smb tumbler
    # thunar-volman only automounts while Thunar is running; udiskie does it
    # for the desktop itself, which is where a pendrive is actually plugged in.
    udisks2 udiskie
    xarchiver mousepad gthumb
    # sddm-greeter links against Qt5, not qt6-declarative; without this the
    # stylus login theme's `import QtQuick.Controls 2.15` fails to resolve and
    # SDDM silently falls back to its stock theme.
    sddm qt5-quickcontrols2 polkit polkit-gnome plymouth
    xdg-user-dirs xdg-utils xdg-desktop-portal xdg-desktop-portal-gtk
    maim xclip xdotool arandr htop xfce4-taskmanager fastfetch dialog gammastep
    # Notices a projector being plugged in and lays the screens out; see the
    # note in packages.x86_64.
    autorandr
    webkit2gtk-4.1 python-gobject adwaita-icon-theme adwaita-cursors

    # ── the applications a student actually needs on day one ─────────────────
    firefox firefox-i18n-pt-br
    libreoffice-fresh libreoffice-fresh-pt-br
    evince vlc mpv
    ffmpeg gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav
    qalculate-gtk
    flatpak timeshift

    # ── printing and scanning ────────────────────────────────────────────────
    cups cups-pdf system-config-printer

    # ── fonts and theming ────────────────────────────────────────────────────
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk
    noto-fonts-extra ttf-liberation otf-font-awesome
    adw-gtk-theme papirus-icon-theme qt5ct qt6ct kvantum

    # ── shell ────────────────────────────────────────────────────────────────
    fish
)

info "Instalando o sistema base — esta é a parte demorada…"
(( ${#HW_PKGS[@]} ))  && PACKAGES+=("${HW_PKGS[@]}")
(( ${#GPU_PKGS[@]} )) && PACKAGES+=("${GPU_PKGS[@]}")

pacstrap -K "$MNT" "${PACKAGES[@]}" || die "pacstrap falhou. Veja $LOG"
ok "Pacotes instalados"

info "Escrevendo o fstab…"
genfstab -U "$MNT" >>"$MNT/etc/fstab" || die "genfstab falhou."

if (( SWAP_MIB > 0 )); then
    info "Criando um arquivo de swap de ${SWAP_MIB} MiB…"
    if [[ $FSTYPE == btrfs ]]; then
        btrfs filesystem mkswapfile --size "${SWAP_MIB}m" "$MNT/swapfile" 2>/dev/null \
            || warn "Não foi possível criar o swap em btrfs; seguindo sem swap."
    else
        fallocate -l "${SWAP_MIB}M" "$MNT/swapfile" && chmod 600 "$MNT/swapfile" \
            && mkswap "$MNT/swapfile" >/dev/null \
            || warn "Não foi possível criar o arquivo de swap; seguindo sem swap."
    fi
    [[ -f $MNT/swapfile ]] && echo "/swapfile none swap defaults 0 0" >>"$MNT/etc/fstab"
fi

# STYLUS identity goes in before the user is created, so useradd copies the STYLUS
# /etc/skel rather than a vanilla one.
info "Aplicando a identidade visual e as configurações do STYLUS…"
/usr/share/stylus/branding-sync.sh "$MNT" || warn "A sincronização da identidade visual relatou um problema."

info "Configurando o sistema instalado…"

# Console keymap -> X11 layout (br-abnt2 -> layout br, model abnt2)
XKB_LAYOUT=${KEYMAP%%-*}
XKB_MODEL=pc105
[[ $KEYMAP == *abnt2* ]] && XKB_MODEL=abnt2

# The answers are handed over in a file rather than interpolated into the
# script. Writing them inline would let a password containing $ or a backtick
# be expanded - or executed - by the shell that generates this.
{
    printf 'STYLUS_TIMEZONE=%q\n'   "$TIMEZONE"
    printf 'STYLUS_LOCALE=%q\n'     "$LOCALE"
    printf 'STYLUS_KEYMAP=%q\n'     "$KEYMAP"
    printf 'STYLUS_XKB_LAYOUT=%q\n' "$XKB_LAYOUT"
    printf 'STYLUS_XKB_MODEL=%q\n'  "$XKB_MODEL"
    printf 'STYLUS_HOSTNAME=%q\n'   "$HOSTNAME"
    printf 'STYLUS_USERNAME=%q\n'   "$USERNAME"
    printf 'STYLUS_USERPASS=%q\n'   "$USERPASS"
    printf 'STYLUS_ROOTPASS=%q\n'   "$ROOTPASS"
    printf 'STYLUS_DISK=%q\n'       "$DISK"
    printf 'STYLUS_MULTILIB=%q\n'   "$ENABLE_MULTILIB"
    printf 'STYLUS_NVIDIA=%q\n'     "$( [[ $GPU_CHOICE == nvidia ]] && echo 1 || echo 0 )"
} > "$MNT/root/.stylus-answers"
chmod 600 "$MNT/root/.stylus-answers"

# Quoted delimiter: this heredoc is written out verbatim.
cat >"$MNT/root/stylus-configure.sh" <<'CHROOT'
#!/usr/bin/env bash
set -euo pipefail
. /root/.stylus-answers

ln -sf "/usr/share/zoneinfo/${STYLUS_TIMEZONE}" /etc/localtime
hwclock --systohc || true

# The live medium has multilib enabled, so pacstrap could install the 32-bit
# graphics libraries; a freshly installed system has it commented out. Left
# that way, those packages would belong to no repository at all - pacman would
# never update them again and would warn about them on every upgrade. Enable it
# here so what was just installed stays installed.
if [[ ${STYLUS_MULTILIB:-0} == 1 ]] && ! pacman-conf --repo-list | grep -qx multilib; then
    sed -i '/^#\[multilib\]/,/^#Include = .*mirrorlist/ s/^#//' /etc/pacman.conf
    pacman-conf --repo-list | grep -qx multilib ||
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
    pacman -Sy --noconfirm >/dev/null 2>&1 || true
fi

grep -q "^${STYLUS_LOCALE}" /etc/locale.gen || echo "${STYLUS_LOCALE} UTF-8" >> /etc/locale.gen
sed -i "s/^#${STYLUS_LOCALE}/${STYLUS_LOCALE}/" /etc/locale.gen
locale-gen
echo "LANG=${STYLUS_LOCALE}" > /etc/locale.conf
echo "KEYMAP=${STYLUS_KEYMAP}" > /etc/vconsole.conf

mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<XKB
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "${STYLUS_XKB_LAYOUT}"
    Option "XkbModel" "${STYLUS_XKB_MODEL}"
EndSection
XKB

echo "${STYLUS_HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${STYLUS_HOSTNAME}.localdomain ${STYLUS_HOSTNAME}
HOSTS

mkdir -p /etc/mkinitcpio.conf.d
cat > /etc/mkinitcpio.conf.d/stylus.conf <<'MKI'
HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
MKI

# Everything an NVIDIA machine needs and that nothing else writes: the driver's
# module options, its modules in the boot image instead of the kms hook, and a
# pacman hook to keep the boot image in step with driver updates.
#
# The kms hook above is the reason this matters. It puts every DRM driver the
# machine has into the boot image, nouveau included - and on a machine with the
# NVIDIA driver installed that is a race the NVIDIA driver loses: nouveau takes
# the card before the root filesystem is even mounted, and nvidia then has
# nothing left to bind to. stylus-gpu writes the file that overrides it, under a
# name that sorts after this one so it actually wins.
if [ "${STYLUS_NVIDIA:-0}" = 1 ] && [ -x /usr/local/bin/stylus-gpu ]; then
    /usr/local/bin/stylus-gpu --write-nvidia-config || true
    # Suspend on a machine with an NVIDIA card has to save the card's memory
    # somewhere and put it back on the way up. Without these the machine wakes
    # with the card in a state nothing can use, and the first game after
    # closing the lid hangs on a computer that otherwise looks fine.
    systemctl enable nvidia-suspend.service nvidia-hibernate.service \
                     nvidia-resume.service 2>/dev/null || true
fi

mkinitcpio -P

useradd -m -G wheel,audio,video,input,storage,network,lp -s /usr/bin/fish "${STYLUS_USERNAME}"

# GameMode can only lower a game's nice value for users in its own group, and
# raising the game above the browser is most of what GameMode is for on these
# machines. Added afterwards rather than in the line above on purpose: useradd
# fails outright on a group that does not exist, and it would take the whole
# installation with it if the gamemode package ever changed name.
if getent group gamemode >/dev/null 2>&1; then
    usermod -aG gamemode "${STYLUS_USERNAME}" || true
fi
echo "${STYLUS_USERNAME}:${STYLUS_USERPASS}" | chpasswd
if [ -n "${STYLUS_ROOTPASS}" ]; then
    echo "root:${STYLUS_ROOTPASS}" | chpasswd
else
    passwd -l root
fi

install -d -m 750 /etc/sudoers.d
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable sddm.service
systemctl enable systemd-timesyncd.service
systemctl enable fstrim.timer
# The socket, not the service. cups is socket-activated: with cups.socket the
# daemon is started the first time something actually prints or opens a printer
# dialog, and a machine that never sees a printer never starts it at all.
# Enabling the service instead ran a daemon at every boot of every machine in
# the lab for the benefit of the one with a printer attached.
systemctl enable cups.socket
systemctl enable ufw.service
systemctl enable paccache.timer
# Without this the bar's power profile module has nothing to talk to and stays
# blank, since powerprofilesctl reaches the daemon over D-Bus.
systemctl enable power-profiles-daemon.service
systemctl enable earlyoom.service
# Checks, before the login screen, that some graphics driver actually took the
# card - and loads nouveau if none did. It is what stops a failed NVIDIA driver
# from turning into a machine with no desktop to repair it from. Costs
# milliseconds on every machine where nothing is wrong.
systemctl enable stylus-gpu-fallback.service
ufw default deny incoming  || true
ufw default allow outgoing || true
ufw --force enable         || true

if [ -d /sys/firmware/efi/efivars ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=STYLUS
else
    grub-install --target=i386-pc "${STYLUS_DISK}"
fi
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grep -q '^GRUB_DISABLE_OS_PROBER' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet splash"/' /etc/default/grub
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="STYLUS"/' /etc/default/grub
grep -q '^GRUB_DISTRIBUTOR' /etc/default/grub || echo 'GRUB_DISTRIBUTOR="STYLUS"' >> /etc/default/grub

# The STYLUS boot menu. gfxterm is what makes a theme render at all; without an
# explicit GFXMODE some firmware drops to 640x480 and the theme looks cramped.
if [ -f /usr/share/grub/themes/stylus/theme.txt ]; then
    sed -i '/^GRUB_THEME=/d; /^GRUB_GFXMODE=/d; /^GRUB_TERMINAL_OUTPUT=/d; /^GRUB_GFXPAYLOAD_LINUX=/d' /etc/default/grub
    {
        echo 'GRUB_THEME="/usr/share/grub/themes/stylus/theme.txt"'
        echo 'GRUB_GFXMODE="1920x1080,1366x768,auto"'
        echo 'GRUB_GFXPAYLOAD_LINUX="keep"'
        echo 'GRUB_TERMINAL_OUTPUT="gfxterm"'
    } >> /etc/default/grub
fi

# Two ways back into a machine whose graphics driver stopped working.
#
# This is the hole that made a bad NVIDIA driver unrecoverable rather than
# merely annoying: with no driver the greeter never appears, and everything
# that could diagnose or repair it lives behind that greeter. A student with a
# black screen has no next step at all.
#
# The first entry blacklists the NVIDIA modules and lets nouveau take the card.
# It is slower and it draws a desktop, from which `stylus-gpu --fix` can be run
# and will say exactly what went wrong. The second gives up on graphics
# entirely and boots to a text console, which works when nothing else does.
#
# Both use the fallback boot image on purpose. The normal one is built with
# autodetect and only contains the modules this machine needed at the time it
# was built; the fallback contains everything, which is the difference when
# what changed is a driver.
ROOT_UUID=$(findmnt -no UUID / 2>/dev/null || true)
if [ -n "${ROOT_UUID}" ] && [ -f /boot/vmlinuz-linux ]; then
    [ -f /boot/initramfs-linux-fallback.img ] \
        && RECOVERY_INITRD=/boot/initramfs-linux-fallback.img \
        || RECOVERY_INITRD=/boot/initramfs-linux.img
    NV_BLACKLIST=nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm
    cat >> /etc/grub.d/40_custom <<CUSTOM

menuentry 'STYLUS — recuperação de vídeo (driver livre)' --class stylus --class gnu-linux --class os {
    load_video
    insmod gzio
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw loglevel=3 modprobe.blacklist=${NV_BLACKLIST}
    initrd ${RECOVERY_INITRD}
}

menuentry 'STYLUS — modo texto (sem vídeo nenhum)' --class stylus --class gnu-linux --class os {
    load_video
    insmod gzio
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw nomodeset systemd.unit=multi-user.target
    initrd ${RECOVERY_INITRD}
}
CUSTOM
    chmod +x /etc/grub.d/40_custom
fi

grub-mkconfig -o /boot/grub/grub.cfg

cp -rn /etc/skel/. "/home/${STYLUS_USERNAME}/" 2>/dev/null || true
chown -R "${STYLUS_USERNAME}:${STYLUS_USERNAME}" "/home/${STYLUS_USERNAME}"
CHROOT

chmod +x "$MNT/root/stylus-configure.sh"
arch-chroot "$MNT" /root/stylus-configure.sh || die "A configuração do novo sistema falhou. Veja $LOG"
rm -f "$MNT/root/stylus-configure.sh" "$MNT/root/.stylus-answers"

# The live medium autologins; a real installation must not.
rm -f "$MNT/etc/sudoers.d/10-stylus-live"
[[ -f $MNT/etc/sddm.conf.d/stylus.conf ]] && \
    sed -i '/^\[Autologin\]/,/^\[/{/^User=/d;/^Session=/d}' "$MNT/etc/sddm.conf.d/stylus.conf"

sync
ok "Instalação concluída"

cat <<EOF

${c_grn}  O STYLUS está instalado.${c_reset}

    Entre como      ${c_b}$USERNAME${c_reset}
    Outros sistemas $( [[ $MODE == wipe ]] && echo 'nenhum — o disco foi apagado' || echo 'mantidos; o GRUB foi configurado para detectá-los' )
    Registro        $LOG

    Depois do primeiro boot, pressione ${c_b}Mod+G${c_reset} para abrir o lançador, ou
    ${c_b}Mod+Shift+A${c_reset} para o catálogo de programas, e instale navegador,
    jogos, drivers e o que mais quiser.

EOF

read -rp "  Reiniciar no STYLUS agora? [s/N] " r
if [[ ${r,,} == s* || ${r,,} == y* ]]; then
    umount -R "$MNT" 2>/dev/null
    systemctl reboot
fi
