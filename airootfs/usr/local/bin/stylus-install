#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  stylus-install — guided STYLUS installer
#
#  Asks a short list of plain questions, shows you exactly what it is about to
#  do, and only then touches the disk. Three disk modes:
#
#    alongside  create STYLUS in unallocated free space, reuse the existing EFI
#               partition, and leave every other operating system untouched
#    partition  format one partition you pick, nothing else
#    wipe       erase an entire disk (requires typing APAGAR)
#
#  stylus-install --advanced  hands over to upstream archinstall instead.
#
#  Everything is logged to /var/log/stylus-install.log
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

LOG=/var/log/stylus-install.log
MNT=/mnt
MIN_ROOT_MIB=20480            # 20 GiB — refuse to install into less
ESP_TYPE_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_blue=$'\033[1;34m'; c_grn=$'\033[1;32m'
c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'

info() { printf '%s==>%s %s\n' "$c_blue" "$c_reset" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_grn"  "$c_reset" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_yel"  "$c_reset" "$*"; }
die()  { printf '\n%s==> ERRO:%s %s\n' "$c_red" "$c_reset" "$*" >&2
         printf '    O registro completo está em %s\n' "$LOG" >&2; exit 1; }

# ── Interaction helpers (dialog when available, prompts otherwise) ───────────
USE_DIALOG=0
command -v dialog >/dev/null && [[ -t 0 && -t 1 ]] && USE_DIALOG=1
DTITLE="Instalador do STYLUS"
# dialog labels its own buttons from its gettext catalogue, which is not
# guaranteed to be installed for pt_BR. Naming them here means the buttons match
# the questions above them whatever dialog would have chosen.
DLABELS=(--ok-label "OK" --cancel-label "Cancelar")
DYESNO=(--yes-label "Sim" --no-label "Não")

msg() {
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DLABELS[@]}" --msgbox "\n$1" 16 74
    else
        printf '\n  %s\n' "$1"; read -rp "  Pressione Enter… "
    fi
}

ask_input() {   # ask_input <prompt> <default>
    local prompt=$1 default=${2:-} out
    if (( USE_DIALOG )); then
        out=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --inputbox "\n$prompt" 10 66 "$default" \
              3>&1 1>&2 2>&3) || return 1
    else
        read -rp "  $prompt [${default}]: " out
    fi
    printf '%s' "${out:-$default}"
}

ask_password() {
    local prompt=$1 a b
    while :; do
        if (( USE_DIALOG )); then
            a=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --insecure --passwordbox "\n$prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
            b=$(dialog --backtitle "$DTITLE" "${DLABELS[@]}" --insecure --passwordbox "\nConfirme: $prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
        else
            read -rsp "  $prompt: " a; echo
            read -rsp "  Confirme: "  b; echo
        fi
        [[ -z $a ]] && { msg "A senha não pode ficar em branco."; continue; }
        [[ $a == "$b" ]] && { printf '%s' "$a"; return 0; }
        msg "As duas senhas não são iguais. Tente de novo."
    done
}

ask_menu() {    # ask_menu <prompt> <tag1> <desc1> [tag2 desc2 ...]
    local prompt=$1; shift
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DLABELS[@]}" --menu "\n$prompt" 20 78 10 "$@" 3>&1 1>&2 2>&3
    else
        local -a tags=() descs=()
        while (( $# )); do tags+=("$1"); descs+=("$2"); shift 2; done
        # To stderr, not stdout. Every caller reads this function through
        # `X=$(ask_menu …)`, so anything printed on stdout is captured as part
        # of the answer - the prompt and the whole numbered list ended up
        # inside $DISK, $MODE and $FSTYPE. The dialog branch above already
        # redirects for exactly this reason (3>&1 1>&2 2>&3); this branch did
        # not. It only shows up without dialog installed, or when stdin is not
        # a terminal, which is why it survived: the ISO has dialog.
        printf '\n  %s\n\n' "$prompt" >&2
        local i
        for i in "${!tags[@]}"; do
            printf '   %2d) %-14s %s\n' "$((i+1))" "${tags[i]}" "${descs[i]}" >&2
        done
        local c; read -rp $'\n  Escolha: ' c
        [[ $c =~ ^[0-9]+$ ]] && (( c>=1 && c<=${#tags[@]} )) && printf '%s' "${tags[c-1]}"
    fi
}

ask_yesno() {
    local q=$1
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" "${DYESNO[@]}" --yesno "\n$q" 12 70
    else
        # "s" for sim, and "y" still works for anyone typing out of habit.
        local a; read -rp "  $q [s/N] " a; [[ ${a,,} == s* || ${a,,} == y* ]]
    fi
}

# ── Preflight ────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Execute como root:  sudo stylus-install"

case ${1:-} in
    --advanced)
        # Straight to upstream archinstall. There is no STYLUS preset to hand it
        # - the option is documented as "the original archinstall instead of
        # this one", for somebody who wants the full manual installer, and a
        # --config pointing at a file that is not on the medium made archinstall
        # abort at launch with a stack trace instead of opening.
        command -v archinstall >/dev/null || die "archinstall não está neste medium."
        exec archinstall ;;
    -h|--help)  cat <<'AJUDA'; exit 0 ;;
stylus-install — instalador guiado do STYLUS

Faz uma lista curta de perguntas simples, mostra exatamente o que vai fazer, e
só então mexe no disco. Três modos de disco:

  alongside   cria o STYLUS no espaço livre não alocado, reaproveita a partição
              EFI existente e não toca em nenhum outro sistema operacional
  partition   formata uma partição que você escolher, e mais nada
  wipe        apaga um disco inteiro (exige digitar APAGAR)

    stylus-install --advanced   usa o archinstall original no lugar deste

Tudo é registrado em /var/log/stylus-install.log
AJUDA
esac

FIRMWARE=BIOS
[[ -d /sys/firmware/efi/efivars ]] && FIRMWARE=UEFI

# Whether there is a network, asked the way pacstrap is going to ask it.
#
# This was one `ping archlinux.org`, and ICMP is blocked on a great many school
# and campus networks - including exactly the kind this distribution exists
# for. On those the installer refused to start, at the first step, on a machine
# whose network was working perfectly, with a message telling the student to
# connect to a network they were already connected to. There is no way past
# that and nothing on screen suggesting there should be.
#
# An HTTPS request is the honest question, because downloading packages is an
# HTTPS request. ping stays as a fallback for the reverse case: a network that
# answers ICMP while something sits in front of HTTPS.
have_network() {
    local url
    for url in https://archlinux.org/ https://geo.mirror.pkgbuild.com/; do
        if command -v curl >/dev/null 2>&1; then
            curl -fsS --max-time 8 -o /dev/null "$url" 2>/dev/null && return 0
        fi
        if command -v wget >/dev/null 2>&1; then
            wget -q --timeout=8 -O /dev/null "$url" 2>/dev/null && return 0
        fi
    done
    ping -c1 -W3 archlinux.org &>/dev/null
}

have_network || die "Sem conexão com a internet.

Conecte-se primeiro — clique no ícone de Wi-Fi na barra, ou execute nmtui.

Se você já está conectado e mesmo assim aparece isto, provavelmente a rede pede
login numa página (é o caso de muitas redes de escola): abra o navegador, faça
o login, e rode o instalador de novo."

for tool in sgdisk parted mkfs.ext4 mkfs.vfat pacstrap genfstab arch-chroot lsblk reflector; do
    command -v "$tool" >/dev/null || die "Ferramenta necessária não encontrada: $tool"
done

clear
msg "Bem-vindo ao instalador do STYLUS.

Ele faz algumas perguntas, mostra um resumo e não mexe em nada até você
confirmar no final.

Firmware detectado: $FIRMWARE

Para manter outro sistema operacional, escolha 'alongside' na etapa do disco —
essa opção usa apenas espaço livre não alocado e nunca formata uma partição que
já existe. Se ainda não houver espaço livre, saia e crie um com o GParted (ele
já está instalado)."

# ── Questions ────────────────────────────────────────────────────────────────
KEYMAP=$(ask_input "Layout do teclado (br-abnt2, us, ...)" "br-abnt2") || exit 1
LOCALE=$(ask_input "Idioma do sistema" "pt_BR.UTF-8")                   || exit 1

# Brazilian default, overridden by geolocation when there is a network.
TZ_GUESS=$(curl -fsS --max-time 5 https://ipapi.co/timezone 2>/dev/null)
[[ -f /usr/share/zoneinfo/${TZ_GUESS:-nope} ]] || TZ_GUESS=America/Campo_Grande
TIMEZONE=$(ask_input "Fuso horário (Região/Cidade)" "$TZ_GUESS")   || exit 1
[[ -f /usr/share/zoneinfo/$TIMEZONE ]] || die "Fuso horário desconhecido: $TIMEZONE"

HOSTNAME=$(ask_input "Nome do computador" "stylus")       || exit 1

while :; do
    USERNAME=$(ask_input "Seu nome de usuário (minúsculas, sem espaços)" "") || exit 1
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
    msg "'$USERNAME' não serve como nome de usuário. Use letras minúsculas, números, - e _."
done
USERPASS=$(ask_password "Senha de $USERNAME") || exit 1

if ask_yesno "Definir uma senha separada de root (administrador)?

Responder Não bloqueia a conta root e você administra a máquina com sudo, que é
o que a maioria das distribuições faz."; then
    ROOTPASS=$(ask_password "Senha de root") || exit 1
else
    ROOTPASS=""
fi

# ── Disk selection ───────────────────────────────────────────────────────────
# Never offer the medium we are running from.
LIVE_DISK=""
live_src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)
[[ -n $live_src ]] && LIVE_DISK=$(lsblk -npo PKNAME "$live_src" 2>/dev/null | head -1)

mapfile -t disks < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"')
disk_menu=()
for d in "${disks[@]}"; do
    dev=$(awk '{print $1}' <<<"$d")
    [[ -n $LIVE_DISK && $dev == "$LIVE_DISK" ]] && continue
    disk_menu+=("$dev" "$(sed "s|^$dev *||; s/ disk$//" <<<"$d")")
done
(( ${#disk_menu[@]} )) || die "Nenhum disco onde instalar foi encontrado."

DISK=$(ask_menu "Em qual disco o STYLUS deve ser instalado?" "${disk_menu[@]}") || exit 1
[[ -b $DISK ]] || die "Não é um dispositivo de bloco: $DISK"

clear
printf '\n%s  Organização atual de %s%s\n\n' "$c_b" "$DISK" "$c_reset"
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK"
printf '\n'
read -rp "  Pressione Enter para continuar… "

find_free_space() {     # biggest unallocated gap: "START_MIB END_MIB SIZE_MIB"
    parted -m -s "$1" unit MiB print free 2>/dev/null |
    awk -F: '/:free;$/ {
        s=$2; e=$3; sz=$4
        sub(/MiB/,"",s); sub(/MiB/,"",e); sub(/MiB/,"",sz)
        if (sz+0 > best+0) { best=sz+0; bs=s+0; be=e+0 }
    } END { if (best>0) printf "%d %d %d\n", bs, be, best }'
}

find_esp() {
    lsblk -rpno NAME,PARTTYPE "$1" |
        awk -v g="$ESP_TYPE_GUID" 'tolower($2)==g {print $1; exit}'
}

# The little partition GRUB embeds itself into when booting a GPT disk without
# UEFI. Without one, `grub-install --target=i386-pc` refuses at the very end -
# after forty minutes of downloading - with a message about embedding.
BIOS_BOOT_GUID=21686148-6449-6e6f-744e-656564454649
find_bios_boot() {
    lsblk -rpno NAME,PARTTYPE "$1" |
        awk -v g="$BIOS_BOOT_GUID" 'tolower($2)==g {print $1; exit}'
}

# Why "alongside" cannot be offered on this disk, or nothing at all when it can.
#
# The menu entry for it says "manter todo o resto", and the installer says
# "nenhuma outra partição foi modificada" after it runs. Both were promises the
# code could not always keep:
#
#  - sgdisk is a GPT tool. Handed a disk with an MBR partition table - which is
#    every machine that came with Windows 7, and plenty that came with 10 - it
#    converts the table to GPT in place. The other operating system on that disk
#    stops booting. Nothing warned, and the mode that promises not to touch
#    anything was the one doing it.
#
#  - On a GPT disk booted without UEFI, GRUB needs a BIOS boot partition to
#    embed itself into. When there is none the install fails at grub-install,
#    which is the last step, long after the disk has been written to.
#
# A pure function of six values so it can be tested without a disk: everything
# it needs is passed in.
alongside_block_reason() {  # <pttype> <firmware> <esp> <bios-boot> <free-mib> <min-mib>
    local pt=$1 fw=$2 esp=$3 bios=$4 free=$5 min=$6

    if (( free < min )); then
        printf 'não há espaço livre não alocado suficiente neste disco (%s GiB livres, e o STYLUS precisa de %s GiB). Use o GParted para diminuir uma partição existente e abrir espaço.' \
               "$(( free / 1024 ))" "$(( min / 1024 ))"
        return 0
    fi
    if [[ $pt != gpt ]]; then
        printf 'este disco usa uma tabela de partições antiga (%s), e criar uma partição nela converteria a tabela para GPT — o que faria o outro sistema operacional do disco parar de iniciar. Para instalar ao lado dele seria preciso converter o disco antes, com o Windows fechado e com backup.' \
               "${pt:-desconhecida}"
        return 0
    fi
    if [[ $fw == UEFI && -z $esp ]]; then
        printf 'não há partição EFI neste disco para compartilhar. Crie uma com o GParted, ou use "wipe".'
        return 0
    fi
    if [[ $fw != UEFI && -z $bios ]]; then
        printf 'este computador inicia pelo modo antigo (BIOS) e o disco é GPT sem a partição de boot que o GRUB precisa. Sem ela a instalação falharia no final. Use "wipe", ou crie uma partição "BIOS boot" de 2 MiB com o GParted.'
        return 0
    fi
    return 1
}

FREE_START=0; FREE_END=0; FREE_SIZE=0
read -r FREE_START FREE_END FREE_SIZE < <(find_free_space "$DISK") || true
FREE_SIZE=${FREE_SIZE:-0}
EXISTING_ESP=$(find_esp "$DISK")
EXISTING_BIOS_BOOT=$(find_bios_boot "$DISK")
PTTYPE=$(lsblk -dno PTTYPE "$DISK" 2>/dev/null | head -1)

mode_menu=()
ALONGSIDE_WHY_NOT=$(alongside_block_reason "$PTTYPE" "$FIRMWARE" "$EXISTING_ESP" \
                                           "$EXISTING_BIOS_BOOT" "$FREE_SIZE" "$MIN_ROOT_MIB")
if [[ -z $ALONGSIDE_WHY_NOT ]]; then
    mode_menu+=(alongside "Usar os $((FREE_SIZE/1024)) GiB livres e manter todo o resto")
else
    # Said out loud rather than quietly left out of the menu. Somebody who came
    # here to install next to Windows and does not see the option needs to know
    # why, or the conclusion they reach is that STYLUS cannot do it at all.
    msg "Não dá para instalar ao lado do que já está no $DISK, porque $ALONGSIDE_WHY_NOT

As outras opções continuam disponíveis."
fi
mode_menu+=(partition "Formatar uma partição que eu escolher")
mode_menu+=(wipe      "Apagar o disco INTEIRO e começar do zero")

MODE=$(ask_menu "Como o STYLUS deve usar o $DISK?" "${mode_menu[@]}") || exit 1

TARGET_PART=""
case $MODE in
  alongside)
    # Belt and braces: the menu should not have offered it, and this runs one
    # step before the disk is written to.
    [[ -z $ALONGSIDE_WHY_NOT ]] || die "Não dá para instalar ao lado: $ALONGSIDE_WHY_NOT"
    ;;
  partition)
    mapfile -t parts < <(lsblk -rpno NAME,SIZE,FSTYPE,MOUNTPOINTS "$DISK" | awk 'NR>1')
    (( ${#parts[@]} )) || die "O $DISK não tem partições para escolher."
    part_menu=()
    for p in "${parts[@]}"; do
        pdev=$(awk '{print $1}' <<<"$p")
        part_menu+=("$pdev" "$(sed "s|^$pdev *||" <<<"$p")")
    done
    TARGET_PART=$(ask_menu "Qual partição deve ser FORMATADA como raiz do STYLUS?
Tudo que estiver nela será perdido. As outras partições não são tocadas." "${part_menu[@]}") || exit 1
    [[ -b $TARGET_PART ]] || die "Não é uma partição: $TARGET_PART"
    findmnt -rno TARGET "$TARGET_PART" &>/dev/null && die "$TARGET_PART está montada no momento."

    # The EFI partition is checked here, not later, and that ordering is the
    # whole point. This mode reuses an existing ESP rather than creating one -
    # and the check that there *is* one lived after mkfs. On a UEFI machine
    # whose disk had no ESP, the installer formatted the partition the student
    # chose, destroying whatever was on it, and only then gave up saying it had
    # nowhere to put the bootloader. Nothing was gained by the formatting and
    # there was no way to undo it.
    if [[ $FIRMWARE == UEFI && -z $EXISTING_ESP ]]; then
        die "Este computador inicia por UEFI e o $DISK não tem partição de sistema EFI.

O STYLUS precisa de uma para instalar o carregador de boot, e neste modo ele
reaproveita a que já existe em vez de criar uma.

Escolha 'wipe' (que cria uma), ou crie uma partição EFI de 1 GiB com o GParted
— tipo FAT32, sinalizadores 'boot' e 'esp' — e rode o instalador de novo.

Nada foi alterado no disco."
    fi

    # And the ESP must not be the partition being formatted, which is a click
    # away in the menu above: the list is every partition on the disk, the ESP
    # included, and formatting it as ext4 takes the other operating system's
    # bootloader with it.
    if [[ -n $EXISTING_ESP && $TARGET_PART == "$EXISTING_ESP" ]]; then
        die "$TARGET_PART é a partição de sistema EFI do disco.

Formatá-la apagaria o carregador de boot de todos os sistemas instalados aqui,
inclusive os outros. Escolha outra partição.

Nada foi alterado no disco."
    fi

    psize=$(( $(blockdev --getsize64 "$TARGET_PART") / 1024 / 1024 ))
    (( psize >= MIN_ROOT_MIB )) || \
        die "$TARGET_PART tem só $((psize/1024)) GiB; o STYLUS precisa de pelo menos $((MIN_ROOT_MIB/1024)) GiB."
    ;;
  wipe)
    ask_yesno "Isso APAGA TUDO no $DISK, inclusive qualquer outro sistema
operacional instalado nele.

Tem certeza?" || exit 1
    # The confirmation word is translated too: typing a word you do not read as
    # a word is not a confirmation, it is copying letters off the screen.
    read -rp "  Digite APAGAR em maiúsculas para confirmar: " confirm
    [[ $confirm == APAGAR ]] || die "Não confirmado — nada foi alterado."
    ;;
  *) exit 1 ;;
esac

FSTYPE=$(ask_menu "Sistema de arquivos da partição raiz do STYLUS" \
    ext4  "Simples e confiável (recomendado)" \
    btrfs "Snapshots e compressão") || exit 1

# ── Swap file size ───────────────────────────────────────────────────────────
# Sized against the disk as well as the memory. The old default was simply
# min(RAM, 8 GiB), which ignored where it was going: on the 32 GiB eMMC laptops
# schools buy, a machine with 4 GiB of memory proposed a 4 GiB swap file - an
# eighth of the whole disk - and one with 8 GiB proposed 8.
#
# It does not need to match the memory anyway. zram already provides swap
# sized to half of RAM, compressed and in memory; this file is the overflow
# underneath it, which is reached rarely and does not need to be large. A tenth
# of the root partition is the ceiling, so the proportion holds on any disk.
#
# Still only a default: the question is asked either way and any number can be
# typed, including 0.
root_mib() {
    case $MODE in
        alongside) printf '%s' "$(( FREE_END - FREE_START ))" ;;
        partition) printf '%s' "${psize:-0}" ;;
        wipe)      printf '%s' "$(( $(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0) / 1024 / 1024 ))" ;;
        *)         printf '0' ;;
    esac
}

RAM_MIB=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
ROOT_MIB=$(root_mib)
SWAP_DEFAULT=$(( RAM_MIB > 8192 ? 8192 : RAM_MIB ))
if (( ROOT_MIB > 0 )); then
    disk_cap=$(( ROOT_MIB / 10 ))
    (( SWAP_DEFAULT > disk_cap )) && SWAP_DEFAULT=$disk_cap
fi
# Below a gigabyte a swap file is not worth the space it costs; zram covers it.
(( SWAP_DEFAULT < 1024 )) && SWAP_DEFAULT=0

SWAP_MIB=$(ask_input "Tamanho do arquivo de swap em MiB (0 para nenhum)" "$SWAP_DEFAULT") || exit 1
[[ $SWAP_MIB =~ ^[0-9]+$ ]] || SWAP_MIB=0

# ── Hardware that worked on the USB stick and would stop working after ───────
# These are on the live medium and were not being installed, which produces the
# worst kind of bug report: it worked before I installed it.
HW_PKGS=(
    # Sound Open Firmware. Intel laptops from about 2019 on have no audio at
    # all without it - not quiet audio, no sound card. This is the single most
    # common "I installed it and the sound disappeared" on Arch.
    sof-firmware
    alsa-utils
    # Wi-Fi regulatory rules. Without them the card is limited to the most
    # conservative channel set, so the 5 GHz network the school runs may simply
    # not appear.
    wireless-regdb
    linux-firmware-marvell
    # Mobile broadband. NetworkManager cannot see a built-in LTE modem without
    # it, and a few school laptops have one.
    modemmanager
)

# Broadcom wireless is detected rather than always installed. The module is
# built by DKMS on every kernel update, which is a real cost on a slow machine,
# and most machines have nothing for it to drive. The ones that do have no Wi-Fi
# at all without it.
#
# The DKMS build rather than the prebuilt broadcom-wl: this installs both the
# normal and the LTS kernel, and the prebuilt module only matches the first. The
# LTS kernel exists to be booted when the normal one breaks, which is exactly
# when needing to reach the network matters most.
if lspci 2>/dev/null | grep -Ei 'network|wireless' | grep -qi 'broadcom'; then
    HW_PKGS+=(broadcom-wl-dkms dkms)
fi

# ── Graphics driver ──────────────────────────────────────────────────────────
# Nothing installed a graphics driver. Intel and AMD survived that because mesa
# arrives as a dependency, but an NVIDIA machine came up on nouveau or on
# software rendering - which is also why the desktop's compositor has a check
# for whether a render node exists at all. A machine whose whole selling point
# includes games should not need a trip to the software catalog before it can
# draw one.
GPU_PKGS=()
ENABLE_MULTILIB=0

detect_gpus() {
    local line out=""
    while IFS= read -r line; do
        case ${line,,} in
            *nvidia*)                                   out+="nvidia "  ;;
            *"advanced micro devices"*|*"amd/ati"*|*radeon*) out+="amd " ;;
            *intel*)                                    out+="intel "   ;;
        esac
    done < <(lspci 2>/dev/null | grep -Ei 'vga|3d controller|display controller')
    printf '%s' "$out"
}

GPUS=$(detect_gpus)
GPU_SEEN=$(lspci 2>/dev/null | grep -Ei 'vga|3d controller|display controller' |
           sed 's/^[0-9a-f:.]* //' | head -3)
[[ -n $GPU_SEEN ]] || GPU_SEEN="(nenhuma detectada)"

# Mesa and its 32-bit half are wanted in every case: they drive Intel and AMD,
# and on a hybrid laptop they still drive the integrated chip that everything
# except games runs on.
#
# The Vulkan loader is in every case too. It is what a game links against - the
# vendor drivers below are plugins for it - and every Vulkan title, all of
# Proton included, fails without it in a way that names neither the loader nor
# the driver. It usually arrives as a dependency of vulkan-radeon or
# vulkan-intel, which is a guarantee only for as long as those are installed.
#
# The software renderer is in packages.install for every machine, not here: it
# is what draws a desktop when the vendor driver does not come up, which is the
# one moment somebody needs a desktop to repair it from.
MESA_SET="mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader"
[[ $GPUS == *intel* ]] && MESA_SET+=" vulkan-intel lib32-vulkan-intel"
[[ $GPUS == *amd*   ]] && MESA_SET+=" vulkan-radeon lib32-vulkan-radeon"

# Playing video on the graphics chip instead of the processor. This is the
# single largest difference available to an old laptop and it was missing:
# decoding 1080p H.264 in software is most of both cores of a 2013 machine -
# the fan runs, the battery goes, and it stutters anyway - while the same clip
# through VA-API is close to idle, on a decoder that was sitting there unused.
#
# Both Intel drivers, deliberately. iHD covers Broadwell and newer, i965 the
# generations before it; they do not conflict and libva picks by device at run
# time. Choosing one from the marketing name in lspci would be a guess, and
# guessing wrong is silent. AMD decodes through mesa, which is already here.
# vpl-gpu-rt alongside them: it is the runtime the newest Intel chips (Tiger
# Lake on) decode through, and the two libva drivers do not cover it.
[[ $GPUS == *intel* ]] && MESA_SET+=" intel-media-driver libva-intel-driver vpl-gpu-rt"

if [[ $GPUS == *nvidia* ]]; then
    # Which NVIDIA driver, decided here rather than asked.
    #
    # There is no one NVIDIA driver: there are four, each covering a different
    # range of cards, and the wrong one does not fail loudly - it installs, the
    # module loads, it binds no card, and the machine runs on the processor
    # looking perfectly configured. The old version of this screen asked the
    # student "is your card older than a GTX 16xx?", which is a question a
    # student cannot answer about a laptop they were given, and then offered
    # nouveau as the answer for older cards - which on a GTX 1050 means giving
    # up most of the card's speed for no reason, because nouveau cannot raise
    # the clocks on Pascal at all.
    #
    # The machine already knows. lspci prints the chip codename and stylus-gpu
    # turns it into the driver name, so this asks nothing and says what it found.
    # Os padrões de reserva apontam para o driver ABERTO, não para o fechado.
    # `nvidia-dkms` não existe mais nos repositórios — o Arch trocou os pacotes
    # principais da NVIDIA pelos módulos abertos — então este `||` era um
    # "target not found" esperando a primeira máquina em que o stylus-gpu não
    # respondesse.
    NV_DRIVER=$(stylus-gpu --nvidia-driver 2>/dev/null || echo open)
    NV_PKG=$(stylus-gpu --nvidia-pkg 2>/dev/null || echo nvidia-open-dkms)
    NV_ARCH_LABEL=$(stylus-gpu --nvidia-label 2>/dev/null || echo "geração não reconhecida")

    case $NV_DRIVER in
        legacy580|legacy470|legacy390)
            # Old enough that nothing in the official repositories drives it.
            # Installing an NVIDIA driver here would blacklist nouveau and
            # leave the machine with no graphics driver whatsoever.
            ask_yesno "Placas de vídeo detectadas:

$GPU_SEEN

Esta placa NVIDIA não tem driver da NVIDIA nos repositórios oficiais: o que
funcionaria nela ($NV_PKG) está na AUR, e compilar da AUR no meio de uma
instalação falha no meio, não no começo.

O driver livre (nouveau) é o que funciona nela agora, e é o que vai ser
instalado. Depois, com o sistema de pé, \`stylus-gpu --fix\` diz o que dá para
melhorar.

Continuar?" || exit 1
            GPU_CHOICE=nouveau ;;
        *)
            nv_label="Driver NVIDIA ($NV_PKG) + bibliotecas de 32 bits"
            [[ $GPUS == *intel* || $GPUS == *amd* ]] &&
                nv_label="NVIDIA ($NV_PKG) + vídeo integrado, com prime-run"

            GPU_CHOICE=$(ask_menu "Placas de vídeo detectadas:

$GPU_SEEN

O STYLUS reconheceu esta placa como $NV_ARCH_LABEL, e o driver certo para ela é
o $NV_PKG. É o que a primeira opção instala — não precisa saber de nada disso
para escolher." \
                nvidia  "$nv_label (recomendado)" \
                nouveau "Driver livre, mais lento, sem compilar nada" \
                skip    "Instalar um driver depois, pelo stylus-app") || exit 1 ;;
    esac
else
    GPU_CHOICE=$( [[ -n $GPUS ]] && echo mesa || echo skip )
    if [[ $GPU_CHOICE == mesa ]]; then
        ask_yesno "Placas de vídeo detectadas:

$GPU_SEEN

Instalar os drivers livres e as bibliotecas de 32 bits para jogos?" || GPU_CHOICE=skip
    fi
fi

case $GPU_CHOICE in
    nvidia)
        # A -dkms package, whichever one this card needs, and never the
        # prebuilt one. This image installs two kernels - linux and linux-lts -
        # and the prebuilt modules are built against linux alone. Booting the
        # LTS kernel, which exists precisely for when the main one breaks,
        # would have found no NVIDIA module at all; and even on the main kernel
        # the prebuilt module and the kernel have to move in lockstep, so an
        # update that lands one without the other leaves the machine on
        # software rendering with nothing to explain it. DKMS rebuilds for
        # every installed kernel. Both kernels' headers are already in
        # PACKAGES, so nothing else is needed.
        # shellcheck disable=SC2206
        GPU_PKGS=("$NV_PKG" dkms nvidia-utils nvidia-settings lib32-nvidia-utils $MESA_SET)
        # A hybrid laptop needs prime-run to send a game to the discrete chip;
        # without it every game runs on the integrated one and nobody can tell
        # why the machine is slow.
        [[ $GPUS == *intel* || $GPUS == *amd* ]] && GPU_PKGS+=(nvidia-prime)
        ENABLE_MULTILIB=1 ;;
    nouveau)
        # nouveau's Vulkan driver is a separate package from mesa and is what a
        # game finds when it asks the loader for a device. Without it the card
        # has a working desktop and no Vulkan at all, which reads as "Steam
        # opens and every game refuses to start".
        # shellcheck disable=SC2206
        GPU_PKGS=($MESA_SET vulkan-nouveau lib32-vulkan-nouveau)
        ENABLE_MULTILIB=1 ;;
    mesa)
        # shellcheck disable=SC2206
        GPU_PKGS=($MESA_SET)
        ENABLE_MULTILIB=1 ;;
    skip)
        GPU_PKGS=() ;;
esac

# ── Desktop environment ──────────────────────────────────────────────────────
# i3 is the default: a listening machine should get out of the way. KDE is
# offered for people who want a full desktop environment — it coexists with
# Stylus sessions and is safe to install alongside.
DESKTOP_CHOICE=i3
DESKTOP_PKGS=()
DESKTOP_SESSION="stylus.desktop"

DESKTOP_CHOICE=$(ask_menu "Ambiente de desktop" \
    i3    "i3wm — leve, minimalista, feito para música (recomendado)" \
    kde   "KDE Plasma — ambiente completo, para quem quer um desktop de verdade") || exit 1

case $DESKTOP_CHOICE in
    kde)
        DESKTOP_SESSION="plasma.desktop"
        DESKTOP_PKGS=(
            plasma-desktop plasma-workspace sddm
            # ── O gerenciador de janelas. NÃO é opcional, e não vem junto ──
            # O KDE separou o KWin em dois pacotes: `kwin` virou o compositor
            # do WAYLAND, e o X11 saiu para `kwin-x11`. O plasma-workspace
            # depende do `kwin` — o de Wayland — e NADA depende do kwin-x11.
            #
            # Este sistema é X11 (DisplayServer=x11, startplasma-x11). Sem
            # esta linha o KDE instalava, abria, mostrava o painel e a área
            # de trabalho, e não tinha gerenciador de janelas NENHUM: não
            # dava para arrastar, redimensionar nem fechar uma janela, o
            # alt+tab não fazia nada e nenhum atalho do KDE funcionava. E
            # nada dizia por quê, porque o `startplasma-x11` existe do mesmo
            # jeito — ele vem do plasma-workspace.
            #
            # O plasma-x11-session são quatro arquivos (só o .desktop da
            # sessão) e depende do kwin-x11: pedir por ele é pedir "a sessão
            # X11 do Plasma, inteira", que é exatamente o que se quer aqui.
            plasma-x11-session
            # ── O que o Plasma NÃO traz sozinho e faz muita falta ──
            # Nenhum destes é dependência de nada acima; sem eles a área de
            # trabalho abre inteira e com buracos que parecem defeito:
            #
            #   kscreen              sem ele NÃO EXISTE a tela de Monitores nas
            #                        configurações: não dá para trocar
            #                        resolução nem ligar um segundo monitor.
            #                        Numa máquina que vai para a TV, é o
            #                        primeiro lugar aonde a pessoa vai.
            #   bluedevil            o bluetooth do KDE. Sem ele, parear um
            #                        fone só pelo bluetoothctl, na mão, num
            #                        sistema cujo assunto é ouvir música.
            #   spectacle            sem ele a tecla Print não faz nada.
            #   plasma-systemmonitor o "gerenciador de tarefas" do KDE
            #                        (Ctrl+Esc). Sem ele não há como ver o
            #                        que travou nem fechar à força.
            kscreen bluedevil spectacle plasma-systemmonitor
            konsole dolphin ark gwenview kate
            plasma-nm plasma-pa powerdevil
            kde-gtk-config kvantum
            xdg-desktop-portal-kde
            ffmpegthumbnailer
        )
        info "KDE Plasma será instalado junto com o i3. O SDDM oferece os dois na tela de login."
        ;;
    i3)
        DESKTOP_SESSION="stylus.desktop"
        DESKTOP_PKGS=()
        ;;
esac

# ── Summary ──────────────────────────────────────────────────────────────────
case $MODE in
  alongside) plan="Criar uma partição $FSTYPE de $(( (FREE_END-FREE_START)/1024 )) GiB no espaço livre do $DISK.
Reaproveitar a partição EFI ${EXISTING_ESP:-(boot BIOS)} sem formatá-la.
Nenhuma partição existente é formatada, redimensionada ou removida." ;;
  partition) plan="Formatar $TARGET_PART como $FSTYPE e instalar o STYLUS nela.
Reaproveitar a partição EFI ${EXISTING_ESP:-(boot BIOS)} sem formatá-la.
Nenhuma outra partição é tocada." ;;
  wipe)      plan="APAGAR TODOS OS DADOS do $DISK e criar um layout novo: EFI + $FSTYPE." ;;
esac

clear
cat <<EOF

${c_b}  O STYLUS será instalado com estas configurações${c_reset}

    Modo de disco  ${c_b}$MODE${c_reset}
    Disco          $DISK
    Sist. arquivos $FSTYPE
    Arquivo swap   $SWAP_MIB MiB
    Vídeo          $( (( ${#GPU_PKGS[@]} )) && echo "${GPU_PKGS[*]}" || echo 'nenhum (instale depois pelo stylus-app)' )
    Desktop        ${DESKTOP_CHOICE} $( [[ $DESKTOP_CHOICE == kde ]] && echo '+ i3 (dual session)' || echo '' )
    Hardware       ${HW_PKGS[*]}
    Firmware       $FIRMWARE
    Nome da máquina $HOSTNAME
    Usuário        $USERNAME $( [[ -n $ROOTPASS ]] && echo '(+ senha de root separada)' || echo '(root bloqueado, só sudo)' )
    Fuso horário   $TIMEZONE
    Idioma         $LOCALE / teclado $KEYMAP

${c_yel}  O que acontece com o disco:${c_reset}
$(sed 's/^/    /' <<<"$plan")

EOF
read -rp "  Digite SIM para começar a instalar, qualquer outra coisa para cancelar: " go
[[ $go == SIM ]] || die "Cancelado — nada foi alterado."

# ── Everything below is logged ───────────────────────────────────────────────
exec > >(tee -a "$LOG") 2>&1
printf '\n===== STYLUS install started %s =====\n' "$(date -Is)"

cleanup() { set +e; swapoff "$MNT/swapfile" 2>/dev/null; umount -R "$MNT" 2>/dev/null; }
trap cleanup EXIT

# ── Repositories, clock and keyring — while the disk is still untouched ──────
#
# Every failure this section exists for used to happen *after* the partition
# table had been rewritten and the root filesystem made: there is nothing to
# undo a wipe with, and "pacstrap falhou" forty minutes in is the worst place
# on the whole path to find out that a package name or a signature was wrong.
# So the repositories are made to work, and the package list is checked against
# them, before a single byte is written to the disk.

# The clock, because package signatures are checked against it. A machine whose
# CMOS battery is dead comes up in 2010, where every signature in the repository
# is dated in the future and pacman refuses all of them with a message about GPG
# that mentions neither the clock nor the year. The mirror's own Date: header is
# the cheapest true answer available, and it is the same request pacman is about
# to make anyway.
acertar_relogio() {
    local cabecalho deles agora fora
    cabecalho=$(curl -sSI --max-time 8 https://archlinux.org/ 2>/dev/null |
                sed -n 's/^[Dd]ate: //p' | tr -d '\r' | head -1)
    [[ -n $cabecalho ]] || return 0
    deles=$(date -d "$cabecalho" +%s 2>/dev/null) || return 0
    [[ $deles =~ ^[0-9]+$ ]] || return 0
    agora=$(date +%s)
    fora=$(( deles > agora ? deles - agora : agora - deles ))
    if (( fora > 600 )); then
        warn "O relógio da máquina estava $(( fora / 60 )) minutos fora do ar — acertando."
        date -s "@$deles" >/dev/null 2>&1 || true
        hwclock --systohc 2>/dev/null || true
    fi
    timedatectl set-ntp true 2>/dev/null || true
}

# multilib, on the LIVE medium.
#
# This is the bug that made "installation isn't working": lib32-gamemode is in
# the package list for every machine, and the graphics drivers add lib32-mesa
# and the rest. The live medium's /etc/pacman.conf is the stock one that comes
# out of the pacman package - archiso does not install the build profile's
# pacman.conf into the image - and in that file multilib is commented out. So
# pacstrap stopped at `target not found: lib32-gamemode`, on a disk it had
# already formatted, on every single machine.
#
# The profile now ships airootfs/etc/pacman.conf with multilib on, which fixes
# it at the source; this stays because the installer also runs on a system
# updated from an older ISO, and because it is two lines.
ligar_multilib() {
    pacman-conf --repo-list 2>/dev/null | grep -qx multilib && return 0
    sed -i '/^#\[multilib\]/,/^#Include = .*mirrorlist/ s/^#//' /etc/pacman.conf
    pacman-conf --repo-list 2>/dev/null | grep -qx multilib && return 0
    printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
    pacman-conf --repo-list 2>/dev/null | grep -qx multilib
}

info "Acertando o relógio…"
acertar_relogio

# ── Os espelhos de download ─────────────────────────────────────────────────
#
# **Sintoma:** a instalação passa vinte e cinco minutos baixando e morre em
# "Operation too slow. Less than 1 bytes/sec transferred" num espelho alemão,
# numa máquina no Brasil — com o disco já formatado.
#
# A causa é o `--latest 20` que estava aqui: ele pega os vinte espelhos DO
# MUNDO que sincronizaram mais recentemente e só ENTÃO ordena esses vinte por
# velocidade. Distância não entra na conta em momento nenhum. Rodando daqui,
# os vinte "mais frescos" são Alemanha, China, Índia, Nova Zelândia, África
# do Sul — e um único espelho brasileiro, por sorte.
#
# O país sai do fuso horário que a pessoa já escolheu lá em cima. O zone.tab
# faz esse mapa (America/Sao_Paulo -> BR), offline, em qualquer máquina Arch:
# nenhum serviço de geolocalização e nenhuma pergunta a mais.
pais_do_fuso() {
    awk -v tz="$1" '$3 == tz { print $1; exit }' /usr/share/zoneinfo/zone.tab 2>/dev/null
}

# Quantos espelhos a lista tem DE VERDADE. Um reflector que "deu certo" e
# gravou só três linhas de comentário é a forma mais silenciosa de ficar sem
# repositório nenhum — e o erro só aparece no pacstrap, depois de formatar.
#
# `grep -c` que não acha nada imprime 0 e SAI COM ERRO; escrito como
# `grep -c ... || echo 0`, isso imprimia "0" duas vezes e o `(( ))` de quem
# chama morria em "operand expected". Daí a variável no meio.
contar_espelhos() {
    local n
    n=$(grep -c '^Server' "${1:-/etc/pacman.d/mirrorlist}" 2>/dev/null)
    printf '%s' "${n:-0}"
}

# ordenar_espelhos [--amplo]
#   sem argumento: o país da pessoa primeiro.
#   --amplo:       ignora o país e mede um campo grande, excluindo os espelhos
#                  que estão na lista atual — é o que se usa na segunda
#                  tentativa, quando os de agora acabaram de falhar.
#
# Grava num temporário e só troca a lista boa por uma que tenha espelho
# dentro: reflector que falha no meio não pode deixar a máquina sem nenhum.
ordenar_espelhos() {
    local amplo=0 pais tmp evitar=""
    [[ ${1:-} == --amplo ]] && amplo=1
    tmp=$(mktemp) || return 1

    local base=(--protocol https --age 24 --threads 8
                --connection-timeout 5 --download-timeout 10)

    if (( amplo )); then
        # Os que estão na lista agora acabaram de falhar; fora todos eles.
        evitar=$(sed -n 's|^Server *= *https\?://\([^/]*\)/.*|\1|p' \
                 /etc/pacman.d/mirrorlist 2>/dev/null | paste -sd '|')
        [[ -n $evitar ]] && base+=(--exclude "$evitar")
    else
        pais=$(pais_do_fuso "$TIMEZONE")
        if [[ -n $pais ]] &&
           reflector "${base[@]}" --country "$pais" --sort rate --number 10 \
                     --save "$tmp" 2>/dev/null &&
           (( $(contar_espelhos "$tmp") >= 3 )); then
            cat "$tmp" > /etc/pacman.d/mirrorlist; rm -f "$tmp"
            ok "Espelhos: $(contar_espelhos) no país do seu fuso horário ($pais)"
            return 0
        fi
    fi

    # País sem espelho suficiente (a maioria dos países não tem três), ou
    # segunda tentativa: mede cem de verdade em vez de confiar na data de
    # sincronismo de vinte, e fica com os dez que responderam mais rápido.
    if reflector "${base[@]}" --latest 100 --fastest 10 --save "$tmp" 2>/dev/null &&
       (( $(contar_espelhos "$tmp") >= 3 )); then
        cat "$tmp" > /etc/pacman.d/mirrorlist; rm -f "$tmp"
        ok "Espelhos: $(contar_espelhos), os mais rápidos que responderam"
        return 0
    fi

    rm -f "$tmp"
    warn "Não deu para escolher espelhos; seguindo com a lista que veio no medium."
    return 1
}

info "Escolhendo os espelhos de download mais próximos…"
ordenar_espelhos

if ligar_multilib; then
    ok "Repositório multilib disponível (programas de 32 bits, Steam, jogos)"
else
    warn "Não deu para ligar o repositório multilib. Os pacotes de 32 bits ficam
      de fora e o Steam não vai rodar até alguém ligá-lo à mão."
fi

info "Baixando a lista de pacotes…"
pacman -Sy --noconfirm >/dev/null 2>&1 || die "Não foi possível baixar a lista de pacotes dos espelhos.

A rede respondeu quando o instalador começou, então isto costuma ser um espelho
fora do ar. Rode o instalador de novo — ele escolhe outros — ou confira a
conexão.

Nada foi alterado no disco."

# The keyring, here rather than in the new root. `pacstrap -K` creates the
# target's keyring by populating it from THIS system's /usr/share/pacman/
# keyrings, so an ISO older than the last key rotation hands the new system a
# set of keys that cannot verify today's packages - and the error names a
# package, never the keyring. Updating it on the live medium first is what makes
# an ISO from six months ago still install.
info "Conferindo o chaveiro de assinaturas…"
pacman -S --needed --noconfirm archlinux-keyring >/dev/null 2>&1 \
    || warn "Não deu para atualizar o chaveiro; seguindo com o que veio no medium."

# ── The package list ────────────────────────────────────────────────────────
# A file, not an array in here. It was an array in here, and that is exactly
# how an installed STYLUS ended up being a different distribution from the ISO
# that installed it: nobody remembers to edit two lists. The list the ISO
# carries is the one that gets installed, and tools/check.sh is what keeps it
# in step with packages.x86_64.
LISTA_PACOTES=${STYLUS_PACKAGE_LIST:-/usr/share/stylus/packages.install}
[[ -r $LISTA_PACOTES ]] || die "A lista de pacotes não está no medium: $LISTA_PACOTES

Isso não deveria acontecer numa ISO do STYLUS. Nada foi alterado no disco."

mapfile -t PACKAGES < <(sed 's/#.*//' "$LISTA_PACOTES" | tr -s '[:space:]' '\n' | grep -v '^$')
# A truncated or empty list would install a machine with no desktop on it and
# only say so at the login screen that never appears.
(( ${#PACKAGES[@]} >= 100 )) || die "A lista de pacotes veio com só ${#PACKAGES[@]} nomes ($LISTA_PACOTES).

Ela está truncada ou corrompida. Nada foi alterado no disco."

(( ${#HW_PKGS[@]} ))  && PACKAGES+=("${HW_PKGS[@]}")
(( ${#GPU_PKGS[@]} )) && PACKAGES+=("${GPU_PKGS[@]}")
(( ${#DESKTOP_PKGS[@]} )) && PACKAGES+=("${DESKTOP_PKGS[@]}")

# Every name in that list, checked against the repositories that are actually
# configured, with the disk still intact.
#
# One name that no longer exists is enough to end a `pacstrap` - and it ends it
# at the end, after the download. Upstream renames packages, splits them, and
# drops them; this list is long and some of it is old. Checked here, a bad name
# costs a line on the screen instead of a formatted disk and forty minutes.
info "Conferindo os nomes dos pacotes…"
mapfile -t SEM_PACOTE < <(LC_ALL=C pacman -Si -- "${PACKAGES[@]}" 2>&1 >/dev/null |
                          sed -n 's/^error: package .\(.*\). was not found$/\1/p' | sort -u)
if (( ${#SEM_PACOTE[@]} )); then
    faltando=" ${SEM_PACOTE[*]} "
    # Without any one of these there is nothing to boot afterwards, so this is a
    # stop and not a warning: the problem is the repositories, not one name.
    for p in base linux mkinitcpio grub sudo networkmanager; do
        [[ $faltando == *" $p "* ]] || continue
        die "O repositório não está oferecendo nem o pacote '$p'.

Isso não é um nome errado — é o espelho respondendo com uma lista incompleta ou
antiga. Rode o instalador de novo (ele escolhe outros espelhos).

Nada foi alterado no disco."
    done

    restantes=()
    for p in "${PACKAGES[@]}"; do
        [[ $faltando == *" $p "* ]] || restantes+=("$p")
    done
    PACKAGES=("${restantes[@]}")

    warn "Estes pacotes não existem mais nos repositórios e ficaram de fora:"
    printf '      %s\n' "${SEM_PACOTE[@]}"
    printf '\n'
    if [[ $faltando == *" lib32-"* ]]; then
        printf '      Os que começam com lib32- são o repositório multilib desligado.\n'
        printf '      Sem eles o Steam e os jogos de 32 bits não abrem; o resto do\n'
        printf '      sistema funciona igual.\n\n'
    fi
    read -rp "  Instalar mesmo assim? Digite SIM para seguir: " go2
    [[ $go2 == SIM ]] || die "Cancelado — nada foi alterado."
fi

# Anything lib32-* that survived means the installed system has to keep multilib
# turned on, or pacman would stop being able to update those packages and would
# warn about them on every upgrade. lib32-gamemode is in the list for every
# machine, so this is not only the graphics case - and ENABLE_MULTILIB was only
# ever set by the graphics question, which left `skip` with orphaned packages.
for p in "${PACKAGES[@]}"; do
    [[ $p == lib32-* ]] && { ENABLE_MULTILIB=1; break; }
done

ok "${#PACKAGES[@]} pacotes conferidos"

snapshot_parts() { lsblk -rpno NAME "$DISK" | tail -n +2 | sort; }

ROOT_PART=""
ESP_PART="$EXISTING_ESP"

case $MODE in
  wipe)
    info "Apagando o $DISK…"
    swapoff -a 2>/dev/null
    umount -R "$MNT" 2>/dev/null
    wipefs -af "$DISK"       || die "wipefs falhou no $DISK"
    sgdisk --zap-all "$DISK" || die "Não foi possível limpar a tabela de partições."
    if [[ $FIRMWARE == UEFI ]]; then
        sgdisk -n 1:1M:+1G -t 1:ef00 -c 1:"EFI system" "$DISK" || die "Falha ao criar a partição EFI."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"STYLUS root"  "$DISK" || die "Falha ao criar a partição raiz."
    else
        sgdisk -n 1:1M:+2M -t 1:ef02 -c 1:"BIOS boot"  "$DISK" || die "Falha ao criar a partição de boot do BIOS."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"STYLUS root"  "$DISK" || die "Falha ao criar a partição raiz."
    fi
    partprobe "$DISK"; udevadm settle; sleep 1
    mapfile -t newparts < <(snapshot_parts)
    (( ${#newparts[@]} >= 2 )) || die "As novas partições não apareceram."
    [[ $FIRMWARE == UEFI ]] && ESP_PART=${newparts[0]}
    ROOT_PART=${newparts[1]}
    if [[ $FIRMWARE == UEFI ]]; then
        mkfs.vfat -F32 -n STYLUS_EFI "$ESP_PART" || die "Falha ao formatar a partição EFI."
    fi
    ;;

  alongside)
    info "Criando uma partição no espaço livre (${FREE_START} MiB → ${FREE_END} MiB)…"
    before=$(snapshot_parts)
    sgdisk -n "0:${FREE_START}M:$((FREE_END - 1))M" -t 0:8300 -c 0:"STYLUS root" "$DISK" \
        || die "Não foi possível criar uma partição no espaço livre."
    partprobe "$DISK"; udevadm settle; sleep 1
    ROOT_PART=$(comm -13 <(printf '%s\n' "$before") <(snapshot_parts) | head -1)
    [[ -b ${ROOT_PART:-} ]] || die "A nova partição não apareceu. Nada foi formatado."
    ok "Criada $ROOT_PART — nenhuma outra partição foi modificada"
    ;;

  partition)
    ROOT_PART=$TARGET_PART
    wipefs -af "$ROOT_PART" || die "Não foi possível limpar $ROOT_PART"
    ;;
esac

[[ -b ${ROOT_PART:-} ]] || die "Nenhuma partição raiz definida — cancelando antes de formatar."

info "Formatando $ROOT_PART como $FSTYPE…"
case $FSTYPE in
    ext4)  mkfs.ext4  -F -L STYLUS "$ROOT_PART" || die "mkfs.ext4 falhou." ;;
    btrfs) mkfs.btrfs -f -L STYLUS "$ROOT_PART" || die "mkfs.btrfs falhou." ;;
esac

info "Montando…"
mount "$ROOT_PART" "$MNT" || die "Não foi possível montar $ROOT_PART"
if [[ $FIRMWARE == UEFI ]]; then
    [[ -b ${ESP_PART:-} ]] || die "Nenhuma partição de sistema EFI disponível."
    mkdir -p "$MNT/boot/efi"
    mount "$ESP_PART" "$MNT/boot/efi" || die "Não foi possível montar a partição EFI $ESP_PART"
    ok "Usando a partição EFI $ESP_PART (não foi reformatada)"
fi

info "Instalando o sistema base — esta é a parte demorada…"

# One retry, and only one. What this catches is a mirror that disappears in the
# middle of a two-gigabyte download: everything already fetched is in the new
# root's cache, so the second run resumes instead of starting over, and picking
# fresh mirrors first is what stops it from walking into the same dead one.
if ! pacstrap -K "$MNT" "${PACKAGES[@]}"; then
    warn "O download parou no meio. Trocando de espelho e tentando de novo…"
    # `--amplo` porque os espelhos da lista atual acabaram de falhar: sem
    # excluí-los, a segunda escolha devolvia exatamente a mesma lista e a
    # segunda tentativa morria no mesmo espelho que a primeira.
    ordenar_espelhos --amplo || true
    pacstrap -K "$MNT" "${PACKAGES[@]}" || die "A instalação dos pacotes falhou duas vezes.

A mensagem exata do pacman está no fim de $LOG — é ela que diz qual foi o
problema. As causas comuns são um espelho lento demais ('Operation too slow'),
a rede caindo no meio do download, e o espaço em disco acabando.

Se foi espelho lento, escolha um à mão antes de tentar outra vez:

    reflector --country BR --protocol https --sort rate --number 10 \\
              --save /etc/pacman.d/mirrorlist

O disco já foi particionado e formatado. Rodar o instalador de novo formata
outra vez e baixa tudo de novo — não continua de onde parou."
fi
ok "Pacotes instalados"

info "Escrevendo o fstab…"
genfstab -U "$MNT" >>"$MNT/etc/fstab" || die "genfstab falhou."

if (( SWAP_MIB > 0 )); then
    info "Criando um arquivo de swap de ${SWAP_MIB} MiB…"
    if [[ $FSTYPE == btrfs ]]; then
        btrfs filesystem mkswapfile --size "${SWAP_MIB}m" "$MNT/swapfile" 2>/dev/null \
            || warn "Não foi possível criar o swap em btrfs; seguindo sem swap."
    else
        fallocate -l "${SWAP_MIB}M" "$MNT/swapfile" && chmod 600 "$MNT/swapfile" \
            && mkswap "$MNT/swapfile" >/dev/null \
            || warn "Não foi possível criar o arquivo de swap; seguindo sem swap."
    fi
    [[ -f $MNT/swapfile ]] && echo "/swapfile none swap defaults 0 0" >>"$MNT/etc/fstab"
fi

# STYLUS identity goes in before the user is created, so useradd copies the STYLUS
# /etc/skel rather than a vanilla one.
#
# Not a warning. `pacstrap` installs packages; every single thing that makes
# this machine STYLUS - the commands, the deck, the full-screen shelf, the
# audio configuration, /etc/skel - comes from here and from nowhere else. This
# line used to end in `|| warn`, and branding-sync.sh did not exist at all, so
# the installer printed "Instalação concluída" and handed over a plain Arch
# with i3 on it and no `stylus` command anywhere. Failing loudly is the only
# honest answer: there is nothing to fall back to.
info "Aplicando a identidade visual e as configurações do STYLUS…"
/usr/share/stylus/branding-sync.sh "$MNT" || die "Não foi possível copiar o STYLUS para o sistema novo.

Os pacotes foram instalados, mas o que faz esta máquina ser o STYLUS — os
comandos, o deck, a tela cheia, a configuração de áudio — não chegou lá. Um
sistema assim não é o STYLUS, e por isso a instalação para aqui em vez de
dizer que deu certo.

As linhas acima dizem o que falhou. Rodar o instalador de novo formata o disco
outra vez e baixa os pacotes de novo — não continua de onde parou."

info "Configurando o sistema instalado…"

# Console keymap -> X11 layout (br-abnt2 -> layout br, model abnt2)
XKB_LAYOUT=${KEYMAP%%-*}
XKB_MODEL=pc105
[[ $KEYMAP == *abnt2* ]] && XKB_MODEL=abnt2

# The answers are handed over in a file rather than interpolated into the
# script. Writing them inline would let a password containing $ or a backtick
# be expanded - or executed - by the shell that generates this.
{
    printf 'STYLUS_TIMEZONE=%q\n'   "$TIMEZONE"
    printf 'STYLUS_LOCALE=%q\n'     "$LOCALE"
    printf 'STYLUS_KEYMAP=%q\n'     "$KEYMAP"
    printf 'STYLUS_XKB_LAYOUT=%q\n' "$XKB_LAYOUT"
    printf 'STYLUS_XKB_MODEL=%q\n'  "$XKB_MODEL"
    printf 'STYLUS_HOSTNAME=%q\n'   "$HOSTNAME"
    printf 'STYLUS_USERNAME=%q\n'   "$USERNAME"
    printf 'STYLUS_USERPASS=%q\n'   "$USERPASS"
    printf 'STYLUS_ROOTPASS=%q\n'   "$ROOTPASS"
    printf 'STYLUS_DISK=%q\n'       "$DISK"
    printf 'STYLUS_MULTILIB=%q\n'   "$ENABLE_MULTILIB"
    printf 'STYLUS_NVIDIA=%q\n'     "$( [[ $GPU_CHOICE == nvidia ]] && echo 1 || echo 0 )"
    printf 'STYLUS_DESKTOP=%q\n'    "$DESKTOP_CHOICE"
    printf 'STYLUS_SESSION=%q\n'    "$DESKTOP_SESSION"
} > "$MNT/root/.stylus-answers"
chmod 600 "$MNT/root/.stylus-answers"

# Quoted delimiter: this heredoc is written out verbatim.
cat >"$MNT/root/stylus-configure.sh" <<'CHROOT'
#!/usr/bin/env bash
set -euo pipefail
. /root/.stylus-answers

ln -sf "/usr/share/zoneinfo/${STYLUS_TIMEZONE}" /etc/localtime
hwclock --systohc || true

# The live medium has multilib enabled, so pacstrap could install the 32-bit
# graphics libraries; a freshly installed system has it commented out. Left
# that way, those packages would belong to no repository at all - pacman would
# never update them again and would warn about them on every upgrade. Enable it
# here so what was just installed stays installed.
if [[ ${STYLUS_MULTILIB:-0} == 1 ]] && ! pacman-conf --repo-list | grep -qx multilib; then
    sed -i '/^#\[multilib\]/,/^#Include = .*mirrorlist/ s/^#//' /etc/pacman.conf
    pacman-conf --repo-list | grep -qx multilib ||
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
    pacman -Sy --noconfirm >/dev/null 2>&1 || true
fi

grep -q "^${STYLUS_LOCALE}" /etc/locale.gen || echo "${STYLUS_LOCALE} UTF-8" >> /etc/locale.gen
sed -i "s/^#${STYLUS_LOCALE}/${STYLUS_LOCALE}/" /etc/locale.gen
locale-gen
echo "LANG=${STYLUS_LOCALE}" > /etc/locale.conf
echo "KEYMAP=${STYLUS_KEYMAP}" > /etc/vconsole.conf

mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<XKB
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "${STYLUS_XKB_LAYOUT}"
    Option "XkbModel" "${STYLUS_XKB_MODEL}"
EndSection
XKB

echo "${STYLUS_HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${STYLUS_HOSTNAME}.localdomain ${STYLUS_HOSTNAME}
HOSTS

mkdir -p /etc/mkinitcpio.conf.d
cat > /etc/mkinitcpio.conf.d/stylus.conf <<'MKI'
HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
MKI

# Everything an NVIDIA machine needs and that nothing else writes: the driver's
# module options, its modules in the boot image instead of the kms hook, and a
# pacman hook to keep the boot image in step with driver updates.
#
# The kms hook above is the reason this matters. It puts every DRM driver the
# machine has into the boot image, nouveau included - and on a machine with the
# NVIDIA driver installed that is a race the NVIDIA driver loses: nouveau takes
# the card before the root filesystem is even mounted, and nvidia then has
# nothing left to bind to. stylus-gpu writes the file that overrides it, under a
# name that sorts after this one so it actually wins.
if [ "${STYLUS_NVIDIA:-0}" = 1 ] && [ -x /usr/local/bin/stylus-gpu ]; then
    /usr/local/bin/stylus-gpu --write-nvidia-config || true
    # Suspend on a machine with an NVIDIA card has to save the card's memory
    # somewhere and put it back on the way up. Without these the machine wakes
    # with the card in a state nothing can use, and the first game after
    # closing the lid hangs on a computer that otherwise looks fine.
    systemctl enable nvidia-suspend.service nvidia-hibernate.service \
                     nvidia-resume.service 2>/dev/null || true
fi

# ── A tela de arranque ────────────────────────────────────────────────────
# O tema do plymouth existe no repositório (logo.png, stylus.script), o hook
# `plymouth` está na linha de HOOKS acima e o pacote está na lista — e nada
# NUNCA escolheu o tema. O plymouth cai no padrão dele, então a tela que
# aparece entre o GRUB e o login era a de fábrica: o STYLUS nunca foi visto
# ali por ninguém. É a família do stylus-welcome — a peça inteira pronta,
# faltando o fio.
#
# Sem `-R`: o `mkinitcpio -P` logo abaixo é quem assa o tema na imagem, e
# rodar os dois seria assar duas vezes numa instalação que já é longa.
if [ -d /usr/share/plymouth/themes/stylus ]; then
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme stylus || true
    else
        mkdir -p /etc/plymouth
        printf '[Daemon]\nTheme=stylus\n' > /etc/plymouth/plymouthd.conf
    fi
fi

# ── A imagem de arranque, e por que ela é conferida em vez de suposta ──────
# O `mkinitcpio -P` já foi um `|| die` — e derrubava a instalação por avisos
# que não impedem nada, com o disco formatado e antes do grub-install. Virou
# um `|| echo "geralmente inofensivo"`, e aí ficou pior: quando ele falha DE
# VERDADE, não sobra initramfs nenhum, o kernel entra em pânico antes de
# montar a raiz, e a máquina reinicia em laço. A instalação termina dizendo
# "concluída" e entrega um computador que não liga — e a linha tranquilizadora
# passa despercebida no meio de mil outras.
#
# Aviso e falha não são a mesma coisa, e não dá para distinguir pelo código de
# saída: o mkinitcpio sai diferente de zero por firmware que faltou tanto
# quanto por imagem que não foi escrita. Então não se pergunta a ele — olha-se
# o que ficou no /boot, que é o que o GRUB vai carregar.
mkinitcpio -P || echo "  ! mkinitcpio terminou com erros — conferindo o que saiu"

INIT_OK=0
INIT_FALTA=""
for _preset in /etc/mkinitcpio.d/*.preset; do
    [ -f "$_preset" ] || continue
    _k=$(basename "$_preset" .preset)
    # 1 MiB é folgado de propósito: um initramfs de verdade passa de 10 MiB, e
    # um arquivo truncado por disco cheio no meio da escrita fica bem abaixo.
    if [ -s "/boot/initramfs-${_k}.img" ] &&
       [ "$(stat -c%s "/boot/initramfs-${_k}.img" 2>/dev/null || echo 0)" -gt 1048576 ]; then
        INIT_OK=$((INIT_OK + 1))
    else
        INIT_FALTA="$INIT_FALTA $_k"
    fi
done

if [ "$INIT_OK" -eq 0 ]; then
    echo "  ✗ Nenhuma imagem de arranque foi gerada em /boot."
    echo
    echo "    Sem ela o kernel não monta a raiz: a máquina reiniciaria em laço,"
    echo "    sem chegar a lugar nenhum. A instalação para aqui de propósito —"
    echo "    é a única forma de você ficar sabendo agora, e não depois de"
    echo "    desligar na tomada cinco vezes."
    echo
    echo "    Quase sempre é espaço em disco. As linhas do mkinitcpio acima"
    echo "    dizem o que faltou."
    exit 1
elif [ -n "$INIT_FALTA" ]; then
    echo "  ! sem imagem de arranque para:$INIT_FALTA"
    echo "    A máquina liga pelos outros $INIT_OK kernel(s); escolha no menu do GRUB"
    echo "    se o primeiro não subir."
else
    echo "  ✓ imagem de arranque gerada para $INIT_OK kernel(s)"
fi

# optical, because `stylus rip` reads the CD drive directly and cdparanoia
# needs the device, not a mount. rfkill, because the wifi key on a laptop is a
# kill switch and toggling it without the group silently does nothing. uucp,
# for USB DACs that present as serial devices.
useradd -m -G wheel,audio,video,input,storage,optical,network,rfkill,uucp,lp \
        -s /usr/bin/fish "${STYLUS_USERNAME}" 2>/dev/null ||
    useradd -m -G wheel,audio,video,input,storage,network \
        -s /usr/bin/fish "${STYLUS_USERNAME}"

# GameMode can only lower a game's nice value for users in its own group, and
# raising the game above the browser is most of what GameMode is for on these
# machines. Added afterwards rather than in the line above on purpose: useradd
# fails outright on a group that does not exist, and it would take the whole
# installation with it if the gamemode package ever changed name.
if getent group gamemode >/dev/null 2>&1; then
    usermod -aG gamemode "${STYLUS_USERNAME}" || true
fi
echo "${STYLUS_USERNAME}:${STYLUS_USERPASS}" | chpasswd
if [ -n "${STYLUS_ROOTPASS}" ]; then
    echo "root:${STYLUS_ROOTPASS}" | chpasswd
else
    passwd -l root
fi

install -d -m 750 /etc/sudoers.d
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# ── Os serviços ─────────────────────────────────────────────────────────────
# Este arquivo roda com `set -e`, e um `systemctl enable` de unidade que não
# existe SAI COM ERRO. Escritos soltos, como estavam, qualquer pacote que
# saísse da lista derrubava a configuração inteira — depois do pacstrap, com
# o disco já formatado e antes do grub-install, ou seja: máquina que não liga.
#
# Foi o que quase aconteceu ao tirar a impressão daqui: o `cups` saiu da lista
# de pacotes e o `systemctl enable cups.socket` ficou. Por isso agora há duas
# listas e uma função.
essenciais() {          # sem estes não há máquina utilizável
    local s
    for s in "$@"; do
        systemctl enable "$s" 2>/dev/null ||
            printf '  ! %s não pôde ser ligado\n' "$s"
    done
}
opcionais() {           # a falta de um não justifica perder a instalação
    local u
    for u in "$@"; do
        systemctl enable "$u" 2>/dev/null ||
            printf '  ! %s não pôde ser ligado (o pacote não está instalado?)\n' "$u"
    done
}

essenciais NetworkManager.service sddm.service
# O único systemctl deste arquivo que ficava fora das duas funções acima —
# e, portanto, o único capaz de derrubar a configuração inteira sozinho.
systemctl set-default graphical.target 2>/dev/null ||
    printf '  ! não deu para deixar a máquina ligando na tela de login\n'

opcionais bluetooth.service systemd-timesyncd.service fstrim.timer \
          ufw.service paccache.timer \
          power-profiles-daemon.service earlyoom.service \
          rtkit-daemon.service \
          stylus-gpu-fallback.service stylus-fontcache.service \
          stylus-session-guard.service
#
# O que cada um dos nossos faz, para quem for mexer nesta lista:
#   stylus-gpu-fallback  confere, antes da tela de login, se algum driver
#                        pegou a placa — e carrega o nouveau se nenhum pegou.
#                        É o que impede um driver NVIDIA quebrado de virar uma
#                        máquina sem área de trabalho para consertá-la.
#   stylus-session-guard confere, antes da tela de login, se a sessão que o
#                        autologin vai abrir sozinha TEM como abrir. Se não
#                        tiver, desvia para a do STYLUS. Sem ele, um autologin
#                        apontado para o Plasma numa máquina sem OpenGL vira
#                        um laço: entra, o KWin morre, entra de novo, para
#                        sempre — sem tela de login e sem jeito de sair.
#   stylus-fontcache     o cache do fontconfig antes do greeter. Sem ele o
#                        primeiro a pedir uma fonte paga a varredura inteira,
#                        e o primeiro é o i3 — que trava no Pango tempo
#                        suficiente para parecer que a máquina não ligou.
#   rtkit-daemon         é o que deixa o PipeWire pegar a prioridade de tempo
#                        real que ele pede. Sem isso cada falha de buffer vira
#                        um clique no meio de uma parte silenciosa.
#   power-profiles       sem ele o módulo da barra não tem com quem falar.
#
# Impressão não está aqui de propósito: este sistema não tem suíte de
# escritório nem impressão, e o cups saiu junto.
ufw default deny incoming  || true
ufw default allow outgoing || true
ufw --force enable         || true

if [ -d /sys/firmware/efi/efivars ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=STYLUS || \
        echo "  ! grub-install (UEFI) encontrou problemas"
else
    grub-install --target=i386-pc "${STYLUS_DISK}" || \
        echo "  ! grub-install (BIOS) encontrou problemas"
fi
# O `grub-install` acima tolera falhar de propósito — mas a tolerância era
# faz-de-conta: sem /etc/default/grub, o primeiro `sed -i` daqui não acha o
# arquivo, sai com erro e o `set -e` derruba a configuração inteira dois
# comandos depois de a gente ter decidido seguir em frente.
if [ -f /etc/default/grub ]; then
    sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
    grep -q '^GRUB_DISABLE_OS_PROBER' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
    sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet splash"/' /etc/default/grub
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="STYLUS"/' /etc/default/grub
    grep -q '^GRUB_DISTRIBUTOR' /etc/default/grub || echo 'GRUB_DISTRIBUTOR="STYLUS"' >> /etc/default/grub
else
    echo "  ! /etc/default/grub não existe — o menu de boot fica no padrão"
fi

# The STYLUS boot menu. gfxterm is what makes a theme render at all; without an
# explicit GFXMODE some firmware drops to 640x480 and the theme looks cramped.
if [ -f /usr/share/grub/themes/stylus/theme.txt ] && [ -f /etc/default/grub ]; then
    sed -i '/^GRUB_THEME=/d; /^GRUB_GFXMODE=/d; /^GRUB_TERMINAL_OUTPUT=/d; /^GRUB_GFXPAYLOAD_LINUX=/d' /etc/default/grub
    {
        echo 'GRUB_THEME="/usr/share/grub/themes/stylus/theme.txt"'
        echo 'GRUB_GFXMODE="1920x1080,1366x768,auto"'
        echo 'GRUB_GFXPAYLOAD_LINUX="keep"'
        echo 'GRUB_TERMINAL_OUTPUT="gfxterm"'
    } >> /etc/default/grub
fi

# Two ways back into a machine whose graphics driver stopped working.
#
# This is the hole that made a bad NVIDIA driver unrecoverable rather than
# merely annoying: with no driver the greeter never appears, and everything
# that could diagnose or repair it lives behind that greeter. A student with a
# black screen has no next step at all.
#
# The first entry blacklists the NVIDIA modules and lets nouveau take the card.
# It is slower and it draws a desktop, from which `stylus-gpu --fix` can be run
# and will say exactly what went wrong. The second gives up on graphics
# entirely and boots to a text console, which works when nothing else does.
#
# Both use the fallback boot image on purpose. The normal one is built with
# autodetect and only contains the modules this machine needed at the time it
# was built; the fallback contains everything, which is the difference when
# what changed is a driver.
ROOT_UUID=$(findmnt -no UUID / 2>/dev/null || true)
if [ -n "${ROOT_UUID}" ] && [ -f /boot/vmlinuz-linux ]; then
    [ -f /boot/initramfs-linux-fallback.img ] \
        && RECOVERY_INITRD=/boot/initramfs-linux-fallback.img \
        || RECOVERY_INITRD=/boot/initramfs-linux.img
    NV_BLACKLIST=nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm
    cat >> /etc/grub.d/40_custom <<CUSTOM

menuentry 'STYLUS — recuperação de vídeo (driver livre)' --class stylus --class gnu-linux --class os {
    load_video
    insmod gzio
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw loglevel=3 modprobe.blacklist=${NV_BLACKLIST}
    initrd ${RECOVERY_INITRD}
}

menuentry 'STYLUS — modo texto (sem vídeo nenhum)' --class stylus --class gnu-linux --class os {
    load_video
    insmod gzio
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /boot/vmlinuz-linux root=UUID=${ROOT_UUID} rw nomodeset systemd.unit=multi-user.target
    initrd ${RECOVERY_INITRD}
}
CUSTOM
    chmod +x /etc/grub.d/40_custom
fi

grub-mkconfig -o /boot/grub/grub.cfg || echo "  ! grub-mkconfig encontrou problemas"

cp -rn /etc/skel/. "/home/${STYLUS_USERNAME}/" 2>/dev/null || true

# The machine starts in MUSIC mode, because that is what it is. Mod+D or
# `stylus-mode desktop` goes to the other one, and it is remembered from then on.
install -d -m 0755 "/home/${STYLUS_USERNAME}/.config/stylus"
echo music > "/home/${STYLUS_USERNAME}/.config/stylus/mode"

# Which session SDDM offers first. Three STYLUS sessions are installed and with
# nothing said, the greeter picks whichever sorts first - `stylus-desktop`,
# the one that is not the point of the machine. This is where SDDM keeps that
# answer, and seeding it is what makes the FIRST login land in music mode.
# When KDE is installed, plasma.desktop becomes the default session.
install -d -m 0755 /var/lib/sddm
# Qual sessão o SDDM oferece primeiro. Começa na do STYLUS e só muda se o
# KDE realmente chegou ao disco — escolher KDE numa máquina onde o
# plasma-workspace não instalou escrevia um state.conf apontando para um
# binário inexistente, e o greeter abria numa sessão que morre na hora.
# Cair para a sessão de música é feio; abrir no nada não tem conserto sem
# outro computador.
SESSION_FILE="/usr/share/xsessions/stylus.desktop"

if [ "${STYLUS_DESKTOP:-i3}" = "kde" ]; then
    # O nome do arquivo de sessão mudou no Plasma 6: o X11 virou
    # `plasmax11.desktop` e `plasma.desktop` passou a ser o do Wayland. Fixar
    # um dos dois no código dá certo em metade das versões, então procura.
    for _cand in plasmax11 plasma-x11 plasma; do
        if [ -f "/usr/share/xsessions/${_cand}.desktop" ]; then
            SESSION_FILE="/usr/share/xsessions/${_cand}.desktop"
            break
        fi
    done

    # Nenhum arquivo de sessão, mas o binário está lá: alguma versão do
    # plasma-workspace não instalou o .desktop do X11. Escreve um.
    if [ "$SESSION_FILE" = "/usr/share/xsessions/stylus.desktop" ] \
       && [ -x /usr/bin/startplasma-x11 ]; then
        mkdir -p /usr/share/xsessions
        cat > /usr/share/xsessions/plasma.desktop <<'PLASMA'
[Desktop Entry]
Type=Application
Name=Plasma
Comment=KDE Plasma Desktop
Exec=/usr/bin/startplasma-x11
TryExec=/usr/bin/startplasma-x11
DesktopNames=KDE
PLASMA
        SESSION_FILE="/usr/share/xsessions/plasma.desktop"
    fi

    if [ "$SESSION_FILE" = "/usr/share/xsessions/stylus.desktop" ]; then
        echo "  ! KDE foi escolhido mas o Plasma não está instalado —"
        echo "    a sessão padrão continua sendo a do STYLUS."
    else
        # ── O SDDM abre a NOSSA sessão, que abre o Plasma ──────────────────
        # Apontar o SDDM direto para o plasmax11.desktop é o caminho curto e
        # é o que tranca a máquina. Se o Plasma não subir — e ele não sobe sem
        # OpenGL — o SDDM lança de novo, e de novo, sem parar e sem mostrar
        # tela de login. De fora parece uma máquina reiniciando sozinha, e não
        # existe nenhum lugar de onde consertar.
        #
        # A stylus-desktop.desktop faz a mesma coisa passando pelo
        # stylus-session, que confere antes se o Plasma tem como abrir e cai
        # no i3 quando não tem. A sessão do Plasma continua instalada e
        # escolhível na tela de login por quem quiser; o que muda é para onde
        # a máquina vai SOZINHA.
        PLASMA_SESSION_FILE="$SESSION_FILE"
        SESSION_FILE="/usr/share/xsessions/stylus-desktop.desktop"
        # Quem escolheu KDE liga na área de trabalho, não no modo música.
        echo desktop > "/home/${STYLUS_USERNAME}/.config/stylus/mode"
    fi

    # ── Aparência do KDE ────────────────────────────────────────────────────
    # Tudo daqui para baixo é ENFEITE. Roda num subshell com `set +e` de
    # propósito: foi exatamente aqui que a instalação morreu no meio do
    # chroot, com o disco já formatado e antes do grub-install — ou seja,
    # máquina que não liga, por causa de um tema.
    #
    # O erro era este: o `mkdir -p` abaixo criava `plasmarc` como PASTA, e a
    # linha seguinte fazia `cat > .../plasmarc`. "É um diretório", `set -e`,
    # fim da instalação. Se você mexer aqui, lembre que nenhuma linha desta
    # seção vale uma máquina que não liga.
    (
        set +e
        KDE_CONF="/home/${STYLUS_USERNAME}/.config"
        KDE_DATA="/home/${STYLUS_USERNAME}/.local/share"
        mkdir -p "$KDE_CONF/gtk-3.0" "$KDE_CONF/gtk-4.0" \
                 "$KDE_CONF/autostart" "$KDE_CONF/Kvantum" \
                 "$KDE_DATA/konsole" "$KDE_DATA/color-schemes"

        # plasmarc é ARQUIVO. Nunca passe este caminho para o mkdir acima.
        cat > "$KDE_CONF/plasmarc" <<'EOF'
[Theme]
name=breeze-dark
EOF

        # O que de fato deixa os aplicativos do KDE escuros. O plasmarc
        # acima só troca o tema da barra e dos widgets do Plasma; sem o
        # kdeglobals o Dolphin, o Kate e o Konsole abrem em Breeze CLARO
        # numa máquina cujo resto é preto.
        cat > "$KDE_CONF/kdeglobals" <<'EOF'
[General]
ColorScheme=StylusDark
Name=STYLUS Dark
AccentColor=240,160,48
XftAntialias=true
XftHintStyle=hintslight
XftSubPixel=rgb

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
SingleClick=false
widgetStyle=kvantum
AnimationDurationFactor=0.5

[Icons]
Theme=Papirus-Dark

[UiSettings]
ColorScheme=StylusDark
EOF
        # A paleta em si vem do repositório (usr/share/color-schemes). Uma
        # cópia na casa do usuário para o seletor de cores do KDE listar.
        if [ -f /usr/share/color-schemes/StylusDark.colors ]; then
            cp -f /usr/share/color-schemes/StylusDark.colors \
                  "$KDE_DATA/color-schemes/StylusDark.colors"
        fi

        cat > "$KDE_CONF/Kvantum/kvantum.kvconfig" <<'EOF'
[General]
theme=Stylus
EOF

        cat > "$KDE_CONF/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-font-name=Noto Sans 11
gtk-application-prefer-dark-theme=1
EOF
        cp -f "$KDE_CONF/gtk-3.0/settings.ini" "$KDE_CONF/gtk-4.0/settings.ini"

        for ver in qt5ct qt6ct; do
            mkdir -p "$KDE_CONF/$ver"
            cat > "$KDE_CONF/$ver/$ver.conf" <<EOF
[Appearance]
custom_palette=true
color_scheme_path=/usr/share/$ver/colors/stylus.conf
icon_theme=Papirus-Dark
style=kvantum

[Fonts]
general=@Variant(\0\0\0@\0\0\0\x12Noto Sans\0\0\0\n\0\0\0\0\x28\x7f\0\0\x14)
EOF
        done

        # O Konsole lê perfil e esquema de cor de ~/.local/share/konsole,
        # não de ~/.config. Escrito no lugar errado, o perfil existia e
        # nunca era encontrado — terminal branco no meio do sistema preto.
        cat > "$KDE_DATA/konsole/Stylus.profile" <<'EOF'
[General]
Name=Stylus
Parent=FALLBACK/
TerminalColumns=110
TerminalRows=32

[Appearance]
ColorScheme=Stylus
Font=JetBrainsMono Nerd Font,12,-1,5,50,0,0,0,0,0
UseCustomFont=true

[Scrolling]
HistoryMode=2

[Cursor Options]
CursorShape=0
UseCustomCursorColor=true
CustomCursorColor=240,160,48
EOF

        cat > "$KDE_DATA/konsole/Stylus.colorscheme" <<'EOF'
[Background]
Color=7,8,11
[BackgroundIntense]
Color=16,18,25
[Foreground]
Color=232,236,245
[ForegroundIntense]
Color=255,255,255
[Color0]
Color=7,8,11
[Color0Intense]
Color=52,58,72
[Color1]
Color=238,122,130
[Color1Intense]
Color=255,150,158
[Color2]
Color=126,217,158
[Color2Intense]
Color=150,240,182
[Color3]
Color=240,160,48
[Color3Intense]
Color=255,200,80
[Color4]
Color=91,206,250
[Color4Intense]
Color=130,220,255
[Color5]
Color=183,160,255
[Color5Intense]
Color=205,185,255
[Color6]
Color=126,200,217
[Color6Intense]
Color=150,225,240
[Color7]
Color=204,208,224
[Color7Intense]
Color=255,255,255
[General]
Description=Stylus Dark
Opacity=0.95
Blur=true
EOF

        # Sem isto o perfil existe e o Konsole abre no Breeze de sempre.
        cat > "$KDE_CONF/konsolerc" <<'EOF'
[Desktop Entry]
DefaultProfile=Stylus.profile

[MainWindow]
MenuBar=Disabled
ToolBarsMovable=Disabled
EOF

        # Os atalhos (Meta+M, Meta+D…) escritos AGORA, não no primeiro login.
        # O autostart abaixo roda depois que a área de trabalho já apareceu,
        # e o kglobalaccel lê esse arquivo ao subir: escrito lá, o primeiro
        # login é sempre o login em que nenhuma tecla funciona.
        if [ -x /usr/local/bin/stylus-kde-shortcuts ]; then
            HOME="/home/${STYLUS_USERNAME}" \
            XDG_CONFIG_HOME="$KDE_CONF" \
                /usr/local/bin/stylus-kde-shortcuts --seed
        fi

        cat > "$KDE_CONF/autostart/stylus-kde.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Stylus KDE
Exec=/usr/local/bin/stylus-kde-shortcuts
Hidden=false
NoDisplay=true
X-KDE-autostart-after=panel
OnlyShowIn=KDE;
EOF

        # Deixa o stylus-mode alternar entre KDE e i3 sem pedir senha.
        cat > /etc/sudoers.d/stylus-mode <<SUDOERS
${STYLUS_USERNAME} ALL=(root) NOPASSWD: /usr/local/bin/stylus-set-session desktop, /usr/local/bin/stylus-set-session music
SUDOERS
        chmod 0440 /etc/sudoers.d/stylus-mode
        # Um sudoers com erro de sintaxe tranca o sudo da máquina inteira.
        if command -v visudo >/dev/null 2>&1; then
            visudo -cf /etc/sudoers.d/stylus-mode >/dev/null 2>&1 ||
                rm -f /etc/sudoers.d/stylus-mode
        fi
    )
    if [ "$SESSION_FILE" = "/usr/share/xsessions/stylus.desktop" ]; then
        echo "  ✓ aparência do KDE preparada (o Plasma pode ser instalado depois)"
    else
        echo "  ✓ KDE Plasma configurado (sessão: ${SESSION_FILE##*/})"
    fi
fi

cat > /var/lib/sddm/state.conf <<SDDMSTATE
[Last]
Session=${SESSION_FILE}
User=${STYLUS_USERNAME}
SDDMSTATE
chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true

chown -R "${STYLUS_USERNAME}:${STYLUS_USERNAME}" "/home/${STYLUS_USERNAME}"
CHROOT

chmod +x "$MNT/root/stylus-configure.sh"
arch-chroot "$MNT" /root/stylus-configure.sh || die "A configuração do novo sistema falhou. Veja $LOG"
rm -f "$MNT/root/stylus-configure.sh" "$MNT/root/.stylus-answers"

# The live medium autologins; a real installation must not.
rm -f "$MNT/etc/sudoers.d/10-stylus-live"
[[ -f $MNT/etc/sddm.conf.d/stylus.conf ]] && \
    sed -i '/^\[Autologin\]/,/^\[/{/^User=/d;/^Session=/d}' "$MNT/etc/sddm.conf.d/stylus.conf"

sync
ok "Instalação concluída"

cat <<EOF

${c_grn}  O STYLUS está instalado.${c_reset}

    Entre como      ${c_b}$USERNAME${c_reset}
    Outros sistemas $( [[ $MODE == wipe ]] && echo 'nenhum — o disco foi apagado' || echo 'mantidos; o GRUB foi configurado para detectá-los' )
    Registro        $LOG

    Depois do primeiro boot, pressione ${c_b}Mod+G${c_reset} para abrir o lançador, ou
    ${c_b}Mod+Shift+A${c_reset} para o catálogo de programas, e instale navegador,
    jogos, drivers e o que mais quiser.

$( [[ $DESKTOP_CHOICE == kde ]] && {
    # Não repetir a escolha: dizer o que o chroot REALMENTE gravou. Quando o
    # Plasma não chega ao disco, o configure cai de volta para a sessão do
    # STYLUS — e esta tela dizia "KDE é a sessão padrão" do mesmo jeito,
    # contradizendo o aviso que tinha aparecido dois minutos antes.
    # Procura pela sessão do STYLUS, não por "plasma": o state.conf agora
    # aponta para stylus-desktop.desktop mesmo quando o KDE instalou direito
    # (veja o comentário no chroot). Procurando "plasma" aqui, uma instalação
    # de KDE perfeita passava a ser anunciada como "o Plasma não chegou".
    if grep -q 'Session=.*stylus-desktop' "$MNT/var/lib/sddm/state.conf" 2>/dev/null; then
        echo "    KDE Plasma é a sessão padrão. Para alternar para i3, use
    ${c_b}stylus-mode toggle${c_reset} ou escolha na tela de login do SDDM.
"
    else
        echo "    ${c_yel}O KDE foi escolhido, mas o Plasma não chegou ao disco${c_reset} — a sessão
    padrão continua sendo a do STYLUS. Dá para instalar depois com
    ${c_b}sudo pacman -S plasma-desktop plasma-workspace plasma-x11-session${c_reset}.
"
    fi
} )
    Para mudar ou consertar o próprio sistema, ${c_b}stylus claude${c_reset} (ou
    ${c_b}Mod+C${c_reset}) abre a fonte dele com o Claude Code, aqui na máquina.

EOF

read -rp "  Reiniciar no STYLUS agora? [s/N] " r
if [[ ${r,,} == s* || ${r,,} == y* ]]; then
    umount -R "$MNT" 2>/dev/null
    systemctl reboot
fi
