#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-switch-kde — substitui i3 por KDE Plasma completo
# ═══════════════════════════════════════════════════════════════════════════
#  sudo stylus-switch-kde && sudo reboot
#
#  Remove i3 e instala KDE. O SDDM passa a usar plasma.desktop direto,
#  sem wrapper — é o próprio KDE que decide o que fazer, como em qualquer
#  distro KDE. O stylus-mode continua funcionando para alternar.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
info()  { printf "${BLUE}==>${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}  !${NC} %s\n" "$*"; }
fail()  { printf "${RED}  ✗${NC} %s\n" "$*"; }

[[ $EUID -eq 0 ]] || { fail "sudo stylus-switch-kde"; exit 1; }

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo stylus)}"
USER_HOME=$(eval echo "~$REAL_USER")
ok "Usuário: $REAL_USER ($USER_HOME)"

# ── 1. Instalar KDE Plasma PRIMEIRO ────────────────────────────────────
# NÃO remover i3 antes: se a instalação do KDE falhar, a máquina fica
# sem nenhum window manager e trava. Instalar, verificar, e SÓ DEPOIS
# remover o i3.
info "Instalando KDE Plasma..."
# O plasma-x11-session traz o kwin-x11 junto, e é ele que faz a sessão X11
# ter gerenciador de janelas. Sem ele o KDE abre sem conseguir mover uma
# janela sequer — veja o comentário longo no stylus-install.
pacman -S --needed --noconfirm \
    plasma-desktop plasma-workspace plasma-x11-session \
    plasma-nm plasma-pa powerdevil \
    kde-gtk-config kvantum konsole dolphin gwenview kate \
    xdg-desktop-portal-kde \
    && ok "KDE Plasma instalado" || { fail "KDE não instalou — i3 mantido"; exit 1; }

# Verificar se startplasma-x11 existe
if ! command -v startplasma-x11 >/dev/null 2>&1; then
    fail "startplasma-x11 não encontrado — KDE não instalou direito"
    fail "i3 continua funcionando. Tente: sudo pacman -S plasma-desktop plasma-workspace plasma-x11-session"
    exit 1
fi

ok "startplasma-x11 encontrado"

# O startplasma-x11 existir não prova nada sobre a sessão X11 funcionar: ele
# vem do plasma-workspace, e o gerenciador de janelas do X11 vem do kwin-x11,
# que é outro pacote. Conferir só o primeiro deixava passar um KDE onde não se
# arrasta uma janela.
if ! command -v kwin_x11 >/dev/null 2>&1; then
    fail "kwin_x11 não encontrado — a sessão X11 ficaria sem gerenciador de janelas"
    fail "Tente: sudo pacman -S plasma-x11-session"
    exit 1
fi
ok "kwin_x11 encontrado"

# ── 2. O i3 FICA ───────────────────────────────────────────────────────
# Este bloco removia `i3-wm i3lock xss-lock polybar picom arandr autorandr`.
# Três coisas quebravam de uma vez, e nenhuma delas aparecia aqui:
#
#   1. O modo música É o i3. `stylus-session` abre ele com
#      `i3 -c i3-music.config`. Sem o pacote, a tela cheia — o motivo desta
#      máquina existir — deixava de abrir para sempre.
#   2. Este mesmo script termina imprimindo "Para alternar para i3:
#      stylus-mode toggle", trinta linhas depois de apagar o i3.
#   3. O i3 é para onde o stylus-session cai quando o Plasma não pode abrir.
#      Sem ele, uma máquina sem OpenGL não tem para onde ir: preto e pronto.
#
# Instalar o KDE não é motivo para desinstalar o outro lado. Os dois convivem
# — é disso que o `stylus-mode` trata — e o espaço em disco de um gerenciador
# de janelas não paga nenhum dos três prejuízos acima.
ok "i3 mantido (é o modo música, e é para onde a máquina cai se o KDE falhar)"

# ── 3. Modo ────────────────────────────────────────────────────────────
mkdir -p "$USER_HOME/.config/stylus"
echo "desktop" > "$USER_HOME/.config/stylus/mode"
chown "$REAL_USER":"$REAL_USER" "$USER_HOME/.config/stylus/mode"
ok "Modo: desktop"

# ── 4. SDDM: plasma.desktop direto ─────────────────────────────────────
# startplasma-x11 SÓ funciona quando o SDDM lança como sessão KDE.
# O SDDM configura XDG_CURRENT_DESKTOP=KDE, D-Bus, e tudo que o KDE
# precisa. O stylus-session com exec startplasma-x11 não faz isso.
mkdir -p /etc/sddm.conf.d

# ── 4a. Qual é a sessão do Plasma nesta versão ──────────────────────────
# O Plasma 6 renomeou a sessão X11 para plasmax11.desktop, e plasma.desktop
# virou a do Wayland. Procurar antes de escrever: gravar um nome fixo no SDDM
# dá, na versão errada, uma sessão que não existe e um login que morre na
# hora — sem nada na tela dizendo por quê.
mkdir -p /usr/share/xsessions
KDE_SESSION=""
for _c in plasmax11 plasma-x11 plasma; do
    [[ -f /usr/share/xsessions/$_c.desktop ]] && { KDE_SESSION=$_c.desktop; break; }
done

# Nenhuma sessão instalada, mas o binário está lá: escreve uma. Só neste
# caso — antes isto rodava sempre que faltasse plasma.desktop, e no Plasma 6
# faltava por ser o nome do Wayland, então criava um arquivo a mais sem
# precisar.
if [[ -z $KDE_SESSION ]] && [[ -x /usr/bin/startplasma-x11 ]]; then
    cat > /usr/share/xsessions/plasma.desktop <<'PLASMA'
[Desktop Entry]
Type=Application
Name=Plasma
Comment=KDE Plasma Desktop
Exec=/usr/bin/startplasma-x11
TryExec=/usr/bin/startplasma-x11
DesktopNames=KDE
PLASMA
    KDE_SESSION=plasma.desktop
    ok "plasma.desktop criado"
fi
# O fail() só imprime; sem o exit isto seguiria e gravaria "Session=" vazio.
[[ -n $KDE_SESSION ]] || { fail "nenhuma sessão do Plasma instalada — SDDM não foi tocado"; exit 1; }
ok "sessão do KDE: $KDE_SESSION"

# ── 4b. O autologin entra na sessão do STYLUS, nunca no Plasma direto ──
# Aqui estava o defeito que deixava a máquina inutilizável, e ele merece ser
# escrito por inteiro porque parece inofensivo:
#
#     [Autologin] User=<alguém>  Session=plasmax11.desktop  Relogin=true
#
# Com essas três linhas juntas, se o Plasma não abrir — e ele não abre sem
# OpenGL — o SDDM entra sozinho, o KWin morre em três segundos, o Relogin
# entra sozinho de novo, e isso não para NUNCA. Não aparece tela de login,
# não dá para escolher outra sessão, não dá para abrir um terminal. De fora
# parece a máquina reiniciando sem parar. A única saída é o botão de
# desligar, e o boot seguinte faz tudo de novo.
#
# O autologin em si é certo: esta máquina é para usar do sofá, com controle,
# e pedir senha a cada troca de modo é o oposto disso. O que estava errado
# era o ALVO. Apontando para stylus.desktop, todo login passa pelo
# stylus-session, que confere se o Plasma tem como abrir antes de tentar e
# cai no i3 quando não tem. Mesma comodidade, sem o precipício.
KDE_SESSION_REAL=$KDE_SESSION
KDE_SESSION=stylus.desktop

cat > /etc/sddm.conf.d/stylus.conf <<SDDM
[General]
DisplayServer=x11
Numlock=on

[Theme]
Current=stylus
CursorTheme=Adwaita
CursorSize=24

[Autologin]
User=$REAL_USER
# stylus.desktop, e não $KDE_SESSION_REAL: veja o comentário acima. Apontar
# isto direto para o Plasma é o que trancava a máquina num laço de login.
Session=$KDE_SESSION
Relogin=true

[X11]
MinimumVT=7

[Users]
HideShells=/usr/bin/nologin,/sbin/nologin
SDDM
ok "SDDM → stylus.desktop (que abre o $KDE_SESSION_REAL depois de conferir)"

# ── 5. Garantir que xsessions/stylus.desktop existe para stylus-mode ────
# O stylus-mode toggle precisa de um stylus.desktop para voltar ao i3.
mkdir -p /usr/share/xsessions
cat > /usr/share/xsessions/stylus.desktop <<'EOF'
[Desktop Entry]
Name=STYLUS
Comment=Modo música — i3 com atalhos para estante e deck
Exec=/usr/local/bin/stylus-session
TryExec=/usr/local/bin/stylus-session
Type=Application
DesktopNames=STYLUS
EOF

# ── 6. Sudoers: permitir stylus-mode trocar sessão sem senha ───────────
# O stylus-mode roda como USUÁRIO mas precisa trocar o Session= no SDDM.
# Em vez de polkit ou setuid (shell scripts não aceitam setuid no Arch),
# damos permissão para um comando específico.
SUDOERS_STYLUS="/etc/sudoers.d/stylus-mode"
cat > "$SUDOERS_STYLUS" <<SUDOERS
# stylus-mode pode trocar a sessão do SDDM sem senha.
$REAL_USER ALL=(root) NOPASSWD: /usr/local/bin/stylus-set-session desktop, /usr/local/bin/stylus-set-session music
SUDOERS
chmod 0440 "$SUDOERS_STYLUS"
ok "sudoers: stylus-mode pode trocar sessão"

# ── 7. KDE Config ──────────────────────────────────────────────────────
# Stock KDE: não mexemos no kwinrc (deixa o KDE decidir focus policy,
# compositor, atalhos). Só tema e visual.
C="$USER_HOME/.config"
mkdir -p "$C"

cat > "$C/plasmarc" <<'EOF'
[Theme]
name=Breeze Dark
EOF

mkdir -p "$C/gtk-3.0" "$C/gtk-4.0"
cat > "$C/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-font-name=Noto Sans 11
EOF
cp "$C/gtk-3.0/settings.ini" "$C/gtk-4.0/settings.ini"

for ver in qt5ct qt6ct; do
    mkdir -p "$C/$ver"
    cat > "$C/$ver/$ver.conf" <<EOF
[Appearance]
custom_palette=true
color_scheme_path=/usr/share/$ver/colors/stylus.conf
icon_theme=Papirus-Dark
style=Fusion

[Fonts]
fixed=@Variant(\0\0\0@\0\0\0\x16JetBrainsMono Nerd Font\0\0\0\n\0\0\0\0\x32\x7f\0\0\x18)
general=@Variant(\0\0\0@\0\0\0\x12Noto Sans\0\0\0\n\0\0\0\0\x28\x7f\0\0\x14)
EOF
done

mkdir -p "$C/Kvantum"
cat > "$C/Kvantum/kvantum.kvconfig" <<'EOF'
[General]
theme=Stylus
EOF

mkdir -p "$C/konsole"
cat > "$C/konsole/Stylus.profile" <<'EOF'
[General]
Name=Stylus
Parent=FALLBACK/

[Appearance]
ColorScheme=Stylus
Font=JetBrainsMono Nerd Font,12,-1,5,50,0,0,0,0,0
UseCustomFont=true

[Scrolling]
HistoryMode=2
EOF

cat > "$C/konsole/Stylus.colorscheme" <<'EOF'
[Background]
Color=7,8,11
[Foreground]
Color=204,208,224
[Color0]
Color=26,29,36
[Color1]
Color=200,80,80
[Color2]
Color=0,212,170
[Color3]
Color=220,180,60
[Color4]
Color=0,102,204
[Color5]
Color=180,100,220
[Color6]
Color=0,180,180
[Color7]
Color=204,208,224
[Color8]
Color=61,65,80
[Color9]
Color=220,100,100
[Color10]
Color=0,230,190
[Color11]
Color=240,200,80
[Color12]
Color=0,120,230
[Color13]
Color=200,120,240
[Color14]
Color=0,200,200
[Color15]
Color=255,255,255
[General]
Description=Stylus Dark
Opacity=0.95
Blur=true
EOF

# ── 8. Autostart: tema e wallpaper ─────────────────────────────────────
mkdir -p "$C/autostart"
cat > "$C/autostart/stylus-kde.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Stylus KDE
Exec=/usr/local/bin/stylus-kde-shortcuts
Hidden=false
NoDisplay=true
X-KDE-autostart-after-desktop=true
OnlyShowIn=KDE;
EOF

# ── 9. Dono ───────────────────────────────────────────────────────────
chown -R "$REAL_USER":"$REAL_USER" "$C"

echo ""
printf "${GREEN}═══ PRONTO ═══${NC}\n"
echo ""
echo "  sudo reboot"
echo ""
echo "  KDE Plasma é a sessão padrão agora."
echo "  Para alternar para i3: stylus-mode toggle"
echo "  Para remover KDE: sudo stylus-switch-i3 && sudo reboot"
echo ""
