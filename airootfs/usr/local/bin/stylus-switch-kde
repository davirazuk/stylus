#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-switch-kde — instala KDE Plasma e configura tudo
# ═══════════════════════════════════════════════════════════════════════════
#    sudo stylus-switch-kde && sudo reboot
#
#  Para voltar ao i3:
#    sudo stylus-switch-i3 && sudo reboot
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
info()  { printf "${BLUE}==>${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}  !${NC} %s\n" "$*"; }
fail()  { printf "${RED}  ✗${NC} %s\n" "$*"; }

[[ $EUID -eq 0 ]] || { fail "sudo stylus-switch-kde"; exit 1; }

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo stylus)}"
USER_HOME=$(eval echo "~$REAL_USER")
ok "Usuário: $REAL_USER ($USER_HOME)"

# ── 1. Pacotes ─────────────────────────────────────────────────────────
info "Instalando KDE..."
pacman -S --needed --noconfirm \
    plasma-desktop plasma-workspace plasma-nm plasma-pa powerdevil khotkeys \
    kde-gtk-config kvantum sddm konsole dolphin gwenview kate \
    xdg-desktop-portal-kde qt5ct qt6ct \
    adw-gtk-theme papirus-icon-theme \
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk \
    2>/dev/null && ok "Pacotes OK" || warn "algum pacote falhou"

# ── 2. Modo ────────────────────────────────────────────────────────────
mkdir -p "$USER_HOME/.config/stylus"
echo "desktop" > "$USER_HOME/.config/stylus/mode"
chown "$REAL_USER":"$REAL_USER" "$USER_HOME/.config/stylus/mode"
ok "Modo: desktop"

# ── 3. SDDM ────────────────────────────────────────────────────────────
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/stylus.conf <<SDDM
[General]
DisplayServer=x11
Numlock=on

[Theme]
Current=stylus

[Autologin]
User=$REAL_USER
Session=stylus.desktop
Relogin=true
SDDM
ok "SDDM configurado"

# ── 4. KDE Config ──────────────────────────────────────────────────────
C="$USER_HOME/.config"
mkdir -p "$C"

# KWin
cat > "$C/kwinrc" <<'EOF'
[Compositing]
OpenGLIsUnsafe=false
LatencyPolicy=85

[Desktops]
Number=1

[Windows]
BorderlessMaximizedWindows=true
FocusPolicy=ClickRaise
BorderlessMouseQuickTileEnabled=true

[TabBox]
LayoutName=Compact
EOF

# Plasma Dark
cat > "$C/plasmarc" <<'EOF'
[Theme]
name=Breeze Dark
EOF

# GTK Dark
mkdir -p "$C/gtk-3.0" "$C/gtk-4.0"
cat > "$C/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-font-name=Noto Sans 11
EOF
cp "$C/gtk-3.0/settings.ini" "$C/gtk-4.0/settings.ini"

# Qt Fusion Dark
for ver in qt5ct qt6ct; do
    mkdir -p "$C/$ver"
    cat > "$C/$ver/$ver.conf" <<EOF
[Appearance]
custom_palette=true
color_scheme_path=/usr/share/$ver/colors/stylus.conf
icon_theme=Papirus-Dark
style=Fusion

[Fonts]
fixed=@Variant(\0\0\0@\0\0\0\x16JetBrainsMono Nerd Font\0\0\0\n\0\0\0\0\x32\x7f\0\0\x18)
general=@Variant(\0\0\0@\0\0\0\x12Noto Sans\0\0\0\n\0\0\0\0\x28\x7f\0\0\x14)
EOF
done

# Konsole Stylus
mkdir -p "$C/konsole"
cat > "$C/konsole/Stylus.profile" <<'EOF'
[General]
Name=Stylus
Parent=FALLBACK/

[Appearance]
ColorScheme=Stylus
Font=JetBrainsMono Nerd Font,12,-1,5,50,0,0,0,0,0
UseCustomFont=true

[Scrolling]
HistoryMode=2
EOF

cat > "$C/konsole/Stylus.colorscheme" <<'EOF'
[Background]
Color=7,8,11
[Foreground]
Color=204,208,224
[Color0]
Color=26,29,36
[Color1]
Color=200,80,80
[Color2]
Color=0,212,170
[Color3]
Color=220,180,60
[Color4]
Color=0,102,204
[Color5]
Color=180,100,220
[Color6]
Color=0,180,180
[Color7]
Color=204,208,224
[Color8]
Color=61,65,80
[Color9]
Color=220,100,100
[Color10]
Color=0,230,190
[Color11]
Color=240,200,80
[Color12]
Color=0,120,230
[Color13]
Color=200,120,240
[Color14]
Color=0,200,200
[Color15]
Color=255,255,255
[General]
Description=Stylus Dark
Opacity=0.95
Blur=true
EOF

# ── 5. KDE Shortcuts ──────────────────────────────────────────────────
# kglobalaccel5 é o daemon que faz o Meta key funcionar. Se o
# kglobalshortcutsrc estiver corrompido, deletar para o KDE recriar.
KGSC="$C/kglobalshortcutsrc"
if [[ -f "$KGSC" ]] && ! grep -q "plasma-show-desktop\|_k_friendly_name" "$KGSC" 2>/dev/null; then
    rm -f "$KGSC"
    ok "kglobalshortcutsrc corrompido — removido (KDE recria no boot)"
fi

mkdir -p "$C/autostart"

cat > "$C/autostart/stylus-kde.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Stylus KDE
Exec=/usr/local/bin/stylus-kde-shortcuts
Hidden=false
NoDisplay=true
X-KDE-autostart-after-desktop=true
OnlyShowIn=KDE;
EOF

ok "KDE configs escritas"

# ── 6. Dono ────────────────────────────────────────────────────────────
chown -R "$REAL_USER":"$REAL_USER" "$C"

echo ""
printf "${GREEN}═══ PRONTO ═══${NC}\n"
echo ""
echo "  sudo reboot"
echo ""
echo "  Depois do reboot:"
echo "    • Modo música: stylus-mode music"
echo "    • Modo desktop: stylus-mode desktop"
echo "    • Deck: stylus-deck"
echo "    • Estante: stylus-shelf"
echo "    • Volta pro i3: sudo stylus-switch-i3 && sudo reboot"
echo ""
