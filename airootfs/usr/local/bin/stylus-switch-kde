#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-switch-kde — troca o i3 pelo KDE Plasma
# ═══════════════════════════════════════════════════════════════════════════
#  Instala o plasma-desktop, configura tema escuro e define modo desktop.
#  NÃO remove i3 — é fallback se KDE quebrar. Roda como root.
#
#    sudo stylus-switch-kde
#    sudo reboot
#
#  Para voltar ao i3:
#    sudo stylus-switch-i3
#    sudo reboot
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
info()  { printf "${BLUE}==>${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}  !${NC} %s\n" "$*"; }
err()   { printf "${RED}  ✗${NC} %s\n" "$*"; }

[[ $EUID -eq 0 ]] || { err "rode como root: sudo stylus-switch-kde"; exit 1; }

REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo stylus)}"
USER_HOME=$(eval echo "~$REAL_USER")
ok "Usuário: $REAL_USER"

# ── 1. Instalar KDE ───────────────────────────────────────────────────
KDE_PKGS=(
    plasma-desktop plasma-workspace plasma-nm plasma-pa
    plasma-browser-integration kde-gtk-config kvantum sddm
    konsole dolphin ark gwenview spectacle kate
    xdg-desktop-portal-kde xsettingsd
    qt5ct qt6ct adw-gtk-theme papirus-icon-theme
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk
)

info "Instalando KDE Plasma..."
pacman -S --needed --noconfirm "${KDE_PKGS[@]}" || warn "algum pacote não instalou — KDE pode estar incompleto"
ok "KDE instalado"

# NÃO remove i3 — é fallback de segurança

# ── 2. Modo desktop ───────────────────────────────────────────────────
# stylus-session já detecta KDE: se startplasma-x11 existe, usa ele.
# Só precisamos escrever "desktop" no arquivo de modo.
MODE_FILE="$USER_HOME/.config/stylus/mode"
mkdir -p "$(dirname "$MODE_FILE")"
echo "desktop" > "$MODE_FILE"
chown "$REAL_USER":"$REAL_USER" "$MODE_FILE"
ok "Modo: desktop (KDE na próxima sessão)"

# ── 3. SDDM: manter stylus.desktop como sessão ────────────────────────
# stylus.desktop é o dispatcher — ele lê o modo e decide KDE ou i3.
# NÃO trocar para plasma.desktop, senão o stylus-mode para de funcionar.
SDDM_CONF="/etc/sddm.conf.d/stylus.conf"
mkdir -p /etc/sddm.conf.d
cat > "$SDDM_CONF" <<SDDM
[General]
DisplayServer=x11
Numlock=on

[Theme]
Current=stylus
CursorTheme=Adwaita
CursorSize=24

[Autologin]
User=$REAL_USER
Session=stylus.desktop
Relogin=true

[X11]
MinimumVT=7

[Users]
HideShells=/usr/bin/nologin,/sbin/nologin
SDDM

ok "SDDM: autologin=$REAL_USER, sessão=stylus.desktop (dispatcher)"

# ── 4. KDE configs ────────────────────────────────────────────────────
KDE_CONF="$USER_HOME/.config"
mkdir -p "$KDE_CONF"

# KWin
cat > "$KDE_CONF/kwinrc" <<'KWIN'
[Compositing]
OpenGLIsUnsafe=false

[Desktops]
Number=1

[Wayland]
Enabled=false
KWIN

# Plasma tema escuro
cat > "$KDE_CONF/plasmarc" <<'PLASMA'
[Theme]
name=Breeze Dark
PLASMA

# GTK
mkdir -p "$KDE_CONF/gtk-3.0" "$KDE_CONF/gtk-4.0"
cat > "$KDE_CONF/gtk-3.0/settings.ini" <<'GTK3'
[Settings]
gtk-theme-name=adw-gtk3-dark
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Adwaita
gtk-font-name=Noto Sans 11
GTK3
cp "$KDE_CONF/gtk-3.0/settings.ini" "$KDE_CONF/gtk-4.0/settings.ini"

# Qt
for ver in qt5ct qt6ct; do
    mkdir -p "$KDE_CONF/$ver"
    cat > "$KDE_CONF/$ver/$ver.conf" <<QT
[Appearance]
custom_palette=true
color_scheme_path=/usr/share/$ver/colors/stylus.conf
icon_theme=Papirus-Dark
standard_dialogs=default
style=Fusion

[Fonts]
fixed=@Variant(\0\0\0@\0\0\0\x16JetBrainsMono Nerd Font\0\0\0\n\0\0\0\0\x32\x7f\0\0\x18)
general=@Variant(\0\0\0@\0\0\0\x12Noto Sans\0\0\0\n\0\0\0\0\x28\x7f\0\0\x14)
QT
done

# Konsole
KONSOLE_DIR="$KDE_CONF/konsole"
mkdir -p "$KONSOLE_DIR"
cat > "$KONSOLE_DIR/Stylus.profile" <<'KONSOLE'
[General]
Name=Stylus
Parent=FALLBACK/

[Appearance]
ColorScheme=Stylus
Font=JetBrainsMono Nerd Font,12,-1,5,50,0,0,0,0,0
UseCustomFont=true

[Scrolling]
HistoryMode=2
KONSOLE

cat > "$KONSOLE_DIR/Stylus.colorscheme" <<'COLORS'
[Background]
Color=7,8,11

[Foreground]
Color=204,208,224

[Color0]
Color=26,29,36
[Color1]
Color=200,80,80
[Color2]
Color=0,212,170
[Color3]
Color=220,180,60
[Color4]
Color=0,102,204
[Color5]
Color=180,100,220
[Color6]
Color=0,180,180
[Color7]
Color=204,208,224

[Color8]
Color=61,65,80
[Color9]
Color=220,100,100
[Color10]
Color=0,230,190
[Color11]
Color=240,200,80
[Color12]
Color=0,120,230
[Color13]
Color=200,120,240
[Color14]
Color=0,200,200
[Color15]
Color=255,255,255

[General]
Description=Stylus Dark
Opacity=0.95
Blur=true
COLORS

ok "KDE: tema escuro, Konsole, Dolphin, GTK, Qt"

# ── 5. Dono dos configs ───────────────────────────────────────────────
chown -R "$REAL_USER":"$REAL_USER" "$KDE_CONF"
chown -R "$REAL_USER":"$REAL_USER" "$USER_HOME/.config/stylus"

# ── Resumo ─────────────────────────────────────────────────────────────
echo ""
printf "${GREEN}═══ PRONTO ═══${NC}\n"
echo ""
echo "  KDE Plasma instalado."
echo "  Tema: escuro, Papirus-Dark, JetBrains Mono"
echo "  Autologin: $REAL_USER"
echo "  Sessão: stylus.desktop (dispatcher → KDE automaticamente)"
echo ""
echo "  Reinicie: sudo reboot"
echo ""
echo "  Depois do reboot:"
echo "    • Modo música: stilu-mode music"
echo "    • Modo desktop: stylus-mode desktop"
echo "    • Deck: Meta+D ou stylus-deck"
echo "    • Trocar modo: Meta+T"
echo ""
echo "  Para voltar ao i3:"
echo "    sudo stylus-switch-i3 && sudo reboot"
echo ""
