#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-switch-kde — troca o i3 pelo KDE Plasma
# ═══════════════════════════════════════════════════════════════════════════
#  Instala o plasma-desktop e o essencial do KDE, remove i3/polybar/rofi,
#  cria a sessão KDE no SDDM e ativa o autologin. Roda como root.
#
# Depois de rodar:
#    sudo stylus-switch-kde
#    sudo reboot
#
#  A máquina volta no KDE. A estante, o deck e o modo música continuam
#  funcionando — são scripts, não dependentes do WM.
#
#  Para voltar ao i3:
#    sudo stylus-switch-i3
#    sudo reboot
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
info()  { printf "${BLUE}==>${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}  ✓${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}  !${NC} %s\n" "$*"; }
err()   { printf "${RED}  ✗${NC} %s\n" "$*"; }

# ── Pré-requisitos ────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || { err "rode como root: sudo stylus-switch-kde"; exit 1; }

info "Pacotes do KDE Plasma..."

# Pacotes KDE que o stylus precisa
KDE_PKGS=(
    plasma-desktop
    plasma-workspace
    plasma-nm
    plasma-pa
    plasma-browser-integration
    kde-gtk-config
    kvantum
    sddm
    konsole
    dolphin
    ark
    gwenview
    spectacle
    kate
    nitrogen
    xdg-desktop-portal-kde
    xsettingsd
    qt5ct
    qt6ct
    adw-gtk-theme
    papirus-icon-theme
    ttf-jetbrains-mono-nerd
    noto-fonts
    noto-fonts-emoji
    noto-fonts-cjk
)

# Pacotes i3 que serão removidos
I3_PKGS=(
    i3-wm
    i3lock
    xss-lock
    polybar
    rofi
    picom
    dunst
    feh
    arandr
    autorandr
)

info "Instalando KDE Plasma..."
pacman -S --needed --noconfirm "${KDE_PKGS[@]}"
ok "KDE instalado"

info "Removendo i3 e barra..."
pacman -Rns --noconfirm "${I3_PKGS[@]}" 2>/dev/null || warn "alguns pacotes i3 não estavam instalados"
ok "i3 removido"

# ── Sessão KDE ────────────────────────────────────────────────────────────
info "Criando sessão KDE..."

KDE_SESSION="/usr/share/xsessions/plasma.desktop"
cat > "$KDE_SESSION" <<'DESKTOP'
[Desktop Entry]
Name=KDE Plasma
Comment=KDE Plasma Desktop
Exec=/usr/bin/startplasma-x11
Type=Application
DesktopNames=KDE
DESKTOP

ok "Sessão KDE criada em $KDE_SESSION"

# ── Ativar KDE como padrão no SDDM ──────────────────────────────────────
SDDM_CONF="/etc/sddm.conf.d/stylus.conf"
if [[ -f "$SDDM_CONF" ]]; then
    # Trocar Session= para plasma.desktop
    if grep -q "^Session=" "$SDDM_CONF"; then
        sed -i 's/^Session=.*/Session=plasma.desktop/' "$SDDM_CONF"
    else
        echo "Session=plasma.desktop" >> "$SDDM_CONF"
    fi
else
    mkdir -p /etc/sddm.conf.d
    cat > "$SDDM_CONF" <<'SDDM'
[Autologin]
User=stylus
Session=plasma.desktop
SDDM
fi

ok "SDDM configurado para KDE"

# ── Modo padrão ──────────────────────────────────────────────────────────
MODE_FILE="/home/stylus/.config/stylus/mode"
mkdir -p "$(dirname "$MODE_FILE")"
echo "desktop" > "$MODE_FILE"
chown -R stylus:stylus "$(dirname "$MODE_FILE")"

ok "Modo padrão: desktop"

# ── Wallpaper ────────────────────────────────────────────────────────────
if [[ -d /usr/share/backgrounds/stylus ]]; then
    info "Configurando wallpaper do nitrogen..."
    NITROGEN_DIR="/home/stylus/.config/nitrogen"
    mkdir -p "$NITROGEN_DIR"
    cat > "$NITROGEN_DIR/bg-saved.cfg" <<BG
[xin-background]
file=/usr/share/backgrounds/stylus/stylus.png
mode=0
bgcolor=#07080b
BG
    chown -R stylus:stylus "$NITROGEN_DIR"
    ok "Wallpaper configurado"
fi

echo ""
printf "${GREEN}═══ PRONTO ═══${NC}\n"
echo ""
echo "  KDE Plasma instalado e configurado."
echo "  Reinicie: sudo reboot"
echo ""
echo "  Para voltar ao i3:"
echo "    sudo stylus-switch-i3"
echo "    sudo reboot"
echo ""
