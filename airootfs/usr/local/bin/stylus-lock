#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  stylus-lock — lock the screen against the STYLUS wallpaper rather than a flat
#  colour.
#
#  This lives in /usr/local/bin rather than in the i3 configuration because
#  three different sessions need it: the desktop (Mod+L and xss-lock), the Big
#  Picture session, and the launcher's power menu. They used to each call
#  i3lock directly with their own colour, which is how two of them ended up
#  locking to a leftover Catppuccin grey.
#
#  i3lock does not scale images, so a 1920x1080 wallpaper on any other screen
#  would sit in a corner. The wallpaper is rendered to the current resolution
#  once and cached; the flat colour is the fallback when that is not possible.
# ─────────────────────────────────────────────────────────────────────────────
set -u

# O papel de parede mora numa PASTA chamada stylus, e este caminho apontava
# para um arquivo com o nome da pasta. Como todo uso dele estava atrás de um
# `[[ -f $BG ]]`, nada quebrava: a tela de bloqueio só nunca mostrava o papel
# de parede, em resolução nenhuma, e caía sempre na cor chapada lá embaixo.
BG=/usr/share/backgrounds/stylus/stylus.png
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/stylus"
# INK, a mesma cor de fundo do resto do sistema. Era 10241d — um cinza
# ESVERDEADO (16,36,29) que não está na paleta e não veio de lugar nenhum.
# Ficava escondido justamente porque era o caminho que sempre acontecia.
COLOR=07080b

# ── No KDE, quem tranca é o KDE ────────────────────────────────────────────
# Chamar o i3lock aqui dentro do Plasma desenha uma tela por cima e pronto: a
# SESSÃO não fica marcada como trancada. O Plasma continua achando que está
# aberta, o Meta+L dele abre um segundo bloqueio por baixo, e o que o
# loginctl responde sobre a máquina passa a ser mentira. Pedir ao loginctl é
# o mesmo caminho que o próprio KDE usa.
if [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] || pgrep -x plasmashell >/dev/null 2>&1; then
    loginctl lock-session "${XDG_SESSION_ID:-self}" 2>/dev/null && exit 0
    command -v loginctl >/dev/null && loginctl lock-sessions 2>/dev/null && exit 0
fi

command -v i3lock >/dev/null 2>&1 || {
    echo "stylus-lock: nem o KDE nem o i3lock estão aqui para trancar a tela" >&2
    exit 1
}

geometry=$(xrandr --current 2>/dev/null | awk '/\*/ {print $1; exit}')
[[ -z $geometry ]] && exec i3lock -c "$COLOR" -e -f

# Pre-rendered at build time for the common resolutions - no image tooling
# needed on the machine.
PRERENDERED="/usr/share/stylus/lock/stylus-$geometry.png"
[[ -f $PRERENDERED ]] && exec i3lock -i "$PRERENDERED" -e -f

CACHE="$CACHE_DIR/lock-$geometry.png"

if [[ ! -f $CACHE && -f $BG ]]; then
    mkdir -p "$CACHE_DIR"
    if command -v magick >/dev/null; then
        magick "$BG" -resize "${geometry}^" -gravity center -extent "$geometry" \
               -fill black -colorize 35% "$CACHE" 2>/dev/null
    elif command -v convert >/dev/null; then
        convert "$BG" -resize "${geometry}^" -gravity center -extent "$geometry" \
                -fill black -colorize 35% "$CACHE" 2>/dev/null
    elif command -v ffmpeg >/dev/null; then
        ffmpeg -loglevel quiet -y -i "$BG" \
               -vf "scale=${geometry/x/:}:force_original_aspect_ratio=increase,crop=${geometry/x/:},eq=brightness=-0.25" \
               "$CACHE" 2>/dev/null
    fi
fi

if [[ -f $CACHE ]]; then
    exec i3lock -i "$CACHE" -e -f
fi
exec i3lock -c "$COLOR" -e -f
