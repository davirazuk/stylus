#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus — the front door
# ═══════════════════════════════════════════════════════════════════════════
#  Everything this system does about music hangs off this one command, on
#  purpose. A collection tool that is fourteen separate scripts is fourteen
#  things to remember; this is one thing with rooms in it.
#
#  The bare `stylus` says what is on right now, because that is the question
#  asked most often and it should not need a subcommand.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# O STYLUS_SHARE existe para poder rodar este despachante contra um CLONE sem
# instalar nada — a mesma ideia do STYLUS_SOURCE do sync.sh e do
# STYLUS_GUARD_ROOT do guarda de sessão. Sem ele, testar uma correção nas
# ferramentas exigia sincronizar a máquina primeiro, e o que se testava era
# sempre a versão velha que já estava instalada.
SHARE=${STYLUS_SHARE:-/usr/share/stylus}
DECK=$SHARE/deck
TOOLS=$SHARE/tools
PY="$DECK/venv/bin/python3"
[[ -x $PY ]] || PY=python3
export PYTHONPATH="$DECK${PYTHONPATH:+:$PYTHONPATH}"

d=$'\033[2m'; b=$'\033[1m'; a=$'\033[38;5;117m'; o=$'\033[0m'

usage() {
cat <<EOF

  ${b}stylus${o} ${d}— o sistema, do lado da música${o}

  ${a}ouvir${o}
    ${b}stylus${o}                    o que está tocando, e onde no disco
    ${b}stylus deck${o} ${d}[DISCO]${o}      põe um disco e abre o deck: a cerimônia
                              inteira, com o disco girando na tela. Volta para
                              onde a agulha parou — ${d}--recomeçar${o} põe do zero
    ${b}stylus play${o} ${d}DISCO${o}        toca o lado inteiro, na ordem, sem tela
    ${b}stylus record${o} ${d}[DISCO]${o}    sorteia um da estante e mostra os lados,
                              puxando para o que faz tempo que não toca
    ${b}stylus shelf${o}              a estante em grade de capas
    ${b}stylus ui${o}                 a tela cheia, do jeito que ela abre no sofá
    ${b}stylus lado${o}               em que lado do disco você está, e quanto falta
    ${b}stylus virar${o}              põe a agulha no começo do próximo lado
                              ${d}(stylus voltar faz o contrário)${o}
    ${b}stylus parede${o} ${d}[DISCO]${o}    põe o disco que está tocando de papel de
                              parede — o desenho vem da intensidade dele
    ${b}stylus scope${o}              só o instrumento: o vetorscópio, sem disco

  ${a}a coleção${o}
    ${b}stylus library${o} ${d}[PASTA]${o}   mostra ou define onde ela fica
    ${b}stylus diary${o} ${d}[N]${o}         o que você pôs, quando, e quantas vezes
    ${b}stylus stats${o} ${d}[--ano N]${o}   o formato da sua escuta: quem volta, em que
                              dia, a que horas, o que nunca saiu da prateleira
    ${b}stylus check${o}              o que está quebrado aí dentro
    ${b}stylus gaps${o} ${d}ARTISTA${o}      que discos desse artista faltam
    ${b}stylus covers${o} ${d}[--apply]${o}  cover.jpg nas pastas que não têm
    ${b}stylus lyrics${o} ${d}[DISCO]${o}    procura e grava .lrc ao lado dos arquivos
    ${b}stylus tags${o} ${d}[DISCO]${o}      arruma tags e capa embutida
    ${b}stylus rip${o}                rasga o CD que está na gaveta, para a estante
    ${b}stylus get${o} ${d}URL|FILA${o}      baixa e arquiva na estante
    ${b}stylus qobuz${o} ${d}[...]${o}       a interface do qobuz-dl, e a fila que
                              baixa e arquiva disco por disco
    ${b}stylus suggest${o}            playlists sugeridas pela sua escuta
    ${b}stylus reindex${o}            limpa o cache da estante e recria

  ${a}as máquinas${o}
    ${b}stylus phone${o} ${d}[...]${o}       o celular: estado, sincronizar, playlists
    ${b}stylus webdav${o} ${d}[...]${o}      põe a coleção do celular na estante, sem copiar
    ${b}stylus audio${o}              o caminho do sinal, medido, não prometido
    ${b}stylus apps${o} ${d}[NOME]${o}       instala o que não vem em pacote
    ${b}stylus ch${o} ${d}[...]${o}          Clone Hero: buscar, baixar e sincronizar songs
    ${b}stylus gpu${o}                driver de vídeo
    ${b}stylus kde${o}                por que a área de trabalho não abriu
    ${b}stylus aur${o}                instala o yay, para o que só existe no AUR
    ${b}stylus fontes${o}             por que apareceu caixinha no lugar do ícone
    ${b}stylus mode${o} ${d}[música|área]${o} troca entre a tela cheia e a área de trabalho
    ${b}stylus claude${o} ${d}[...]${o}      o Claude Code aqui dentro, com a fonte do
                              sistema do lado e a máquina para olhar
    ${b}stylus atalhos${o}            a lista de atalhos de teclado
    ${b}stylus instalar${o}           instala o STYLUS no computador (medium ao vivo)
    ${b}stylus update${o}             atualiza o sistema
    ${b}stylus backup${o}             salva configuração e memória da coleção

  ${d}sem argumento nenhum, responde a pergunta que se faz mais vezes.${o}
  ${d}também atende por: now, app, install, wallpaper.${o}

EOF
}

need() { command -v "$1" >/dev/null || { echo "stylus: falta o $1" >&2; return 1; }; }

cmd=${1:-}
[[ -n $cmd ]] && shift || true

# ── `stylus X --help` nunca pode FAZER o X ────────────────────────────────
# **Sintoma:** o `--help` era repassado ao programa de baixo, e vários deles
# não sabem o que é. `stylus backup --help` FAZIA UM BACKUP e deixava um
# .tar.gz na casa da pessoa. `stylus reindex --help` relia a estante inteira.
# `stylus aur --help` mexia no yay. `stylus app --help` e `stylus ch --help`
# respondiam "não conheço --help" em vermelho, e `stylus ui --help` não dizia
# nada. Ou seja: o gesto universal de "me explique antes de eu executar" era
# justamente o que executava.
#
# Quem sabe se explicar está na lista abaixo, e foi CONFERIDO um por um — o
# resto é respondido aqui. A lista é a exceção e não a regra de propósito:
# um subcomando novo, ou um cujo programa mudou, cai no lado seguro sozinho.
# O `shelf` NÃO está aqui: o `stylus-shelf --help` abre o rofi e tenta tomar
# o teclado da sessão — conferido, ele desiste depois de 5001 tentativas. Um
# `--help` que sequestra a tela é o pior caso desta lista, não o menor.
SABEM_AJUDAR=" now deck play record library diary stats check gaps
covers lyrics tags rip get qobuz suggest phone webdav audio gpu kde fontes
mode parede wallpaper spotify instalar install update "

if [[ ${1:-} == -h || ${1:-} == --help ]] && [[ -n $cmd ]]; then
    if [[ $SABEM_AJUDAR != *" $cmd "* ]]; then
        # A linha que o próprio `stylus` já escreve sobre este subcomando,
        # sem os códigos de cor, mais as linhas de continuação (que vêm
        # indentadas e sem "stylus" no começo).
        linha_de() {            # linha_de <regex-do-nome>
            usage | sed 's/\x1b\[[0-9;]*m//g' |
                awk -v c="$1" '
                    $0 ~ "^ +stylus " c "( |$)" { p=1; print; next }
                    p && /^ +stylus / { exit }
                    p && /^ *$/       { exit }
                    p                 { print }
                '
        }
        # Exato primeiro; depois com sufixo, porque vários subcomandos têm
        # apelido e a lista escreve só um deles — o `stylus app` funciona mas
        # está escrito como "stylus apps". Nesta ordem, e não numa expressão
        # só, senão "ch" acharia a linha do "check".
        texto=$(linha_de "$cmd")
        [[ -z $texto ]] && texto=$(linha_de "$cmd[a-z]*")
        if [[ -n $texto ]]; then
            printf '%s\n' "$texto"
        else
            printf '\n  %sstylus %s%s não está na lista de ajuda.\n' \
                   "$b" "$cmd" "$o"
        fi
        printf '\n  %sstylus --help%s mostra a lista inteira.\n\n' "$d" "$o"
        exit 0
    fi
fi

case "$cmd" in
    ""|now)
        # No modo música, `stylus` sozinho abre a tela cheia — é o lançador.
        # Se ela JÁ está aberta (o caso normal: o i3 a abriu no login), o
        # stylus-ui devolve 76 e aqui cai no texto do que está tocando, que
        # é o que alguém num terminal ou por ssh queria de verdade.
        if [[ "${STYLUS_MODE:-}" == "music" ]] ||
           [[ "$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/stylus/mode" 2>/dev/null)" == "music" ]]; then
            stylus-ui "$@"; rc=$?
            (( rc == 76 )) || exit $rc
        fi
        exec "$PY" "$TOOLS/now.py" "$@" ;;
    ui)          exec stylus-ui "$@" ;;
    deck)        exec stylus-deck "$@" ;;
    play)        exec stylus-deck --no-scope "$@" ;;
    scope)       exec "$PY" "$DECK/scope.py" "$@" ;;
    record)      exec "$PY" "$TOOLS/record.py" "$@" ;;
    shelf)       exec stylus-shelf "$@" ;;
    library)     exec "$PY" "$TOOLS/library.py" "$@" ;;
    diary)       exec "$PY" "$TOOLS/diary.py" "$@" ;;
    stats)       exec "$PY" "$TOOLS/stats.py" "$@" ;;
    check)       exec "$PY" "$TOOLS/check_library.py" "$@" ;;
    gaps)        exec "$PY" "$TOOLS/discover.py" "$@" ;;
    covers)      exec "$PY" "$TOOLS/extract_covers.py" "$@" ;;
    lyrics)      exec "$PY" "$TOOLS/lyrics.py" "$@" ;;
    tags)        exec "$PY" "$TOOLS/embed_metadata.py" "$@" ;;
    rip)         exec "$PY" "$TOOLS/rip.py" "$@" ;;
    get)         exec "$PY" "$TOOLS/get.py" "$@" ;;
    # A interface web do qobuz-dl e a fila que ela alimenta. As duas filas já
    # estavam aqui e não havia como chegar nelas nem como pôr a interface no ar.
    qobuz)       exec stylus-qobuz "$@" ;;
    suggest)     exec "$PY" "$TOOLS/suggest_playlists.py" "$@" ;;
    reindex)
        # A interface guarda um índice da estante para abrir instantaneamente.
        # Apagá-lo é como se manda ela reler o disco.
        rm -f "$HOME/.cache/stylus/shelf.json" "$HOME/.cache/stylus/shelf.tsv"
        "$PY" -c 'import vinyl; print(f"{len(vinyl.shelf(min_tracks=1))} discos")'
        ;;
    backup)
        # Só o que é SEU e não dá para baixar de novo: a memória da coleção,
        # as playlists, a configuração. A música não vai — ela é grande e já
        # está no celular. Sem remoto configurado, guarda aqui do lado.
        alvo="${STYLUS_BACKUP:-gdrive:stylus-backup/$(date +%F)}"
        if command -v rclone >/dev/null && rclone listremotes 2>/dev/null | grep -q .; then
            rclone copy "$HOME/.local/share/stylus" "$alvo/state" --progress
            rclone copy "$HOME/.config/stylus" "$alvo/config" --progress
            echo "em $alvo"
        else
            dest="$HOME/stylus-backup-$(date +%F).tar.gz"
            tar czf "$dest" -C "$HOME" .local/share/stylus .config/stylus 2>/dev/null
            echo "sem remoto do rclone configurado; guardei em $dest"
        fi
        ;;
    mode)        exec stylus-mode "$@" ;;
    # O papel de parede desenhado a partir do disco que está tocando.
    parede|wallpaper) exec stylus-wallpaper "$@" ;;
    # Em que lado do disco você está, agora.
    lado)        exec stylus-side-watch --once "$@" ;;
    # Dava para pular FAIXA desde sempre e não dava para pular LADO — a única
    # coisa que este sistema pede que você faça com as mãos.
    virar)       exec stylus-side-watch --virar "$@" ;;
    voltar)      exec stylus-side-watch --voltar "$@" ;;
    # Estes três existiam como uma FUNÇÃO do fish chamada `stylus`, que ficava
    # na frente deste arquivo no shell padrão do sistema e respondia "comando
    # desconhecido" para deck, library, phone, record, shelf — a CLI inteira
    # do README, morta no shell em que todo mundo digita. A função saiu; o que
    # ela tinha de bom veio para cá, onde é o lugar.
    instalar|install)
        command -v stylus-install >/dev/null || {
            echo "stylus: o instalador só existe no medium ao vivo." >&2; exit 1; }
        exec sudo stylus-install "$@" ;;
    atalhos)     exec less -R /usr/share/stylus/keybindings.txt ;;
    # O Claude Code, nesta máquina. Editar a fonte e VER acontecer é a coisa
    # que nenhuma sessão remota consegue fazer.
    claude)      exec stylus-claude "$@" ;;
    aur)         exec install-yay "$@" ;;
    phone)       exec stylus-phone "$@" ;;
    webdav)      exec stylus-webdav "$@" ;;
    audio)       exec stylus-audio "$@" ;;
    # `apps` no plural, e os dois nomes que a função do fish entendia. Ela
    # aceitava `stylus apps` e foi removida daqui — o que quebrou o comando
    # para quem já o usava, sem nada dizer o que tinha acontecido. Um alias
    # custa uma linha; quebrar o dedo de quem já digitava custa mais.
    app|apps)    exec stylus-app "$@" ;;
    ch)          exec stylus-ch "$@" ;;
    gpu)         exec stylus-gpu "$@" ;;
    # Por que a área de trabalho não abriu. Quando o pré-voo do
    # stylus-session recusa o Plasma, ele entrega o i3 e não diz nada na
    # tela — este é o lugar onde o motivo fica escrito.
    kde)         exec stylus-kde "$@" ;;
    # Caixinha vazia na tela não diz nada sobre a causa, e as causas são quatro.
    fontes)      exec stylus-fontes "$@" ;;
    update)      exec stylus-update "$@" ;;
    -h|--help|help) usage ;;
    *)
        # Um nome que não é subcomando quase sempre é um DISCO — "stylus
        # loveless" tem que fazer a coisa óbvia em vez de imprimir a ajuda.
        if "$PY" -c "import sys, vinyl; sys.exit(0 if vinyl.resolve_album(None,'','$cmd') or __import__('os').path.isdir('$cmd') else 1)" 2>/dev/null; then
            exec stylus-deck "$cmd" "$@"
        fi
        echo "stylus: não conheço \"$cmd\", e não achei nenhum disco com esse nome." >&2
        echo "        \`stylus --help\` lista o que existe." >&2
        exit 1
        ;;
esac
