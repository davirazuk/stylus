#!/usr/bin/env bash
# stylus-mode — troca entre MÚSICA e ÁREA DE TRABALHO, como um Steam Deck.
#
#     stylus-mode              diz em qual você está
#     stylus-mode desktop      vai para a área de trabalho
#     stylus-mode music        volta para a tela cheia
#     stylus-mode toggle       o outro, seja qual for
#     sudo stylus-mode permitir  libera a troca sem senha (uma vez só)
#     stylus-mode autologin      entra sozinho? (ligar / desligar)
#
# Encerra a sessão X para trocar. COM autologin isso é meio segundo de tela
# preta e você está do outro lado; sem ele, a tela de login aparece no meio e
# pede a senha — o que assusta quem não foi avisado. `stylus-mode autologin`
# diz em qual dos dois casos esta máquina está.
set -uo pipefail
F="$HOME/.config/stylus/mode"
mkdir -p "$(dirname "$F")"
cur=$(cat "$F" 2>/dev/null || echo music)

# ── Liberar a troca sem senha ──────────────────────────────────────────────
#  A troca precisa mexer na configuração do SDDM, e isso é root. O
#  stylus-install grava a regra que permite exatamente estas duas chamadas —
#  mas SÓ na hora de instalar. Máquina que já existia nunca recebe: o
#  stylus-update copia o airootfs e o airootfs não tem sudoers de máquina
#  instalada (o único que existe lá é o do medium ao vivo, que some no
#  final da instalação).
#
#  Sem a regra, o `sudo` de baixo é chamado a partir de um item de menu, sem
#  terminal e sem askpass. Ele falha na hora, o aviso vai para um stderr que
#  ninguém está lendo, e o script seguia em frente e derrubava a sessão do
#  mesmo jeito — que voltava no MESMO modo, porque o SDDM não tinha sido
#  trocado. Do lado de cá: clicou em "Modo música", a tela piscou, e nada.
permitir() {
    [[ $EUID -eq 0 ]] || { echo "use: sudo stylus-mode permitir" >&2; exit 1; }
    local quem=${SUDO_USER:-${1:-}}
    [[ -n $quem ]] || { echo "não sei para quem liberar; rode com sudo" >&2; exit 1; }
    id "$quem" >/dev/null 2>&1 || { echo "usuário desconhecido: $quem" >&2; exit 1; }
    local alvo=/etc/sudoers.d/stylus-mode tmp
    tmp=$(mktemp) || exit 1
    printf '%s ALL=(root) NOPASSWD: /usr/local/bin/stylus-set-session desktop, /usr/local/bin/stylus-set-session music\n' \
        "$quem" > "$tmp"
    # Um sudoers com erro de sintaxe tranca o sudo da máquina inteira. Valida
    # ANTES de pôr no lugar, e nunca escreve direto no destino.
    if ! visudo -cf "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"; echo "a regra não passou no visudo; nada foi mudado" >&2; exit 1
    fi
    install -m 0440 -o root -g root "$tmp" "$alvo" && rm -f "$tmp"
    echo "pronto: $quem troca de modo sem senha."
    exit 0
}

# ── entrar sozinho ─────────────────────────────────────────────────────────
#  A promessa desta ferramenta — "meio segundo de preto e você está do outro
#  lado" — só existe com autologin. Numa máquina instalada ele vem DESLIGADO
#  de propósito: entrar sem senha é decisão de quem usa o computador, não
#  nossa, e ligá-lo escondido dentro de outro comando seria tomá-la no lugar
#  da pessoa. Então fica aqui, com o nome dito por extenso.
CONF_SDDM=/etc/sddm.conf.d/stylus.conf

autologin_usuario() {   # imprime o usuário do autologin, se houver
    local f
    for f in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
        [[ -f $f ]] || continue
        sed -n '/^\[Autologin\]/,/^\[/p' "$f" 2>/dev/null \
            | sed -n 's/^User=\(.\+\)/\1/p' | head -1 | grep . && return 0
    done
    return 1
}

autologin() {
    local quem acao=${1:-}
    case "$acao" in
        ""|estado)
            if quem=$(autologin_usuario); then
                echo "entra sozinho como $quem."
            else
                echo "não entra sozinho: o login pede a senha."
                echo "para ligar:  sudo stylus-mode autologin ligar"
            fi
            exit 0 ;;
        ligar|desligar) ;;
        *) echo "uso: stylus-mode autologin [ligar|desligar]" >&2; exit 1 ;;
    esac
    [[ $EUID -eq 0 ]] || { echo "use: sudo stylus-mode autologin $acao" >&2; exit 1; }
    quem=${SUDO_USER:-}
    [[ -n $quem ]] || { echo "não sei para quem; rode com sudo" >&2; exit 1; }
    mkdir -p "$(dirname "$CONF_SDDM")"
    [[ -f $CONF_SDDM ]] || printf '[Autologin]\n' > "$CONF_SDDM"
    grep -q '^\[Autologin\]' "$CONF_SDDM" || printf '\n[Autologin]\n' >> "$CONF_SDDM"
    # Só a linha User= dentro do bloco [Autologin]; nada mais do arquivo é
    # tocado. Um sed sem o intervalo pegaria um User= de outra seção.
    sed -i '/^\[Autologin\]/,/^\[/{/^User=/d}' "$CONF_SDDM"
    if [[ $acao == ligar ]]; then
        sed -i "/^\[Autologin\]/a User=$quem" "$CONF_SDDM"
        grep -q '^Relogin=' "$CONF_SDDM" || sed -i "/^\[Autologin\]/a Relogin=true" "$CONF_SDDM"
        echo "pronto: a máquina entra sozinha como $quem."
        echo "(trocar de modo passa a ser meio segundo de preto, sem senha.)"
    else
        echo "pronto: o login volta a pedir a senha."
        echo "(trocar de modo continua funcionando — só passa pela tela de login.)"
    fi
    exit 0
}

# Troca a sessão do SDDM, e devolve se conseguiu.
#
# `-n` primeiro, sempre: a regra do sudoers libera exatamente estas duas
# chamadas sem senha, e sem terminal um `sudo` que PEDE senha abriria um
# askpass que pode não existir — pendurando o item de menu para sempre. Só
# quando há terminal de verdade é que vale a pena perguntar.
trocar_sessao() {
    local alvo=$1
    sudo -n /usr/local/bin/stylus-set-session "$alvo" >/dev/null 2>&1 && return 0
    [[ -t 0 ]] || return 1
    echo "a troca de modo precisa de sudo nesta máquina:" >&2
    sudo /usr/local/bin/stylus-set-session "$alvo" >/dev/null
}

case "${1:-}" in
    "")        echo "$cur"; exit 0 ;;
    permitir|allow) shift; permitir "$@" ;;
    autologin|sozinho) shift; autologin "$@" ;;
    music|desktop|kde) novo=$1 ;;
    toggle)    novo=$([[ $cur == music ]] && echo desktop || echo music) ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)         echo "stylus-mode: música ou área de trabalho, só isso." >&2; exit 1 ;;
esac

[[ $novo == "$cur" ]] && { echo "já está no modo $novo"; exit 0; }

# ── Trocar a sessão do SDDM ───────────────────────────────────────────
# O SDDM precisa saber qual sessão lançar. Vai o NOME do modo, não o nome do
# arquivo: quem sabe se a sessão do Plasma se chama plasma.desktop ou
# plasmax11.desktop nesta máquina é o stylus-set-session, que olha.
#
# E a ordem importa: TROCAR PRIMEIRO, gravar o modo depois, derrubar a sessão
# por último. Antes o modo era gravado antes de qualquer conferência, e a
# sessão era derrubada mesmo quando a troca falhava — deixando o arquivo
# dizendo "music" numa máquina que voltou no KDE, e o próximo `toggle` indo
# para o lado errado.
# A área de trabalho NÃO é só o Plasma. Exigir o startplasma-x11 aqui
# recusava a troca numa máquina que tem o i3 completo — e é exatamente para
# ele que o stylus-session cai quando o Plasma não está instalado, de
# propósito ("o i3 é uma área de trabalho de verdade"). Quem decide qual das
# duas abrir é o stylus-session, na hora; aqui só se pergunta se existe
# ALGUMA.
if [[ $novo != "music" ]] \
   && ! command -v startplasma-x11 >/dev/null 2>&1 \
   && ! command -v i3 >/dev/null 2>&1; then
    echo "não há área de trabalho instalada — rode: sudo stylus-switch-kde" >&2
    exit 1
fi
if [[ $novo == "music" ]] && ! command -v i3 >/dev/null 2>&1; then
    echo "i3 não está instalado — rode: sudo stylus-switch-i3" >&2
    exit 1
fi

if ! trocar_sessao "$([[ $novo == music ]] && echo music || echo desktop)"; then
    # E NÃO derruba a sessão. Derrubar aqui era o pior dos mundos: a tela
    # apagava, voltava no mesmo lugar, e nada explicava.
    echo "não deu para trocar a sessão do SDDM." >&2
    echo "Falta a permissão. Rode uma vez:  sudo stylus-mode permitir" >&2
    command -v notify-send >/dev/null && \
        notify-send --app-name=STYLUS --urgency=critical \
            "não deu para trocar de modo" \
            "falta uma permissão. num terminal, uma vez só:
sudo stylus-mode permitir" 2>/dev/null || true
    exit 1
fi
echo "$novo" > "$F"

# ── vai voltar sozinho, ou vai pedir senha? ────────────────────────────────
# **Sintoma:** "o Meta+Esc quebrou o KDE e eu tive que reiniciar."
#
# O que acontecia: a sessão caía, e a máquina NÃO entrava de volta sozinha.
# A promessa desta ferramenta — "meio segundo de preto e você está do outro
# lado" — depende de o SDDM ter autologin configurado. Numa máquina instalada
# ele não tem: o instalador tira o `User=` do bloco [Autologin] de propósito,
# porque autologin sem senha numa máquina de verdade é decisão de quem
# instala, não nossa.
#
# Sem o `User=`, apertar o atalho dá: tela preta, e depois uma tela de login
# que ninguém estava esperando. Do lado de quem apertou, isso não se lê como
# "digite sua senha": lê-se como a máquina ter quebrado. E a reação certa
# para uma máquina quebrada é reiniciar, que foi o que aconteceu.
#
# A troca continua sendo a mesma; o que faltava era avisar.
autologin_ligado() { autologin_usuario >/dev/null 2>&1; }
alvo_humano=$([[ $novo == music ]] && echo MÚSICA || echo 'ÁREA DE TRABALHO')
if autologin_ligado; then
    aviso="voltando em um segundo…"
    urgencia=low
else
    aviso="a tela vai apagar e o login vai pedir a sua senha.
o modo $alvo_humano já está escolhido lá.
(sudo stylus-mode autologin ligar tira a senha do caminho)"
    urgencia=normal
    echo "atenção: esta máquina não tem autologin." >&2
    echo "A tela vai apagar e o SDDM vai pedir a sua senha — o modo $alvo_humano" >&2
    echo "já vai estar escolhido. (Não é defeito.)" >&2
    echo "Para trocar de modo sem passar por ali:  sudo stylus-mode autologin ligar" >&2
fi

# Avisar ANTES de derrubar a sessão: sem isto a tela some sem explicação e
# parece que alguma coisa quebrou.
command -v notify-send >/dev/null && \
    notify-send --app-name=STYLUS --urgency="$urgencia" \
        "modo $alvo_humano" "$aviso" 2>/dev/null || true
# Sem autologin a pessoa precisa LER o aviso antes de a tela apagar.
sleep "$(autologin_ligado && echo 0.6 || echo 2.5)"
if command -v i3-msg >/dev/null && i3-msg -t get_version >/dev/null 2>&1; then
    exec i3-msg exit
fi
exec loginctl terminate-session "${XDG_SESSION_ID:-self}"
