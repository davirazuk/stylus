#!/usr/bin/env bash
# stylus-mode — troca entre MÚSICA e ÁREA DE TRABALHO, como um Steam Deck.
#
#     stylus-mode              diz em qual você está
#     stylus-mode desktop      vai para a área de trabalho
#     stylus-mode music        volta para a tela cheia
#     stylus-mode toggle       o outro, seja qual for
#
# Encerra a sessão X para trocar. Com o autologin ligado (que é o padrão
# deste sistema) isso é meio segundo de tela preta e você está do outro lado.
set -uo pipefail
F="$HOME/.config/stylus/mode"
mkdir -p "$(dirname "$F")"
cur=$(cat "$F" 2>/dev/null || echo music)

case "${1:-}" in
    "")        echo "$cur"; exit 0 ;;
    music|desktop|kde) novo=$1 ;;
    toggle)    novo=$([[ $cur == music ]] && echo desktop || echo music) ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)         echo "stylus-mode: música ou área de trabalho, só isso." >&2; exit 1 ;;
esac

[[ $novo == "$cur" ]] && { echo "já está no modo $novo"; exit 0; }
echo "$novo" > "$F"

# ── Trocar a sessão do SDDM ───────────────────────────────────────────
# O SDDM precisa saber qual sessão lançar. Vai o NOME do modo, não o nome do
# arquivo: quem sabe se a sessão do Plasma se chama plasma.desktop ou
# plasmax11.desktop nesta máquina é o stylus-set-session, que olha.
if [[ $novo == "desktop" || $novo == "kde" ]]; then
    sudo /usr/local/bin/stylus-set-session desktop 2>/dev/null \
        || echo "⚠ não conseguiu trocar sessão — rode: sudo stylus-switch-kde" >&2
else
    # Verificar se i3 está instalado antes de trocar
    if ! command -v i3 >/dev/null 2>&1; then
        echo "⚠ i3 não está instalado — rode: sudo stylus-switch-i3" >&2
        echo "$cur" > "$F"
        exit 1
    fi
    sudo /usr/local/bin/stylus-set-session music 2>/dev/null \
        || echo "⚠ não conseguiu trocar sessão — rode: sudo stylus-switch-i3" >&2
fi

# Avisar ANTES de derrubar a sessão: sem isto a tela some sem explicação e
# parece que alguma coisa quebrou.
command -v notify-send >/dev/null && \
    notify-send --app-name=STYLUS --urgency=low \
        "modo $([[ $novo == music ]] && echo MÚSICA || echo 'ÁREA DE TRABALHO')" \
        "voltando em um segundo…" 2>/dev/null || true
sleep 0.6
if command -v i3-msg >/dev/null && i3-msg -t get_version >/dev/null 2>&1; then
    exec i3-msg exit
fi
exec loginctl terminate-session "${XDG_SESSION_ID:-self}"
