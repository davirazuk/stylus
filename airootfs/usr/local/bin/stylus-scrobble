#!/usr/bin/env python3
"""
stylus-scrobble — scrobbler para last.fm

Roda em background via systemd user service. Monitora o que está tocando
via playerctl (MPRIS) e scrobla para o last.fm.

Requer:
  - API key e secret do last.fm (registrados em https://www.last.fm/api/account/create)
  - Login uma vez: stylus-scrobble login

Scrobla automaticamente quando:
  - A faixa foi OUVIDA por pelo menos 4 minutos OU metade da duração (o que
    vier primeiro). Ouvida, não decorrida: pausar congela o contador, e
    pular para a frente não conta o pedaço que você pulou.
  - Não scrobla a mesma faixa duas vezes seguidas
"""
import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request

CONFIG = os.path.expanduser("~/.config/stylus/scrobble.json")
STATE = os.path.expanduser("~/.local/share/stylus")
PIDFILE = os.path.join(STATE, "scrobbler.pid")

# last.fm API
API_URL = "https://ws.audioscrobbler.com/2.0/"
AUTH_URL = "https://www.last.fm/api/auth/"


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)


def api_call(method, params, config):
    """Chama a API do last.fm com assinatura MD5."""
    params["api_key"] = config["api_key"]
    params["method"] = method
    params["format"] = "json"

    # Assinatura: todos os parâmetros ordenados + secret, MD5
    if "sk" in config:
        params["sk"] = config["sk"]
    sig = "".join(f"{k}{params[k]}" for k in sorted(params))
    sig += config["api_secret"]
    params["api_sig"] = hashlib.md5(sig.encode()).hexdigest()

    data = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(API_URL, data=data)
    try:
        resp = urllib.request.urlopen(req, timeout=10)
        return json.loads(resp.read())
    except Exception as e:
        print(f"  API error: {e}", file=sys.stderr)
        return {}


def get_now_playing():
    """O que está tocando, via playerctl.

    **A duração vinha SEMPRE zero.** O formato pedido era
    `{{duration(mpris:length)}}`, e o `duration()` do playerctl é o ajudante
    que FORMATA microssegundos em "3:42" — daí o `isdigit()` logo abaixo
    dava falso e a duração virava 0 em toda faixa. Com ela zerada, o limiar
    de scrobble caía sempre nos 4 minutos fixos, e a metade "ou metade da
    duração" da regra do last.fm nunca acontecia: **nenhuma música de menos
    de quatro minutos era scroblada, nunca**, que é metade do que se ouve.

    Agora vem o `mpris:length` cru. Ele é em MICROssegundos — a variável
    antiga se chamava `duration_ms` e dividia por mil, o que teria dado um
    número mil vezes maior se algum dia tivesse chegado a ser lido.
    """
    try:
        r = subprocess.run(
            ["playerctl", "metadata", "--format",
             "{{artist}}\n{{album}}\n{{title}}\n{{mpris:length}}"],
            capture_output=True, text=True, timeout=3
        )
        if r.returncode != 0:
            return None
        lines = r.stdout.strip().split("\n")
        if len(lines) < 3:
            return None
        artist, album, title = lines[0], lines[1], lines[2]
        micros = 0
        if len(lines) > 3:
            try:
                micros = int(float(lines[3].strip()))
            except (TypeError, ValueError):
                micros = 0
        return {
            "artist": artist,
            "album": album,
            "title": title,
            "duration": max(0, micros // 1_000_000),   # microssegundos → s
        }
    except Exception:
        return None


def get_position():
    """A posição da agulha, em segundos — ou None quando não dá para saber.

    Mesma armadilha do `get_now_playing`: pedia
    `--format {{position(mpris:position)}}`, que é o ajudante que FORMATA em
    "2:05", e o `isdigit()` embaixo nunca era verdade — devolvia 0 sempre.
    O `playerctl position` sem formato já escreve segundos com decimal.

    Devolve None e não 0 quando não sabe: zero é uma posição válida (o
    começo da faixa) e confundir as duas fazia o contador de escuta andar
    sozinho.
    """
    try:
        r = subprocess.run(["playerctl", "position"],
                           capture_output=True, text=True, timeout=3)
        if r.returncode != 0:
            return None
        return float(r.stdout.strip())
    except (ValueError, OSError, subprocess.SubprocessError):
        return None


# De quanto em quanto tempo o laço olha o tocador.
PASSO = 5.0


def ouviu_quanto(antes, agora):
    """Quanto de MÚSICA passou entre duas voltas do laço, em segundos.

    POR QUE ISTO EXISTE
    -------------------
    O contador era `time.time() - track_start`: relógio de parede desde que a
    faixa apareceu. O docstring deste arquivo promete "pausar e voltar não
    reseta o contador", e o que acontecia era pior do que resetar — **pausar
    não PARAVA o contador**. Sair para o almoço com a música pausada
    scroblava a faixa inteira sem ninguém ter ouvido nada, e é justamente
    isso que um scrobble não pode fazer: ele é o registro do que você ouviu.

    Aqui a conta é sobre a AGULHA. Um passo do laço são cinco segundos, então
    um avanço plausível está entre zero e dois passos:

      · pausado, a posição não anda   → zero, e o contador congela;
      · busca para frente             → salto grande, não conta (você não
                                        ouviu o pedaço que pulou);
      · busca para trás / repetiu     → salto negativo, não conta, e a
                                        próxima volta continua de onde está.

    Sem posição nenhuma (tocador sem MPRIS de posição), volta ao relógio de
    parede — um scrobbler que desiste é pior do que um impreciso.
    """
    if antes is None or agora is None:
        return PASSO
    d = agora - antes
    return d if 0.0 < d <= PASSO * 2.0 else 0.0


def scrobble(track, config):
    """Envia um scrobble para o last.fm."""
    params = {
        "artist": track["artist"],
        "track": track["title"],
        "timestamp": str(int(time.time())),
    }
    if track.get("album"):
        params["album"] = track["album"]
    if track.get("duration"):
        params["duration"] = str(track["duration"])
    return api_call("track.scrobble", params, config)


def update_now_playing(track, config):
    """Atualiza o now playing no last.fm."""
    params = {
        "artist": track["artist"],
        "track": track["title"],
    }
    if track.get("album"):
        params["album"] = track["album"]
    if track.get("duration"):
        params["duration"] = str(track["duration"])
    return api_call("track.updateNowPlaying", params, config)


def do_login():
    """Fluxo de login interativo."""
    print("\n  Para configurar o scrobbling:")
    print("  1. Acesse https://www.last.fm/api/account/create")
    print("  2. Crie uma aplicação e copie a API key e o secret")
    print()
    api_key = input("  API key: ").strip()
    api_secret = input("  API secret: ").strip()
    if not api_key or not api_secret:
        print("  API key e secret são obrigatórios.")
        return

    config = {"api_key": api_key, "api_secret": api_secret}

    # Gerar URL de autorização
    sig_params = {"method": "auth.getToken", "api_key": api_key}
    sig = "".join(f"{k}{sig_params[k]}" for k in sorted(sig_params))
    sig += api_secret
    sig_params["api_sig"] = hashlib.md5(sig.encode()).hexdigest()
    sig_params["format"] = "json"

    data = urllib.parse.urlencode(sig_params).encode()
    req = urllib.request.Request(API_URL, data=data)
    resp = urllib.request.urlopen(req, timeout=10)
    token_data = json.loads(resp.read())
    token = token_data.get("token", "")

    if not token:
        print("  Não conseguiu obter token.")
        return

    auth_url = f"{AUTH_URL}?api_key={api_key}&token={token}"
    print(f"\n  Abra no navegador:\n  {auth_url}\n")
    print("  Autorize a aplicação e pressione Enter quando pronto.")
    input("  > ")

    # Obter sessão
    session_params = {"method": "auth.getSession", "token": token}
    session = api_call("auth.getSession", session_params,
                       {"api_key": api_key, "api_secret": api_secret})
    if "session" in session:
        config["sk"] = session["session"]["key"]
        config["username"] = session["session"]["name"]
        save_config(config)
        print(f"  ✓ Logado como {config['username']}")
    else:
        print(f"  ✗ Falha: {session}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "login":
        do_login()
        return

    if len(sys.argv) > 1 and sys.argv[1] == "status":
        config = load_config()
        if config.get("sk"):
            print(f"  ✓ Logado como {config.get('username', '?')}")
        else:
            print("  ✗ Não logado — rode: stylus-scrobble login")
        return

    config = load_config()
    if not config.get("sk"):
        print("  ✗ Não logado — rode: stylus-scrobble login", file=sys.stderr)
        sys.exit(1)

    # Escrever PID
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    last_track = None
    ouvido = 0.0            # segundos de música que REALMENTE passaram
    anterior = None         # a posição da agulha na volta passada
    scrobbled = False

    try:
        while True:
            time.sleep(PASSO)
            track = get_now_playing()
            if not track or not track["artist"] or not track["title"]:
                last_track = None
                anterior = None
                scrobbled = False
                continue

            # Nova faixa?
            key = f"{track['artist']}|{track['album']}|{track['title']}"
            pos = get_position()
            if key != last_track:
                last_track = key
                ouvido, anterior = 0.0, pos
                scrobbled = False
                # Atualizar now playing
                update_now_playing(track, config)
            else:
                ouvido += ouviu_quanto(anterior, pos)
                anterior = pos

            duration = track.get("duration", 0)

            # Scrobble: 4min OU metade da duração (o que vier primeiro)
            threshold = min(240, max(0, duration // 2)) if duration else 240
            if not scrobbled and ouvido >= threshold and threshold > 0:
                result = scrobble(track, config)
                if result and result.get("scrobbles"):
                    accepted = result["scrobbles"].get("@attr", {}).get("accepted", 0)
                    if int(accepted) > 0:
                        scrobbled = True
                        print(f"  ✓ {track['artist']} — {track['title']}")
    except KeyboardInterrupt:
        pass
    finally:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
