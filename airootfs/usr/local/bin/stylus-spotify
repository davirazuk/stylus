#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stylus-spotify — busca e controle do Spotify via spotifyd + spotipy
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

# Igual ao `stylus`: dá para apontar este comando para um clone e testar o
# conserto antes de aplicá-lo na máquina.
SHARE=${STYLUS_SHARE:-/usr/share/stylus}

# O spotipy não existe nos repositórios do Arch e o `pip install` do sistema
# é recusado (PEP 668). Quem resolve isso é o venv da pessoa; veja o porquê
# inteiro em /usr/share/stylus/venv.sh.
# shellcheck source=/dev/null
source "$SHARE/venv.sh" 2>/dev/null || true
if declare -F venv_python_ou_sistema >/dev/null; then
    PY=$(venv_python_ou_sistema)
else
    PY="$SHARE/deck/venv/bin/python3"; [[ -x $PY ]] || PY=python3
fi

usage() {
cat <<'EOF'
  stylus-spotify search QUERY    busca faixas (saída JSON)
  stylus-spotify play URI        toca uma faixa (spotify:track:...)
  stylus-spotify pause           pausa
  stylus-spotify next            próxima faixa
  stylus-spotify prev            faixa anterior
  stylus-spotify status          agora tocando (saída JSON)
  stylus-spotify daemon          verifica se spotifyd está rodando
  stylus-spotify instalar        instala o spotipy (uma vez, na sua casa)
  stylus-spotify instalar --daemon  instala TAMBÉM o spotifyd, que é quem toca
EOF
}

cmd=${1:-}
[[ -n $cmd ]] && shift || true

case "$cmd" in
    search|buscar)
        query="$*"
        [[ -z $query ]] && { echo '{"error":"faltou a busca"}' >&2; exit 1; }
        $PY - "$query" <<'PYEOF'
import configparser, json, os, sys

# As credenciais. A versão anterior trazia um client_id fixo no código e um
# client_secret VAZIO — e o fluxo de client credentials do Spotify não
# autentica sem segredo. Ou seja: a busca não funcionava em máquina nenhuma,
# e o que aparecia era o erro do servidor, não "faltam credenciais".
#
# Aqui elas vêm do ambiente ou de ~/.config/stylus/spotify.conf, no mesmo
# feitio do config.ini do qobuz-dl.
def credenciais():
    cid = os.environ.get("STYLUS_SPOTIFY_ID", "").strip()
    seg = os.environ.get("STYLUS_SPOTIFY_SECRET", "").strip()
    if cid and seg:
        return cid, seg
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                       os.path.expanduser("~/.config")),
                        "stylus", "spotify.conf")
    if os.path.exists(conf):
        cp = configparser.ConfigParser()
        try:
            cp.read(conf, encoding="utf-8")
            sec = cp["spotify"] if cp.has_section("spotify") else cp["DEFAULT"]
            return (sec.get("client_id", "").strip(),
                    sec.get("client_secret", "").strip())
        except Exception:                       # noqa: BLE001
            pass
    return "", ""


FALTA = ("o Spotify precisa de credenciais: crie um app em "
         "developer.spotify.com e escreva client_id e client_secret "
         "em ~/.config/stylus/spotify.conf, na seção [spotify]")


def buscar(query):
    cid, seg = credenciais()
    if not cid or not seg:
        return {"error": FALTA}
    try:
        import spotipy
        from spotipy.oauth2 import SpotifyClientCredentials
    except ImportError:
        # A mensagem antiga mandava `pip install --user spotipy`, que no Arch
        # falha sempre: o python é do pacman e o pip recusa mexer nele. Ficava
        # a pior combinação possível — o recurso não funciona e a instrução
        # para consertar também não.
        return {"error": "o spotipy não está instalado. "
                         "Rode:  stylus spotify instalar"}
    try:
        sp = spotipy.Spotify(auth_manager=SpotifyClientCredentials(
            client_id=cid, client_secret=seg))
        r = sp.search(q=query, type="track", limit=20)
    except Exception as e:                      # noqa: BLE001
        return {"error": str(e)}

    faixas = []
    for t in r.get("tracks", {}).get("items", []):
        ms = t.get("duration_ms", 0)
        faixas.append({
            "name":   t.get("name", ""),
            "artist": ", ".join(a["name"] for a in t.get("artists", [])),
            "album":  t.get("album", {}).get("name", ""),
            "uri":    t.get("uri", ""),
            "duration": "%d:%02d" % (ms // 60000, (ms % 60000) // 1000),
        })
    return {"tracks": faixas}


q = sys.argv[1] if len(sys.argv) > 1 else ""
if not q:
    print(json.dumps({"error": "busca vazia"}))
    sys.exit(1)
print(json.dumps(buscar(q), ensure_ascii=False))
PYEOF
        ;;
    play|tocar)
        uri="${1:-}"
        [[ -z $uri ]] && { echo '{"error":"faltou URI"}' >&2; exit 1; }
        playerctl -p spotifyd open "$uri" 2>/dev/null
        ;;
    pause|pausar)
        playerctl -p spotifyd play-pause 2>/dev/null
        ;;
    next|proxima)
        playerctl -p spotifyd next 2>/dev/null
        ;;
    prev|anterior)
        playerctl -p spotifyd previous 2>/dev/null
        ;;
    status|tocando)
        playerctl -p spotifyd metadata \
            --format '{"title":"{{title}}","artist":"{{artist}}","album":"{{album}}","status":"{{status}}","position":"{{position(m)}}","duration":"{{duration(m)}}"}' \
            2>/dev/null || echo '{"status":"stopped"}'
        ;;
    daemon)
        # Três estados, não dois. A tela de instalação mandava rodar
        # `systemctl --user enable --now spotifyd` para quem não tinha o
        # spotifyd INSTALADO — e ele não está nos repositórios oficiais do
        # Arch, está no AUR. O comando falhava com "Unit spotifyd.service not
        # found" e a pessoa ficava sem saída nenhuma, tendo feito exatamente o
        # que a tela mandou.
        if playerctl -p spotifyd status >/dev/null 2>&1; then
            echo "ok"
        elif command -v spotifyd >/dev/null 2>&1; then
            echo "parado"
        else
            echo "ausente"
        fi
        ;;
    instalar|install)
        declare -F venv_instalar >/dev/null || {
            echo "stylus-spotify: falta o $SHARE/venv.sh" >&2; exit 1; }
        if venv_tem spotipy; then
            echo "o spotipy já está instalado."
        else
            echo "Instalando o spotipy no ambiente Python do STYLUS…"
            venv_instalar spotipy || {
                echo "stylus-spotify: a instalação falhou (sem rede?)" >&2; exit 1; }
        fi
        venv_tem spotipy && echo "pronto. \`stylus spotify buscar NOME\` já funciona."
        # O spotifyd só a pedido: ele vem do AUR, é compilado na máquina, e
        # leva minutos. Instalar isso sem avisar dentro de um comando que a
        # pessoa achou que era rápido é o tipo de surpresa que não se faz.
        if [[ ${1:-} == --daemon ]]; then
            if command -v spotifyd >/dev/null 2>&1; then
                echo "o spotifyd já está aqui."
            elif command -v yay >/dev/null 2>&1; then
                echo "Instalando o spotifyd do AUR (ele é compilado aqui; leva alguns minutos)…"
                yay -S --needed --noconfirm spotifyd || {
                    echo "stylus-spotify: o spotifyd não instalou." >&2; exit 1; }
            else
                echo "o spotifyd mora no AUR e esta máquina não tem um auxiliar." >&2
                echo "Rode antes:  install-yay" >&2
                exit 1
            fi
            echo "agora:  systemctl --user enable --now spotifyd"
            echo "(e ele precisa de conta Premium — o Spotify não deixa tocar sem.)"
        else
            command -v spotifyd >/dev/null 2>&1 || \
                echo "  para tocar também:  stylus spotify instalar --daemon"
        fi ;;
    -h|--help|help) usage ;;
    *) echo "stylus-spotify: \"$cmd\" não existe" >&2; usage >&2; exit 1 ;;
esac
