# STYLUS Dark — a paleta da interface de música, para os aplicativos do KDE.
#
# Regra §5.5: âmbar é a ÚNICA cor viva. Ele é a seleção, o foco e o cursor —
# nada mais no sistema tem direito a ele. Azul é informação (links), e o resto
# é a mesma escala de cinza-azulado do fundo da tela cheia. Sem isto o KDE
# abre em Breeze claro e a máquina fica com duas personalidades.
[General]
ColorScheme=StylusDark
Name=STYLUS Dark
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=7,8,11
BackgroundAlternate=16,18,25
ForegroundNormal=232,236,245
ForegroundActive=240,160,48
ForegroundInactive=138,149,170
ForegroundLink=91,206,250
ForegroundVisited=183,160,255
ForegroundNegative=238,122,130
ForegroundNeutral=255,200,80
ForegroundPositive=126,217,158
DecorationFocus=240,160,48
DecorationHover=192,128,32

