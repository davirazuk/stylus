# ═══════════════════════════════════════════════════════════════════════════
#  STYLUS — MODO MÚSICA
# ═══════════════════════════════════════════════════════════════════════════
#  i3 sem nada de i3: sem barra, sem bordas, sem espaços, tudo em tela cheia.
#  Ele está aqui só para dar foco e decoração a qualquer janela que um jogo
#  ou um diálogo abra por cima da interface — sem WM nenhum, um instalador do
#  Steam abre sem foco e a pessoa acha que travou.
#
#  A interface é a única coisa que se vê. Se ela morrer, o i3 a reabre.
# ═══════════════════════════════════════════════════════════════════════════
set $mod Mod4

font pango:JetBrainsMono Nerd Font 11
default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
gaps outer 0
focus_follows_mouse no

# A interface: em tela cheia, sempre, e reaberta se cair.
exec_always --no-startup-id /usr/local/bin/stylus-ui-supervise

# Serviços que o modo música ainda precisa
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
# O aviso do fim do lado vale nos DOIS modos: é o assunto da máquina, não um
# enfeite da área de trabalho.
exec --no-startup-id stylus-side-watch
exec --no-startup-id nm-applet --indicator
exec --no-startup-id picom -b

# Tudo o que abrir, abre em tela cheia. Num modo de sofá não existe
# "janelinha": ou a coisa toma a tela ou ela não deveria ter aberto.
for_window [class=".*"] fullscreen enable

# ── as únicas teclas que existem aqui ──────────────────────────────────────
bindsym $mod+d exec --no-startup-id stylus-mode desktop
bindsym $mod+q kill
bindsym $mod+Return exec --no-startup-id alacritty
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym $mod+Shift+r restart
