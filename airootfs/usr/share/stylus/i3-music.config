# ═══════════════════════════════════════════════════════════════════════════
#  STYLUS — MODO MÚSICA
# ═══════════════════════════════════════════════════════════════════════════
#  i3 sem nada de i3: sem barra, sem bordas, sem espaços, tudo em tela cheia.
#  Ele está aqui só para dar foco e decoração a qualquer janela que um jogo
#  ou um diálogo abra por cima da interface — sem WM nenhum, um instalador do
#  Steam abre sem foco e a pessoa acha que travou.
#
#  A interface é a única coisa que se vê. Se ela morrer, o i3 a reabre.
# ═══════════════════════════════════════════════════════════════════════════
set $mod Mod4

font pango:JetBrainsMono Nerd Font 11
default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
gaps outer 0
focus_follows_mouse no

# A interface: em tela cheia, sempre, e reaberta se cair.
exec_always --no-startup-id /usr/local/bin/stylus-ui-supervise

# Serviços que o modo música ainda precisa
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
# O aviso do fim do lado vale nos DOIS modos: é o assunto da máquina, não um
# enfeite da área de trabalho.
exec --no-startup-id stylus-side-watch
exec --no-startup-id nm-applet --indicator
exec --no-startup-id picom -b

# Tudo o que abrir, abre em tela cheia. Num modo de sofá não existe
# "janelinha": ou a coisa toma a tela ou ela não deveria ter aberto.
for_window [class=".*"] fullscreen enable

# ── navegação ──────────────────────────────────────────────────────────────
# Mod+D: volta pro desktop (área de trabalho)
bindsym $mod+d exec --no-startup-id stylus-mode desktop
# Mod+M: abre a estante ( grade de capas )
bindsym $mod+m exec --no-startup-id stylus-shelf
# Mod+O: abre o deck (vinil)
bindsym $mod+o exec --no-startup-id stylus-deck
# Mod+G: abre a interface de música em janela (não reinicia)
bindsym $mod+g exec --no-startup-id stylus-ui
# Mod+Return: terminal
bindsym $mod+Return exec --no-startup-id alacritty
# Mod+Q: fechar janela
bindsym $mod+q kill
# Mod+F: fullscreen toggle (para diálogos)
bindsym $mod+f fullscreen toggle

# ── virar o lado ───────────────────────────────────────────────────────────
# Os controles de mídia pulam FAIXA; isto põe a agulha no começo do outro
# LADO, que é a única coisa que este sistema pede que você faça com as mãos.
bindsym $mod+Shift+v exec --no-startup-id stylus-side-watch --virar

# ── mídia (botoes do teclado) ──────────────────────────────────────────────
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
# Volume com OSD (on-screen display) — mostra barra na tela
set $osd ~/.config/i3/scripts/osd.sh
bindsym XF86AudioRaiseVolume exec --no-startup-id $osd vol-up
bindsym XF86AudioLowerVolume exec --no-startup-id $osd vol-down
bindsym XF86AudioMute        exec --no-startup-id $osd vol-mute
# Brilho
bindsym XF86MonBrightnessUp   exec --no-startup-id $osd bright-up
bindsym XF86MonBrightnessDown exec --no-startup-id $osd bright-down

# ── atalhos extras ─────────────────────────────────────────────────────────
# Mod+Shift+M: controle de volume por canal (pavucontrol)
bindsym $mod+Shift+m exec --no-startup-id pavucontrol
# Mod+Slash: letra da música que está tocando
bindsym $mod+slash exec --no-startup-id rofi -e "$(stylus lyrics --print 2>/dev/null)"
# Mod+Shift+R: reiniciar i3 (sem fechar nada)
bindsym $mod+Shift+r restart
