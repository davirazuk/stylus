# Pelo stylus-term: é programa de terminal, e aberto direto pelo menu do KDE
# ou pelo rofi ele roda sem janela nenhuma — parece que o clique não fez nada.
[Desktop Entry]
Type=Application
Name=Qobuz
GenericName=Comprar e baixar
Comment=Procura e baixa discos em qualidade de estúdio
Exec=stylus-term "Qobuz" stylus-qobuz
Icon=stylus
Terminal=false
StartupNotify=true
Categories=AudioVideo;Audio;
Keywords=qobuz;baixar;comprar;flac;hires;alta resolução;loja;
